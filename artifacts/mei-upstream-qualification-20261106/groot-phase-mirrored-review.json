  "source_lead": {
    "core_commit": "7495d1165da54ef029a1af4c319ebe86f2349896",
    "change": "CommandEncoder.set_input_array now adds data_size()*itemsize(), correctly counting bytes; array.h explicitly defines data_size in elements. needs_commit compares accumulated bytes with the same max-MB heuristic. M1 Max heuristic is50MB, environment MLX_MAX_MB_PER_BUFFER can override.",
    "hypothesis": "Corrected accounting may increase commit frequency for fixed arrays and explain submission/back-pressure change. Test50vs200MB with same candidate/weights/precision/budgets before any production change. Do not undo correct byte accounting."
  },
