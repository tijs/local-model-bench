      "store.py": "def apply(state, row):\n    event, key, delta = row\n    if event in state['seen']:\n        return\n    state['totals'][key] = state['totals'].get(key, 0) + delta\n    state['seen'].append(event)",
      "worker.py": "from store import apply\n\n\ndef pump(pages, state, limit):\n    result = {\n        'at': [state['at'][0], state['at'][1]],\n        'seen': list(state['seen']),\n        'totals': dict(state['totals']),\n    }\n    token, offset = result['at']\n\n    consumed = 0\n    while token and consumed < limit:\n        rows, following = pages[token]\n        available = rows[offset:]\n        if not available:\n            token = following\n            offset = 0\n            continue\n\n        take = available[:limit - consumed]\n        for row in take:\n            apply(result, row)\n        consumed += len(take)\n\n        if consumed < limit:\n            token = following\n            offset = 0\n        else:\n            offset = offset + len(take)\n            if offset >= len(rows):\n                token = following\n                offset = 0\n            break\n\n    # normalize past exhausted and empty pages\n    while token:\n        rows, following = pages[token]\n        if offset >= len(rows):\n            token = following\n            offset = 0\n        else:\n            break\n\n    result['at'] = [token, offset]\n    return result\n\n\ndef export(pages, start, limits):\n    state = {'at': [start, 0], 'seen': [], 'totals': {}}\n    for limit in limits:\n        state = pump(pages, state, limit)\n    return state"
    },
