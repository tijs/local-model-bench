Script:

```rust
use notekeep::{filter_by_tag, Note};

fn mk(id: &str, tags: &[&str]) -> Note {
    Note {
        id: id.to_string(),
        title: id.to_string(),
        body: String::new(),
        tags: tags.iter().map(|t| t.to_string()).collect(),
        pinned: false,
    }
}

fn run(bin: &str, dir: &std::path::Path, args: &[&str]) -> String {
    let out = std::process::Command::new(bin)
        .current_dir(dir)
        .args(args)
        .output()
        .expect("spawn notekeep");
    assert!(out.status.success(), "notekeep exited nonzero: {:?}", out.status);
    String::from_utf8_lossy(&out.stdout).to_string()
}

fn lines(s: &str) -> Vec<String> {
    s.lines().map(|l| l.to_string()).collect()
}

fn main() {
    // --- lib: exact match + order preservation ---
    let notes = vec![
        mk("a", &["x", "y"]),
        mk("b", &[]),
        mk("c", &["rustlang"]),
        mk("d", &["rust"]),
        mk("e", &["x"]),
        mk("f", &["x", "rust"]),
    ];
    assert_eq!(filter_by_tag(&notes, "rust").iter().map(|n| n.id.as_str()).collect
::<Vec<_>>(), vec!["d", "f"]);
    assert_eq!(filter_by_tag(&notes, "x").iter().map(|n| n.id.as_str()).collect::
<Vec<_>>(), vec!["a", "e", "f"]);
    assert!(filter_by_tag(&notes, "nope").is_empty());
    assert!(filter_by_tag(&notes, "").is_empty());
    assert!(filter_by_tag(&[], "x").is_empty());
    println!("lib checks OK");

    // --- CLI: --tag wiring ---
    let bin = std::env::var("NK_BIN").expect("NK_BIN must point at the built note
keep binary");
    let dir = std::env::temp_dir().join("hermes-verify-nkcli");
