+// Verification of filter_by_tag and --tag flag
+// Run: rustc --edition 2021 -L target/debug/deps hermes-verify-filter.rs -o hermes-verify-filter --extern notekeep=target/debug/libnotekeep.rlib 2>&1
+// Then: ./hermes-verify-filter
+
+use notekeep::{filter_by_tag, new_note, Note};
+
+fn main() {
+    let notes = vec![
+        new_note("1", "Rust basics", "Learn #rust #beginner"),
+        new_note("2", "Python guide", "Learn #python #web"),
+        new_note("3", "Rust async", "Async #rust #async"),
+        new_note("4", "Cooking", "#food #recipe"),
+    ];
+
+    // Test 1: filter_by_tag returns exact matches only
+    let rust_notes = filter_by_tag(&notes, "rust");
+    assert_eq!(rust_notes.len(), 2, "expected 2 rust notes, got {}", rust_notes.len());
+    assert_eq!(rust_notes[0].id, "1");
+    assert_eq!(rust_notes[1].id, "3");
+
+    // Test 2: non-matching tag returns empty
+    let go_notes = filter_by_tag(&notes, "go");
+    assert_eq!(go_notes.len(), 0, "expected 0 go notes");
+
+    // Test 3: exact match, not substring (e.g. "rust" should not match "rustacean")
+    let mut notes2 = vec![
+        new_note("a", "rust", "just #rust"),
+        new_note("b", "rustacean", "just #rustacean"),
+    ];
+    let rust2 = filter_by_tag(&notes2, "rust");
+    assert_eq!(rust2.len(), 1, "expected exact match only, got {}", rust2.len());
+    assert_eq!(rust2[0].id, "a");
+
+    // Test 4: order preserved
+    let all_rust = filter_by_tag(&notes, "rust");
+    assert_eq!(all_rust[0].id, "1");
+    assert_eq!(all_rust[1].id, "3");
+
+    // Test 5: empty input
+    let empty: Vec<Note> = vec![];
+    let filtered = filter_by_tag(&empty, "anything");
+    assert_eq!(filtered.len(), 0);
+
+    println!("ALL FILTER_BY_TAG TESTS PASSED");
+}
