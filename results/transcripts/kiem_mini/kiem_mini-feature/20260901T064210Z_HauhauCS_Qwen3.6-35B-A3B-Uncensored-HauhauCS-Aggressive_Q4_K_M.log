+use notekeep::{filter_by_tag, new_note, Note};
+
+fn main() {
+    let notes = vec![
+        new_note("1", "Rust basics", "Learn #rust #beginner"),
+        new_note("2", "Python guide", "Learn #python #web"),
+        new_note("3", "Rust async", "Async #rust #async"),
+        new_note("4", "Cooking", "#food #recipe"),
+    ];
+
+    // 1. Exact match returns correct count
+    let rust = filter_by_tag(&notes, "rust");
+    assert_eq!(rust.len(), 2);
+    assert_eq!(rust[0].id, "1");
+    assert_eq!(rust[1].id, "3");
+
+    // 2. Non-matching tag returns empty
+    assert_eq!(filter_by_tag(&notes, "go").len(), 0);
+
+    // 3. Exact match, not substring
+    let notes2 = vec![
+        new_note("a", "rust", "just #rust"),
+        new_note("b", "rustacean", "just #rustacean"),
+    ];
+    let r = filter_by_tag(&notes2, "rust");
+    assert_eq!(r.len(), 1);
+    assert_eq!(r[0].id, "a");
+
+    // 4. Empty input
+    let empty: Vec<Note> = vec![];
+    assert_eq!(filter_by_tag(&empty, "x").len(), 0);
+
+    println!("ALL FILTER_BY_TAG TESTS PASSED");
+}
