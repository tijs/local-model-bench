+#!/usr/bin/env rust
+// This script verifies the filter_by_tag functionality in notekeep
+
+use notekeep::{filter_by_tag, new_note};
+use std::fs;
+use std::path::Path;
+
+fn main() {
+    // Test the filter_by_tag function directly
+    let note1 = new_note("1", "Note 1", "#rust #programming");
+    let note2 = new_note("2", "Note 2", "#rust #systems");
+    let note3 = new_note("3", "Note 3", "#python #programming");
+    let notes = vec![note1, note2, note3];
+    
+    // Test filtering by "rust"
+    let rust_notes = filter_by_tag(&notes, "rust");
+    assert_eq!(rust_notes.len(), 2);
+    assert_eq!(rust_notes[0].id, "1");
+    assert_eq!(rust_notes[1].id, "2");
+    
+    // Test filtering by "programming"
+    let programming_notes = filter_by_tag(&notes, "programming");
+    assert_eq!(programming_notes.len(), 2);
+    assert_eq!(programming_notes[0].id, "1");
+    assert_eq!(programming_notes[1].id, "3");
+    
+    // Test filtering by "python"
+    let python_notes = filter_by_tag(&notes, "python");
+    assert_eq!(python_notes.len(), 1);
+    assert_eq!(python_notes[0].id, "3");
+    
+    // Test filtering by a non-existent tag
+    let no_match = filter_by_tag(&notes, "nonexistent");
+    assert_eq!(no_match.len(), 0);
+    
+    // Test the CLI integration
+    let data_dir = Path::new("data/notes");
+    if data_dir.exists() {
+        fs::remove_dir_all(data_dir).unwrap();
+    }
+    fs::create_dir_all(data_dir).unwrap();
+    
+    // Create some test notes
+    let note1 = new_note("1", "Rust Note", "#rust #programming\nThis is a rust note");
+    let note2 = new_note("2", "Python Note", "#python #programming\nThis is a python note");
+    let note3 = new_note("3", "Systems Note", "#rust #systems\nThis is a systems note");
+    
+    notekeep::store::save(data_dir, &note1).unwrap();
+    notekeep::store::save(data_dir, &note2).unwrap();
+    notekeep::store::save(data_dir, &note3).unwrap();
+    
+    // Test the list command without filter
+    let output = std::process::Command::new("cargo")
+        .arg("run")
+        .arg("--")
+        .arg("list")
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(stdout.contains("1 Rust Note"));
+    assert!(stdout.contains("2 Python Note"));
+    assert!(stdout.contains("3 Systems Note"));
+    
+    // Test the list command with rust tag filter
+    let output = std::process::Command::new("cargo")
+        .arg("run")
+        .arg("--")
+        .arg("list")
+        .arg("--tag")
+        .arg("rust")
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(stdout.contains("1 Rust Note"));
+    assert!(stdout.contains("3 Systems Note"));
+    assert!(!stdout.contains("2 Python Note"));
