+#!/bin/bash
+set -e
+
+# Test the filter_by_tag function directly
+cargo run --quiet -- 
+    use notekeep::{filter_by_tag, new_note};
+    let note1 = new_note("1", "Note 1", "#rust #programming");
+    let note2 = new_note("2", "Note 2", "#rust #systems");
+    let note3 = new_note("3", "Note 3", "#python #programming");
+    let notes = vec![note1, note2, note3];
+    
+    let rust_notes = filter_by_tag(&notes, "rust");
+    assert_eq!(rust_notes.len(), 2);
+    assert_eq!(rust_notes[0].id, "1");
+    assert_eq!(rust_notes[1].id, "2");
+    
+    let programming_notes = filter_by_tag(&notes, "programming");
+    assert_eq!(programming_notes.len(), 2);
+    assert_eq!(programming_notes[0].id, "1");
+    assert_eq!(programming_notes[1].id, "3");
+    
+    let python_notes = filter_by_tag(&notes, "python");
+    assert_eq!(python_notes.len(), 1);
+    assert_eq!(python_notes[0].id, "3");
+    
+    let no_match = filter_by_tag(&notes, "nonexistent");
+    assert_eq!(no_match.len(), 0);
+    
+    println!("Direct function tests passed!")
+
+echo "Testing CLI integration..."
+
+# Create test data directory
+rm -rf data/notes
+mkdir -p data/notes
+
+# Create test notes
+cargo run --quiet -- create "#rust #programming\nRust Note"
+cargo run --quiet -- create "#python #programming\nPython Note"
+cargo run --quiet -- create "#rust #systems\nSystems Note"
+
+# Test list command
+echo "Testing list command..."
+echo "=== All notes ==="
+cargo run --quiet -- list
+
+# Test tag filtering
+echo "=== Rust notes ==="
+cargo run --quiet -- list --tag rust
+
+if ! cargo run --quiet -- list --tag rust | grep -q "1 Rust Note" || \
+   ! cargo run --quiet -- list --tag rust | grep -q "3 Systems Note"; then
+    echo "ERROR: Rust filter not working correctly"
+    exit 1
+fi
+
+echo "=== Python notes ==="
+cargo run --quiet -- list --tag python
+
+if ! cargo run --quiet -- list --tag python | grep -q "2 Python Note"; then
+    echo "ERROR: Python filter not working correctly"
+    exit 1
+fi
+
+echo "=== Programming notes ==="
+cargo run --quiet -- list --tag programming
+
+if ! cargo run --quiet -- list --tag programming | grep -q "1 Rust Note" || \
+   ! cargo run --quiet -- list --tag programming | grep -q "2 Python Note"; then
+    echo "ERROR: Programming filter not working correctly"
+    exit 1
+fi
+
+echo "=== Non-existent tag ==="
+cargo run --quiet -- list --tag nonexistent
+
+if [ "$(cargo run --quiet -- list --tag nonexistent | wc -l)" -ne 0 ]; then
