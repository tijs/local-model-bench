+use notekeep::{filter_by_tag, new_note};
+
+#[test]
+fn test_filter_by_tag() {
+    let note1 = new_note("1", "Note 1", "#rust #programming");
+    let note2 = new_note("2", "Note 2", "#rust #systems");
+    let note3 = new_note("3", "Note 3", "#python #programming");
+    let notes = vec![note1, note2, note3];
+    
+    let rust_notes = filter_by_tag(&notes, "rust");
+    assert_eq!(rust_notes.len(), 2);
+    assert_eq!(rust_notes[0].id, "1");
+    assert_eq!(rust_notes[1].id, "2");
+    
+    let programming_notes = filter_by_tag(&notes, "programming");
+    assert_eq!(programming_notes.len(), 2);
+    assert_eq!(programming_notes[0].id, "1");
+    assert_eq!(programming_notes[1].id, "3");
+    
+    let python_notes = filter_by_tag(&notes, "python");
+    assert_eq!(python_notes.len(), 1);
+    assert_eq!(python_notes[0].id, "3");
+    
+    let no_match = filter_by_tag(&notes, "nonexistent");
+    assert_eq!(no_match.len(), 0);
+}
