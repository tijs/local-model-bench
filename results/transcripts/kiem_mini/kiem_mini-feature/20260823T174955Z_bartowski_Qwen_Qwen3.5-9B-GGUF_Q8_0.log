+use notekeep::{Note, filter_by_tag, extract_tags};
+
+fn main() {
+    let mut notes = vec![
+        Note {
+            id: "1".to_string(),
+            title: "Note 1".to_string(),
+            body: "First #work #important".to_string(),
+            tags: vec!["work".to_string(), "important".to_string()],
+            pinned: false,
+        },
+        Note {
+            id: "2".to_string(),
+            title: "Note 2".to_string(),
+            body: "Second #personal #important".to_string(),
+            tags: vec!["personal".to_string(), "important".to_string()],
+            pinned: false,
+        },
+        Note {
+            id: "3".to_string(),
+            title: "Note 3".to_string(),
+            body: "Third #work #personal".to_string(),
+            tags: vec!["work".to_string(), "personal".to_string()],
+            pinned: false,
+        },
+    ];
+    
+    println!("All notes:");
+    for n in &notes {
+        println!("  {} - tags: {:?}", n.title, n.tags);
+    }
+    
+    println!("\nFilter by 'work':");
+    let work_notes = filter_by_tag(&notes, "work");
+    for n in &work_notes {
+        println!("  {} - tags: {:?}", n.title, n.tags);
+    }
+    
+    println!("\nFilter by 'important':");
+    let important_notes = filter_by_tag(&notes, "important");
+    for n in &important_notes {
+        println!("  {} - tags: {:?}", n.title, n.tags);
+    }
+    
+    println!("\nFilter by 'personal':");
+    let personal_notes = filter_by_tag(&notes, "personal");
+    for n in &personal_notes {
+        println!("  {} - tags: {:?}", n.title, n.tags);
+    }
+    
+    println!("\nFilter by 'nonexistent':");
+    let nonexistent_notes = filter_by_tag(&notes, "nonexistent");
+    for n in &nonexistent_notes {
+        println!("  {} - tags: {:?}", n.title, n.tags);
+    }
+}
