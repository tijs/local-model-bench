+/// Returns notes whose tags contain exactly `tag`, preserving their order.
+pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
+    notes
+        .iter()
+        .filter(|note| note.tags.iter().any(|note_tag| note_tag == tag))
