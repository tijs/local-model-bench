+#!/usr/bin/env bash
+# Ad-hoc verification for notekeep filter_by_tag + list --tag (not the test suite).
+set -euo pipefail
+cd /Users/tijs/projects/local-model-bench/runner/runs/tmpbgg8zuq8/run/rust
+
+WORK=$(mktemp -d "/private/var/folders/1s/ggz8433s6x56bzrwdtfbblfc0000gn/T/hermes-verify-notekeep.XXXXXX")
+trap 'rm -rf "$WORK"' EXIT
+BIN=./target/debug/notekeep
+
+fail() { echo "FAIL: $1"; exit 1; }
+
+# --- unit-level: filter_by_tag exact match + order (fresh cargo test of the focused file) ---
+cargo test --test basic filters_by_exact_tag_preserving_order tag_match_is_exact_not_substring no_matches_returns_empty -q >/dev/null \
+  || fail "focused unit tests did not pass"
+
+# --- CLI-level: build a scratch data dir and exercise `list` / `list --tag` ---
+rm -rf data
+mkdir -p "$WORK/data/notes"
+mv data "$WORK/data_backup" 2>/dev/null || true
+mkdir -p data
+
+$BIN create "alpha note #alpha" >/dev/null
+$BIN create "beta note #beta #gamma" >/dev/null
+$BIN create "plain note no tags" >/dev/null
+$BIN create "second alpha #alpha" >/dev/null
+
+all=$($BIN list)
+[ "$(echo "$all" | wc -l)" -eq 4 ] || fail "expected 4 notes, got: $all"
+
+a=$($BIN list --tag alpha)
+[ "$(echo "$a" | wc -l)" -eq 2 ] || fail "--tag alpha expected 2 lines: $a"
+# order preserved: alpha-created first, second alpha last
+first_line=$(echo "$a" | head -1); last_line=$(echo "$a" | tail -1)
+case "$first_line" in *alpha*) ;; *) fail "first alpha note not first: $a";; esac
+
+b=$($BIN list --tag beta)
+[ "$(echo "$b" | wc -l)" -eq 1 ] || fail "--tag beta expected 1 line: $b"
+case "$b" in *"beta note #beta #gamma"*) ;; *) fail "wrong note for --tag beta: $b";; esac
+
+# exact match, not substring: "alp" must match nothing, nor "lph"
+[ -z "$($BIN list --tag alp)" ] || fail "--tag alp matched something (substring leak?)"
+[ -z "$($BIN list --tag lph)" ] || fail "--tag lph matched something (substring leak?)"
+
+# unknown tag -> empty output, exit 0
+out=$($BIN list --tag does-not-exist); rc=$?
+[ -z "$out" ] && [ $rc -eq 0 ] || fail "unknown tag: out='$out' rc=$rc"
+
+# no --tag flag still lists everything (regression)
+[ "$(echo "$($BIN list)" | wc -l)" -eq 4 ] || fail "plain list changed behavior"
+
+# bare --tag with no value -> nonzero exit + stderr message
+$BIN list --tag 2>"$WORK/err.txt"; rc=$?
+[ $rc -ne 0 ] || fail "bare --tag should exit nonzero"
+grep -qi "missing value for --tag" "$WORK/err.txt" || fail "unexpected stderr: $(cat "$WORK/err.txt")"
+
+# cleanup scratch data dir (restore repo to clean state)
+rm -rf data
+if [ -d "$WORK/data_backup" ]; then mv "$WORK/data_backup" data; fi
+
+echo "PASS: all ad-hoc checks passed (unit + CLI behavior)"
