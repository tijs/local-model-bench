"$BIN" create "Ideas #work" >/dev/null
"$BIN" create "Deep focus #working" >/dev/null
"$BIN" create "Groceries #fitness" >/dev/null

all_ids() { "$BIN" list | awk '{print $1}'; }
tagged_ids() { "$BIN" list --tag "$1" | awk '{print $1}'; }

ALL="$(all_ids)"
[ "$(echo "$ALL" | wc -l | tr -d ' ')" = "4" ] || fail "expected 4 notes, got: $ALL"

F="$(tagged_ids fitness)"
[ "$(echo "$F" | wc -l | tr -d ' ')" = "2" ] || fail "fitness should match 2, got: $F"
# Both must be fitness notes: verify titles
titles="$("$BIN" list --tag fitness | awk '{print $2, $3, $4}')"
echo "$titles" | grep -q "Morning run" || fail "missing Morning run"
echo "$titles" | grep -q "Groceries" || fail "missing Groceries"
# Subsequence order check: filtered ids appear in ALL in the same relative order
awk -v all="$ALL" 'BEGIN{n=split(all,a,"\n"); for(i=1;i<=n;i++) pos[a[i]]=i} {p=($0 in pos)?pos[$0]:0; if(p<prev) {print "order violation: " $0; exit 1} prev=p} END{}' <<< "$F" || fail "order not preserved for fitness"

W="$(tagged_ids work)"
[ "$(echo "$W" | wc -l | tr -d ' ')" = "1" ] || fail "exact match broken: work matched $(echo "$W" | wc -l | tr -d ' ') notes (expected 1)"
"$BIN" list --tag work | grep -q "Ideas" || fail "work filter returned wrong note"

[ "$(tagged_ids working | wc -l | tr -d ' ')" = "1" ] || fail "working should match 1"
[ "$(tagged_ids nonexistent | wc -l | tr -d ' ')" = "0" ] || fail "nonexistent tag should match 0"

# --tag with no value → exit code 1
if "$BIN" list --tag 2>/dev/null; then fail "--tag without value should fail"; fi

echo "ALL AD-HOC CHECKS PASSED"
rm -rf "$RUN"

