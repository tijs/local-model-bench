fn parse_tag_flag(args: &[String]) -> Result<Option<String>, String> {
    let mut tag = None;
    let mut i = 0;
    while i < args.len() {
        if args[i] == "--tag" {
            match args.get(i + 1) {
                Some(v) => {
                    tag = Some(v.clone());
                    i += 2;
                }
                None => return Err("--tag requires a value".to_string()),
            }
        } else {
            return Err(format!("unexpected argument: {}", args[i]));
        }
    }
    Ok(tag)
}
```

