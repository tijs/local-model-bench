+use notekeep::{Note, filter_by_tag};
+
+#[test]
+fn filter_by_tag_exact_match() {
+    let notes = vec![
+        Note { id: "1".to_string(), title: "a".to_string(), body: "".to_string(), tags: vec!["rust".to_string(), "code".to_string()], pinned: false },
+        Note { id: "2".to_string(), title: "b".to_string(), body: "".to_string(), tags: vec!["python".to_string()], pinned: false },
+        Note { id: "3".to_string(), title: "c".to_string(), body: "".to_string(), tags: vec!["rust".to_string()], pinned: false },
+        Note { id: "4".to_string(), title: "d".to_string(), body: "".to_string(), tags: vec!["code".to_string()], pinned: false },
+    ];
+    
+    let filtered = filter_by_tag(&notes, "rust");
+    assert_eq!(filtered.len(), 2);
+    assert_eq!(filtered[0].id, "1");
+    assert_eq!(filtered[1].id, "3");
+    
+    let filtered2 = filter_by_tag(&notes, "code");
+    assert_eq!(filtered2.len(), 2);
+    assert_eq!(filtered2[0].id, "1");
+    assert_eq!(filtered2[1].id, "4");
+    
+    let filtered3 = filter_by_tag(&notes, "nonexistent");
+    assert_eq!(filtered3.len(), 0);
+}
+
+#[test]
+fn filter_by_tag_no_substring_match() {
+    let notes = vec![
+        Note { id: "5".to_string(), title: "e".to_string(), body: "".to_string(), tags: vec!["rustacean".to_string()], pinned: false },
+    ];
+    let filtered = filter_by_tag(&notes, "rust");
+    assert_eq!(filtered.len(), 0);
+    
+    let notes2 = vec![
+        Note { id: "6".to_string(), title: "f".to_string(), body: "".to_string(), tags: vec!["rust".to_string()], pinned: false },
+    ];
+    let filtered2 = filter_by_tag(&notes2, "rustacean");
+    assert_eq!(filtered2.len(), 0);
+}
+
+#[test]
+fn filter_by_tag_preserves_order() {
