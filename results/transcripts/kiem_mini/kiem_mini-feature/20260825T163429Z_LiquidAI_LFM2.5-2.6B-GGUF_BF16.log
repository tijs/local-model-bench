```rust
"list" => {
    let notes = store::load_all(&data_dir()).expect("load failed");
    if let Some(tag) = args.get(3) && tag.starts_with("--") {
        let filtered = filter_by_tag(&notes, &tag[2..]);
        for n in filtered {
            println!("{} {}", n.id, n.title);
        }
    } else {
        for n in notes {
            println!("{} {}", n.id, n.title);
        }
    }
}
```

