+3|#[derive(Debug, Clone, PartialEq)]
+4|pub struct Note {
+5|    pub id: String,
+6|    pub title: String,
+7|    pub body: String,
+8|    pub tags: Vec<String>,
+9|    pub pinned: bool,
+10|
