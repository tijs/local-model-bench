+12|/// Sets `pinned = true` on the note matching `id`, if any.
+13|pub fn pin(notes: &mut [Note], id: &str) {
+14|    if let Some(n) = notes.iter_mut().find(|n| n.id == id) {
+15|        n.pinned = true;
+16|    }
+17|}
+18|
+19|/// Sets `pinned = false` on the note matching `id`, if any.
+20|pub fn unpin(notes: &mut [Note], id: &str) {
+21|    if let Some(n) = notes.iter_mut().find(|n| n.id == id) {
+22|        n.pinned = false;
+23|    }
+24|}
+25|
+26|/// Returns notes with pinned ones first, preserving relative order within
+27|/// each group.
+28|pub fn ordered_pinned_first(notes: &[Note]) -> Vec<&Note> {
+29|    let mut pinned: Vec<&Note> = notes.iter().filter(|n| n.pinned).collect();
+30|    let mut rest: Vec<&Note> = notes.iter().filter(|n| !n.pinned).collect();
+31|    pinned.append(&mut rest);
+32|    pinned
+33|}
+34|
+35|/// Returns notes whose tags contain exactly the given tag (exact match, not substring).
+34|pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
+35|    notes
+36|        .into_iter()
+37|        .filter(|note| note.tags.contains(&tag))
+38|        .collect()
+39;}
+40|
+41|
+42|/// Extracts #tags from a note's body text, in the order they appear.
+43|pub fn extract_tags(text: &str) -> Vec<String> {
+44|    text.split_whitespace()
+45|        .filter(|tok| tok.starts_with('#'))
+46|        .map(|tok| tok.trim_start_matches('#').to_string())
+47|        .collect()
+48|}
+49|
+50|pub fn new_note(id: &str, title: &str, body: &str) -> Note {
+51|    Note {
+52|        id: id.to_string(),
+53|        title: title.to_string(),
+54|        body: body.to_string(),
+55|        tags: extract_tags(body),
+56|        pinned: false,
+57|    }
