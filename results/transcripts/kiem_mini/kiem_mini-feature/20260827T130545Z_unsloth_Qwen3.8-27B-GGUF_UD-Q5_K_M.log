    let notes = store::load_all(&data_dir()).expect("load failed");
    let shown = match &tag {
        Some(t) => notekeep::filter_by_tag(&notes, t),
        None => notes.iter().collect::<Vec<_>>(),
    };
    for n in shown {
        println!("{} {}", n.id, n.title);
    }
}
```

