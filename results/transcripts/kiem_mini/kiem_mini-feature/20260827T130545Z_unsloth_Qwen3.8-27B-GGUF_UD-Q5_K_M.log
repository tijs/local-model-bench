    let mut tag: Option<String> = None;
    let mut rest = args.get(2..).iter();
    while let Some(arg) = rest.next() {
        if arg == "--tag" {
            let value = rest
                .next()
                .cloned()
                .unwrap_or_else(|| {
                    eprintln!("error: --tag requires a value");
                    std::process::exit(1);
