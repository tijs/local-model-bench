/// Returns notes whose `tags` contain `tag` exactly (not as a substring),
/// preserving relative order.
pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
    notes
        .iter()
        .filter(|n| n.tags.iter().any(|t| t == tag))
        .collect()
}
```

