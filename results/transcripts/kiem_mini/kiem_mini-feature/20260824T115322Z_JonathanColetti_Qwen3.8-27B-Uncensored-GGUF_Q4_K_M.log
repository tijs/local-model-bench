"list" => {
    let notes = store::load_all(&data_dir()).expect("load failed");
    let mut tag: Option<String> = None;
    let rest = &args[2..];
    let mut i = 0;
    while i < rest.len() {
        if rest[i] == "--tag" {
            tag = rest.get(i + 1).cloned();
            i += 2;
        } else {
            i += 1;
        }
    }
    if let Some(tag) = tag {
        for n in filter_by_tag(&notes, &tag) {
            println!("{} {}", n.id, n.title);
        }
    } else {
        for n in notes {
            println!("{} {}", n.id, n.title);
        }
    }
}
