fn run(bin: &str, args: &[&str]) -> (i32, String) {
    let out = std::process::Command::new(bin)
        .args(args)
        .output()
        .expect("spawn notekeep");
    let code = out.status.code().unwrap_or(-1);
    (code, String::from_utf8_lossy(&out.stdout).to_string())
}

fn main() {
    ...lib assertions...

    let bin = "...";
    let _ = run(bin, &["create", "alpha note #alpha #alphabet"]);
    let _ = run(bin, &["create", "beta note #beta"]);
    let (c, all) = run(bin, &["list"]);
    assert_eq!(c, 0);
    assert_eq!(lines(all), 2, "list shows both");
    let (c, filtered) = run(bin, &["list", "--tag", "alpha"]);
    assert_eq!(c, 0);
    let l = lines(filtered);
    assert_eq!(l.len(), 1, "one alpha note");
    // substring: "alp" should match nothing... wait, "alpha" contains "alp" but the
 tag is "alpha"; filtering on tag "alp" should return 0.
    let (c, sub) = run(bin, &["list", "--tag", "alp"]);
    assert_eq!(c, 0);
    assert_eq!(lines(sub), 0, "no substring match");
    let (c, none) = run(bin, &["list", "--tag", "zzz"]);
    assert_eq!(c, 0);
    assert_eq!(lines(none), 0);
    // missing value should error
    let out = std::process::Command::new(bin).args(["list", "--tag"]).output().unwrap
();
    assert!(!out.status.success(), "--tag without value errors");
    println!("cli e2e: PASS");
    println!("ALL VERIFICATION PASSED");
}

fn lines(s: String) -> usize { s.lines().count() }
