use notekeep::{filter_by_tag, new_note, Note};

fn note(id: &str, tags: &[&str]) -> Note {
    let mut n = new_note(id, id, "");
    n.tags = tags.iter().map(|s| s.to_string()).collect();
    n
}

fn main() {
    let notes = vec![
        note("a", &["rust", "rustacean"]),
        note("b", &["groceries"]),
        note("c", &["rust"]),
        note("d", &[]),
    ];

    // Exact match, order preserved
    let r: Vec<&str> = filter_by_tag(&notes, "rust").iter().map(|n| n.id.as_str()).
collect();
    assert_eq!(r, vec!["a", "c"], "exact match + order");

    // No substring leakage
    assert!(filter_by_tag(&notes, "rustacean").len() == 1);
    assert!(filter_by_tag(&notes, "rusta").is_empty(), "no substring match");
    assert!(filter_by_tag(&notes, "rustac").is_empty(), "no prefix substring match
");
    assert!(filter_by_tag(&notes, "").is_empty(), "empty tag matches none");
    assert!(filter_by_tag(&[], "rust").is_empty(), "empty slice");
    println!("lib assertions: PASS");

    // CLI e2e: run notekeep binary in this cwd (relative data dir)
    let bin = "/Users/tijs/projects/local-model-bench/runner/runs/tmp278wgv_5/run
/rust/target/debug/notekeep";
