+use std::collections::HashSet;
+
+// Mock Note struct for testing
+struct Note {
+    id: String,
+    title: String,
+    tags: Vec<String>,
+}
+
+impl Note {
+    fn new(id: &str, title: &str, tags: &[&str]) -> Self {
+        Note {
+            id: id.to_string(),
+            title: title.to_string(),
+            tags: tags.to_vec(),
+        }
+    }
+}
+
+// This is a simplified version of the actual filter_by_tag implementation
+fn filter_by_tag(notes: &[Note], tag: &str) -> Vec<&Note> {
+    notes.iter().filter(|n| n.tags.contains(&tag))
+}
+
+fn main() {
+    // Test 1: Exact match should work
+    let notes = vec![
+        Note::new("1", "Test 1", &["rust", "programming"]),
+        Note::new("2", "Test 2", &["go", "programming"]),
+        Note::new("3", "Test 3", &["rust", "web"]),
+    ];
+
+    let result: Vec<&Note> = filter_by_tag(&notes, "rust");
+    
+    // Should get notes with "rust" tag exactly
+    assert_eq!(result.len(), 2, "Should find 2 notes with 'rust' tag");
+    assert!(result[0].id == "1", "First note should be found");
+    assert!(result[1].id == "3", "Third note should be found");
+    
+    // Test 2: Non-existent tag should return empty
+    let result2: Vec<&Note> = filter_by_tag(&notes, "python");
+    assert_empty(result2, "Should return empty for non-existent tag");
+    
+    // Test 3: Multiple tags per note - exact match only (not substring)
+    let notes2 = vec![
+        Note::new("4", "Test 4", &["rust", "python"]),
+        Note::new("5", "Test 5", &["go", "rust"]),
+    ];
+    
+    let result3: Vec<&Note> = filter_by_tag(&notes2, "rust");
+    assert_eq!(result3.len(), 1, "Should only get note with exact 'rust' match");
+    assert_eq!(result3[0].id, "4", "Only first note should be returned");
+    
+    println!("All tests passed!");
+}
