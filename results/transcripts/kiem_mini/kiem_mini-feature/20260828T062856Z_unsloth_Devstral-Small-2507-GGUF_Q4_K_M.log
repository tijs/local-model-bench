+#!/bin/bash
+# Verification script for notekeep tag filtering functionality
+
+set -e
+
+# Change to the project directory
+cd /Users/tijs/projects/local-model-bench/runner/runs/tmp0y3trs11/run/rust
+
+# Clean up any existing notes
+m -rf data/notes
+mkdir -p data/notes
+
+# Build the project
+cargo build --quiet
+
+# Test 1: Create notes with different tags
+echo "Creating test notes..."
+cargo run create "Note about Rust #rust #programming" > /dev/null
+cargo run create "Another Rust note #rust" > /dev/null
+cargo run create "Python note #python" > /dev/null
+cargo run create "No tags note" > /dev/null
+
+# Test 2: List all notes
+echo -e "\nTest 2: List all notes"
+all_notes=$(cargo run list)
+echo "$all_notes"
+
+# Verify we have 4 notes
+echo "$all_notes" | wc -l | grep -q 4
+
+# Test 3: Filter by rust tag
+echo -e "\nTest 3: Filter by rust tag"
+rust_notes=$(cargo run list --tag rust)
+echo "$rust_notes"
+
+# Verify we have 2 notes with rust tag
+echo "$rust_notes" | wc -l | grep -q 2
+
+# Test 4: Filter by python tag
+echo -e "\nTest 4: Filter by python tag"
+python_notes=$(cargo run list --tag python)
+echo "$python_notes"
+
+# Verify we have 1 note with python tag
+echo "$python_notes" | wc -l | grep -q 1
+
+# Test 5: Filter by non-existent tag
+echo -e "\nTest 5: Filter by non-existent tag"
+empty_notes=$(cargo run list --tag nonexistent)
+echo "$empty_notes"
+
+# Verify we have 0 notes with non-existent tag
+echo "$empty_notes" | wc -l | grep -q 0
+
+# Test 6: Error handling for missing tag
+echo -e "\nTest 6: Error handling for missing tag"
+if cargo run list --tag | grep -q "usage: notekeep list --tag <TAG>"; then
+    echo "Error handling works correctly"
+else
+    echo "Error handling failed"
+    exit 1
+fi
+
+echo -e "\nAll tests passed successfully!"
+
+# Clean up
+rm -rf data/notes
