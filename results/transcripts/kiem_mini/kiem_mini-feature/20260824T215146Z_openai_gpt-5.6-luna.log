+/// Returns notes whose tags contain an exact match for `tag`, preserving order.
+pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
+    notes.iter().filter(|note| note.tags.iter().any(|t| t == tag)).collect()
