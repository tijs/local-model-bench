The implementation is complete and verified. The changes include:

1. **New function in `src/lib.rs`**:
```rust
/// Returns notes whose tags contain exactly the given tag (exact match).
/// Preserves the original order of notes.
pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
    notes.iter().filter(|n| n.tags.contains(&tag.to_string())).collect()
}
```

2. **Updated CLI in `src/main.rs`**:
```rust
"list" => {
    let notes = store::load_all(&data_dir()).expect("load failed");
    let filtered_notes: Vec<&Note> = if args.len() > 2 && args[2] == "--tag" && args.len() > 3 {
        let tag = &args[3];
        notekeep::filter_by_tag(&notes, tag)
    } else {
        notes.iter().collect()
    };
    for n in filtered_notes {
        println!("{} {}", n.id, n.title);
    }
}
```

