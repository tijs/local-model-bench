+use notekeep::{new_note, filter_by_tag};
+
+fn main() {
+    // Create test notes with different tags
+    let note1 = new_note("1", "Note 1", "This is a test note with #tag1");
+    let note2 = new_note("2", "Note 2", "Another note with #tag2");
+    let note3 = new_note("3", "Note 3", "A note with #tag1 and #tag2");
+    let note4 = new_note("4", "Note 4", "Note without tags");
+    
+    let notes = vec![note1, note2, note3, note4];
+    
+    // Test filtering by tag1
+    let filtered = filter_by_tag(&notes, "tag1");
+    println!("Found {} notes with tag1", filtered.len());
+    assert_eq!(filtered.len(), 2);
+    assert_eq!(filtered[0].id, "1");
+    assert_eq!(filtered[1].id, "3");
+    
+    // Test filtering by tag2
+    let filtered = filter_by_tag(&notes, "tag2");
+    println!("Found {} notes with tag2", filtered.len());
+    assert_eq!(filtered.len(), 2);
+    assert_eq!(filtered[0].id, "2");
+    assert_eq!(filtered[1].id, "3");
+    
+    // Test filtering by non-existent tag
+    let filtered = filter_by_tag(&notes, "nonexistent");
+    println!("Found {} notes with nonexistent tag", filtered.len());
+    assert_eq!(filtered.len(), 0);
+    
+    println!("All tests passed!");
+}
