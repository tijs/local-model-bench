+use notekeep::{Note, filter_by_tag};
+
+#[test]
+fn filter_by_tag_exact_match_preserves_order() {
+    let notes = vec![
+        Note { id: "1".into(), title: "a".into(), body: "".into(), tags: vec!["rust".into(), "cli".into()], pinned: false },
+        Note { id: "2".into(), title: "b".into(), body: "".into(), tags: vec!["rust".into()], pinned: false },
+        Note { id: "3".into(), title: "c".into(), body: "".into(), tags: vec!["python".into()], pinned: false },
+    ];
+    let filtered = filter_by_tag(&notes, "rust");
+    assert_eq!(filtered.len(), 2);
+    assert_eq!(filtered[0].id, "1");
+    assert_eq!(filtered[1].id, "2");
+}
+
+#[test]
+fn filter_by_tag_no_substring() {
+    let notes = vec![
+        Note { id: "1".into(), title: "a".into(), body: "".into(), tags: vec!["rust".into()], pinned: false },
+    ];
+    let filtered = filter_by_tag(&notes, "ru");
+    assert_eq!(filtered.len(), 0);
+}
+
+#[test]
+fn filter_by_tag_empty() {
+    let notes: Vec<Note> = vec![];
+    let filtered = filter_by_tag(&notes, "any");
+    assert!(filtered.is_empty());
+}
