<|tool_call_start|>[write_file(path='/Users/tijs/projects/local-model-bench/runner/runs/tmpk9v1yoyk/run/rust/src/lib.rs', content='use notekeep::{new_note, store};\n\nuse std::env;\nuse std::path::PathBuf;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nfn data_dir() -> PathBuf {\n    PathBuf::from("data/notes")\n}\n\npub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&\'a Note> {\n    notes\n        .iter()\n        .filter(|n| n.tags.contains(&tag))\n        .cloned()\n        .collect()\n}\n\nfn main() {\n    let args: Vec<String> = env::args().collect();\n    if args.len() < 2 {\n        eprintln!(\"usage: notekeep <create|list|tags> [...]\");\n        std::process::exit(1);\n    }\n    match args[1].as_str() {\n        \"create\" => {\n            let body = args.get(2).cloned().unwrap_or_default();\n            let id = format!(\n                \"{}\",\n                SystemTime::now()\n                    .duration_since(UNIX_EPOCH)\n                    .unwrap()\n                    .as_nanos()\n            );\n            let title = body.lines().next().unwrap_or(\"\").to_string();\n            let note = new_note(&id, &title, &body);\n            store::save(&data_dir(), &note).expect(\"save failed\");\n            println!(\"created {}\", note.id);\n        }\n        \"list\" => {\n            let notes = store::load_all(&data_dir()).expect(\"load failed\");\n            for n in notes {\n                println!(\"{} {}\", n.id, n.title);\n            }\n        }\n        \"tags\" => {\n            let notes = store::load_all(&data_dir()).expect(\"load failed\");\n            let mut all_tags: Vec<String> = notes.iter().flat_map(|n| n.tags.clone()).collect();\n            all_tags.sort();\n            all_tags.dedup();\n            for t in all_tags {\n                println!(\"{t}\");\n            }\n        }\n        other => {\n            eprintln!(\"unknown command: {other}\");\n            std::process::exit(1);\n        }\n    }\n}\n'), write_file(path='/Users/tijs/projects/local-model-bench/runner/runs/tmpk9v1yoyk/run/rust/src/main.rs', content='use notekeep::{new_note, store};\n\nuse std::env;\nuse std::path::PathBuf;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nfn data_dir() -> PathBuf {\n    PathBuf::from("data/notes")\n}\n\nfn main() {\n    let args: Vec<String> = env::args().collect();\n    if args.len() < 2 {\n        eprintln!(\"usage: notekeep <create|list|tags> [--tag <TAG>] [...]\");\n        std::process::exit(1);\n    }\n    \n    // Handle --tag flag\n    let tag = None;\n    for (i, arg) in args.iter().enumerate() {\n        if arg == "--tag" {\n            tag = Some(arg.next().unwrap());\n        } else if arg.starts_with(\'--tag\') {\n            tag = Some(arg);\n        }\n    }\n    \n    match args[1].as_str() {\n        \"create\" => {\n            let body = args.get(2).cloned().unwrap_or_default();\n            let id = format!(\n                \"{}\",\n                SystemTime::now()\n                    .duration_since(UNIX_EPOCH)\n                    .unwrap()\n                    .as_nanos()\n            );\n            let title = body.lines().next().unwrap_or(\"\").to_string();\n            let note = new_note(&id, &title, &body);\n            store::save(&data_dir(), &note).expect(\"save failed\");\n            println!(\"created {}\", note.id);\n        }\n        \"list\" => {\n            let notes = store::load_all(&data_dir()).expect(\"load failed\");\n            if let Some(t) = tag {\n                // Filter notes by the given tag\n                let filtered = filter_by_tag(&notes, t);\n                for n in filtered {\n                    println!(\"{} {}\", n.id, n.title);\n                }\n            } else {\n                for n in notes {\n                    println!(\"{} {}\", n.id, n.title);\n                }\n            }\n        }\n        \"tags\" => {\n            let notes = store::load_all(&data_dir()).expect(\"load failed\");\n            let mut all_tags: Vec<String> = notes.iter().flat_map(|n| n.tags.clone()).collect();\n            all_tags.sort();\n            all_tags.dedup();\n            for t in all_tags {\n                println!(\"{t}\");\n            }\n        }\n        other => {\n            eprintln!(\"unknown command: {other}\");\n            std::process::exit(1);\n        }\n    }\n}\n')]<|tool_call_end|>


