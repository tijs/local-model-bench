More simply:
BEGIN {
  n = split(unfiltered, u, "\n")
  m = split(filtered, f, "\n")
  for (i = 1; i <= m; i++) {
    split(f[i], w, " "); inset[w[1]] = 1
    fids[i] = w[1]
