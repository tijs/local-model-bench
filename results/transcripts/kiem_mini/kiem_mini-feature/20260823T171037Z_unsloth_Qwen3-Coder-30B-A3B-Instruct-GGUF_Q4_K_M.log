+#[test]
+fn filter_by_tag_filters_correctly() {
+    let note1 = Note {
+        id: "1".to_string(),
+        title: "Note 1".to_string(),
+        body: "This is a test note".to_string(),
+        tags: vec!["tag1".to_string(), "tag2".to_string()],
+        pinned: false,
+    };
+    
+    let note2 = Note {
+        id: "2".to_string(),
+        title: "Note 2".to_string(),
+        body: "Another test note".to_string(),
+        tags: vec!["tag2".to_string(), "tag3".to_string()],
+        pinned: false,
+    };
+    
+    let note3 = Note {
+        id: "3".to_string(),
+        title: "Note 3".to_string(),
+        body: "Third test note".to_string(),
+        tags: vec!["tag4".to_string()],
+        pinned: false,
+    };
+    
+    let notes = vec![note1, note2, note3];
+    
+    // Test filtering by existing tag
+    let filtered = filter_by_tag(&notes, "tag2");
+    assert_eq!(filtered.len(), 2);
+    assert_eq!(filtered[0].id, "1");
+    assert_eq!(filtered[1].id, "2");
+    
+    // Test filtering by non-existing tag
+    let filtered_empty = filter_by_tag(&notes, "nonexistent");
+    assert_eq!(filtered_empty.len(), 0);
+    
+    // Test filtering by single tag
+    let filtered_single = filter_by_tag(&notes, "tag4");
+    assert_eq!(filtered_single.len(), 1);
+    assert_eq!(filtered_single[0].id, "3");
+}
