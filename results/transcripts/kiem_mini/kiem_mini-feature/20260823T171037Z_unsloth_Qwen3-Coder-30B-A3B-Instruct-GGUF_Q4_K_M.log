+/// Returns notes whose tags contain exactly `tag` (exact match, not substring),
+/// preserving their relative order.
+pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
+    notes.iter().filter(|note| note.tags.contains(&tag.to_string())).collect()
+}
