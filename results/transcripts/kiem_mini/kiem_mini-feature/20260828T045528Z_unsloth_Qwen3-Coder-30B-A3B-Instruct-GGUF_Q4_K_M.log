@@ -0,0 +1,36 @@
+use notekeep::{extract_tags, filter_by_tag, Note};
+
+#[test]
+fn filters_by_exact_tag_match() {
+    let note1 = Note {
+        id: "1".to_string(),
+        title: "Note 1".to_string(),
+        body: "This note has #tech tag".to_string(),
+        tags: extract_tags("This note has #tech tag"),
+        pinned: false,
+    };
+    
+    let note2 = Note {
+        id: "2".to_string(),
+        title: "Note 2".to_string(),
+        body: "This note has #rust tag".to_string(),
+        tags: extract_tags("This note has #rust tag"),
+        pinned: false,
+    };
+    
+    let notes = vec![note1, note2];
+    
+    // Filter by exact tag match
+    let filtered = filter_by_tag(&notes, "tech");
+    assert_eq!(filtered.len(), 1);
+    assert_eq!(filtered[0].id, "1");
+    
+    // Filter by different tag
+    let filtered = filter_by_tag(&notes, "rust");
+    assert_eq!(filtered.len(), 1);
+    assert_eq!(filtered[0].id, "2");
+    
+    // Filter by non-existent tag
+    let filtered = filter_by_tag(&notes, "python");
+    assert_eq!(filtered.len(), 0);
+}
