```rust
"list" => {
    let notes = store::load_all(&data_dir()).expect("load failed");
    let mut tag_filter: Option<String> = None;
    let mut rest = args[2..].iter();
    while let Some(arg) = rest.next() {
        if arg == "--tag" {
            let value = rest.next().cloned().unwrap_or_else(|| {
                eprintln!("--tag requires a value");
                std::process::exit(1);
            });
            tag_filter = Some(value);
        } else {
            eprintln!("unknown option: {arg}");
            std::process::exit(1);
        }
    }
    let shown = match &tag_filter {
        Some(t) => filter_by_tag(&notes, t),
        None => notes.iter().collect(),
    };
    for n in shown {
        println!("{} {}", n.id, n.title);
    }
}
```

