+#[test]
+fn filter_by_tag_matches_exact_only_and_preserves_order() {
+    let mut notes = vec![
+        new_note("1", "alpha", "alpha #rust #tag1"),
+        new_note("2", "beta", "beta #tag1"),
+        new_note("3", "gamma", "gamma #rust"),
+        new_note("4", "delta", "delta #tag1extra #rust"),
+    ];
+    notes.push(new_note("5", "epsilon", "epsilon #tag1"));
+
+    let filtered = filter_by_tag(&notes, "tag1");
+    let ids: Vec<&str> = filtered.iter().map(|n| n.id.as_str()).collect();
+    assert_eq!(ids, vec!["1", "2", "5"]);
+
+    // exact match: "tag1extra" must not match "tag1"
+    let filtered2 = filter_by_tag(&notes, "tag1extra");
+    assert_eq!(filtered2.iter().map(|n| n.id.as_str()).collect::<Vec<_>>(), vec!["4"]);
+
+    // no matches
+    assert!(filter_by_tag(&notes, "missing").is_empty());
+}
