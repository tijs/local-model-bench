+fn note(id: &str, tags: &[&str]) -> Note {
+    Note {
+        id: id.to_string(),
+        title: format!("title {id}"),
+        body: String::new(),
+        tags: tags.iter().map(|t| t.to_string()).collect(),
+        pinned: false,
+    }
+}
+
+#[test]
+fn filter_by_tag_exact_match_preserves_order() {
+    let notes = vec![
+        note("a", &["food", "shopping"]),
+        note("b", &["food"]),
+        note("c", &["shopping"]),
+        note("d", &[]),
+    ];
+    let food: Vec<&Note> = filter_by_tag(&notes, "food");
+    assert_eq!(
+        food.iter().map(|n| n.id.as_str()).collect::<Vec<_>>(),
+        vec!["a", "b"]
+    );
+}
