#!/usr/bin/env bash
set -euo pipefail
CRATE=/Users/tijs/projects/local-model-bench/runner/runs/tmp49p9f97t/run/rust
WORK=$(mktemp -d /tmp/hermes-verify-work.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
TD="$WORK/target"   # isolated target dir for a fresh build

echo "== cargo build (isolated target dir) =="
(cd "$CRATE" && CARGO_TARGET_DIR="$TD" cargo build --quiet)

echo "== cargo test (isolated target dir) =="
(cd "$CRATE" && CARGO_TARGET_DIR="$TD" cargo test --quiet)

BIN="$TD/debug/notekeep"
D="$WORK/data"
run() { (cd "$D" && "$BIN" "$@"); }

run create "Groceries #shopping #food" > /dev/null
run create "Ideas #food" > /dev/null
run create "Plan #shopping" > /dev/null

echo "== e2e assertions =="
fail=0
check() {
  local desc="$1"; shift
  local expected="$1"; shift
  local actual
  actual="$("$@" 2>&1)"
  if [ "$actual" == "$expected" ]; then
    echo "PASS: $desc"
  else
    echo "FAIL: $desc"
    echo "--- expected:"; echo "$expected"
    echo "--- actual:"; echo "$actual"
    fail=1
  fi
}

check "plain list shows all 3" \
"$(run list | wc -l | tr -d ' ')" ...
