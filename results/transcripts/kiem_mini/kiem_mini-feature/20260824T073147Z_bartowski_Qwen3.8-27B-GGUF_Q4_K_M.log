Let's implement check_count and check_contains.

```bash
count() { run "$@" | wc -l | tr -d ' '; }

assert_count() { local desc="$1" want="$2"; shift 2; local got; got="$(count "$@")
"; [ "$got" = "$want" ] && echo "PASS: $desc (got $got)" || { echo "FAIL: $desc (
want $want, got $got)"; fail=1; }; }

assert_contains() { local desc="$1" pat="$2"; shift 2; if run "$@" | grep -q -- "$
pat"; then echo "PASS: $desc"; else echo "FAIL: $desc"; fail=1; fi; }

assert_not_contains() { local desc="$1" pat="$2"; shift 2; if run "$@" | grep -q --
 "$pat"; then echo "FAIL: $desc (found $pat)"; fail=1; else echo "PASS: $desc"; fi
; }

assert_count "list shows 3 notes" 3 list
assert_count "list --tag food -> 2" 2 list --tag food
assert_contains "food filter includes Groceries" "Groceries" list --tag food
assert_contains "food filter includes Ideas" "Ideas" list --tag food
assert_not_contains "food filter excludes Plan" "Plan" list --tag food
assert_count "list --tag shopping -> 2" 2 list --tag shopping
assert_contains "shopping filter includes Plan" "Plan" list --tag shopping
assert_not_contains "shopping filter excludes Ideas" "Ideas" list --tag shopping
assert_count "substring 'shopp' matches nothing" 0 list --tag shopp
assert_count "unknown tag matches nothing" 0 list --tag none

[ "$fail" -eq 0 ] && echo "ALL AD-HOC CHECKS PASSED" || { echo "AD-HOC CHECKS FAILED
"; exit 1; }
