/// Returns, in their original relative order, the notes whose `tags`
/// contain `tag` as an exact match.
pub fn filter_by_tag<'a>(notes: &'a [Note], tag: &str) -> Vec<&'a Note> {
    notes.iter().filter(|n| n.tags.iter().any(|t| t == tag)).collect()
}
```

