+import Foundation
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+let noteFieldSeparator = "\n---\n"
+
+public func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: noteFieldSeparator, maxSplits: Int.max, omittingEmptySubsequences: false)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let pinned: Bool
+    switch String(parts[2]) {
+    case "1": pinned = true
+    case "0": pinned = false
+    default: pinned = false
+    }
+    return Note(
+        id: String(parts[0]),
+        title: String(parts[1]),
+        body: String(parts[3]),
+        tags: extractTags(from: String(parts[3])),
+        pinned: pinned
+    )
+}
+
+func check(_ label: String, _ text: String, expectThrow: Bool) {
+    do {
+        let n = try parseNote(from: text)
+        if expectThrow { print("FAIL \(label): expected throw, got \(n)") }
+        else { print("OK \(label): id=\(n.id) title=\(n.title) pinned=\(n.pinned) tags=\(n.tags)") }
+    } catch let e as NoteParseError {
+        if expectThrow { print("THREW OK \(label): \(e)") }
+        else { print("FAIL \(label): unexpected throw \(e)") }
+    } catch { print("FAIL \(label): unexpected \(error)") }
+}
+
+// Build the valid note with an actual newline separator (not the literal backslash-n).
+let sep = "\n---\n"
+let valid = "id-1" + sep + "Hello #world #swift" + sep + "1" + sep + "body #tag here"
+check("valid+pinned1", valid, expectThrow: false)
+
+let pinned0 = "id-2" + sep + "Title" + sep + "0" + sep + "plain body"
+check("pinned0", pinned0, expectThrow: false)
+
+check("malformed-3parts", "a\n---b\n---c", expectThrow: true)
+check("empty", "", expectThrow: true)
+check("malformed-5parts", "a\n---b\n---c\n---d\n---e", expectThrow: true)
+
+let emptyBody = "id" + sep + "T" + sep + "0" + sep + ""
+check("empty-body-ok", emptyBody, expectThrow: false)
