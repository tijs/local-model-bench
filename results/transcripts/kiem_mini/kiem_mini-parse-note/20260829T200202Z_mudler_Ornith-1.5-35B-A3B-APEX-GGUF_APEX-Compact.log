  ┊ review diff
a//Users/tijs/projects/local-model-bench/runner/runs/tmprymat1dv/run/swift/Sources/NoteKit/NoteKit.swift → b//Users/tijs/projects/local-model-bench/runner/runs/tmprymat1dv/run/swift/Sources/NoteKit/NoteKit.swift
@@ -14,3 +14,43 @@
     public let tags: [String]
     public let pinned: Bool
 }
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// The literal separator between the four persisted note fields: id, title,
+/// the pinned flag, and body.
+public let noteSeparator = "\n---\n"
+
+/// Parses a note from its persisted text form.
+///
+/// The text must contain exactly four fields joined by `noteSeparator`
+/// (`"\n---\n"`): id, title, a pinned flag ("1" or "0"), then body. The body
+/// may itself contain the separator, so the split is bounded to four parts.
+/// Throws `NoteParseError.malformedFormat` if the text does not split into
+/// exactly four parts.
+public func parseNote(from text: String) throws -> Note {
+    let parts: [String] = text.split(
+        separator: noteSeparator,
+        maxSplits: 3,
+        omittingEmptySubsequences: false
+    )
+
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = parts[0]
+    let title = parts[1]
+    let pinned = parts[2] == "1"
+    let body = parts[3]
+
+    return Note(
+        id: id,
+        title: title,
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
