+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note from its plain-text representation.
+///
+/// The expected format is four fields joined by "\n---\n":
+///   id\n---\ntitle\n---\npinned (1 or 0)\n---\nbody
+///
+/// If the text does not split into exactly four parts, throws
+/// `NoteParseError.malformedFormat`.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n", maxSplits: 3, omittingEmptySubsequences: false)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
