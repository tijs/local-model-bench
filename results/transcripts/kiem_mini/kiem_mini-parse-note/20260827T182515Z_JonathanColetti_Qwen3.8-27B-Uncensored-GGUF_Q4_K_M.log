a//Users/tijs/projects/local-model-bench/runner/runs/tmpnt8ssc6a/run/swift/Sources/NoteKit/NoteKit.swift → b//Users/tijs/projects/local-model-bench/runner/runs/tmpnt8ssc6a/run/swift/Sources/NoteKit/NoteKit.swift
@@ -14,3 +14,27 @@
     public let tags: [String]
     public let pinned: Bool
 }
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses note text in the same plain-text format the Rust CLI writes:
+/// id, title, pinned flag ("1" or "0"), and body joined by "\n---\n".
+/// Throws `NoteParseError.malformedFormat` if the text does not split into
+/// exactly 4 parts.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(
+        separator: "\n---\n",
+        maxSplits: 3,
+        omittingEmptySubsequences: false
+    )
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+    return Note(id: id, title: title, body: body, tags: extractTags(from: body), pinned: pinned)
+}
