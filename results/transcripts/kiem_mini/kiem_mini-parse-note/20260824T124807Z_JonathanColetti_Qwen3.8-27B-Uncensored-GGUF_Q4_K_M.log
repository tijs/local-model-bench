+/// Parses a note persisted in the Rust CLI's plain-text format:
+/// four fields — id, title, pinned flag ("1"/"0"), body — joined by
+/// the literal separator "\n---\n".
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    return Note(
+        id: parts[0],
+        title: parts[1],
+        body: parts[3],
+        tags: extractTags(from: parts[3]),
+        pinned: parts[2] == "1"
+    )
+}
