+/// Errors that can occur when parsing a note from its serialized string format.
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note from its plain-text serialized form.
+///
+/// The format is four fields joined by the literal separator `\n---\n`:
+///   id\n---\ntitle\n---\npinned (1 or 0)\n---\nbody
+///
+/// If the text does not split into exactly four parts, `malformedFormat`
+/// is thrown.  Tags are extracted from the body via `extractTags(from:)`.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+
+    return Note(
+        id: id,
+        title: title,
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
+
