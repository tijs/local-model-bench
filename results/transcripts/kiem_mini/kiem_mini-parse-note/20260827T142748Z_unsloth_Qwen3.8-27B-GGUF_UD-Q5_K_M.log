import Foundation

/// The error thrown when a note's text cannot be split into the four
/// fields (id, title, pinned, body) joined by the persistence separator.
public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

/// Parses a note persisted as plain text: four fields joined by the
/// literal separator "\n---\n" — id, title, pinned flag ("1" or "0"), body.
public func parseNote(from text: String) throws -> Note {
    let parts = text.components(separatedBy: "\n---\n")
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    let body = parts[3]
    return Note(
        id: parts[0],
        title: parts[1],
        pinned: parts[2] == "1",
        body: body,
        tags: extractTags(from: body)
    )
}
```

