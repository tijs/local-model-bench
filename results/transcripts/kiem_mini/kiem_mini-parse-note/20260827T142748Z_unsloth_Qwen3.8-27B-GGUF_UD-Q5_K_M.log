In Swift: implement splitn. Simple approach:

```swift
private func splitn(_ string: String, _ separator: String, _ maxParts: Int) -> [String
] {
    var parts: [String] = []
    var remaining = Substring(string)
    while parts.count < maxParts - 1 {
        guard let range = remaining.range(of: separator) else { break }
        parts.append(String(remaining[..<range.lowerBound]))
        remaining = remaining[range.upperBound...]
    }
    parts.append(String(remaining))
    return parts
}
```

