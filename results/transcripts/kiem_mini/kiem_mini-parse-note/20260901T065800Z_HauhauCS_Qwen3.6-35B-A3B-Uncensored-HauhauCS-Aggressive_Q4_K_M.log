+import Foundation
+
+// Inline the NoteKit source to test it standalone
+public func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n", maxSplits: 3, omittingEmptySubsequences: false)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+    return Note(id: id, title: title, body: body, tags: extractTags(from: body), pinned: pinned)
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+// --- Tests ---
+var passed = 0
+var failed = 0
+
+func assertEqual<T: Equatable>(_ a: T, _ b: T, _ msg: String) {
+    if a == b {
+        print("PASS: \(msg)")
+        passed += 1
+    } else {
+        print("FAIL: \(msg)  (got \(a), expected \(b))")
+        failed += 1
+    }
+}
+
+func assertThrows<T>(_ fn: () throws -> T, _ expectedError: Error, _ msg: String) {
+    do {
+        _ = try fn()
+        print("FAIL: \(msg) — no error thrown")
+        failed += 1
+    } catch let err {
+        if err == expectedError {
+            print("PASS: \(msg)")
+            passed += 1
+        } else {
+            print("FAIL: \(msg) — threw \(err), expected \(expectedError)")
+            failed += 1
+        }
+    }
+}
+
+// 1. Happy path: valid 4-part note
+let validNote = "abc123\n---\nMy Note\n---\n1\n---\nSome body text #tag1 #tag2"
+do {
+    let note = try parseNote(from: validNote)
+    assertEqual(note.id, "abc123", "id matches")
+    assertEqual(note.title, "My Note", "title matches")
+    assertEqual(note.pinned, true, "pinned is true")
+    assertEqual(note.body, "Some body text #tag1 #tag2", "body matches")
+    assertEqual(note.tags, ["tag1", "tag2"], "tags extracted")
+} catch {
+    print("FAIL: valid note threw \(error)")
+    failed += 1
+}
+
+// 2. Pinned = false
