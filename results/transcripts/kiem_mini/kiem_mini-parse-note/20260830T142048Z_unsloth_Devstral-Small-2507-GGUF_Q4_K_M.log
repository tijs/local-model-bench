+public func parseNote(from text: String) throws -> Note {
+    let separator = "\n---\n"
+    let parts = text.split(separator: separator)
+    
+    // We need exactly 4 parts: id, title, pinned flag, body
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = String(parts[0]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let title = String(parts[1]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let pinnedString = String(parts[2]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let body = String(parts[3]).trimmingCharacters(in: .whitespacesAndNewlines)
+    
+    // Parse pinned flag (should be "1" or "0")
+    let pinned: Bool
+    switch pinnedString {
+    case "1":
+        pinned = true
+    case "0":
+        pinned = false
+    default:
+        throw NoteParseError.malformedFormat
+    }
+    
+    // Extract tags from the body
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
