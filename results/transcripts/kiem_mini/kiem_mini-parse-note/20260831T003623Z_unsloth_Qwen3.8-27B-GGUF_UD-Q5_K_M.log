+import NoteKit
+import Foundation
+
+var failures = 0
+func check(_ name: String, _ cond: @autoclosure () -> Bool) {
+    if cond() { print("PASS \(name)") } else { print("FAIL \(name)"); failures += 1 }
+}
+
+// 1. Well-formed note, pinned=1
+let n1 = try parseNote(from: "note-123\n---\nWeekly Plan\n---\n1\n---\nBuy milk #shopping #home")
+check("id", n1.id == "note-123")
+check("title", n1.title == "Weekly Plan")
+check("pinned true", n1.pinned == true)
+check("body", n1.body == "Buy milk #shopping #home")
+check("tags", n1.tags == ["shopping", "home"])
+
+// 2. Multi-line body, tags via existing extractTags
+let n1b = try parseNote(from: "id-x\n---\nT\n---\n0\n---\nline1 #a\nline2 #b")
+check("multi-line body preserved", n1b.body == "line1 #a\nline2 #b")
+check("multi-line tags reuse extractTags", n1b.tags == extractTags(from: n1b.body))
+
+// 3. pinned=0, no tags
+let n2 = try parseNote(from: "id-a\n---\nT\n---\n0\n---\nbody text")
+check("pinned false", n2.pinned == false)
+check("tags none", n2.tags == [])
+
+// 4. Body containing the separator survives (maxSplits, like Rust splitn(4))
+let n3 = try parseNote(from: "id-b\n---\nT\n---\n0\n---\nline1\n---\nline2")
+check("body with separator", n3.body == "line1\n---\nline2")
+
+// 5. Empty body allowed
+let n7 = try parseNote(from: "id-c\n---\nT\n---\n1\n---\n")
+check("empty body ok", n7.body == "" && n7.pinned && n7.tags == [])
+
+// 6-8. Malformed -> .malformedFormat
+for (name, bad) in [("3 parts", "id-only\n---\ntitle"),
+                    ("no separator", "just plain text"),
+                    ("empty string", "")] {
+    do {
+        _ = try parseNote(from: bad)
+        check("\(name) throws", false)
+    } catch let e as NoteParseError {
+        check("\(name) throws malformedFormat", e == .malformedFormat)
+    } catch {
+        check("\(name) wrong error type", false)
+    }
+}
+
+if failures > 0 { print("\(failures) FAILURES"); exit(1) }
+print("ALL OK")
