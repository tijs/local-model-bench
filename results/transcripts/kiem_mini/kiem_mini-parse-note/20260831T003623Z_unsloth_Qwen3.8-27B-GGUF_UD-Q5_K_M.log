+    _ = try parseNote(from: "id-only\n---\ntitle")
+    check("3 parts throws", false)
+} catch let e as NoteParseError {
+    check("3 parts throws malformedFormat", e == .malformedFormat)
+} catch { check("3 parts wrong error", false) }
+
+// 5. No separator at all -> throw
+do {
+    _ = try parseNote(from: "just plain text")
+    check("no separator throws", false)
+} catch let e as NoteParseError {
+    check("no separator throws malformedFormat", e == .malformedFormat)
+} catch { check("no separator wrong error", false) }
+
+// 6. Empty string -> throw
