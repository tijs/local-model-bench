+    assertEqual(note.title, "My Note", "title")
+    assertEqual(note.pinned, true, "pinned")
+    assertEqual(note.body, "Some body #tag1 #tag2", "body")
+    assertEqual(note.tags, ["tag1", "tag2"], "tags")
+} catch { failed += 1; print("  FAIL: threw \(error)") }
+
