+import Foundation
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+
+func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+
+    return Note(
+        id: id,
+        title: title,
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
+
+var passed = 0
+var failed = 0
+
+func assertEqual<T: Equatable>(_ a: T, _ b: T, _ msg: String) {
+    if a == b { passed += 1; print("  PASS: \(msg)") }
+    else { failed += 1; print("  FAIL: \(msg) — got \(a), expected \(b)") }
+}
+
+print("Test 1: valid note pinned=1")
