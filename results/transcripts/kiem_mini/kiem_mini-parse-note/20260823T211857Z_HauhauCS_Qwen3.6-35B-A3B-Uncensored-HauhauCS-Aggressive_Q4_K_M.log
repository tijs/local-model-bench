+import Foundation
+
+// Inline the NoteKit types for ad-hoc verification
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+
+func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+
+    return Note(
+        id: id,
+        title: title,
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
+
+// --- Tests ---
+var passed = 0
+var failed = 0
+
+func assertEqual<T: Equatable>(_ a: T, _ b: T, _ msg: String) {
+    if a == b {
+        passed += 1
+        print("  PASS: \(msg)")
+    } else {
+        failed += 1
+        print("  FAIL: \(msg) — got \(a), expected \(b)")
+    }
+}
+
+print("Test 1: valid note with pinned=1")
+do {
+    let text = "abc123\n---\nMy Note\n---\n1\n---\nSome body text #tag1 #tag2"
+    let note = try parseNote(from: text)
+    assertEqual(note.id, "abc123", "id")
+    assertEqual(note.title, "My Note", "title")
+    assertEqual(note.pinned, true, "pinned")
+    assertEqual(note.body, "Some body text #tag1 #tag2", "body")
+    assertEqual(note.tags, ["tag1", "tag2"], "tags")
+} catch {
+    failed += 1; print("  FAIL: valid note threw \(error)")
+}
+
+print("Test 2: valid note with pinned=0")
+do {
+    let text = "xyz\n---\nUnpinned\n---\n0\n---\nbody"
+    let note = try parseNote(from: text)
+    assertEqual(note.pinned, false, "pinned")
+} catch {
+    failed += 1; print("  FAIL: threw \(error)")
+}
+
+print("Test 3: malformed — only 3 parts")
