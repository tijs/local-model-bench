```swift
public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

public func parseNote(from text: String) throws -> Note {
    // Split by " | " separator into exactly 4 parts
    let parts = text.split(separator: " | ")
    
    // Must have exactly 4 parts
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    
    let id = parts[0]
    let title = parts[1]
    let pinned = Title.isPinned(parts[2]) // or parse boolean from string
    
    // Extract tags from body (part 3)
    let tags = extractTags(from: parts[3])
    
    return Note(id: id, title: title, body: parts[3], tags: tags, pinned: pinned)
}
```

