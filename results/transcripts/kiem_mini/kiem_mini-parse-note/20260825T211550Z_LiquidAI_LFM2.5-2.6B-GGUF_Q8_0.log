+import Foundation
+
+@testable import NoteKit
+
+func main() {
+    // Test 1: Valid note with exactly 4 parts separated by " | "
+    let validNoteText = "ID-001 | My First Note | true | Hello world #important #swift"
+    do {
+        let note = try NoteKit.parseNote(from: validNoteText)
+        print("Test 1 PASSED: Valid note parsed successfully")
+        print("  ID: \(note.id)")
+        print("  Title: \(note.title)")
+        print("  Pinned: \(note.pinned)")
+        print("  Body: \(note.body)")
+        print("  Tags: \(note.tags)")
+    } catch NoteKit.NoteParseError.malformedFormat {
+        print("Test 1 FAILED: Valid note was rejected")
+    } catch {
+        print("Test 1 FAILED with unexpected error: \(error)")
+    }
+
+    // Test 2: Invalid format - too few parts (3)
+    let invalidShortText = "ID-002 | My Short Note | true"
+    do {
+        let note = try NoteKit.parseNote(from: invalidShortText)
+        print("Test 2 FAILED: Should have thrown malformedFormat for short text")
+    } catch NoteKit.NoteParseError.malformedFormat {
+        print("Test 2 PASSED: Short text correctly rejected with malformedFormat")
+    } catch {
+        print("Test 2 FAILED with unexpected error: \(error)")
+    }
+
+    // Test 3: Invalid format - too many parts (5)
+    let invalidLongText = "ID-003 | Title | true | Body part 1 | Body part 2"
+    do {
+        let note = try NoteKit.parseNote(from: invalidLongText)
+        print("Test 3 FAILED: Should have thrown malformedFormat for long text")
+    } catch NoteKit.NoteParseError.malformedFormat {
+        print("Test 3 PASSED: Long text correctly rejected with malformedFormat")
+    } catch {
+        print("Test 3 FAILED with unexpected error: \(error)")
+    }
+
+    // Test 4: Valid note without tags (empty tag list)
+    let noTagsText = "ID-004 | Another Note | false | Just plain text"
+    do {
+        let note = try NoteKit.parseNote(from: noTagsText)
+        print("Test 4 PASSED: Note with no tags parsed correctly")
+        print("  Tags: \(note.tags)")
+    } catch {
+        print("Test 4 FAILED: Could not parse note without tags")
+    }
+
+    // Test 5: Valid note with all fields present and tags
+    let fullNoteText = "ID-005 | Full Note Title | true | Detailed content #tag1 #tag2 #tag3"
+    do {
+        let note = try NoteKit.parseNote(from: fullNoteText)
+        print("Test 5 PASSED: Full note parsed correctly")
+        print("  ID: \(note.id)")
+        print("  Title: \(note.title)")
+        print("  Pinned: \(note.pinned)")
+        print("  Body: \(note.body)")
+        print("  Tags: \(note.tags)")
+    } catch {
+        print("Test 5 FAILED: Could not parse full note")
+    }
+}
+
+if __name__ == "__main__" {
+    main()
+}
