+/// Error thrown when a serialized note does not conform to the expected
+/// four-field layout joined by the literal separator "\n---\n".
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note from its serialized text form.
+///
+/// The expected layout is four fields joined by the literal separator
+/// `"\n---\n"`: id, title, a pinned flag ("1" or "0"), then body.
+/// The text must split into exactly four parts; anything else throws
+/// `NoteParseError.malformedFormat` rather than guessing or defaulting
+/// missing fields.
+public func parseNote(from text: String) throws -> Note {
+    // `split(separator:maxSplits:omittingEmptySubsequences:)` is a
+    // macOS 13.0+ API; the package pins `.macOS(.v13)` so it compiles.
+    // `maxSplits: 3` mirrors Rust's `splitn(4, SEP)`, keeping any extra
+    // separators inside the body, and empty segments are preserved.
+    let parts = text.split(
+        separator: "\n---\n",
+        maxSplits: 3,
+        omittingEmptySubsequences: false
+    )
+
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinnedFlag = String(parts[2])
+    let body = String(parts[3])
+
+    return Note(
+        id: id,
+        title: title,
+        pinned: pinnedFlag == "1",
+        body: body,
+        tags: extractTags(from: body)
+    )
+}
