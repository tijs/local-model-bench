public func parseNote(from text: String) throws -> Note {
    // Split by "###" into exactly 4 parts
    let parts = text.split(separator: "###")
    
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    
    let title = parts[0].trimmingCharacters(in: .whitespacesAndNewlines)
    let body = parts[1].trimmingCharacters(in: .whitespacesAndNewlines)
    // Combine remaining parts for tags extraction
    let tagText = parts[2] + " " + parts[3]
    
    let tags = extractTags(from: tagText)
    
    return Note(id: UUID().uuidString, title: title, body: body, tags: tags, pinned
