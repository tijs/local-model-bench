```swift
public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

public func parseNote(from text: String) throws -> Note {
    // Split by "###" (common title separator)
    let parts = text.split(separator: "###")
    
    // Must have exactly 4 parts
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    
    let title = parts[0].trimmingCharacters(in: .whitespacesAndNewlines)
    let pinned = parts[1].contains("pinned") // heuristic for pinned flag
    let body = parts[2]
    let tags = extractTags(from: text) // reuse existing function
    
    return Note(id: "note_\(parts.count)", title: title, body: body, tags: tags, p
inned: pinned)
}
```

