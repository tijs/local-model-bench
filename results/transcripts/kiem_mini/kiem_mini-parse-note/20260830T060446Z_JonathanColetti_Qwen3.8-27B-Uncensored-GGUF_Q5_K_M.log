+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note in the Rust CLI's plain-text format: four fields
+/// (id, title, pinned flag "1" or "0", body) joined by "\n---\n".
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(
+        separator: "\n---\n",
+        omittingEmptySubsequences: false
+    )
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let pinned: Bool
+    switch parts[2] {
+    case "1": pinned = true
+    case "0": pinned = false
+    default: throw NoteParseError.malformedFormat
+    }
+    let body = String(parts[3])
+    return Note(
+        id: String(parts[0]),
+        title: String(parts[1]),
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
