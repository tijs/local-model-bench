+import Foundation
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+
+enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else { throw NoteParseError.malformedFormat }
+    let id = parts[0]
+    let title = parts[1]
+    let pinnedFlag = parts[2]
+    let body = parts[3]
+    let pinned = pinnedFlag == "1"
+    let tags = extractTags(from: body)
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
+let good = "id123\n---\nMy Title\n---\n1\n---\nBody with #tag1 and #tag2"
+do {
+    let note = try parseNote(from: good)
+    print("OK", note.id, note.title, note.pinned, note.tags)
+} catch {
+    print("Error", error)
+}
+
+let bad = "id\ntitle"
+do {
+    let _ = try parseNote(from: bad)
+    print("Should have failed")
+} catch {
+    print("Bad correctly error", error)
+}
