+
+/// Error thrown when a note's persisted text cannot be split into the
+/// expected four fields (id, title, pinned flag, body).
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// The literal separator used to join the four persisted note fields.
+private let noteFieldSeparator = "\n---\n"
+
+/// Parses a note's persisted text — id, title, pinned flag ("1" or "0"),
+/// and body joined by `"\n---\n"` — into a `Note`. Tags are extracted from
+/// the body via `extractTags(from:)`. Throws `NoteParseError.malformedFormat`
+/// if the text does not split into exactly four parts.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: noteFieldSeparator)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    return Note(
+        id: parts[0],
+        title: parts[1],
+        pinned: parts[2] == "1",
+        body: parts[3],
+        tags: extractTags(from: parts[3])
+    )
+}
