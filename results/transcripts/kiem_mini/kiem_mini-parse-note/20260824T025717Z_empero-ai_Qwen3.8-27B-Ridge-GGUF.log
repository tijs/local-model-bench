+import NoteKit
+
+// Happy path
+let text = "n-042\nShipping plan\n1\nShip it #swift #done"
+let note = try! parseNote(from: text)
+precondition(note.id == "n-042")
+precondition(note.title == "Shipping plan")
+precondition(note.pinned == true)
+precondition(note.body == "Ship it #swift #done")
+precondition(note.tags == ["swift", "done"])
+
+// Unpinned, no tags
+let note2 = try! parseNote(from: "n-043\nDraft\n0\nplain body")
+precondition(note2.pinned == false)
+precondition(note2.tags == [])
+
+// Body containing the separator must still split into exactly 4 parts -> error
+do {
+    _ = try parseNote(from: "id\ntitle\n0\nbody\n---\nextra")
+    fatalError("expected malformedFormat")
+} catch let err as NoteParseError {
+    precondition(err == .malformedFormat)
+}
+
