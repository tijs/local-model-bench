+/// Thrown when note text does not match the expected serialized format.
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// The literal separator joining the four persisted note fields.
+private let noteSeparator = "\n---\n"
+
+/// Parses a note from its serialized form: four fields joined by the
+/// literal separator "\n---\n" — id, title, a pinned flag ("1" or "0"),
+/// then body. Throws `NoteParseError.malformedFormat` unless the text
+/// splits into exactly four parts.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: noteSeparator)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+
+    return Note(
+        id: id,
+        title: title,
+        body: body,
+        tags: extractTags(from: body),
+        pinned: pinned
+    )
+}
+
