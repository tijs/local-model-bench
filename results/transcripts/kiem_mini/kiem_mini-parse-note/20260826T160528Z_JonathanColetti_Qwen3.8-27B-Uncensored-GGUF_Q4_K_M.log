+import Testing
+@testable import NoteKit
+
+@Test func parseNoteValid() throws {
+    let text = "note-1\n---\nHello\n---\n1\n---\nBody text #a #b"
+    let note = try parseNote(from: text)
+    #expect(note.id == "note-1")
+    #expect(note.title == "Hello")
+    #expect(note.pinned == true)
+    #expect(note.body == "Body text #a #b")
+    #expect(note.tags == ["a", "b"])
+}
+
+@Test func parseNoteUnpinnedAndNoTags() throws {
+    let text = "n2\n---\nT\n---\n0\n---\nplain"
+    let note = try parseNote(from: text)
+    #expect(note.pinned == false)
+    #expect(note.tags == [])
+}
+
+@Test func parseNoteMalformed() {
+    #expect(throws: NoteParseError.malformedFormat) { try parseNote(from: "a\n---\nb\n---\n1") }
