a//Users/tijs/projects/local-model-bench/runner/runs/tmpbcilyn_x/run/swift/Sources/NoteKit/NoteKit.swift → b//Users/tijs/projects/local-model-bench/runner/runs/tmpbcilyn_x/run/swift/Sources/NoteKit/NoteKit.swift
@@ -14,3 +14,32 @@
     public let tags: [String]
     public let pinned: Bool
 }
+
+/// The literal separator between the four persisted note fields:
+/// id, title, pinned flag, and body.
+let noteFieldSeparator = "\n---\n"
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note persisted in the four-field, `\n---\n`-separated format.
+///
+/// The text must split into exactly four parts (id, title, pinned, body);
+/// anything else throws `NoteParseError.malformedFormat` rather than
+/// guessing, defaulting a missing field, or crashing.
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: noteFieldSeparator)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let pinned = parts[2]
+        .trimmingCharacters(in: .whitespacesAndNewlines) == "1"
+    return Note(
+        id: parts[0],
+        title: parts[1],
+        body: parts[3],
+        tags: extractTags(from: parts[3]),
+        pinned: pinned
+    )
+}
