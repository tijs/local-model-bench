+import Foundation
+
+/// Extracts #tags from a note's body text, in the order they appear.
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let components = text.components(separatedBy: "\n---\n")
+    
+    guard components.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = components[0]
+    let title = components[1]
+    let pinned = components[2] == "1"
+    let body = components[3]
+    
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
+// Test the implementation
+print("Testing NoteKit implementation...")
+
+do {
+    // Valid note
+    let validNoteText = "note-id-123\nMy Note Title\n0\nThis is the body with #tag1 and #tag2"
+    let note = try parseNote(from: validNoteText)
+    print("✓ Valid note parsed successfully")
+    print("  ID: \(note.id)")
+    print("  Title: \(note.title)")
+    print("  Pinned: \(note.pinned)")
+    print("  Body: \(note.body)")
+    print("  Tags: \(note.tags)")
+    
+    // Test pinned note
+    let pinnedNoteText = "note-id-456\nPinned Note\n1\nThis is a pinned note with #tag3"
+    let pinnedNote = try parseNote(from: pinnedNoteText)
+    print("\n✓ Pinned note parsed successfully")
+    print("  ID: \(pinnedNote.id)")
+    print("  Title: \(pinnedNote.title)")
+    print("  Pinned: \(pinnedNote.pinned)")
+    print("  Body: \(pinnedNote.body)")
+    print("  Tags: \(pinnedNote.tags)")
+    
+    // Test malformed format - too few components
+    let tooFewComponents = "note-id\nMy Title\nBody"
+    do {
+        _ = try parseNote(from: tooFewComponents)
+        print("\n✗ Should have thrown an error for too few components")
+    } catch NoteParseError.malformedFormat {
+        print("\n✓ Correctly threw malformedFormat error for too few components")
+    } catch {
+        print("\n✗ Unexpected error for too few components: \(error)")
+    }
+    
