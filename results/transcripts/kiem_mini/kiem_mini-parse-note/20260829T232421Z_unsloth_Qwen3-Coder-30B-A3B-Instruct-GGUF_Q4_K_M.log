+import Foundation
+
+/// Extracts #tags from a note's body text, in the order they appear.
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    // Split the input by the separator
+    let components = text.components(separatedBy: "\n---\n")
+    
+    // Must have exactly 4 parts
+    guard components.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    // Extract values from components
+    let id = components[0]
+    let title = components[1]
+    let pinned = components[2] == "1"
+    let body = components[3]
+    
+    // Extract tags from the body
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
