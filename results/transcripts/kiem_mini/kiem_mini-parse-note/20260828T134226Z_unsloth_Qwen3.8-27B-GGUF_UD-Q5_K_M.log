```swift
import NoteKit
import Foundation

var failures = 0
func check(_ cond: Bool, _ name: String) {
    if cond { print("PASS: \(name)") } else { print("FAIL: \(name)"); failures +=
 1 }
}

let sep = "\n---\n"

// 1. Valid pinned note, with tags in the body
let text1 = "n-1" + sep + "Groceries" + sep + "1" + sep + "Buy milk #dairy #urgent
"
do {
    let n = try parseNote(from: text1)
    check(n.id == "n-1", "valid: id")
    check(n.title == "Groceries", "valid: title")
    check(n.pinned, "valid: pinned")
    check(n.body == "Buy milk #dairy #urgent", "valid: body")
    check(n.tags == ["dairy", "urgent"], "valid: tags via extractTags")
} catch { check(false, "valid: threw \(error)") }

// 2. Unpinned, empty body
do {
    let n = try parseNote(from: "a" + sep + "t" + sep + "0" + sep)
    check(!n.pinned, "unpinned flag")
    check(n.body == "", "empty body preserved")
    check(n.tags == [], "no tags for empty body")
} catch { check(false, "unpinned: threw \(error)") }

// 3. Separator in body preserved (splitn(4) semantics)
do {
    let n = try parseNote(from: "a" + sep + "t" + sep + "0" + sep + "part1" + sep
 + "part2")
    check(n.body == "part1" + sep + "part2", "body containing separator kept intact
")
} catch { check(false, "body-sep: threw \(error)") }

// 4. Malformed: only 3 parts
do {
    _ = try parseNote(from: "a" + sep + "b" + sep + "c")
    check(false, "3 parts: did not throw")
} catch let e as NoteParseError where e == .malformedFormat {
    check(true, "3 parts throws malformedFormat")
} catch { check(false, "3 parts: wrong error \(error)") }

// 5. Malformed: no separator at all
do {
    _ = try parseNote(from: "no separators here")
    check(false, "no sep: did not throw")
} catch let e as NoteParseError where e == .malformedFormat {
    check(true, "no separator throws malformedFormat")
} catch { check(false, "no sep: wrong error \(error)") }

// 6. Malformed: 2 parts
do {
    _ = try parseNote(from: "a" + sep + "b")
    check(false, "2 parts: did not throw")
} catch let e as NoteParseError where e == .malformedFormat {
    check(true, "2 parts throws malformedFormat")
} catch { check(false, "2 parts: wrong error") }

// 7. Round-trip: exactly what the Rust CLI writes out (format!("{}{}{}{}{}{}{}",
 id, SEP, title, SEP, "1", SEP, body))
let rust = "note-42" + sep + "Rust interop" + sep + "1" + sep + "from the cli #interop
"
do {
    let n = try parseNote(from: rust)
    check(n.id == "note-42" && n.title == "Rust interop" && n.pinned && n.tags ==
 ["interop"], "round-trips Rust-written payload")
} catch { check(false, "roundtrip: threw \(error)") }

// 8. Error is Equatable
check(NoteParseError.malformedFormat == .malformedFormat, "NoteParseError Equatable
")

if failures == 0 { print("ALL CHECKS PASSED") } else { print("\(failures) CHECKS FAILED
"); exit(1) }
```

