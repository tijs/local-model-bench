+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note serialized in the Rust CLI's plain-text format:
+/// four fields (id, title, pinned flag "1"/"0", body) joined by the
+/// literal separator "\n---\n".
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let (id, title, pinnedFlag, body) = (parts[0], parts[1], parts[2], parts[3])
+    let pinned: Bool
+    switch pinnedFlag {
+    case "1": pinned = true
+    case "0": pinned = false
+    default: throw NoteParseError.malformedFormat
+    }
+    return Note(id: id, title: title, body: body, tags: extractTags(from: body), pinned: pinned)
+}
