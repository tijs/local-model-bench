+import Foundation
+
+// This is a simple test to verify our implementation works
+// We'll manually test the parsing logic without using the full testing framework
+
+// First, let's define what we expect from our implementation
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+func parseNote(from text: String) throws -> Note {
+    let components = text.components(separatedBy: "\n---\n")
+    
+    // A valid note must have exactly 4 components
+    guard components.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = components[0]
+    let title = components[1]
+    let pinned = components[2] == "1"
+    let body = components[3]
+    
+    return Note(id: id, title: title, body: body, tags: extractTags(from: body), pinned: pinned)
+}
+
+// Test cases
+print("Testing parseNote function...")
+
+// Valid note
+do {
+    let validNoteText = "note-id-123\nMy Note Title\n0\nThis is the body with #tag1 and #tag2"
+    let note = try parseNote(from: validNoteText)
+    print("✓ Valid note parsed successfully")
+    print("  ID: \(note.id)")
+    print("  Title: \(note.title)")
+    print("  Pinned: \(note.pinned)")
+    print("  Body: \(note.body)")
+    print("  Tags: \(note.tags)")
+} catch {
+    print("✗ Failed to parse valid note: \(error)")
+}
+
+// Malformed note - too few components
+do {
+    let malformedNoteText = "note-id-123\nMy Note Title\n0"
+    try parseNote(from: malformedNoteText)
+    print("✗ Should have failed with malformed note (too few components)")
+} catch NoteParseError.malformedFormat {
+    print("✓ Correctly rejected malformed note (too few components)")
+} catch {
+    print("✗ Unexpected error for malformed note: \(error)")
+}
+
+// Malformed note - too many components
+do {
+    let malformedNoteText = "note-id-123\nMy Note Title\n0\nThis is the body\nExtra line"
+    try parseNote(from: malformedNoteText)
+    print("✗ Should have failed with malformed note (too many components)")
+} catch NoteParseError.malformedFormat {
+    print("✓ Correctly rejected malformed note (too many components)")
+} catch {
+    print("✗ Unexpected error for malformed note: \(error)")
+}
