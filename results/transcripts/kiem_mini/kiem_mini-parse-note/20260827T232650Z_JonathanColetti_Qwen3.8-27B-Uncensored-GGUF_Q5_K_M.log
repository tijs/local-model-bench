import Foundation

var failures = 0
func check(_ cond: Bool, _ label: String) {
    if cond { print("PASS: \(label)") } else { print("FAIL: \(label)"); failures +=
 1 }
}

// 1. valid pinned note
do {
    let n = try parseNote(from: "note-1\n---\nMy Title\n---\n1\n---\nhello #world
 #swift")
    check(n.id == "note-1", "id")
    check(n.title == "My Title", "title")
    check(n.pinned == true, "pinned true")
    check(n.body == "hello #world #swift", "body")
    check(n.tags == ["world", "swift"], "tags reused from extractTags")
} catch { check(false, "valid note should parse: \(error)") }

// 2. unpinned
do {
    let n = try parseNote(from: "n2\n---\nT\n---\n0\n---\nplain")
    check(n.pinned == false, "pinned false")
    check(n.tags == [], "no tags")
} catch { check(false, "unpinned should parse") }

// 3. body with embedded separator
do {
    let n = try parseNote(from: "n3\n---\nT\n---\n1\n---\nline one\n---\nline two
")
    check(n.body == "line one\n---\nline two", "embedded separator stays in body")

} catch { check(false, "embedded separator should parse") }

// 4. malformed: too few parts
do {
    _ = try parseNote(from: "a\n---\nb\n---\nc")
    check(false, "3 parts should throw")
} catch let e as NoteParseError {
    check(e == .malformedFormat, "too few parts -> malformedFormat")
}

// 5. malformed: no separators
do {
    _ = try parseNote(from: "plain text")
    check(false, "no separator should throw")
} catch let e as NoteParseError {
    check(e == .malformedFormat, "no separator -> malformedFormat")
}

// 6. Equatable conformance
check(NoteParseError.malformedFormat == .malformedFormat, "error is Equatable")

if failures > 0 { print("\(failures) FAILURES"); exit(1) }
print("ALL CHECKS PASSED")
```

