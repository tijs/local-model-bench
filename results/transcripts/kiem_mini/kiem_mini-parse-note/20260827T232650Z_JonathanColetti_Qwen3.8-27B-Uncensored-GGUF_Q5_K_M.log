/// Error thrown when a persisted note's text doesn't match the expected
/// `id\n---\ntitle\n---\npinned\n---\nbody` format.
public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

private let noteFieldSeparator = "\n---\n"

public func parseNote(from text: String) throws -> Note {
    // The body itself may contain the separator, so limit splits to the
    // three field boundaries; anything after the third stays in the body.
    let parts = text.split(separator: noteFieldSeparator, maxSplits: 3, omittingEmpty
Subsequences: false)
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    let (id, title, pinnedFlag, body) = (parts[0], parts[1], parts[2], parts[3])
    return Note(
        id: id,
        title: title,
        body: body,
        tags: extractTags(from: body),
        pinned: pinnedFlag == "1"
    )
}
```

