```swift
import Foundation

private let noteSeparator = "\n---\n"

public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    return text.split(separator: " ")
        .filter { $0.hasPrefix("#") }
        .map { String($0.dropFirst()) }
}

public struct Note: Equatable {
    public let id: String
    public let title: String
    public let body: String
    public let tags: [String]
    public let pinned: Bool
}

/// Parses a note from its serialized form:
/// `id \n---\n title \n---\n pinned \n---\n body`
/// where `pinned` is "1" for a pinned note and "0" otherwise.
///
/// The text must split into exactly four parts on the separator; otherwise
/// `NoteParseError.malformedFormat` is thrown rather than guessing,
/// defaulting missing fields, or crashing.
public func parseNote(from text: String) throws -> Note {
    let parts = text.split(
        separator: noteSeparator,
        maxSplits: 3,
        omittingEmptySubsequences: false
    )

    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }

    let id = String(parts[0])
    let title = String(parts[1])
    let pinned = parts[2] == "1"
    let body = String(parts[3])

    return Note(
        id: id,
        title: title,
        body: body,
        tags: extractTags(from: body),
        pinned: pinned
    )
}
```

