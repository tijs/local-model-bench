import Foundation

/// The literal field separator used by the Rust CLI note format:
/// a newline, three dashes, and a newline (`\n---\n`).
private let noteFieldSeparator = "\n---\n"

/// Errors thrown when parsing a note's serialized text.
public enum NoteParseError: Error, Equatable {
    /// The text did not contain exactly the expected number of
    /// separator-delimited fields.
    case malformedFormat
}

public func parseNote(from text: String) throws -> Note {
    let parts = text.components(separatedBy: noteFieldSeparator)
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }

    let id = parts[0].isEmpty ? "" : parts[0]
    let title = parts[1].isEmpty ? "" : parts[1]
    let pinned = parts[2] == "1"
    let body = parts[3].isEmpty ? "" : parts[3]

    return Note(
        id: id,
        title: title,
        body: body,
        tags: extractTags(from: body),
        pinned: pinned
    )
}
```

