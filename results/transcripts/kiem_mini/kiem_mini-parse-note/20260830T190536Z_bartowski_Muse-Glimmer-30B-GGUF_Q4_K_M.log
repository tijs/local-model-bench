+import Foundation
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+enum NoteParseError: Error, Equatable { case malformedFormat }
+func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: "\n---\n")
+    guard parts.count == 4 else { throw NoteParseError.malformedFormat }
+    let id = parts[0]
+    let title = parts[1]
+    let pinnedString = parts[2]
+    let body = parts[3]
+    guard pinnedString == "1" || pinnedString == "0" else { throw NoteParseError.malformedFormat }
+    let pinned = pinnedString == "1"
+    let tags = extractTags(from: body)
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
+print("=== Ad-hoc verification of parseNote ===")
+let cases: [(String, Bool, String)] = [
+    ("abc123\n---\nMy Title\n---\n1\n---\nBody #a #b", true, "valid pinned 1"),
+    ("id2\n---\nT\n---\n0\n---\nNo tags here", true, "valid pinned 0"),
+    ("a\n---\nb", false, "malformed 2 parts"),
+    ("x\n---\ny\n---\n2\n---\nz", false, "bad pinned flag"),
+    ("p\n---\nq\n---\n1\n---\n", true, "empty body"),
+]
+
+var passed = 0
+for text, shouldSucceed, name in cases {
+    do {
+        let n = try parseNote(from: text)
+        if shouldSucceed {
+            print("PASS \(name): id=\(n.id) pinned=\(n.pinned) tags=\(n.tags)")
+            passed += 1
+        } else {
+            print("FAIL \(name): expected error but got success")
+        }
+    } catch {
+        if !shouldSucceed {
+            print("PASS \(name): correctly threw error")
+            passed += 1
+        } else {
+            print("FAIL \(name): unexpected error \(error)")
+        }
+    }
+}
+print("Result: \(passed)/\(cases.count) passed")
