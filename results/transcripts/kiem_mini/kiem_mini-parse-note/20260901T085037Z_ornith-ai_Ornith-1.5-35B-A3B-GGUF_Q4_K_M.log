+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+/// Parses a note serialized as four fields joined by "\n---\n":
+/// id, title, pinned ("1" or "0"), then body.
+///
+/// Throws `NoteParseError.malformedFormat` unless the text splits into
+/// exactly four parts, or the pinned field is neither "1" nor "0".
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n", omittingEmptySubsequences: false)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+
+    let pinned: Bool
+    switch parts[2] {
+    case "1": pinned = true
+    case "0": pinned = false
+    default: throw NoteParseError.malformedFormat
+    }
+
+    return Note(
+        id: String(parts[0]),
+        title: String(parts[1]),
+        body: String(parts[3]),
+        tags: extractTags(from: String(parts[3])),
+        pinned: pinned
+    )
+}
