+import Foundation
+
+func check(_ cond: Bool, _ name: String) {
+    print("\(cond ? "PASS" : "FAIL"): \(name)")
+    if !cond { exitCode = 1 }
+}
+
+var exitCode: Int32 = 0
+
+// 1. Round-trip of the Rust CLI format (pinned, tags in body)
+let text1 = "note-42\n---\nShopping list\n---\n1\n---\nBuy milk #errands #groceries"
+do {
+    let note = try parseNote(from: text1)
+    check(note.id == "note-42", "id")
+    check(note.title == "Shopping list", "title")
+    check(note.pinned == true, "pinned true")
+    check(note.body == "Buy milk #errands #groceries", "body")
+    check(note.tags == ["errands", "groceries"], "tags")
+} catch {
+    check(false, "parse valid note (got \(error))")
+}
+
+// 2. Unpinned
+do {
+    let note = try parseNote(from "a\n---\nT\n---\n0\n---\nplain body")
+    check(note.pinned == false, "pinned false")
+    check(note.tags == [], "no tags")
+} catch {
+    check(false, "parse unpinned (got \(error))")
+}
+
+// 3. Body containing the separator survives (splitn(4) semantics)
+do {
+    let note = try parseNote(from "b\n---\nT\n---\n1\n---\npart one\n---\npart two")
+    check(note.body == "part one\n---\npart two", "body with separator")
+    check(note.pinned == true, "pinned with separator in body")
+} catch {
+    check(false, "parse body with separator (got \(error))")
+}
+
+// 4. Too few parts -> malformedFormat
+do {
+    _ = try parseNote(from "only\n---\ntwo\n---\nparts")
+    check(false, "3 parts should throw")
+} catch NoteParseError.malformedFormat {
+    check(true, "3 parts throws malformedFormat")
+} catch {
+    check(false, "wrong error type: \(error)")
+}
+
+// 5. No separator at all -> malformedFormat
+do {
+    _ = try parseNote(from "just one part")
+    check(false, "1 part should throw")
+} catch NoteParseError.malformedFormat {
+    check(true, "1 part throws malformedFormat")
+} catch {
+    check(false, "wrong error type: \(error)")
+}
+
+// 6. Empty fields are preserved, not defaulted
+do {
+    let note = try parseNote(from "\n---\n\n---\n0\n---\n")
+    check(note.id == "" && note.title == "" && note.body == "", "empty fields preserved")
+    check(note.pinned == false, "empty flag -> pinned false")
+} catch {
+    check(false, "empty fields (got \(error))")
+}
+
+exit(exitCode)
