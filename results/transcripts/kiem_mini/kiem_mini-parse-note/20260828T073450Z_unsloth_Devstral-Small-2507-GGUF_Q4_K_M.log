+import Foundation
+import XCTest
+
+class NoteKitTests: XCTestCase {
+    func testParseNote() throws {
+        let noteText = "123\n---\nMy Note Title\n---\n1\n---\nThis is the note body with #tag1 and #tag2"
+        
+        let note = try parseNote(from: noteText)
+        
+        XCTAssertEqual(note.id, "123")
+        XCTAssertEqual(note.title, "My Note Title")
+        XCTAssertTrue(note.pinned)
+        XCTAssertEqual(note.body, "This is the note body with #tag1 and #tag2")
+        XCTAssertEqual(note.tags, ["tag1", "tag2"])
+    }
+    
+    func testParseNoteUnpinned() throws {
+        let noteText = "456\n---\nAnother Note\n---\n0\n---\nUnpinned note with #singleTag"
+        
+        let note = try parseNote(from: noteText)
+        
+        XCTAssertEqual(note.id, "456")
+        XCTAssertEqual(note.title, "Another Note")
+        XCTAssertFalse(note.pinned)
+        XCTAssertEqual(note.body, "Unpinned note with #singleTag")
+        XCTAssertEqual(note.tags, ["singleTag"])
+    }
+    
+    func testParseNoteMalformedFormat() {
+        // Test with wrong number of parts
+        XCTAssertThrowsError(try parseNote(from: "123\n---\nTitle\n---\n1"))
+        
+        // Test with invalid pinned flag
+        XCTAssertThrowsError(try parseNote(from: "123\n---\nTitle\n---\ninvalid\n---\nBody"))
+    }
+}
+
+NoteKitTests.defaultTestSuite.run()
