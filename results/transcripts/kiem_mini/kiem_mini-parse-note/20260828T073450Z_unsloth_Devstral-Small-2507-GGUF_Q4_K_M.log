+import Foundation
+
+/// Extracts #tags from a note's body text, in the order they appear.
+public func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let separator = "\n---\n"
+    let parts = text.split(separator: separator, omittingEmptySubsequences: false)
+    
+    // We need exactly 4 parts: id, title, pinned flag, body
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = String(parts[0]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let title = String(parts[1]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let pinnedString = String(parts[2]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let body = String(parts[3]).trimmingCharacters(in: .whitespacesAndNewlines)
+    
+    // Parse pinned flag
+    let pinned: Bool
+    if pinnedString == "1" {
+        pinned = true
+    } else if pinnedString == "0" {
+        pinned = false
+    } else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    // Extract tags from the body
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
+// Verification tests
+func verifyImplementation() {
+    print("=== NoteKit Implementation Verification ===\n")
+    
+    // Test 1: Valid pinned note with multiple tags
+    let test1 = "123\n---\nMy Note Title\n---\n1\n---\nThis is the note body with #tag1 and #tag2"
+    do {
+        let note = try parseNote(from: test1)
+        assert(note.id == "123", "ID mismatch")
+        assert(note.title == "My Note Title", "Title mismatch")
+        assert(note.pinned == true, "Pinned flag mismatch")
+        assert(note.body == "This is the note body with #tag1 and #tag2", "Body mismatch")
+        assert(note.tags == ["tag1", "tag2"], "Tags mismatch")
+        print("✓ Test 1 passed: Valid pinned note with multiple tags")
+    } catch {
+        print("✗ Test 1 failed: \(error)")
+        return
+    }
+    
+    // Test 2: Valid unpinned note with single tag
+    let test2 = "456\n---\nAnother Note\n---\n0\n---\nUnpinned note with #singleTag"
+    do {
+        let note = try parseNote(from: test2)
+        assert(note.id == "456", "ID mismatch")
+        assert(note.title == "Another Note", "Title mismatch")
+        assert(note.pinned == false, "Pinned flag mismatch")
+        assert(note.body == "Unpinned note with #singleTag", "Body mismatch")
