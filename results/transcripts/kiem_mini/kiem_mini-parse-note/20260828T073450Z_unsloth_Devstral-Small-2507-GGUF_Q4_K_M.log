+import Foundation
+
+/// Extracts #tags from a note's body text, in the order they appear.
+public func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let separator = "\n---\n"
+    let parts = text.split(separator: separator, omittingEmptySubsequences: false)
+    
+    // We need exactly 4 parts: id, title, pinned flag, body
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = String(parts[0]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let title = String(parts[1]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let pinnedString = String(parts[2]).trimmingCharacters(in: .whitespacesAndNewlines)
+    let body = String(parts[3]).trimmingCharacters(in: .whitespacesAndNewlines)
+    
+    // Parse pinned flag
+    let pinned: Bool
+    if pinnedString == "1" {
+        pinned = true
+    } else if pinnedString == "0" {
+        pinned = false
+    } else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    // Extract tags from the body
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
