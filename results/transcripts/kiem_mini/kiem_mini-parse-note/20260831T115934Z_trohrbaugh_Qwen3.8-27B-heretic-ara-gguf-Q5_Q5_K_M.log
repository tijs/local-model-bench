+
+/// Separates the four persisted note fields (id, title, pinned flag, body).
+private let noteSeparator = "\n---\n"
+
+/// Parses a note persisted in the plain-text CLI format: id, title,
+/// pinned flag ("1" or "0"), and body, joined by "\n---\n".
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.components(separatedBy: noteSeparator, limit: 4)
+    guard parts.count == 4 else {
