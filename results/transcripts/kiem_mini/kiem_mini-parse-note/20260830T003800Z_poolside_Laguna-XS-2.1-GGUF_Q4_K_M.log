@@ -0,0 +1,114 @@
+import Foundation
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+struct Note: Equatable {
+    let id: String
+    let title: String
+    let body: String
+    let tags: [String]
+    let pinned: Bool
+}
+
+enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n", maxSplits: 3, omittingEmptySubsequences: false)
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = parts[2] == "1"
+    let body = String(parts[3])
+    let tags = extractTags(from: body)
+    
+    return Note(id: id, title: title, body: body, tags: tags, pinned: pinned)
+}
+
+// Build a note the same way Rust does
+let sep = "\n---\n"
+let validNote = "test-id-123" + sep + "Test Title" + sep + "1" + sep + "This is the body with #tag1 #tag2"
+
+print("Testing valid note...")
+do {
+    let note = try parseNote(from: validNote)
+    print("✓ Valid note parsed:")
+    print("  id: \(note.id)")
+    print("  title: \(note.title)")
+    print("  pinned: \(note.pinned)")
+    print("  body: \(note.body)")
+    print("  tags: \(note.tags)")
+    assert(note.id == "test-id-123")
+    assert(note.title == "Test Title")
+    assert(note.pinned == true)
+    assert(note.body == "This is the body with #tag1 #tag2")
+    assert(note.tags == ["tag1", "tag2"])
+} catch {
+    print("✗ Unexpected error: \(error)")
+    exit(1)
+}
+
+// Test invalid note (fewer than 4 parts)
+let invalidNote1 = "only-two-parts\n---\nsome-title"
+print("\nTesting invalid note (too few parts)...")
+do {
+    let note = try parseNote(from: invalidNote1)
+    print("✗ Should have thrown error, got: \(note)")
+    exit(1)
+} catch NoteParseError.malformedFormat {
+    print("✓ Correctly threw malformedFormat for invalid note")
+} catch {
+    print("✗ Wrong error type: \(error)")
+    exit(1)
+}
+
+// Test with 0 (unpinned)
+let unpinnedNote = "id2\n---\nTitle\n---\n0\nBody content"
+print("\nTesting unpinned note...")
+do {
+    let note = try parseNote(from: unpinnedNote)
+    print("✓ Unpinned note: id=\(note.id), title=\(note.title), pinned=\(note.pinned)")
