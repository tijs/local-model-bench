/// Error thrown when a note text does not match the on-disk format.
public enum NoteParseError: Error, Equatable {
    case malformedFormat
}

/// Separator between the four fields of a persisted note.
let noteFieldSeparator = "\n---\n"

public func parseNote(from text: String) throws -> Note {
    let parts = text.components(separatedBy: noteFieldSeparator).prefix(4)... 
```

Hmm, Swift doesn't have splitn directly, but we can do this:

```swift
var parts: [String] = []
var rest = text
while let range = rest.range(of: noteFieldSeparator), parts.count < 3 {
    parts.append(String(rest[..<range.lowerBound]))
    rest = String(rest[range.upperBound...])
}
parts.append(rest)
```

More simply: use components(separatedBy:).prefix(4)? That's not right — splitn(4)
 allows the body to contain the separator. `components(separatedBy:).prefix(4)` takes
 the first 4, but throws away the rest of the body. So we have to reconstruct: split
 with max 4 parts and concatenate the remainder? No — the body is everything after
 the 3rd separator, including any separators inside it.

The cleanest approach:

```swift
public func parseNote(from text: String) throws -> Note {
    var parts: [String] = []
    var remaining = Substring(text)
    while parts.count < 3, let range = remaining.range(of: noteFieldSeparator) {
        parts.append(remaining[..<range.lowerBound])
        remaining = remaining[range.upperBound...]
    }
    parts.append(remaining)
    guard parts.count == 4 else { throw NoteParseError.malformedFormat }
    ...
}
```

Wait: the while loop runs while parts.count < 3, appending up to 3 pieces before the
 separator. Then it appends the remainder as the 4th. If there are fewer than 3 separators
, parts.count < 4 → throw. This exactly mirrors splitn(4).

Even simpler, use components:

```swift
let all = text.components(separatedBy: noteFieldSeparator)
guard all.count >= 4 else { throw NoteParseError.malformedFormat }
let id = all[0], title = all[1], pinned = all[2]
let body = all.dropFirst(3).joined(separator: noteFieldSeparator)
```

This is simpler and equivalent to splitn(4) when count >= 4: body = everything from
 the 3rd separator onward, preserving any separators inside the body. Yeah, this works
, and it's more readable.

