public func parseNote(from text: String) throws -> Note {
    let separator = "\n---\n"
    var remaining = text
    var parts: [String] = []
    for _ in 0..<3 {
        guard let range = remaining.range(of: separator) else {
            throw NoteParseError.malformedFormat
        }
        parts.append(String(remaining[remaining.startIndex..<range.lowerBound]))
        remaining = remaining[range.upperBound...]
    }
    parts.append(remaining)
    
    guard parts.count == 4 else {
        throw NoteParseError.malformedFormat
    }
    ...
}
```

