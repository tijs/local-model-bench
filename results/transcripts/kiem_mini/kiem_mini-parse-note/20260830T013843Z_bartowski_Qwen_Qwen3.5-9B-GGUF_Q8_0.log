+import Foundation
+
+let testCases: [(description: String, input: String, expectError: Bool)] = [
+    ("Valid note", "abc123\n---\nMy Title\n---\n1\n---\nBody text with #tags here", false),
+    ("Valid note unpinned", "xyz789\n---\nAnother Title\n---\n0\n---\nPlain body", false),
+    ("Missing parts", "just one line", true),
+    ("Extra parts", "id1\n---\ntitle1\n---\n0\n---\nbody1\n---\nextra", true),
+]
+
+func extractTags(from text: String) -> [String] {
+    return text.split(separator: " ")
+        .filter { $0.hasPrefix("#") }
+        .map { String($0.dropFirst()) }
+}
+
+public enum NoteParseError: Error, Equatable {
+    case malformedFormat
+}
+
+public struct Note: Equatable {
+    public let id: String
+    public let title: String
+    public let body: String
+    public let tags: [String]
+    public let pinned: Bool
+}
+
+public func parseNote(from text: String) throws -> Note {
+    let parts = text.split(separator: "\n---\n")
+    guard parts.count == 4 else {
+        throw NoteParseError.malformedFormat
+    }
+    let id = String(parts[0])
+    let title = String(parts[1])
+    let pinned = String(parts[2]) == "1"
+    let body = String(parts[3])
+    return Note(id: id, title: title, body: body, tags: extractTags(from: body), pinned: pinned)
+}
+
+var passed = 0, failed = 0
+for (desc, input, expectError) in testCases {
+    do {
+        let note = try parseNote(from: input)
+        if expectError { print("FAIL: \(desc)"); failed += 1 }
+        else { print("PASS: \(desc)"); passed += 1 }
+    } catch let error as NoteParseError {
+        if expectError { print("PASS: \(desc)"); passed += 1 }
+        else { print("FAIL: \(desc)"); failed += 1 }
+    } catch { print("FAIL: \(desc)"); failed += 1 }
+}
+Foundation.exit(failed == 0 ? 0 : 1)
