+#!/usr/bin/env python3
+"""
+Ad-hoc verification script for NoteKit parsing functionality.
+This tests the Swift implementation by simulating what the Swift code should do.
+"""
+
+import re
+
+# Mock extractTags function (same as in the Swift code)
+def extract_tags(text):
+    return [tag[1:] for tag in text.split() if tag.startswith("#")]
+
+# Mock NoteParseError
+class NoteParseError(Exception):
+    def __init__(self):
+        self.message = "malformedFormat"
+
+# Mock Note struct
+class Note:
+    def __init__(self, id, title, body, tags, pinned):
+        self.id = id
+        self.title = title
+        self.body = body
+        self.tags = tags
+        self.pinned = pinned
+    
+    def __eq__(self, other):
+        return (self.id == other.id and 
+                self.title == other.title and 
+                self.body == other.body and 
+                self.tags == other.tags and 
+                self.pinned == other.pinned)
+
+# Mock parseNote function (equivalent to Swift implementation)
+def parse_note(text):
+    components = text.split("\n---\n")
+    
+    # Check if we have exactly 4 parts
+    if len(components) != 4:
+        raise NoteParseError()
+    
+    id = components[0]
+    title = components[1]
+    pinned = components[2] == "1"
+    body = components[3]
+    
+    tags = extract_tags(body)
+    
+    return Note(id, title, body, tags, pinned)
+
+# Test cases
