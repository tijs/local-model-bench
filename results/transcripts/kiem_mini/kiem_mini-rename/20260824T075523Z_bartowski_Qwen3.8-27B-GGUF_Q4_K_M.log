pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    if old_id == new_id {
        // still update the title? The spec says to change the id to new_id and the
 title to new_title. If the ids are equal, just update the title in place. Handle
 it: rewrite the file.
    }
    let old_path = dir.join(format!("{}.note", old_id));
    let new_path = dir.join(format!("{}.note", new_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            format!("note {} is malformed", old_id),
        ));
    }
    if new_path.exists() {
        return Err(std::io::Error::new(
            std::io::ErrorKind::AlreadyExists,
            format!("note {} already exists", new_id),
        ));
    }
    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, parts[2], SEP, parts[3]
    );
    if old_id == new_id {
        fs::write(&old_path, new_content)?;
    } else {
        fs::write(&new_path, new_content)?;
        fs::remove_file(&old_path)?;
    }
    Ok(())
}
```

