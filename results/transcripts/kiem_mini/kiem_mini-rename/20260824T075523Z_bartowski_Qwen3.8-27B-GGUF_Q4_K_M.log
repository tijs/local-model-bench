pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 || parts[0] != old_id {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            format!("stored note for id {old_id} is malformed"),
        ));
    }
    if parts[0] != new_id && dir.join(format!("{}.note", new_id)).exists() {
        return Err(std::io::Error::new(
            std::io::ErrorKind::AlreadyExists,
            format!("a note with id {new_id} already exists"),
        ));
    }
    let note = Note {
        id: new_id.to_string(),
        title: new_title.to_string(),
        body: parts[3].to_string(),
        tags: crate::extract_tags(parts[3]),
        pinned: parts[2] == "1",
    };
    save(dir, &note)?;
    if old_id != new_id {
        fs::remove_file(&old_path)?;
    }
    Ok(())
}
```

Wait — if old_id == new_id, save() writes the same file with the new title. Good,
 and no deletion.

Note: `save` uses `note.body` — body is preserved verbatim, so the file contents are
 preserved byte-for-byte except for id/title.

One subtle point: `fs::read_to_string(&old_path)?` — if the file doesn't exist, it
 returns NotFound, which is the correct error for "note not found."

Also, `Note` is imported at the top of store.rs (`use crate::Note;`) — good.

