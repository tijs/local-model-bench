+use notekeep::{new_note, store};
+use std::fs;
+use tempfile::TempDir;
+
+#[test]
+fn rename_updates_id_and_title() {
+    let temp_dir = TempDir::new().expect("failed to create temp dir");
+    let notes_dir = temp_dir.path();
+
+    // Create and save a note
+    let note = new_note("note1", "Original Title", "This is a test #tag1 #tag2");
+    store::save(notes_dir, &note).expect("failed to save note");
+
+    // Verify initial state
+    let loaded = store::load_all(notes_dir).expect("failed to load notes");
+    assert_eq!(loaded.len(), 1);
+    assert_eq!(loaded[0].id, "note1");
+    assert_eq!(loaded[0].title, "Original Title");
+
+    // Rename the note
+    store::rename(notes_dir, "note1", "note2", "New Title").expect("failed to rename note");
+
+    // Verify rename worked
+    let loaded = store::load_all(notes_dir).expect("failed to load notes");
+    assert_eq!(loaded.len(), 1, "Expected exactly 1 note after rename");
+    assert_eq!(loaded[0].id, "note2");
+    assert_eq!(loaded[0].title, "New Title");
+}
+
