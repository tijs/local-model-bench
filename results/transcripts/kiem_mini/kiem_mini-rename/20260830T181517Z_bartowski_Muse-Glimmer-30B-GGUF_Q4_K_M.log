pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
  // ensure dir exists?
  let old_path = dir.join(format!("{}.note", old_id));
  let content = fs::read_to_string(&old_path)?; // will error if not exist
  // parse
  let parts: Vec<&str> = content.splitn(4, SEP).collect();
  if parts.len() != 4 { return Err(...)? } but maybe just proceed.
  let pinned_flag = parts[2];
  let body = parts[3];
  // Build new content
  let new_content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, pinned
_flag, SEP, body);
  let new_path = dir.join(format!("{}.note", new_id));
  // If new_id same as old_id, just overwrite? Probably delete old first? Simpler
: write new then remove old.
  // But we must ensure no trace under old id left on disk. If new_id == old_id, we
 should keep file but update title. The spec says change id to new_id, maybe they
 can be same? Probably assume different.
  // Write new file, then remove old file.
  fs::write(&new_path, new_content)?;
  if old_path != new_path {
      fs::remove_file(old_path)?;
  }
  Ok(())
}

