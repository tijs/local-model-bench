+use notekeep::store::{save, load_all, rename};
+use notekeep::new_note;
+use std::fs;
+use std::path::Path;
+
+#[test]
+fn rename_changes_id_and_title_preserves_body_tags_pinned() {
+    let dir = tempfile::tempdir().unwrap();
+    let note = new_note("oldid", "Old Title", "Body with #tag1 and #tag2");
+    let mut note = note;
+    note.pinned = true;
+    save(dir.path(), &note).unwrap();
+
+    let notes = load_all(dir.path()).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "oldid");
+
+    rename(dir.path(), "oldid", "newid", "New Title").unwrap();
+
+    assert!(!dir.path().join("oldid.note").exists());
+    assert!(dir.path().join("newid.note").exists());
+
+    let notes = load_all(dir.path()).unwrap();
+    assert_eq!(notes.len(), 1);
+    let n = &notes[0];
+    assert_eq!(n.id, "newid");
+    assert_eq!(n.title, "New Title");
+    assert!(n.pinned);
+    assert_eq!(n.body, "Body with #tag1 and #tag2");
+    assert_eq!(n.tags, vec!["tag1", "tag2"]);
+}
+
+#[test]
+fn rename_same_id_updates_title_only() {
+    let dir = tempfile::tempdir().unwrap();
+    let note = new_note("sameid", "Old Title", "Body");
+    save(dir.path(), &note).unwrap();
+
+    rename(dir.path(), "sameid", "sameid", "New Title").unwrap();
+
+    let notes = load_all(dir.path()).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "sameid");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "Body");
+}
