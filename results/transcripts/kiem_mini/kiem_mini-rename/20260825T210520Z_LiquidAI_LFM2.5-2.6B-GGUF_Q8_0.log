**Function Added:**
```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
    let dir = dir.as_path();
    if !dir.exists() {
        return Err(std::io::Error::new(Errcode::NotFound, "Directory does not exist"));
    }

    for entry in fs::read_dir(dir)? {
        let entry = entry?;
        let content = fs::read_to_string(entry.path())?;
        let parts: Vec<&str> = content.splitn(4, SEP).collect();
        if parts.len() == 4 && parts[0] == old_id {
            // Found the note - rename it
            let pinned_flag = if entry.id.to_string() == old_id { "1" } else { "0" };
            let mut new_content = format!(
                "{}{}{}{}{}{}",
                new_id, SEP, new_title, SEP, parts[2], SEP, parts[3]
            );
            fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
            // Delete the old file
            fs::remove_file(entry.path())?;
            return Ok(());
        }
    }

    Err(std::io::Error::new(Errcode::NotFound, "Note with id '{}' not found".format(old_id)))
}
```

**Key behavior:**
- Takes a directory path and four string arguments: `old_id`, `new_id`, `new_title`
- Finds the note by scanning `.note` files in the directory (same parsing logic as `load_all`)
- Renames the note by creating a new `{new_id}.note` file with updated title
- Deletes the original `{old_id}.note` file completely (no trace remains)
- Returns `Ok(())` on success, or an error if the directory or note is not found

