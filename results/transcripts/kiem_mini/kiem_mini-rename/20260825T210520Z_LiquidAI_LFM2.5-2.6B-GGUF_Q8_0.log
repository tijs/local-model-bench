pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    // Find the note with old_id in the directory
    let dir = dir.as_path();
    if !dir.exists() {
        return Err(std::io::Error::new(Errcode::NotFound, "Directory does not exist
"));
    }
    
    for entry in fs::read_dir(dir)? {
        let entry = entry?;
        let content = fs::read_to_string(entry.path())?;
        let parts: Vec<&str> = content.splitn(4, SEP).collect();
        if parts.len() == 4 && parts[0] == old_id {
            // Found the note - rename it
            let mut new_content = format!(
                "{}{}{}{}{}{}",
                new_id, SEP, new_title, SEP, pinned_flag, SEP, parts[3]
            );
            fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
            // Delete the old file
            fs::remove_file(entry.path())?;
            return Ok(());
        }
    }
    
    Err(std::io::Error::new(Errcode::NotFound, "Note with id '{}' not found".format
(old_id)))
}
```

