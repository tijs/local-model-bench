+use std::fs;
+use std::path::Path;
+
+fn main() {
+    // Create a temporary directory for testing under the project root
+    let temp_dir = Path::new("/tmp/test_rename_verify");
+    std::fs::create_dir_all(temp_dir).expect("Failed to create temp dir");
+    
+    println!("Test directory: {}", temp_dir);
+    
+    // Step 1: Create an old note (id="old_note_1")
+    let old_id = "old_note_1";
+    let new_id = "new_note_1";
+    let new_title = "Renamed Note";
+    
+    // Write the original note content
+    let content = format!("Original title content\n\nThis is the body of the old note.", new_title);
+    fs::write(temp_dir.join(format!("{}.note", old_id)), content).expect("Failed to write old note");
+    println!("Created old note: {}", old_id);
+    
+    // Step 2: Call rename
+    let dir = temp_dir;
+    match store::rename(dir, old_id, new_id, new_title) {
+        Ok(_) => println!("Rename succeeded"),
+        Err(e) => {
+            eprintln!("Rename failed: {}", e);
+            std::process::exit(1);
+        }
+    }
+    
+    // Step 3: Load all notes
+    let notes = store::load_all(dir).expect("Failed to load notes");
+    println!("Number of notes after rename: {}", notes.len());
+    
+    if notes.len() != 1 {
+        eprintln!("FAIL: Expected exactly 1 note, got {}", notes.len());
+        std::process::exit(1);
+    }
+    
+    let only_note = &notes[0];
+    println!("Note ID: {}", only_note.id);
+    println!("Note title: {}", only_note.title);
+    
+    if *only_note.id != new_id {
+        eprintln!("FAIL: Expected id '{}', got '{}'", new_id, *only_note.id);
+        std::process::exit(1);
+    }
+    
+    if *only_note.title != new_title {
+        eprintln!("FAIL: Expected title '{}', got '{}'", new_title, *only_note.title);
+        std::process::exit(1);
+    }
+    
+    println!("SUCCESS: Rename function works correctly!");
+    
+    // Cleanup
+    fs::remove_dir(temp_dir).expect("Failed to remove temp dir");
+}
