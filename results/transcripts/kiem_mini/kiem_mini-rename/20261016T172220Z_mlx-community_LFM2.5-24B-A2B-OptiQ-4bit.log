```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
    if !dir.exists() {
        return Ok(());
    }
    let mut found = false;
    for entry in fs::read_dir(dir)? {
        let entry = entry?;
        let content = fs::read_to_string(entry.path())?;
        let parts: Vec<&str> = content.splitn(4, SEP).collect();
        if parts.len() == 4 {
            let tags = crate::extract_tags(parts[3]);
            if parts[0] == old_id {
                let content = format!(
                    "{}{}{}{}{}{}{}",
                    new_id, SEP, new_title, SEP, if parts[2] == "1" { "1" } else { "0" }, SEP, parts[3]
                );
                fs::write(dir.join(format!("{}.note", new_id)), content)?;
                let old_path = entry.path();
                fs::remove_file(old_path)?;
                found = true;
            }
        }
    }
    if !found {
        return Ok(());
    }
    Ok(())
}
```

**Behavior:**
- Reads all `.note` files in the given directory
- Finds the note with `old_id`, rewrites it with `new_id` and `new_title`
- Preserves the body, tags (via `extract_tags`), and pinned state
- Deletes the old note file from disk so no trace remains
- Returns `Ok(())` on success, or `Ok(())` if the note wasn't found (no error)

