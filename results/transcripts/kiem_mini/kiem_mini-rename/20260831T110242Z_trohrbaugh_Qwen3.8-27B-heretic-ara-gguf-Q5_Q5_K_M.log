+#[test]
+fn rename_changes_id_and_title_keeps_everything_else() {
+    let dir = temp_dir("rename_ok");
+    let note = new_note("note-1", "Old title", "body text #tagged");
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "note-1", "note-2", "New title").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    let n = &notes[0];
+    assert_eq!(n.id, "note-2");
+    assert_eq!(n.title, "New title");
+    assert_eq!(n.body, "body text #tagged");
+    assert_eq!(n.tags, vec!["tagged"]);
+    assert!(!n.pinned);
+
+    // No trace under the old id on disk.
+    assert!(!dir.join("note-1.note").exists());
+    let on_disk: Vec<_> = fs::read_dir(&dir).unwrap().map(|e| e.unwrap().path()).collect();
+    assert_eq!(on_disk, vec![dir.join("note-2.note")]);
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn rename_preserves_pinned_state() {
+    let dir = temp_dir("rename_pinned");
+    let mut note = new_note("a", "t1", "body");
+    note.pinned = true;
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "a", "b", "t2").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert!(notes[0].pinned);
+    assert_eq!(notes[0].id, "b");
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
