+use notekeep::store::{load_all, save, rename};
+use notekeep::Note;
+use std::fs;
+use std::path::PathBuf;
+
+#[test]
+fn rename_changes_id_and_title() {
+    let dir = PathBuf::from("/tmp/notekeep_rename_test");
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+
+    let note = Note {
+        id: "old-id".to_string(),
+        title: "Old Title".to_string(),
+        body: "Some body #tag1".to_string(),
+        tags: vec!["tag1".to_string()],
+        pinned: true,
+    };
+    save(&dir, &note).unwrap();
+
+    // Verify initial state
+    let notes = load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "old-id");
+    assert_eq!(notes[0].title, "Old Title");
+    assert!(notes[0].pinned);
+    assert_eq!(notes[0].body, "Some body #tag1");
+    assert_eq!(notes[0].tags, vec!["tag1"]);
+
+    // Rename
+    rename(&dir, "old-id", "new-id", "New Title").unwrap();
+
+    // Verify old file is gone
+    assert!(!dir.join("old-id.note").exists());
+
+    // Verify new file exists
+    assert!(dir.join("new-id.note").exists());
+
+    // Verify load_all returns the renamed note
+    let notes = load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new-id");
+    assert_eq!(notes[0].title, "New Title");
+    assert!(notes[0].pinned);
+    assert_eq!(notes[0].body, "Some body #tag1");
+    assert_eq!(notes[0].tags, vec!["tag1"]);
+
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn rename_nonexistent_file() {
+    let dir = PathBuf::from("/tmp/notekeep_rename_test2");
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+
+    let result = rename(&dir, "no-such-id", "new-id", "New Title");
+    assert!(result.is_err());
+
+    fs::remove_dir_all(&dir).unwrap();
+}
