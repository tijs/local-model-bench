+use notekeep::store::{load_all, rename};
+use notekeep::new_note;
+use std::fs;
+use std::path::Path;
+use tempfile::tempdir;
+
+#[test]
+fn rename_changes_id_and_title() {
+    let dir = tempdir().unwrap();
+    let path = dir.path();
+
+    // Create a note
+    let note = new_note("old-id", "Old Title", "Some body text");
+    notekeep::save(path, &note).unwrap();
+
+    // Rename the note
+    rename(path, "old-id", "new-id", "New Title").unwrap();
+
+    // Load all notes and verify
+    let notes = load_all(path).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new-id");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "Some body text");
+    assert_eq!(notes[0].tags, Vec::<String>::new());
+    assert_eq!(notes[0].pinned, false);
+}
+
+#[test]
+fn rename_preserves_tags() {
+    let dir = tempdir().unwrap();
+    let path = dir.path();
+
+    // Create a note with tags
+    let note = new_note("old-id", "Old Title", "Body #tag1 #tag2");
+    notekeep::save(path, &note).unwrap();
+
+    // Rename the note
