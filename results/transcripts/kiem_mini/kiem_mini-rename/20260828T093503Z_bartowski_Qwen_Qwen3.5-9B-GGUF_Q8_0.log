+    assert_eq!(notes[0].id, "new-id");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "Body #tag1 #tag2");
+    assert_eq!(notes[0].tags, vec!["tag1", "tag2"]);
+}
