+/// Renames a note's id and title to new values.
+/// The note's body, tags, and pinned state remain unchanged.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // Load all notes to find the one with old_id
+    let notes = load_all(dir)?;
+    
+    // Find the note with old_id
+    let note = notes.iter().find(|n| n.id == old_id).ok_or_else(|| {
+        std::io::Error::new(std::io::ErrorKind::NotFound, "Note not found")
+    })?;
+    
+    // Delete the old file
+    let old_path = dir.join(format!("{}.note", old_id));
+    fs::remove_file(old_path)?;
+    
+    // Create a new note with updated id and title
+    let mut renamed_note = note.clone();
+    renamed_note.id = new_id.to_string();
+    renamed_note.title = new_title.to_string();
+    
+    // Save the note with the new id
+    save(dir, &renamed_note)
+}
