+use notekeep::{new_note, store};
+use std::fs;
+use std::path::Path;
+
+fn temp_dir() -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "notekeep-rename-test-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+#[test]
+fn rename_changes_id_and_title_and_removes_old_file() {
+    let dir = temp_dir();
+    let note = new_note("old-123", "Old Title", "body text #alpha #beta");
+    note.pinned = true;
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "old-123", "new-456", "New Title").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1, "exactly one note must remain");
+    let n = &notes[0];
+    assert_eq!(n.id, "new-456");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, "body text #alpha #beta");
+    assert_eq!(n.tags, vec!["alpha", "beta"]);
+    assert!(n.pinned);
+
+    // No trace of the old id on disk.
+    assert!(!dir.join("old-123.note").exists(), "old file still present");
+    assert!(dir.join("new-456.note").exists(), "new file missing");
+    let names: Vec<String> = fs::read_dir(&dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert!(names.iter().any(|f| f == "new-456.note"));
+    assert_eq!(names.len(), 1);
+    fs::remove_dir_all(&dir).ok();
+}
+
+#[test]
+fn rename_to_same_id_keeps_note() {
+    let dir = temp_dir();
+    let note = new_note("abc", "T1", "body #x");
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "abc", "abc", "T2").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "abc");
+    assert_eq!(notes[0].title, "T2");
+    assert_eq!(notes[0].body, "body #x");
+    fs::remove_dir_all(&dir).ok();
+}
+
+#[test]
+fn rename_missing_note_fails() {
+    let dir = temp_dir();
+    let err = store::rename(&dir, "nope", "new", "T");
+    assert!(err.is_err(), "renaming a nonexistent note must fail");
+    let _ = Path::new(&dir);
+    fs::remove_dir_all(&dir).ok();
+}
