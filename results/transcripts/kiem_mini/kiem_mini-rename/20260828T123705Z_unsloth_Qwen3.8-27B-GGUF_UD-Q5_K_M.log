use notekeep::{new_note, store};
use std::fs;

fn main() {
    // Scenario 1: basic rename
    let dir = std::env::temp_dir().join(format!("hermes-verify-data-{}", std::process
::id()));
    let _ = fs::remove_dir_all(&dir);
    let mut note = new_note("old-123", "Old Title", "body text #alpha #beta");
    note.pinned = true;
    store::save(&dir, &note).expect("save");

    store::rename(&dir, "old-123", "new-456", "New Title").expect("rename");

    let notes = store::load_all(&dir).expect("load");
    assert_eq!(notes.len(), 1);
    assert_eq!(notes[0].id, "new-456");
    assert_eq!(notes[0].title, "New Title");
    assert_eq!(notes[0].body, "body text #alpha #beta");
    assert_eq!(notes[0].tags, vec!["alpha", "beta"]);
    assert!(notes[0].pinned);
    assert!(!dir.join("old-123.note").exists());
    let count = fs::read_dir(&dir).unwrap().count();
    assert_eq!(count, 1);
    println!("PASS: rename changes id/title, preserves body/tags/pinned, old file
 gone");

    // Scenario 2: rename to the same id
    let dir2 = std::env::temp_dir().join(format!("hermes-verify-data2-{}", std::process
::id()));
    let _ = fs::remove_dir_all(&dir2);
    store::save(&dir2, &note).expect("save2"); // note is now new-456
    store::rename(&dir2, "new-456", "new-456", "Renamed In Place").expect("same-id
 rename");
    let notes = store::load_all(&dir2).expect("load2");
    assert_eq!(notes.len(), 1);
    assert_eq!(notes[0].id, "new-456");
    assert_eq!(notes[0].title, "Renamed In Place");
    println!("PASS: same-id rename keeps exactly one note");

    // Scenario 3: non-existent note -> Err
    assert!(store::rename(&dir2, "ghost", "x", "T").is_err());
    println!("PASS: missing note returns Err");

    let _ = fs::remove_dir_all(&dir);
    let _ = fs::remove_dir_all(&dir2);
    println!("ALL VERIFICATION CHECKS PASSED");
}
