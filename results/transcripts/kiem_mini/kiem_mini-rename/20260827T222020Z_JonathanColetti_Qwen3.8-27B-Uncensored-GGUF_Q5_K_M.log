 pub fn load_all(dir: &Path) -> std::io::Result<Vec<Note>> {
+    let mut notes = Vec::new();
+    if !dir.exists() {
+        return Ok(notes);
+    }
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        let content = fs::read_to_string(entry.path())?;
+        let parts: Vec<&str> = content.splitn(4, SEP).collect();
+        if parts.len() == 4 {
+            let tags = crate::extract_tags(parts[3]);
+            notes.push(Note {
+                id: parts[0].to_string(),
+                title: parts[1].to_string(),
+                pinned: parts[2] == "1",
+                body: parts[3].to_string(),
+                tags,
+            });
+        }
+    }
+    Ok(notes)
+}
+
+/// Changes an existing stored note's id to `new_id` and its title to
+/// `new_title`, leaving its body, tags, and pinned state unchanged.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 || parts[0] != old_id {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!("no stored note with id {old_id}"),
+        ));
+    }
+    let content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, parts[2], SEP, parts[3]);
+    let new_path = dir.join(format!("{}.note", new_id));
+    fs::write(&new_path, content)?;
+    fs::remove_file(&old_path)
+}
