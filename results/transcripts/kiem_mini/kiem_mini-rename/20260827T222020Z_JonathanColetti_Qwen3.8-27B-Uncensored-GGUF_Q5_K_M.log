+use notekeep::store;
+use notekeep::Note;
+use std::fs;
+use std::path::Path;
+
+#[test]
+fn rename_updates_id_and_title_keeps_rest() {
+    let dir = std::env::temp_dir().join("notekeep_rename_test");
+    let _ = fs::remove_dir_all(&dir);
+
+    let body = "hello world #rust #tags";
+    let note = Note {
+        id: "old123".into(),
+        title: "Old Title".into(),
+        body: body.into(),
+        tags: notekeep::extract_tags(body),
+        pinned: true,
+    };
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "old123", "new456", "New Title").unwrap();
+
+    // No trace of the old id on disk
+    assert!(!dir.join("old123.note").exists());
+    let names: Vec<String> = fs::read_dir(&dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert_eq!(names, vec!["new456.note".to_string()]);
+
+    // load_all returns exactly one note, with the new id and title, rest unchanged
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    let n = &notes[0];
+    assert_eq!(n.id, "new456");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, body);
+    assert_eq!(n.tags, vec!["rust".to_string(), "tags".to_string()]);
+    assert!(n.pinned);
+
+    let _ = fs::remove_dir_all(&dir);
+}
+
