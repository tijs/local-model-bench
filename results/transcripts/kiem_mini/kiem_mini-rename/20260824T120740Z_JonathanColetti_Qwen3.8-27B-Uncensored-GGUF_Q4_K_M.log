+
+/// Changes a stored note's id to `new_id` and its title to `new_title`,
+/// leaving its body, tags, and pinned state unchanged. After a successful
+/// call, `load_all` returns the note under its new id only.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("malformed note file: {}", old_path.display()),
+        ));
+    }
+    let pinned_flag = parts[2];
+    let body = parts[3];
+    let new_content = format!(
+        "{}{}{}{}{}{}{}",
+        new_id, SEP, new_title, SEP, pinned_flag, SEP, body
+    );
+    let new_path = dir.join(format!("{}.note", new_id));
+    fs::write(&new_path, new_content)?;
+    fs::remove_file(&old_path)
 }
 
 pub fn load_all(dir: &Path) -> std::io::Result<Vec<Note>> {
