+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let new_path = dir.join(format!("{}.note", new_id));
+    
+    if !old_path.exists() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!("Note with id '{}' not found", old_id)
+        ));
+    }
+    
+    // Read the old note content
+    let content = fs::read_to_string(&old_path)?;
+    
+    // Parse the old note to preserve body, tags, and pinned state
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "Invalid note format"
+        ));
+    }
+    
+    let old_title = parts[1].to_string();
+    let pinned_flag = parts[2].to_string();
+    let body = parts[3].to_string();
+    
+    // Create new note with new id and title, preserving other fields
+    let new_note = Note {
+        id: new_id.to_string(),
+        title: new_title.to_string(),
+        pinned: pinned_flag == "1",
+        body,
+        tags: crate::extract_tags(&body),
+    };
+    
+    // Delete old file and create new one
+    fs::remove_file(&old_path)?;
+    save(dir, &new_note)?;
+    
+    Ok(())
+}
