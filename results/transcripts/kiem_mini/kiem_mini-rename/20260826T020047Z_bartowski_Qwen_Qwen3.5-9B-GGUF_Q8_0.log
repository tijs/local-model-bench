+use notekeep::{save, load_all, rename, Note};
+use std::fs;
+use std::path::Path;
+use std::env;
+
+#[test]
+fn test_rename() -> std::io::Result<()> {
+    let dir = env::temp_dir().join("notekeep_rename_test");
+    let _ = fs::remove_dir_all(&dir);
+    
+    // Create a note with original id and title
+    let note = Note {
+        id: "old_id".to_string(),
+        title: "Old Title".to_string(),
+        pinned: false,
+        body: "Some content".to_string(),
+        tags: vec!["tag1".to_string(), "tag2".to_string()],
+    };
+    save(&dir, &note)?;
+    
+    // Verify it exists with old id
+    let notes = load_all(&dir)?;
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "old_id");
+    assert_eq!(notes[0].title, "Old Title");
+    
+    // Rename the note
+    rename(&dir, "old_id", "new_id", "New Title")?;
+    
+    // Verify old id is gone
+    let notes = load_all(&dir)?;
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new_id");
+    assert_eq!(notes[0].title, "New Title");
+    
+    // Verify body, tags, and pinned state are preserved
+    assert_eq!(notes[0].body, "Some content");
+    assert_eq!(notes[0].tags.len(), 2);
+    assert_eq!(notes[0].tags[0], "tag1");
+    assert_eq!(notes[0].tags[1], "tag2");
+    assert!(!notes[0].pinned);
+    
+    // Verify no trace of old id
+    let entries: Vec<_> = fs::read_dir(&dir)?
+        .filter_map(|e| e.ok())
+        .map(|e| e.file_name())
+        .collect();
+    assert!(!entries.iter().any(|e| e.to_string_lossy() == "old_id.note"));
+    assert!(entries.iter().any(|e| e.to_string_lossy() == "new_id.note"));
+    
+    fs::remove_dir_all(&dir)?;
+    Ok(())
+}
+
+#[test]
+fn test_rename_preserves_pinned() -> std::io::Result<()> {
+    let dir = env::temp_dir().join("notekeep_rename_pinned_test");
+    let _ = fs::remove_dir_all(&dir);
+    
+    let note = Note {
+        id: "old_id".to_string(),
+        title: "Old Title".to_string(),
+        pinned: true,
+        body: "Some content".to_string(),
+        tags: vec![],
+    };
+    save(&dir, &note)?;
+    
+    rename(&dir, "old_id", "new_id", "New Title")?;
+    
+    let notes = load_all(&dir)?;
+    assert!(notes[0].pinned);
+    
+    fs::remove_dir_all(&dir)?;
+    Ok(())
+}
+
