+use notekeep::{new_note, store};
+use std::fs;
+use tempfile::tempdir;
+
+#[test]
+fn rename_changes_id_and_title_preserves_body_tags_pinned() {
+    let dir = tempdir().unwrap();
+    let dir_path = dir.path();
+    let note = notekeep::new_note("old123", "Old Title", "Body with #tag and more");
+    // manually pin
+    let mut note = note;
+    note.pinned = true;
+    store::save(dir_path, &note).unwrap();
+
+    // rename
+    store::rename(dir_path, "old123", "new456", "New Title").unwrap();
+
+    // old file should be gone
+    assert!(!dir_path.join("old123.note").exists());
+    assert!(dir_path.join("new456.note").exists());
+
+    let notes = store::load_all(dir_path).unwrap();
+    assert_eq!(notes.len(), 1);
+    let n = &notes[0];
+    assert_eq!(n.id, "new456");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, "Body with #tag and more");
+    assert_eq!(n.pinned, true);
+    assert_eq!(n.tags, vec!["tag"]);
+}
