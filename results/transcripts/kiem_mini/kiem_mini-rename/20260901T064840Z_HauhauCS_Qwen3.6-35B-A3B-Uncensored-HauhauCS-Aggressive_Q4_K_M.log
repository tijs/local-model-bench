+use notekeep::store;
+use std::fs;
+use std::path::Path;
+
+fn tmpdir() -> std::path::PathBuf {
+    let d = std::env::temp_dir().join("hermes-verify-rename");
+    let _ = fs::remove_dir_all(&d);
+    fs::create_dir_all(&d).unwrap();
+    d
+}
+
+#[test]
+fn rename_basic() {
+    let tmpdir = tmpdir();
+    let sep = "\n---\n";
+    let old_id = "note-old";
+    let old_title = "Old Title";
+    let pinned_flag = "0";
+    let body = "Hello #world #rust";
+    let content = format!(
+        "{}{}{}{}{}{}{}",
+        old_id, sep, old_title, sep, pinned_flag, sep, body
+    );
+    let old_path = tmpdir.join(format!("{}.note", old_id));
+    fs::write(&old_path, &content).unwrap();
+
+    // Verify pre-rename state
+    let notes_before = store::load_all(&tmpdir).unwrap();
+    assert_eq!(notes_before.len(), 1);
+    assert_eq!(notes_before[0].id, old_id);
+    assert_eq!(notes_before[0].title, old_title);
+    assert_eq!(notes_before[0].pinned, false);
+    assert_eq!(notes_before[0].body, body);
+    assert_eq!(
+        notes_before[0].tags,
+        vec!["world".to_string(), "rust".to_string()]
+    );
+
+    // Rename
+    let new_id = "note-new";
+    let new_title = "New Title";
+    store::rename(&tmpdir, old_id, new_id, new_title).unwrap();
+
+    // Old file gone
+    assert!(!old_path.exists());
+
+    // Post-rename: exactly one note, new id/title, body/pinned/tags unchanged
+    let notes_after = store::load_all(&tmpdir).unwrap();
+    assert_eq!(notes_after.len(), 1);
+    assert_eq!(notes_after[0].id, new_id);
+    assert_eq!(notes_after[0].title, new_title);
+    assert_eq!(notes_after[0].body, body);
+    assert_eq!(notes_after[0].pinned, false);
+    assert_eq!(
+        notes_after[0].tags,
+        vec!["world".to_string(), "rust".to_string()]
+    );
+
+    // New file exists on disk with correct first fields
+    let new_path = tmpdir.join(format!("{}.note", new_id));
+    assert!(new_path.exists());
+    let new_content = fs::read_to_string(&new_path).unwrap();
+    let new_parts: Vec<&str> = new_content.splitn(4, sep).collect();
+    assert_eq!(new_parts[0], new_id);
+    assert_eq!(new_parts[1], new_title);
+
+    fs::remove_dir_all(&tmpdir).unwrap();
+}
+
