+#[test]
+fn rename_changes_id_and_title_keeps_rest_and_leaves_no_trace() {
+    let dir: &Path = &temp_dir();
+    let mut note = new_note("old-id", "Old Title", "body with #tag #two");
+    note.pinned = true;
+    store::save(dir, &note).unwrap();
+
+    store::rename(dir, "old-id", "new-id", "New Title").unwrap();
+
+    let notes = store::load_all(dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    let n = &notes[0];
+    assert_eq!(n.id, "new-id");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, "body with #tag #two");
+    assert_eq!(n.tags, vec!["tag", "two"]);
+    assert!(n.pinned);
+
+    // No trace of the old id on disk: no old file, and no file whose
+    // content still starts with the old id.
+    assert!(!dir.join("old-id.note").exists());
+    for entry in fs::read_dir(dir).unwrap() {
+        let content = fs::read_to_string(entry.unwrap().path()).unwrap();
+        assert!(!content.starts_with("old-id\n"));
+    }
+    let _ = fs::remove_dir_all(dir);
+}
