pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?; // returns NotFound if not there

    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            format!("note '{}' is not in a valid format", old_id),
        ));
    }
    let content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, parts[2],
 SEP, parts[3]);
    let new_path = dir.join(format!("{}.note", new_id));
    if new_path == old_path {
        fs::write(&old_path, content)
    } else {
        if new_path.exists() {
            return Err(std::io::Error::new(
                std::io::ErrorKind::AlreadyExists,
                format!("note '{}' already exists", new_id),
            ));
        }
        fs::write(&new_path, content)?;
        fs::remove_file(&old_path)?;
    }
}
