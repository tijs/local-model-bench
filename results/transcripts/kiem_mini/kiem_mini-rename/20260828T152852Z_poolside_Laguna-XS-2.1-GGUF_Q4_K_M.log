+use notekeep::{new_note, store};
+use std::fs;
+
+#[test]
+fn rename_note_changes_id_and_title() {
+    let dir = std::env::temp_dir().join("notekeep_rename_test");
+
+    // Clean up from any previous test run
+    let _ = fs::remove_dir_all(&dir);
+    fs::create_dir_all(&dir).unwrap();
+
+    // Create a note with old_id
+    let old_id = "12345";
+    let old_title = "Original Title";
+    let note = new_note(old_id, old_title, "Some body content\nwith #tags\n#test");
+
+    store::save(&dir, &note).unwrap();
+
+    // Verify the note was saved with the correct id in the file
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, old_id);
+    assert_eq!(notes[0].title, old_title);
+
+    // Rename the note
+    let new_id = "67890";
+    let new_title = "New Title";
+    store::rename(&dir, old_id, new_id, new_title).unwrap();
+
+    // Verify load_all returns exactly one note with the new id and title
+    let notes_after = store::load_all(&dir).unwrap();
+    assert_eq!(notes_after.len(), 1);
+    assert_eq!(notes_after[0].id, new_id);
+    assert_eq!(notes_after[0].title, new_title);
+
+    // Verify body and tags are unchanged
+    assert_eq!(notes_after[0].body, "Some body content\nwith #tags\n#test");
+    assert_eq!(notes_after[0].tags, vec!["tags", "test"]);
+
+    // Verify there's no trace of the old file
+    let old_file = dir.join(format!("{}.note", old_id));
+    assert!(!old_file.exists(), "Old note file should not exist");
+
+    // Verify the new file exists
+    let new_file = dir.join(format!("{}.note", new_id));
+    assert!(new_file.exists(), "New note file should exist");
+
+    // Clean up
+    fs::remove_dir_all(&dir).unwrap();
+}
+
