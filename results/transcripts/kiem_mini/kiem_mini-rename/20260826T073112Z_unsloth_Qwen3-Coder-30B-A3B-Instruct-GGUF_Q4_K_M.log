+
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // First, load all notes to find the one we want to rename
+    let notes = load_all(dir)?;
+    
+    // Find the note with the old ID
+    let note_to_rename = notes.iter().find(|note| note.id == old_id).cloned();
+    
+    if let Some(note) = note_to_rename {
+        // Create a new note with updated id and title but same body, tags, and pinned state
+        let mut updated_note = note;
+        updated_note.id = new_id.to_string();
+        updated_note.title = new_title.to_string();
+        
+        // Save the updated note with new ID
+        save(dir, &updated_note)?;
+        
+        // Remove the old file (using the old ID)
+        let old_file_path = dir.join(format!("{}.note", old_id));
+        if old_file_path.exists() {
+            fs::remove_file(old_file_path)?;
+        }
+    }
+    
+    Ok(())
 }
 
