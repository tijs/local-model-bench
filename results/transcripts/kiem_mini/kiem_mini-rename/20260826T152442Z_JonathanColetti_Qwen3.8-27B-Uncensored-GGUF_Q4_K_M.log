+#[test]
+fn rename_updates_id_and_title_preserving_rest() {
+    let dir = PathBuf::from(std::env::temp_dir())
+        .join(format!("notekeep_rename_test_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let mut note = new_note("old-1", "Old title", "some body #tag here");
+    note.pinned = true;
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "old-1", "new-1", "New title").unwrap();
+
+    // Old file is gone, new file exists.
+    assert!(!dir.join("old-1.note").exists());
+    assert!(dir.join("new-1.note").exists());
+
+    // Exactly one note, with new id and title, body/tags/pinned preserved.
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new-1");
+    assert_eq!(notes[0].title, "New title");
+    assert_eq!(notes[0].body, "some body #tag here");
+    assert_eq!(notes[0].tags, vec!["tag".to_string()]);
+    assert!(notes[0].pinned);
+
+    let _ = std::fs::remove_dir_all(&dir);
+}
