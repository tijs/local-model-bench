```rust
/// Change the id of a saved note from `old_id` to `new_id`, and its title to
/// `new_title`. Body, tags, and pinned state are preserved.
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            format!("malformed note file {}", old_path.display()),
        ));
    }
    let pinned_flag = parts[2];
    let body = parts[3];
    let new_content = format!("{new_id}{SEP}{new_title}{SEP}{pinned_flag}{SEP}{body
}");
    let new_path = dir.join(format!("{}.note", new_id));
    fs::write(&new_path, new_content)?;
    if old_path != new_path {
        fs::remove_file(&old_path)?;
    }
    Ok(())
}
```

Note: the SEP comparison in load_all: parts[2] == "1" — the pinned flag is preserved
 exactly. Tags are derived from the body, so no problem.

