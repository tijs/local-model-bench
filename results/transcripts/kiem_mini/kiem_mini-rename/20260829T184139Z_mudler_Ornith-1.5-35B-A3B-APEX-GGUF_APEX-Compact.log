```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;

    // Parse using the same layout as load_all so body/tags/pinned survive verbatim
.
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            "malformed note",
        ));
    }
    let pinned = parts[2];
    let body = parts[3];

    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, pinned, SEP, body
    );

    let new_path = dir.join(format!("{}.note", new_id));
    fs::write(&new_path, new_content)?;

    if old_id != new_id {
        let _ = fs::remove_file(&old_path);
    }

    Ok(())
}
```

