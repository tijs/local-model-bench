pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
  let old_path = dir.join(format!("{}.note", old_id));
  let new_path = dir.join(format!("{}.note", new_id));
  // read old content
  let content = fs::read_to_string(&old_path)?;
  // parse parts
  let parts: Vec<&str> = content.splitn(4, SEP).collect();
  // need at least 4 parts
  // parts[0]=id, parts[1]=title, parts[2]=pinned, parts[3]=body
  // Build new content with new_id, new_title, same pinned, same body
  let pinned_flag = parts[2];
  let body = parts[3];
  let new_content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, pinned
_flag, SEP, body);
  // Write new file, then remove old
  fs::write(&new_path, new_content)?;
  fs::remove_file(&old_path)?;
  Ok(())
}

