+use notekeep::{new_note, store::{save, load_all, rename}};
+use std::fs;
+use tempfile::tempdir;
+
+fn main() {
+    let dir = tempdir().unwrap();
+    let path = dir.path();
+
+    // create note with pinned = true
+    let note = new_note("old123", "Old Title", "Body with #tag");
+    let mut note = note;
+    note.pinned = true;
+    save(path, &note).unwrap();
+
+    // verify file exists
+    assert!(path.join("old123.note").exists());
+
+    // rename
+    rename(path, "old123", "new456", "New Title").unwrap();
+
+    // old file gone, new file exists
+    assert!(!path.join("old123.note").exists(), "old file still exists");
+    assert!(path.join("new456.note").exists(), "new file missing");
+
+    // load_all returns exactly one note with new id/title, same body/pinned
+    let notes = load_all(path).unwrap();
+    assert_eq!(notes.len(), 1, "expected one note");
+    let n = &notes[0];
+    assert_eq!(n.id, "new456");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, "Body with #tag");
+    assert!(n.pinned);
+    assert_eq!(n.tags, vec!["tag"]);
+
+    // rename with same id (only title change)
+    rename(path, "new456", "new456", "Title Again").unwrap();
+    let notes2 = load_all(path).unwrap();
+    assert_eq!(notes2.len(), 1);
+    assert_eq!(notes2[0].title, "Title Again");
+    assert_eq!(notes2[0].id, "new456");
+    assert!(path.join("new456.note").exists());
+
+    println!("ADHOC VERIFY PASS: rename works, no stale duplicate");
+}
