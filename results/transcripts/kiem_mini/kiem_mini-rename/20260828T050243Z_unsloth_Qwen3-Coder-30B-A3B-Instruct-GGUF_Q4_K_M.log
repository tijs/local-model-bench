+use std::fs;
+use std::path::Path;
+use notekeep::{new_note, store};
+
+fn main() {
+    // Create a temporary directory for testing
+    let test_dir = Path::new("test_rename");
+    fs::create_dir_all(test_dir).expect("Failed to create test directory");
+    
+    // Create a test note
+    let note = new_note("test_id_123", "Original Title", "This is the body content with #tag1 and #tag2");
+    store::save(test_dir, &note).expect("Failed to save note");
+    
+    // Verify the note was saved correctly
+    let notes = store::load_all(test_dir).expect("Failed to load notes");
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "test_id_123");
+    assert_eq!(notes[0].title, "Original Title");
+    assert_eq!(notes[0].body, "This is the body content with #tag1 and #tag2");
+    
+    // Test the rename function
+    store::rename(test_dir, "test_id_123", "new_id_456", "New Title").expect("Rename failed");
+    
+    // Verify the note was renamed correctly
+    let notes = store::load_all(test_dir).expect("Failed to load notes after rename");
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new_id_456");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "This is the body content with #tag1 and #tag2");
+    
+    // Verify the old file no longer exists
+    let old_path = test_dir.join("test_id_123.note");
+    assert!(!old_path.exists());
+    
+    // Verify the new file exists
+    let new_path = test_dir.join("new_id_456.note");
+    assert!(new_path.exists());
+    
+    // Clean up
+    fs::remove_dir_all(test_dir).expect("Failed to clean up test directory");
+    
+    println!("All tests passed! The rename function works correctly.");
+}
