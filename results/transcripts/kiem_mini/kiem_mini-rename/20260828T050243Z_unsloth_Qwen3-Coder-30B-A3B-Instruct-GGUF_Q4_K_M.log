+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // Find the file with the old ID
+    let old_path = dir.join(format!("{}.note", old_id));
+    
+    // Check if the old file exists
+    if !old_path.exists() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!("Note with id '{}' not found", old_id)
+        ));
+    }
+    
+    // Read the content of the existing note
+    let content = fs::read_to_string(&old_path)?;
+    
+    // Split the content into parts
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "Invalid note format"
+        ));
+    }
+    
+    // Create the new content with updated ID and title
+    let pinned_flag = parts[2]; // Keep the original pinned flag
+    let body = parts[3]; // Keep the original body
+    let new_content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, pinned_flag, SEP, body);
+    
+    // Write the new file with the new ID
+    let new_path = dir.join(format!("{}.note", new_id));
+    fs::write(&new_path, new_content)?;
+    
+    // Remove the old file
+    fs::remove_file(&old_path)?;
+    
+    Ok(())
+}
