```rust
use crate::Note;
use std::fs;
use std::path::Path;

const SEP: &str = "\n---\n";

pub fn save(dir: &Path, note: &Note) -> std::io::Result<()> {
    fs::create_dir_all(dir)?;
    let pinned_flag = if note.pinned { "1" } else { "0" };
    let content = format!(
        "{}{}{}{}{}{}{}",
        note.id, SEP, note.title, SEP, pinned_flag, SEP, note.body
    );
    fs::write(dir.join(format!("{}.note", note.id)), content)
}

pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Invalid note
 format"));
    }

    let pinned_flag = if parts[2] == "1" { "1" } else { "0" };
    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, pinned_flag, SEP, parts[3]
    );

    fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
    fs::remove_file(old_path)?;
    Ok(())
}
```

