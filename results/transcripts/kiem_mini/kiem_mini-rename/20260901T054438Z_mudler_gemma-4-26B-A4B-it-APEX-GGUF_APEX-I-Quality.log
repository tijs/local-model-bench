```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    if !old_path.exists() {
        return Err(std::io::Error::new(std::io::ErrorKind::NotFound, "Old note not
 found"));
    }

    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Invalid note
 format"));
    }

    // parts[0] is id, parts[1] is title, parts[2] is pinned_flag, parts[3] is body

    let pinned_flag = parts[2];
    let body = parts[3];

    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, pinned_flag, SEP, body
    );

    let new_path = dir.join(format!("{}.note", new_id));
    
    // If new_id is different from old_id, we'll definitely want to remove the old
 one.
    // If we write to new_path first and it's the same as old_path, we don't want
 to delete it.
    if old_id == new_id {
        fs::write(&old_path, new_content)?;
    } else {
        fs::write(&new_path, new_content)?;
        fs::remove_file(&old_path)?;
    }

    Ok(())
}
```

