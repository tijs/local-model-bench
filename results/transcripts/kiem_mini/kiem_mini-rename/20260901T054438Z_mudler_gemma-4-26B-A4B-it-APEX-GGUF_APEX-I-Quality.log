Let's refine the `rename` logic:
```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Invalid note
 format"));
    }

    let mut note = Note {
        id: old_id.to_string(),
        title: parts[1].to_string(),
        pinned: parts[2] == "1",
        body: parts[3].to_string(),
        tags: crate::extract_tags(parts[3]),
    };

    note.id = new_id.to_string();
    note.title = new_title.to_string();

    if old_id == new_id {
        save(dir, &note)?;
    } else {
        save(dir, &note)?;
        fs::remove_file(old_path)?;
    }
    Ok(())
}
```

