```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(
            std::io::ErrorKind::InvalidData,
            format!("note file for '{}' has unexpected format", old_id),
        ));
    }
    let pinned_flag = parts[2];
    let body = parts[3];
    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, pinned_flag, SEP, body
    );
    fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
    fs::remove_file(&old_path)?;
    Ok(())
}
```

**Behavior:** reads the `{old_id}.note` file, parses the 4-field format, writes a new `{new_id}.note` with the new id/title but identical pinned flag and body, then deletes the old file. Returns `InvalidData` if the source file doesn't match the expected format. After calling it, `load_all(dir)` returns one note with the new id and title, and no trace remains under the old id.


