Rust program:

```rust
use std::fs;
use std::path::Path;
use notekeep::{new_note, store};

fn main() {
    let dir = std::env::temp_dir().join(format!("hermes-verify-data-{}", std::process
::id()));
    let _ = fs::remove_dir_all(&dir);

    let mut note = new_note("a-123", "First", "some body #x #y");
    note.pinned = true;
    store::save(&dir, &note).unwrap();
    store::save(&dir, &new_note("b-456", "Other", "another")).unwrap();

    store::rename(&dir, "a-123", "z-789", "Second").unwrap();

    // disk state
    let mut files: Vec<String> = fs::read_dir(&dir).unwrap()
        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
        .collect();
    files.sort();
    assert_eq!(files, vec!["b-456.note".to_string(), "z-789.note".to_string()], "
disk files: {:?}", files);
    assert!(!dir.join("a-123.note").exists(), "old file must be gone");

    // content check
    let content = fs::read_to_string(dir.join("z-789.note")).unwrap();
    assert!(content.starts_with("z-789\n---\nSecond\n---\n1\n---\n"), "content: {:?}",
 content);

    // load_all
    let mut notes = store::load_all(&dir).unwrap();
    notes.sort_by(|a, b| a.id.cmp(&b.id));
    assert_eq!(notes.len(), 2);
    let renamed = notes.iter().find(|n| n.id == "z-789").expect("renamed note missing
");
    assert_eq!(renamed.title, "Second");
    assert_eq!(renamed.body, "some body #x #y");
    assert_eq!(renamed.tags, vec!["x", "y"]);
    assert!(renamed.pinned);
    assert!(!notes.iter().any(|n| n.id == "a-123"), "old id still present in load
_all");

    let _ = fs::remove_dir_all(&dir);
    println!("HERMES-VERIFY-OK: rename ad-hoc verification passed");
}
```

