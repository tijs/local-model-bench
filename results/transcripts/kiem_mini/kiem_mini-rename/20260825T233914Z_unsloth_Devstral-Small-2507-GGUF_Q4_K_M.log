+use notekeep::{new_note, store};
+use std::fs;
+use std::path::PathBuf;
+
+fn data_dir() -> PathBuf {
+    PathBuf::from("test_data/notes")
+}
+
+fn main() {
+    // Create test directory
+    fs::create_dir_all(&data_dir()).unwrap();
+    
+    // Create a test note
+    let note = new_note("test_id", "Test Title", "Test body with #tag1 #tag2");
+    store::save(&data_dir(), &note).unwrap();
+    
+    // Verify it was saved
+    let notes = store::load_all(&data_dir()).unwrap();
+    println!("Before rename: {:?}", notes);
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "test_id");
+    assert_eq!(notes[0].title, "Test Title");
+    
+    // Rename the note
+    store::rename(&data_dir(), "test_id", "new_id", "New Title").unwrap();
+    
+    // Verify the rename worked
+    let notes = store::load_all(&data_dir()).unwrap();
+    println!("After rename: {:?}", notes);
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new_id");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "Test body with #tag1 #tag2");
+    
+    // Clean up
+    fs::remove_dir_all(data_dir().parent().unwrap()).unwrap();
+    
+    println!("All tests passed!");
+}
