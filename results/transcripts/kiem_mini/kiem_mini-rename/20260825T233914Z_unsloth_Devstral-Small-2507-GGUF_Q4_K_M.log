+use std::fs;
+use std::path::Path;
+
+mod store;
+use store::*;
+
+fn main() {
+    // Create a temporary directory for testing
+    let temp_dir = Path::new("test_rename_dir");
+    fs::create_dir_all(temp_dir).unwrap();
+    
+    // Create a test note
+    let note = Note {
+        id: "test_id".to_string(),
+        title: "Test Title".to_string(),
+        body: "Test body with #tag1 #tag2".to_string(),
+        tags: vec!["tag1".to_string(), "tag2".to_string()],
+        pinned: true,
+    };
+    
+    // Save the note
+    save(temp_dir, &note).unwrap();
+    
+    // Verify it was saved
+    let notes = load_all(temp_dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "test_id");
+    assert_eq!(notes[0].title, "Test Title");
+    
+    // Rename the note
+    rename(temp_dir, "test_id", "new_id", "New Title").unwrap();
+    
+    // Verify the rename worked
+    let notes = load_all(temp_dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new_id");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "Test body with #tag1 #tag2");
+    assert_eq!(notes[0].pinned, true);
+    
+    // Clean up
+    fs::remove_dir_all(temp_dir).unwrap();
+    
+    println!("All tests passed!");
+}
