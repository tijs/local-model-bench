+
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // Load all notes to find the one we want to rename
+    let mut notes = load_all(dir)?;
+    
+    // Find the note with the old_id
+    if let Some(note) = notes.iter_mut().find(|n| n.id == old_id) {
+        // Create a new note with the new id and title, but same body, tags, and pinned state
+        let new_note = Note {
+            id: new_id.to_string(),
+            title: new_title.to_string(),
+            body: note.body.clone(),
+            tags: note.tags.clone(),
+            pinned: note.pinned,
+        };
+        
+        // Save the new note
+        save(dir, &new_note)?;
+        
+        // Delete the old note file
+        fs::remove_file(dir.join(format!("{}.note", old_id)))?;
+        
+        Ok(())
+    } else {
+        // Note with old_id not found
+        Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            "Note not found",
+        ))
+    }
 }
 
