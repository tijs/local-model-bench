+use notekeep::store;
+use notekeep::new_note;
+use std::path::PathBuf;
+
+#[test]
+fn rename_changes_id_and_title_preserving_rest() {
+    let dir = PathBuf::from("data/rename_test");
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let note = new_note("old-1", "Old Title", "body text #tag1");
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "old-1", "new-1", "New Title").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1, "exactly one note should remain");
+    assert_eq!(notes[0].id, "new-1");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "body text #tag1");
+    assert_eq!(notes[0].tags, vec!["tag1".to_string()]);
+    assert!(!notes[0].pinned);
+
+    // No trace under the old id.
+    assert!(!dir.join("old-1.note").exists());
+    // New file exists.
+    assert!(dir.join("new-1.note").exists());
+
+    std::fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn rename_keeps_pinned_state() {
+    let dir = PathBuf::from("data/rename_pinned_test");
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let mut note = new_note("p1", "T", "body #x");
+    note.pinned = true;
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "p1", "p2", "T2").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "p2");
+    assert!(notes[0].pinned);
+    assert_eq!(notes[0].body, "body #x");
+
+    std::fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn rename_to_same_id_is_noop_and_keeps_one_file() {
+    let dir = PathBuf::from("data/rename_same_test");
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let note = new_note("s1", "Old", "body");
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "s1", "s1", "New").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "s1");
+    assert_eq!(notes[0].title, "New");
+
+    std::fs::remove_dir_all(&dir).unwrap();
+}
+
+#[test]
+fn rename_missing_old_id_errors() {
+    let dir = PathBuf::from("data/rename_missing_test");
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let result = store::rename(&dir, "nope", "x", "X");
+    assert!(result.is_err());
+
+    std::fs::remove_dir_all(&dir).unwrap();
+}
