```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    let (title, pinned_flag, body) = match parts.as_slice() {
        [_, t, p, b] => (t, p, b),
        _ => {
            return Err(std::io::Error::new(
                std::io::ErrorKind::InvalidData,
                "stored note is malformed",
            ));
        }
    };
    fs::create_dir_all(dir)?;
    let new_content = format!(
        "{}{}{}{}{}{}{}",
        new_id, SEP, new_title, SEP, pinned_flag, SEP, body
    );
    fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
    if old_id != new_id {
        fs::remove_file(&old_path)?;
    }
    Ok(())
}
```

