@@ -0,0 +1,73 @@
+use crate::Note;
+use std::fs;
+use std::path::Path;
+
+const SEP: &str = "\n---\n";
+
+pub fn save(dir: &Path, note: &Note) -> std::io::Result<()> {
+    fs::create_dir_all(dir)?;
+    let pinned_flag = if note.pinned { "1" } else { "0" };
+    let content = format!(
+        "{}{}{}{}{}{}{}",
+        note.id, SEP, note.title, SEP, pinned_flag, SEP, note.body
+    );
+    fs::write(dir.join(format!("{}.note", note.id)), content)
+}
+
+pub fn load_all(dir: &Path) -> std::io::Result<Vec<Note>> {
+    let mut notes = Vec::new();
+    if !dir.exists() {
+        return Ok(notes);
+    }
+    for entry in fs::read_dir(dir)? {
+        let entry = entry?;
+        let content = fs::read_to_string(entry.path())?;
+        let parts: Vec<&str> = content.splitn(4, SEP).collect();
+        if parts.len() == 4 {
+            let tags = crate::extract_tags(parts[3]);
+            notes.push(Note {
+                id: parts[0].to_string(),
+                title: parts[1].to_string(),
+                pinned: parts[2] == "1",
+                body: parts[3].to_string(),
+                tags,
+            });
+        }
+    }
+    Ok(notes)
+}
+
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // Load all notes to find the one with old_id
+    let mut notes = load_all(dir)?;
+    
+    // Find the note with old_id
+    if let Some(note) = notes.iter_mut().find(|n| n.id == old_id) {
+        // Create a new note with the same body, tags, and pinned state
+        // but with new_id and new_title
+        let new_note = Note {
+            id: new_id.to_string(),
+            title: new_title.to_string(),
+            body: note.body.clone(),
+            tags: note.tags.clone(),
+            pinned: note.pinned,
+        };
+        
+        // Save the new note
+        save(dir, &new_note)?;
+        
+        // Delete the old note file
+        let old_path = dir.join(format!("{}.note", old_id));
+        if old_path.exists() {
+            fs::remove_file(old_path)?;
+        }
+        
+        Ok(())
+    } else {
+        // Note with old_id not found
+        Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            "Note with old_id not found",
+        ))
+    }
+}
