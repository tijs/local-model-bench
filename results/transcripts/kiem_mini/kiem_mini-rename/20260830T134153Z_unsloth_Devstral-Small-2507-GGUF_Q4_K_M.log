+use std::path::Path;
+use std::fs;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Note {
+    pub id: String,
+    pub title: String,
+    pub body: String,
+    pub tags: Vec<String>,
+    pub pinned: bool,
+}
+
+const SEP: &str = "\n---\n";
+
+fn extract_tags(text: &str) -> Vec<String> {
+    text.split_whitespace()
+        .filter(|tok| tok.starts_with('#'))
+        .map(|tok| tok.trim_start_matches('#').to_string())
+        .collect()
+}
+
+fn new_note(id: &str, title: &str, body: &str) -> Note {
+    Note {
+        id: id.to_string(),
+        title: title.to_string(),
+        body: body.to_string(),
+        tags: extract_tags(body),
+        pinned: false,
+    }
+}
+
+fn save(dir: &Path, note: &Note) -> std::io::Result<()> {
+    fs::create_dir_all(dir)?;
+    let pinned_flag = if note.pinned { "1" } else { "0" };
+    let content = format!(
+        "{}{}{}{}{}{}{}",
+        note.id, SEP, note.title, SEP, pinned_flag, SEP, note.body
+    );
+    fs::write(dir.join(format!("{}.note", note.id)), content)
