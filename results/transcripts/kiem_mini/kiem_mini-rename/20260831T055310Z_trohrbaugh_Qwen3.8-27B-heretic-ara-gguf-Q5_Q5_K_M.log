+use notekeep::store;
+use notekeep::Note;
+use std::path::PathBuf;
+
+#[test]
+fn rename_changes_id_and_title_keeps_rest() {
+    let dir: PathBuf = std::env::temp_dir().join(format!("notekeep_rename_test_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+
+    let note = Note {
+        id: "abc".to_string(),
+        title: "Old Title".to_string(),
+        body: "hello #world #rust".to_string(),
+        tags: vec!["world".to_string(), "rust".to_string()],
+        pinned: true,
+    };
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "abc", "xyz", "New Title").unwrap();
+
+    // Old file gone, new file present
+    assert!(!dir.join("abc.note").exists());
+    assert!(dir.join("xyz.note").exists());
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "xyz");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "hello #world #rust");
+    assert_eq!(notes[0].tags, vec!["world".to_string(), "rust".to_string()]);
+    assert!(notes[0].pinned);
+
+    let _ = std::fs::remove_dir_all(&dir);
+}
