+use notekeep::store::{load_all, rename, save};
+use notekeep::Note;
+
+fn main() {
+    let dir = std::path::Path::new("/tmp/hermes-verify-rename-dir");
+    let _ = std::fs::remove_dir_all(dir);
+    std::fs::create_dir_all(dir).unwrap();
+
+    let note = Note {
+        id: "old".into(),
+        title: "Old Title".into(),
+        body: "hello #rust #world".into(),
+        tags: vec!["rust".into(), "world".into()],
+        pinned: true,
+    };
+    save(dir, &note).unwrap();
+
+    rename(dir, "old", "new", "New Title").unwrap();
+
+    assert!(
+        !dir.join("old.note").exists(),
+        "old note file should be gone"
+    );
+    assert!(dir.join("new.note").exists(), "new note file should exist");
+
+    let notes = load_all(dir).unwrap();
+    assert_eq!(notes.len(), 1, "load_all must return exactly one note");
+    assert_eq!(notes[0].id, "new");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "hello #rust #world");
+    assert_eq!(
+        notes[0].tags,
+        vec!["rust".to_string(), "world".to_string()]
+    );
+    assert!(notes[0].pinned);
+
+    // rename to same id must not destroy the note.
+    rename(dir, "new", "new", "Still New").unwrap();
+    assert!(dir.join("new.note").exists(), "same-id rename must keep file");
+    assert_eq!(load_all(dir).unwrap()[0].title, "Still New");
+
+    std::fs::remove_dir_all(dir).unwrap();
+    println!("rename verification: PASS");
+}
