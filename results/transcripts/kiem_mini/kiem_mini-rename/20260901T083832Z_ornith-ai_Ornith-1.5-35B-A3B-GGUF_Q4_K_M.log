**Implementation** — `rename` added to `src/store.rs:44`:

```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
    let old_path = dir.join(format!("{}.note", old_id));
    let content = fs::read_to_string(&old_path)?;
    let parts: Vec<&str> = content.splitn(4, SEP).collect();
    if parts.len() != 4 {
        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "malformed note file"));
    }
    let pinned_flag = parts[2];
    let body = parts[3];
    let new_content = format!("{}{}{}{}{}{}{}", new_id, SEP, new_title, SEP, pinned_flag, SEP, body);
    fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
    if old_id != new_id {
        fs::remove_file(&old_path)?;
    }
    Ok(())
}
```

It reuses the crate's own `{id}\n---\n{title}\n---\n{pinned}\n---\n{body}` format and `SEP`, so preserving the body preserves tags (derived on load) and preserving `pinned_flag` preserves the pinned state.

