+use notekeep::store::{load_all, rename, save};
+use notekeep::Note;
+
+#[test]
+fn rename_changes_id_and_title_preserves_rest() {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .unwrap()
+        .join("tmp_rename_check");
+    let _ = std::fs::remove_dir_all(&dir);
+
+    let note = Note {
+        id: "old".to_string(),
+        title: "Old Title".to_string(),
+        body: "hello #rust #world".to_string(),
+        tags: vec!["rust".to_string(), "world".to_string()],
+        pinned: true,
+    };
+    save(&dir, &note).unwrap();
+
+    rename(&dir, "old", "new", "New Title").unwrap();
+
+    // No trace of the old id.
+    assert!(!dir.join("old.note").exists());
+    assert!(dir.join("new.note").exists());
+
+    let notes = load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "hello #rust #world");
+    assert_eq!(notes[0].tags, vec!["rust".to_string(), "world".to_string()]);
+    assert!(notes[0].pinned);
+
+    std::fs::remove_dir_all(&dir).unwrap();
+}
