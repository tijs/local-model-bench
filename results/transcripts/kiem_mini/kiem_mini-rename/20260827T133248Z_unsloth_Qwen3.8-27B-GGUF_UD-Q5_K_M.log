use notekeep::{new_note, store};
use std::fs;
use std::path::Path;

fn main() {
    let base = std::env::args().nth(1).expect("data dir arg");
    let _ = fs::remove_dir_all(&base);
    fs::create_dir_all(&base).unwrap();

    // Two notes: one to rename, one untouched.
    let mut n1 = new_note("id-old", "Old Title", "hello #alpha #beta");
    n1.pinned = true;
    store::save(&base, &n1).unwrap();
    let n2 = new_note("keep", "Stay", "untouched");
    store::save(&base, &n2).unwrap();

    store::rename(&base, "id-old", "id-new", "Brand New").unwrap();

    let notes = store::load_all(&base).unwrap();
    assert_eq!(notes.len(), 2, "expected exactly 2 notes");
    let renamed = notes.iter().find(|n| n.id == "id-new").expect("renamed note missing
");
    assert_eq!(renamed.title, "Brand New");
    assert_eq!(renamed.body, "hello #alpha #beta");
    assert_eq!(renamed.tags, vec!["alpha", "beta"]);
    assert!(renamed.pinned);
    assert!(notes.iter().all(|n| n.id != "id-old"), "old id still present");

    // On-disk state: exactly the expected files.
    let mut files: Vec<String> = fs::read_dir(&base).unwrap()
        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
        .collect();
    files.sort();
    assert_eq!(files, vec!["id-new.note", "keep.note"]);

    // The new file's own content must carry the new id as its first field.
    let content = fs::read_to_string(base.join("id-new.note")).unwrap();
    assert!(content.starts_with("id-new\n---\nBrand New\n---\n1\n---\n"), "first field
 wrong: {:?}", content);

    // Missing note -> Err.
    assert!(store::rename(&base, "ghost", "x", "t").is_err());

    let _ = fs::remove_dir_all(&base);
    println!("HERMES-VERIFY-PASS");
}
```

