+// Ad-hoc verification for notekeep::store::rename (not part of the repo suite).
+use notekeep::new_note;
+use notekeep::store;
+use std::path::Path;
+
+fn main() {
+    let dir = std::env::temp_dir().join(format!("hermes-verify-rename-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    let dir: &Path = &dir;
+
+    // 1. Save a pinned note with tags, then rename it.
+    let mut note = new_note("old-1", "Old Title", "hello #alpha #beta");
+    note.pinned = true;
+    store::save(dir, &note).unwrap();
+    store::rename(dir, "old-1", "new-2", "New Title").unwrap();
+
+    // 2. load_all: exactly one note, new id/title, body/tags/pinned preserved.
+    let notes = store::load_all(dir).unwrap();
+    assert_eq!(notes.len(), 1, "expected exactly one note, got {}", notes.len());
+    assert_eq!(notes[0].id, "new-2");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "hello #alpha #beta");
+    assert_eq!(notes[0].tags, vec!["alpha", "beta"]);
+    assert!(notes[0].pinned, "pinned state must survive rename");
+
+    // 3. No trace of the old id on disk.
+    let files: Vec<String> = std::fs::read_dir(dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert_eq!(files, vec!["new-2.note"], "unexpected files: {:?}", files);
+
+    // 4. Renaming a nonexistent note is an error.
+    assert!(store::rename(dir, "ghost", "x", "t").is_err(), "rename of missing note must err");
+
+    // 5. Renaming to the same id (only title change) works and leaves one file.
+    store::rename(dir, "new-2", "new-2", "Same Id New Title").unwrap();
+    let notes = store::load_all(dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "new-2");
+    assert_eq!(notes[0].title, "Same Id New Title");
+    let files: Vec<String> = std::fs::read_dir(dir)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert_eq!(files, vec!["new-2.note"]);
+
+    // 6. Malformed note file (wrong field count) is rejected.
+    std::fs::write(dir.join("bad.note"), "no-separators-here").unwrap();
+    assert!(store::rename(dir, "bad", "c", "t").is_err(), "malformed file must err");
+    std::fs::remove_file(dir.join("bad.note")).unwrap();
+
+    let _ = std::fs::remove_dir_all(&dir);
+    println!("hermes-verify: all rename checks passed");
+}
