+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    // Load all notes to find the one with old_id
+    let notes = load_all(dir)?;
+    if let Some(mut note_to_rename) = notes.into_iter().find(|n| n.id == old_id) {
+        // Create a new note with the new id and title, but same body, tags, and pinned state
+        let new_note = Note {
+            id: new_id.to_string(),
+            title: new_title.to_string(),
+            body: note_to_rename.body,
+            tags: note_to_rename.tags,
+            pinned: note_to_rename.pinned,
+        };
+        
+        // Save the new note
+        save(dir, &new_note)?;
+        
+        // Delete the old note file
+        let old_file_path = dir.join(format!("{}.note", old_id));
+        if old_file_path.exists() {
+            fs::remove_file(old_file_path)?;
+        }
+        
+        Ok(())
+    } else {
+        // Note with old_id not found
+        Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            "Note with specified old_id not found",
+        ))
+    }
