    assert_eq!(notes[0].title, "New Title");
    assert_eq!(notes[0].body, "body text #tag");
    assert!(notes[0].pinned);
    assert_eq!(notes[0].tags, vec!["tag"]);
    assert!(!dir.join("a.note").exists());
    std::fs::remove_dir_all(&dir).ok();
}
