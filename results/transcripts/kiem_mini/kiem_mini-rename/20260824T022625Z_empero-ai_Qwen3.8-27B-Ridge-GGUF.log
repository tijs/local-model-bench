+/// Renames a stored note: changes its id to `new_id` and its title to
+/// `new_title`, leaving body, tags, and pinned state unchanged. The old
+/// `{old_id}.note` file is removed so no duplicate under the old id
+/// remains on disk. Returns an error if the note was not found.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 || parts[0] != old_id {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!("note not found: {}", old_id),
+        ));
+    }
+    let new_content = format!(
+        "{}{}{}{}{}{}{}",
+        new_id, SEP, new_title, SEP, parts[2], SEP, parts[3]
+    );
+    fs::write(dir.join(format!("{}.note", new_id)), new_content)?;
+    fs::remove_file(&old_path)
+}
