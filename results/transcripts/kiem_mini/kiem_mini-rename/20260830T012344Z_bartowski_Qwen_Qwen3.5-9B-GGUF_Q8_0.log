+/// Renames a note's id and title, preserving body, tags, and pinned state.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let new_path = dir.join(format!("{}.note", new_id));
+
+    if !old_path.exists() {
+        return Err(std::io::Error::new(std::io::ErrorKind::NotFound, "Note not found"));
+    }
+
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "Invalid note format"));
+    }
+
+    let body = parts[3].to_string();
+    let pinned = parts[2] == "1";
+    let tags = crate::extract_tags(&body);
+
+    let new_content = format!(
+        "{}{}{}{}{}{}{}",
+        new_id, SEP, new_title, SEP, pinned, SEP, body
+    );
+
+    fs::create_dir_all(dir)?;
+    fs::write(&new_path, new_content)?;
+    fs::remove_file(old_path)?;
+
+    Ok(())
+}
