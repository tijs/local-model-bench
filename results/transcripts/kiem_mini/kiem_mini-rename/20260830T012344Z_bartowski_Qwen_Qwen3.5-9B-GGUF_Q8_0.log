+use std::fs;
+use std::io::{self, Write};
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() -> io::Result<()> {
+    let tmp_dir = std::env::temp_dir().join("notekeep_rename_test");
+    let _ = fs::remove_dir_all(&tmp_dir);
+    fs::create_dir_all(&tmp_dir)?;
+
+    println!("Test directory: {:?}", tmp_dir);
+
+    // Create a test note
+    let old_id = "abc123";
+    let new_id = "xyz789";
+    let old_title = "Old Title";
+    let new_title = "New Title";
+    let body = "Some body content with #tag1 and #tag2";
+
+    let note = notekeep::new_note(old_id, old_title, body);
+    notekeep::save(&tmp_dir, &note)?;
+
+    println!("Created note with id: {}, title: {}", old_id, old_title);
+
+    // Verify it exists
+    let notes = notekeep::load_all(&tmp_dir)?;
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, old_id);
+    assert_eq!(notes[0].title, old_title);
+    assert_eq!(notes[0].body, body);
+    assert_eq!(notes[0].tags, vec!["tag1".to_string(), "tag2".to_string()]);
+    assert!(!notes[0].pinned);
+    println!("Initial note verified");
+
+    // Rename the note
+    notekeep::rename(&tmp_dir, old_id, new_id, new_title)?;
+    println!("Renamed note from {} to {} with title '{}'", old_id, new_id, new_title);
+
+    // Verify the old file is gone
+    let old_path = tmp_dir.join(format!("{}.note", old_id));
+    assert!(!old_path.exists(), "Old note file should not exist");
+    println!("Old file removed");
+
+    // Verify the new file exists with correct content
+    let new_path = tmp_dir.join(format!("{}.note", new_id));
+    assert!(new_path.exists(), "New note file should exist");
+    println!("New file exists");
+
+    // Load all notes and verify
+    let notes = notekeep::load_all(&tmp_dir)?;
+    assert_eq!(notes.len(), 1, "Should have exactly one note");
+    
+    let note = &notes[0];
+    assert_eq!(note.id, new_id, "ID should be updated");
+    assert_eq!(note.title, new_title, "Title should be updated");
+    assert_eq!(note.body, body, "Body should be unchanged");
+    assert_eq!(note.tags, vec!["tag1".to_string(), "tag2".to_string()], "Tags should be unchanged");
+    assert!(!note.pinned, "Pinned state should be unchanged");
+    println!("Renamed note verified");
+
+    // Cleanup
+    let _ = fs::remove_dir_all(&tmp_dir);
+    println!("Test passed!");
+
+    Ok(())
+}
