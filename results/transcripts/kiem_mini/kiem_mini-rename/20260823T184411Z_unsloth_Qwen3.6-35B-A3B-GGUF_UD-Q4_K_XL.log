+// Ad-hoc verification for store::rename
+use std::fs;
+use std::path::PathBuf;
+use notekeep::{store, new_note};
+
+fn main() {
+    let tmp = PathBuf::from("/tmp/hermes-verify-rename-notes");
+    let _ = fs::remove_dir_all(&tmp);
+    fs::create_dir_all(&tmp).unwrap();
+
+    // 1) Create a note
+    let note = new_note("old-id", "Old Title", "Hello #world #rust");
+    store::save(&tmp, &note).unwrap();
+
+    let before = store::load_all(&tmp).unwrap();
+    assert_eq!(before.len(), 1, "should have exactly 1 note before rename");
+    assert_eq!(before[0].id, "old-id");
+    assert_eq!(before[0].title, "Old Title");
+    assert_eq!(before[0].body, "Hello #world #rust");
+    assert!(!before[0].pinned);
+    assert_eq!(before[0].tags, vec!["world".to_string(), "rust".to_string()]);
+    println!("PASS: note created correctly under old-id");
+
+    // 2) Rename
+    store::rename(&tmp, "old-id", "new-id", "New Title").unwrap();
+
+    // 3) Old file gone
+    assert!(!tmp.join("old-id.note").exists(), "old file should be deleted");
+    println!("PASS: old file deleted");
+
+    // 4) New file exists
+    assert!(tmp.join("new-id.note").exists(), "new file should exist");
+    println!("PASS: new file exists");
+
+    // 5) load_all returns exactly one note with new id/title, unchanged body/tags/pinned
+    let after = store::load_all(&tmp).unwrap();
+    assert_eq!(after.len(), 1, "should have exactly 1 note after rename");
+    assert_eq!(after[0].id, "new-id");
+    assert_eq!(after[0].title, "New Title");
+    assert_eq!(after[0].body, "Hello #world #rust");
+    assert_eq!(after[0].tags, vec!["world".to_string(), "rust".to_string()]);
+    assert!(!after[0].pinned);
+    println!("PASS: load_all returns correct note with new id/title, unchanged body/tags/pinned");
+
+    // 6) Pinned note survives rename
+    let mut pinned = new_note("pinned-old", "Pinned", "pinned body #tag1");
+    pinned.pinned = true;
+    store::save(&tmp, &pinned).unwrap();
+    store::rename(&tmp, "pinned-old", "pinned-new", "Pinned New").unwrap();
+    let final_notes = store::load_all(&tmp).unwrap();
+    assert_eq!(final_notes.len(), 2);
+    let pn = final_notes.iter().find(|n| n.id == "pinned-new").unwrap();
+    assert!(pn.pinned, "pinned should be preserved");
+    assert_eq!(pn.title, "Pinned New");
+    println!("PASS: pinned state preserved through rename");
+
+    // Cleanup
+    let _ = fs::remove_dir_all(&tmp);
+
+    println!("\nALL CHECKS PASSED");
+}
