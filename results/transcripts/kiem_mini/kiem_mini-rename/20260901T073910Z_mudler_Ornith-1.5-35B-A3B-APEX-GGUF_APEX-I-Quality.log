+/// Renames the stored note whose id is `old_id` to `new_id` and updates its
+/// title to `new_title`, leaving the body, tags, and pinned state unchanged.
+///
+/// The note is rewritten under a new filename (`{new_id}.note`) and the old
+/// file (`{old_id}.note`) is removed, so nothing remains under the old id.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let new_path = dir.join(format!("{}.note", new_id));
+
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("malformed note file: {}", old_path.display()),
+        ));
+    }
+
+    let pinned_flag = if parts[2] == "1" { "1" } else { "0" };
+    let new_content = format!(
+        "{}{}{}{}{}{}{}",
+        new_id, SEP, new_title, SEP, pinned_flag, SEP, parts[3]
+    );
+
+    // Write the new file first so a failure mid-operation leaves the old note
+    // intact and loadable.
+    fs::write(&new_path, new_content)?;
+    fs::remove_file(&old_path)?;
+
+    Ok(())
 }
 
