+
+/// Renames the stored note with id `old_id` to `new_id`, updating its title to
+/// `new_title`. The body, tags, and pinned state are left unchanged. After this
+/// call the note is only reachable under `new_id`; nothing remains on disk under
+/// `old_id`.
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    fs::create_dir_all(dir)?;
+    let old_path = dir.join(format!("{old_id}.note"));
+    if !old_path.exists() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::NotFound,
+            format!("no note found for id '{old_id}'"),
+        ));
+    }
+
+    let mut note = load_all(dir)?
+        .into_iter()
+        .find(|n| n.id == old_id)
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::NotFound,
+                format!("no note found for id '{old_id}'"),
+            )
+        })?;
+
+    note.id = new_id.to_string();
+    note.title = new_title.to_string();
+    save(dir, &note)?;
+
+    fs::remove_file(old_path)
 }
 
 pub fn load_all(dir: &Path) -> std::io::Result<Vec<Note>> {
