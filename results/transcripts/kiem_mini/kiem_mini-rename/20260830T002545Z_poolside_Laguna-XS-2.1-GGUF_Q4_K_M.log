@@ -0,0 +1,67 @@
+use notekeep::store;
+use notekeep::Note;
+
+fn main() {
+    let dir = std::env::temp_dir().join("hermes-verify-rename-test");
+    let _ = std::fs::remove_dir_all(&dir);
+    let _ = std::fs::create_dir_all(&dir);
+
+    // Test 1: Basic rename
+    println!("Test 1: Basic rename");
+    let note = Note {
+        id: "old_id".to_string(),
+        title: "Old Title".to_string(),
+        body: "Some body text #tag1 #tag2".to_string(),
+        tags: notekeep::extract_tags("Some body text #tag1 #tag2"),
+        pinned: false,
+    };
+    store::save(&dir, &note).unwrap();
+
+    let notes_before = store::load_all(&dir).unwrap();
+    assert_eq!(notes_before.len(), 1);
+    assert_eq!(notes_before[0].id, "old_id");
+    assert_eq!(notes_before[0].title, "Old Title");
+
+    store::rename(&dir, "old_id", "new_id", "New Title").unwrap();
+
+    let notes_after = store::load_all(&dir).unwrap();
+    assert_eq!(notes_after.len(), 1);
+    assert_eq!(notes_after[0].id, "new_id");
+    assert_eq!(notes_after[0].title, "New Title");
+    assert_eq!(notes_after[0].body, "Some body text #tag1 #tag2");
+    assert_eq!(notes_after[0].tags, vec!["tag1", "tag2"]);
+    assert_eq!(notes_after[0].pinned, false);
+
+    assert!(!dir.join("old_id.note").exists());
+    assert!(dir.join("new_id.note").exists());
+    println!("  PASSED");
+
+    // Test 2: Rename pinned note
+    println!("Test 2: Rename pinned note");
+    let dir2 = dir.join("test2");
+    let _ = std::fs::create_dir_all(&dir2);
+
+    let pinned_note = Note {
+        id: "pinned_id".to_string(),
+        title: "Pinned Note".to_string(),
+        body: "Pinned body #tag".to_string(),
+        tags: notekeep::extract_tags("Pinned body #tag"),
+        pinned: true,
+    };
+    store::save(&dir2, &pinned_note).unwrap();
+
+    let notes_before = store::load_all(&dir2).unwrap();
+    assert!(notes_before[0].pinned);
+
+    store::rename(&dir2, "pinned_id", "new_pinned_id", "Renamed Pinned").unwrap();
+
+    let notes_after = store::load_all(&dir2).unwrap();
+    assert_eq!(notes_after.len(), 1);
+    assert!(notes_after[0].pinned);
+    println!("  PASSED");
+
+    // Cleanup
+    let _ = std::fs::remove_dir_all(&dir);
+
+    println!("All tests passed!");
+}
