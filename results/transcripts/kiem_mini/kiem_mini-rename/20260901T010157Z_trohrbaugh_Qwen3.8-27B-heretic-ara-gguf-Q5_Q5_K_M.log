+use notekeep::{new_note, store};
+use std::path::Path;
+use std::process::Command;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+fn temp_dir() -> String {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let dir = format!("/tmp/notekeep_rename_test_{}", nanos);
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+#[test]
+fn rename_changes_id_and_title_keeps_body_tags_pinned() {
+    let dir = temp_dir();
+    let p = Path::new(&dir);
+    let note = new_note("old-id", "Old Title", "some body text #alpha #beta");
+    note.pinned = true;
+    store::save(p, &note).unwrap();
+
+    store::rename(p, "old-id", "new-id", "New Title").unwrap();
+
+    let notes = store::load_all(p).unwrap();
+    assert_eq!(notes.len(), 1, "expected exactly one note, got {}", notes.len());
+    assert_eq!(notes[0].id, "new-id");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "some body text #alpha #beta");
+    assert_eq!(notes[0].tags, vec!["alpha", "beta"]);
+    assert!(notes[0].pinned);
+    assert!(!p.join("old-id.note").exists(), "old file still on disk");
+    assert!(p.join("new-id.note").exists());
+
+    let _ = Command::new("rm").args(["-rf", &dir]).status();
+}
+
+#[test]
+fn rename_same_id_only_updates_title() {
+    let dir = temp_dir();
+    let p = Path::new(&dir);
+    let note = new_note("same-id", "Old Title", "body here");
+    store::save(p, &note).unwrap();
+
+    store::rename(p, "same-id", "same-id", "Fresh Title").unwrap();
+
+    let notes = store::load_all(p).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "same-id");
+    assert_eq!(notes[0].title, "Fresh Title");
+    assert_eq!(notes[0].body, "body here");
+
+    let _ = Command::new("rm").args(["-rf", &dir]).status();
+}
+
+#[test]
+fn rename_missing_note_is_error() {
+    let dir = temp_dir();
+    let p = Path::new(&dir);
+    std::fs::create_dir_all(p).unwrap();
+    assert!(store::rename(p, "ghost", "other", "T").is_err());
+
+    let _ = Command::new("rm").args(["-rf", &dir]).status();
+}
