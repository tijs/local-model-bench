use notekeep::{new_note, store};

fn main() {
    let dir = std::env::temp_dir().join(format!("hermes-verify-data-{}", std::process
::id()));
    std::fs::create_dir_all(&dir).unwrap();
    let mut note = new_note("old-id", "Old Title", "body text #alpha #beta");
    note.pinned = true;
    store::save(&dir, &note).unwrap();
    store::rename(&dir, "old-id", "new-id", "New Title").unwrap();
    let notes = store::load_all(&dir).unwrap();
    assert_eq!(notes.len(), 1);
    assert_eq!(notes[0].id, "new-id");
    assert_eq!(notes[0].title, "New Title");
    assert_eq!(notes[0].body, "body text #alpha #beta");
    assert_eq!(notes[0].tags, vec!["alpha".to_string(), "beta".to_string()]);
    assert!(notes[0].pinned);
    assert!(!dir.join("old-id.note").exists());
    assert!(dir.join("new-id.note").exists());
    // error when note doesn't exist
    assert!(store::rename(&dir, "ghost", "x", "T").is_err());
    std::fs::remove_dir_all(&dir).unwrap();
    println!("hermes-verify: OK");
}
```

