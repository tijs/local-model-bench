pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    let notes = store::load_all(dir)?;
    
    if let Some(note) = notes.iter().find(|n| n.id == old_id) {
        note.id = new_id.to_string();
        note.title = new_title.to_string();
        
        store::save(dir, &note)?;
    }
    
    Ok(())
}
```

