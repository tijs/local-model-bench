Let me try a different approach - instead of using `store::load_all` and `store::
save`, I'll use direct file operations. This would bypass any module resolution issues
:

```rust
pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io
::Result<()> {
    // Load all notes from the directory by reading files directly
    let mut notes = Vec::new();
    if dir.exists() {
        for entry in fs::read_dir(dir)? {
            let entry = entry?;
            let content = fs::read_to_string(entry.path())?;
            let parts: Vec<&str> = content.splitn(4, SEP).collect();
            if parts.len() == 4 {
                let tags = crate::extract_tags(parts[3]);
                notes.push(Note {
                    id: parts[0].to_string(),
                    title: parts[1].to_string(),
                    pinned: parts[2] == "1",
                    body: parts[3].to_string(),
                    tags,
                });
            }
        }
    }
    
    // Find the note with the old id
    if let Some(note) = notes.iter().find(|n| n.id == old_id) {
        note.id = new_id.to_string();
        note.title = new_title.to_string();
        
        // Save the updated note back to disk
        fs::create_dir_all(dir)?;
        let pinned_flag = if note.pinned { "1" } else { "0" };
        let content = format!(
            "{}{}{}{}{}{}",
            note.id, SEP, note.title, SEP, pinned_flag, SEP, note.body
        );
        fs::write(dir.join(format!("{}.note", note.id)), content)
    }
    
    Ok(())
}
```

