 use notekeep::extract_tags;
+use notekeep::new_note;
+use notekeep::store;
+use std::path::PathBuf;
+
+fn temp_dir(tag: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!(
+        "notekeep-rename-test-{}-{}",
+        tag,
+        std::process::id()
+    ));
+    let _ = std::fs::remove_dir_all(&dir);
+    dir
+}
+
+#[test]
+fn rename_changes_id_and_title_persists_cleanly() {
+    let dir = temp_dir("rename");
+    let note = new_note("old-1", "Old Title", "keep this #tag");
+    note.keep_pinned();
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "old-1", "new-9", "New Title").unwrap();
+
+    let loaded = store::load_all(&dir).unwrap();
+    assert_eq!(loaded.len(), 1);
+    let n = &loaded[0];
+    assert_eq!(n.id, "new-9");
+    assert_eq!(n.title, "New Title");
+    assert_eq!(n.body, "keep this #tag");
+    assert_eq!(n.tags, vec!["tag".to_string()]);
+    assert!(n.pinned);
+    assert!(!dir.join("old-1.note").exists());
+    assert!(dir.join("new-9.note").exists());
+    let _ = std::fs::remove_dir_all(&dir);
+}
 
