+
+pub fn rename(dir: &Path, old_id: &str, new_id: &str, new_title: &str) -> std::io::Result<()> {
+    let old_path = dir.join(format!("{}.note", old_id));
+    let content = fs::read_to_string(&old_path)?;
+    let parts: Vec<&str> = content.splitn(4, SEP).collect();
+    if parts.len() != 4 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("note file {} is malformed", old_path.display()),
+        ));
+    }
+    if parts[0] != old_id {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!(
+                "note file {} does not contain id {}",
+                old_path.display(),
+                old_id
+            ),
+        ));
+    }
+    let mut note = Note {
+        id: new_id.to_string(),
+        title: new_title.to_string(),
+        pinned: parts[2] == "1",
+        body: parts[3].to_string(),
+        tags: crate::extract_tags(parts[3]),
+    };
+    // `save` writes under the note's own id; the id has already been
+    // replaced above, so this creates the file with the new name.
+    save(dir, &note)?;
+    fs::remove_file(&old_path)?;
+    Ok(())
 }
 
