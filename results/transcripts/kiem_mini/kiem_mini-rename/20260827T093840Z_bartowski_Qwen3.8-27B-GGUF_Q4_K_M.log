+fn rename_changes_id_and_title_leaving_rest_untouched() {
+    let dir = std::env::temp_dir().join(format!(
+        "notekeep-rename-test-{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+
+    let mut note = new_note("abc", "Old Title", "line one\n#alpha #beta");
+    note.pinned = true;
+    store::save(&dir, &note).unwrap();
+
+    store::rename(&dir, "abc", "xyz", "New Title").unwrap();
+
+    let notes = store::load_all(&dir).unwrap();
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0].id, "xyz");
+    assert_eq!(notes[0].title, "New Title");
+    assert_eq!(notes[0].body, "line one\n#alpha #beta");
+    assert_eq!(notes[0].tags, vec!["alpha", "beta"]);
+    assert!(notes[0].pinned);
+
+    // No trace under the old id, on disk or in memory.
+    assert!(!dir.join("abc.note").exists());
+    assert!(dir.join("xyz.note").exists());
+    assert!(notes.iter().all(|n| n.id != "abc"));
+
+    let _ = std::fs::remove_dir_all(&dir);
+}
