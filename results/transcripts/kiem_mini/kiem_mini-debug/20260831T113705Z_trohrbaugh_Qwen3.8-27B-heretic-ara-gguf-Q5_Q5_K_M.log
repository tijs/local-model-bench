Implementation:

```swift
import Foundation

/// Extract #tags from the body text of a note in order of appearance.
public func extractTags(from text: String) -> [String] {
    let pattern = "#([A-Za-z0-9_-]+)"
    guard let regex = try? NSRegularExpression(pattern: pattern) else { return []
 }
    let nsText = text as NSString
    let range = NSRange(location: 0, length: nsText.length)
    return regex.matches(in: text, range: range).compactMap { m in
        guard m.range(at: 1).location != NSNotFound,
              let r = Range(m.range(at: 1), in: text) else { return nil }
        return String(text[r])
    }
}
```

