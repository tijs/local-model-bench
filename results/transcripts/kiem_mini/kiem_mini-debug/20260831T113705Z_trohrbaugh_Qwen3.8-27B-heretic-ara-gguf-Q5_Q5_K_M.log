```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var chars = Array(text)
    var i = 0
    while i < chars.count {
        if chars[i] == "#" && (i == 0 || !isTagChar(chars[i - 1])) {
            var j = i + 1
            while j < chars.count && isTagChar(chars[j]) {
                j += 1
            }
            if j > i + 1 {
                tags.append(String(chars[(i + 1)..<j]))
            }
            i = j
        } else {
            i += 1
        }
    }
    return tags
}

private func isTagChar(_ c: Character) -> Bool {
    c.isLetter || c.isNumber || c == "_"
}
```

