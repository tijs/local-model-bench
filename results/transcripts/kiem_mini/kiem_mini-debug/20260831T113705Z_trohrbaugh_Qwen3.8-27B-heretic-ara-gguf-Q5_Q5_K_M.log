```swift
public func extractTags(from text: String) -> [String] {
    let pattern = /#[\w]+/
    var tags: [String] = []
    for match in text.matches(of: pattern) {
        let tag = String(match.output.0.dropFirst())
        if !tag.isEmpty {
            tags.append(tag)
        }
    }
    return tags
}
```

