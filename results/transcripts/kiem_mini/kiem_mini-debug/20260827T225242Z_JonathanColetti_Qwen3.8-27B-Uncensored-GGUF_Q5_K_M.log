```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var i = text.startIndex
    while i < text.endIndex {
        if text[i] != "#" {
            i = text.index(after: i)
            continue
        }
        var nameStart = text.index(after: i)
        var nameEnd = nameStart
        while nameEnd < text.endIndex {
            let c = text[nameEnd]
            if c.isLetter || c.isNumber || c == "-" || c == "_" {
                nameEnd = text.index(after: nameEnd)
            } else {
                break
            }
        }
        if nameEnd > nameStart {
            tags.append(String(text[nameStart..<nameEnd]))
        }
        i = nameEnd > nameStart ? nameEnd : text.index(after: i)
    }
    return tags
}
```

