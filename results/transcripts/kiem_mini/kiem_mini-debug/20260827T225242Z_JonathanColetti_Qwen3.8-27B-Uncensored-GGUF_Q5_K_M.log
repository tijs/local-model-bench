public func extractTags(from text: String) -> [String] {
    let boundary: Set<Character> = [" ", "\t", "\n", "\r", "(", ")", "[", "]", "{
", "}", "<", ">", ",", ".", ";", ":", "!", "?", "\"", "'", "—"]
    var tags: [String] = []
    var i = text.startIndex
    while let hash = text[i...].firstIndex(of: "#") {
        i = hash
        i = text.index(after: i)
        var end = i
        while end < text.endIndex && !boundary.contains(text[end]) {
            end = text.index(after: end)
        }
        if end > i {
            tags.append(String(text[i..<end]))
        }
        i = end
    }
    return tags
}
```

