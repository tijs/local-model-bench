 import Foundation
 
 /// Extracts #tags from a note's body text, in the order they appear.
+/// A tag is a `#` followed by one or more letters, digits, underscores, or
+/// hyphens, so tags adjacent to punctuation (e.g. "list,#urgent." or
+/// "(#ideas)") are still recognized.
 public func extractTags(from text: String) -> [String] {
-    return text.split(separator: " ")
-        .filter { $0.hasPrefix("#") }
-        .map { String($0.dropFirst()) }
+    let pattern = "#([\\p{L}\\p{N}_-]+)"
+    guard let regex = try? NSRegularExpression(pattern: pattern) else { return [] }
+    let nsText = text as NSString
+    let matches = regex.matches(in: text, range: NSRange(location: 0, length: nsText.length))
+    return matches.compactMap { match in
+        guard let range = Range(match.range(at: 1), in: text) else { return nil }
+        return String(text[range])
+    }
 }
 
