+import Foundation
+
+/// Extracts #tags from a note's body text, in the order they appear.
+/// Tags can appear anywhere in the text, not just after spaces.
+func extractTags(from text: String) -> [String] {
+    // Use regex to find all #tags, capturing the text after the #
+    let pattern = #"#(\w+)"#
+    let regex = try! NSRegularExpression(pattern: pattern)
+    let nsString = text as NSString
+    let matches = regex.matches(in: text, options: [], range: NSRange(location: 0, length: nsString.length))
+    
+    // Extract the tag names from the matches, preserving order
+    return matches.map { 
+        let range = nsString.range(of: nsString.substring(with: $0.range(at: 1)))
+        return nsString.substring(with: range)
+    }
+}
+
+// Test cases
+let testCases = [
+    ("hello #world #swift", ["world", "swift"]),
+    ("just plain text", []),
+    ("shopping list,#urgent.", ["urgent"]),
+    ("(#ideas)", ["ideas"]),
+    ("Note with #tag1 and #tag2, #tag3 (and #tag4)", ["tag1", "tag2", "tag3", "tag4"])
+]
+
+// Run tests
+for (input, expected) in testCases {
+    let result = extractTags(from: input)
+    let passed = result == expected
+    print("Input: \"\(input)\"")
+    print("Expected: \"\(expected)\"")
+    print("Result: \"\(result)\"")
+    print("Passed: \"\(passed)\"")
+    print()
+}
