public func extractTags(from text: String) -> [String] {
    let options: String.CompareOptions = .regularExpression
    var result: [String] = []
    var searchStart = text.startIndex
    while searchStart < text.endIndex,
          let match = text.range(of: "#[\\w]+", options: options, range: searchStart
..<text.endIndex) {
        result.append(String(match.dropFirst()))
        searchStart = match.upperBound
    }
    return result
}
```

