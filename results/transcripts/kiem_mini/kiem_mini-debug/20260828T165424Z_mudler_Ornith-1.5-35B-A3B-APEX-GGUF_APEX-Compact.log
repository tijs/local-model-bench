public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let tagChars = Set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ01234
56789_")
    let chars = Array(text)
    var i = 0
    while i < chars.count {
        if chars[i] == "#" {
            let start = i + 1
            var j = start
            while j < chars.count && (chars[j].isLetter || chars[j].isNumber || chars
[j] == "_" || chars[j] == "-") {
                j += 1
            }
            if j > start {
                tags.append(String(chars[start..<j]))
            }
            i = j
        } else {
            i += 1
        }
    }
    return tags
}
```

