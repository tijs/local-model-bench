import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    let pattern = "#[\\w]+"
    guard let regex = try? NSRegularExpression(pattern: pattern) else {
        return []
    }
    let range = NSRange(location: 0, length: text.utf16Count)
    let matches = regex.matches(in: text, options: [], range: range)
    return matches.map { match in
        let matchRange = match.range
        // Avoid returning an empty range
        guard matchRange.location != NSNotFound, matchRange.length > 1 else { return
 nil }
        let substring = text[Range(matchRange) ?? Range(0..<0)]
        return String(substring.dropFirst())
    }
    .compactMap { $0 }
}
```

