+import Foundation
+
+// Inline copy of the fixed extractTags for standalone verification
+public func extractTags(from text: String) -> [String] {
+    let tagPattern = "#([a-zA-Z0-9_]+)"
+    let regex = try! NSRegularExpression(pattern: tagPattern)
+    let range = NSRange(text.startIndex..., in: text)
+    return regex.matches(in: text, range: range)
+        .map { match in
+            let tagRange = Range(match.range(at: 1), in: text)!
+            return String(text[tagRange])
+        }
+}
+
+var passed = 0
+var failed = 0
