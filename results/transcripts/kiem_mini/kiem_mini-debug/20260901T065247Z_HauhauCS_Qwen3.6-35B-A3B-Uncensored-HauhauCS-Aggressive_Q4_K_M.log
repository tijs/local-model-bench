+    passed += 1
+} else {
+    print("FAIL: '(#ideas)' -> \(r2) (expected [\"ideas\"])")
+    failed += 1
+}
+
+// Regression: space-separated tags (was working)
+let r3 = extractTags(from: "hello #world #swift")
+if r3 == ["world", "swift"] {
+    print("PASS: 'hello #world #swift' -> \(r3)")
+    passed += 1
+} else {
