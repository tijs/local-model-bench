        for match in matches {
            if let range = Range(match.upperBound, in: text) {
                let tag = String(text[range])
                // Strip trailing punctuation (non-alphanumeric characters)
                var cleanTag = tag
                while !cleanTag.isEmpty && !isLetter(cleanTag.lastIndex) {
                    cleanTag.removeLast()
                }
                tags.append(cleanTag)
            }
        }
    }
    
    return tags
}
