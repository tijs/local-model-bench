```swift
public func extractTags(from text: String) -> [String] {
    // Find all tokens starting with # (non-whitespace after #)
    let tagPattern = "#[^\\s]+"
    let matches = text.range(of: tagPattern)
    
    var tags: [String] = []
    while let match = matches.first {
        let range = match.range
        // Extract the matched string (e.g., "#urgent.")
        let fullTag = String(text[range])
        // Remove leading #
        let tag = fullTag.dropFirst()
        // Strip trailing punctuation (like .,;:!? etc.)
        tag = tag.trimmingCharacters(in: .punctuation)
        tags.append(tag)
    }
    
    return tags
}
```

