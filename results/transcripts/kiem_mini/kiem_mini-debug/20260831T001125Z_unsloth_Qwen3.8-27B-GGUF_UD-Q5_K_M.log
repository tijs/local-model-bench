```swift
import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    // Match a '#' followed by one or more non-whitespace, non-'#' characters,
    // then strip trailing punctuation (e.g. ".") so "list,#urgent." -> "urgent"
    // and "(#ideas)" -> "ideas".
    guard let regex = try? NSRegularExpression(pattern: "#([^\\s#]+)") else {
        return []
    }
    let range = NSRange(text.startIndex..., in: text)
    let matches = regex.matches(in: text, range: range)
    var tags: [String] = []
    for match in matches {
        guard let r = Range(match.range(at: 1), in: text) else { continue }
        var tag = String(text[r])
        // Strip trailing punctuation that is clearly sentence/bracket
        // punctuation, not part of the tag name.
        while let last = tag.last, tagPunctuation.contains(last) {
            tag.removeLast()
        }
        if !tag.isEmpty {
            tags.append(tag)
        }
    }
    return tags
}

private let tagPunctuation: Set<Character> = [
    ".", ",", ";", ":", "!", "?", ")", "]", "}", ")", ")",
    "\"", "'", "“", "”", "‘", "’", ")", "．",
]
