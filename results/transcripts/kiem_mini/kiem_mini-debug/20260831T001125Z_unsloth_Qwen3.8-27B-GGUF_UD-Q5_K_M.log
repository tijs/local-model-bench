```swift
public func extractTags(from text: String) -> [String] {
    let delimiters: Set<Character> = ["(", ")", "[", "]", "{", "}", "<", ">", ",",
 ";", ":", "!", "?", ".", "\""]
    var tags: [String] = []
    var chars = Array(text)
    var i = 0
    while i < chars.count {
        let c = chars[i]
        if c == "#" {
            // Only treat as a tag if at the start, or after whitespace/punctuation
 (i.e. a non-word character)
            let isStart = i == 0
            let prevIsWord = i > 0 && (chars[i-1].isLetter || chars[i-1].isNumber
 || chars[i-1] == "_")
            if isStart || !prevIsWord {
                var j = i + 1
                while j < chars.count {
                    let d = chars[j]
                    if d.isWhitespace || delimiters.contains(d) { break }
                    j += 1
                }
                if j > i + 1 {
                    tags.append(String(chars[(i+1)..<j]))
                    i = j
                    continue
                }
            }
        }
        i += 1
    }
    return tags
}
```

