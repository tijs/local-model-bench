import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    let regex = NSRegularExpression(pattern: "\\b#\\S+")
    let range = NSRange(location: 0, option: .regularExpression)
    var matches = regex.matches(in: text, range: range)
    var tags: [String] = []
    
    while let match = regex.lastRange(matchingOccurrences: matches, at: nil) {
        for (1...match.endIndexInText).bound(1) in 0..<text.count {
            if text[matches[0].range(at: $0).location == NSRange(location: 0, option: .regularExpression).destination {
                tags.append(String(text[match.range(at: $0).location...match.locationInText))
            }
        }
    }
    
    return tags
}
```

