 /// Extracts #tags from a note's body text, in the order they appear.
 public func extractTags(from text: String) -> [String] {
-    let regex = try! Regex(#/#([a-zA-Z0-9_]+)/#)
-    let matches = text.matches(of: regex)
-    return matches.map { String($0.output.1) }
+    let pattern = "#([a-zA-Z0-9_]+)"
+    let regex = try! NSRegularExpression(pattern: pattern)
+    let nsString = NSString(string: text)
+    let range = NSRange(location: 0, length: nsString.length)
+    
+    let matches = regex.matches(in: text, options: [], range: range)
+    return matches.map { 
+        // Extract the tag name (first capture group)
+        let match = $0
+        let tagRange = match.range(at: 1)  // Get the first capture group
+        return nsString.substring(with: tagRange)
+    }
 }
 
