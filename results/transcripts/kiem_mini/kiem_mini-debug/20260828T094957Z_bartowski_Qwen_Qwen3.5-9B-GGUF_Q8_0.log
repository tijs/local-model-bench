 punctuation and special symbols.

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var i = 0
    while i < text.count {
        guard text[i] == "#" else { i += 1; continue }
        var end = i + 1
        while end < text.count {
            let c = text[end]
            if c.isAlphanumeric {
                end += 1
            } else if c == "-" || c == "_" {
                end += 1
            } else {
                break
            }
        }
        if end > i + 1 {
            let tag = String(text[i..<end]).dropFirst()
            var cleanTag = tag
            while !cleanTag.isEmpty && !String(cleanTag.last!).isAlphanumeric {
                cleanTag = String(cleanTag.dropLast())
            }
            if !cleanTag.isEmpty {
                tags.append(cleanTag)
            }
        }
        i = end
    }
    return tags
}
```

This approach collects alphanumeric characters and hyphens/underscores in a single
 loop, then strips trailing punctuation from the result.

