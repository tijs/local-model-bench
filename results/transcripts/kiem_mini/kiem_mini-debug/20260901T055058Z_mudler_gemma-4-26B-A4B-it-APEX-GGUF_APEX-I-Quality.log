import Foundation

func extractTags(from text: String) -> [String] {
    let pattern = "#(\\w+)"
    guard let regex = try? NSRegularExpression(pattern: pattern) else { return []
 }
    let range = NSRange(text.startIndex..<text.endIndex, in: text)
    let matches = regex.matches(in: text, options: [], range: range)
    
    return matches.compactMap { match in
        if let tagRange = Range(match.range(at: 1), in: text) {
            return String(text[tagRange])
        }
        return nil
    }
}

func test() {
    let cases: [(String, [String])] = [
        ("hello #world #swift", ["world", "swift"]),
        ("just plain text", []),
        ("shopping list,#urgent.", ["urgent"]),
        ("(#ideas)", ["ideas"]),
        ("#tag1 #tag2", ["tag1", "tag2"]),
        ("no tag here", []),
        ("##double", ["double"]), // \w+ handles this? actually #(\w+) on ##double
 -> match is #double, group 1 is double.
    ]

    for (input, expected) in cases {
        let result = extractTags(from: input)
        if result == expected {
            print("✅ PASS: input=\"\(input)\", expected=\(expected), got=\(result
)")
        } else {
            print("❌ FAIL: input=\"\(input)\", expected=\(expected), got=\(result
)")
            exit(1)
        }
    }
    print("All ad-hoc tests passed!")
}

test()
```

