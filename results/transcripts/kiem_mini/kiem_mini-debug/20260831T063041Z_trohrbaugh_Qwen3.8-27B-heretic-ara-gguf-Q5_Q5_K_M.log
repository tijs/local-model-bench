Let's design the implementation:

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    for token in text.split(separator: " ") {
        guard let hashIndex = token.firstIndex(of: "#") else { continue }
        let before = token[..<hashIndex]
        // # must be at the start of the token or preceded only by punctuation
        guard before.allSatisfy({ !$0.isLetter && !$0.isNumber && $0 != "_" }) else
 { continue }
        var tag = token[token.index(after: hashIndex)...]
        // Strip trailing punctuation
        while let last = tag.last, !last.isLetter && !last.isNumber && last != "_"
 {
            tag = tag.dropLast()
        }
        if !tag.isEmpty {
            tags.append(String(tag))
        }
    }
    return tags
}
```

