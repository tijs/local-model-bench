```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let chars = Array(text)
    var i = 0
    while i < chars.count {
        if chars[i] == "#" {
            var j = i + 1
            while j < chars.count && isValidTagChar(chars[j]) {
                j += 1
            }
            if j > i + 1 {
                tags.append(String(chars[(i + 1)..<j]))
            }
            i = j
        } else {
            i += 1
        }
    }
    return tags
}

private func isValidTagChar(_ c: Character) -> Bool {
    return c.isLetter || c.isNumber || c == "_" || c == "-"
}
```

