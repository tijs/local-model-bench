 import Foundation
 
 /// Extracts #tags from a note's body text, in the order they appear.
+///
+/// A tag is any `#` immediately followed by one or more valid tag
+/// characters (letters, numbers, `_`, or `-`). Because we scan for `#`
+/// directly rather than splitting on whitespace, tags embedded after
+/// non-space characters (e.g. `(#ideas)`, `#urgent.`) are still found,
+/// and trailing punctuation is not included in the tag.
 public func extractTags(from text: String) -> [String] {
-    return text.split(separator: " ")
-        .filter { $0.hasPrefix("#") }
-        .map { String($0.dropFirst()) }
+    let chars = Array(text)
+    var tags: [String] = []
+    var i = 0
+    while i < chars.count {
+        if chars[i] == "#" {
+            var j = i + 1
+            while j < chars.count && Note.isValidTagChar(chars[j]) {
+                j += 1
+            }
+            if j > i + 1 { // at least one valid character followed the `#`
+                tags.append(String(chars[(i + 1)..<j]))
+            }
+            i = j
+        } else {
+            i += 1
+        }
+    }
+    return tags
+}
+
+private extension Note {
+    static func isValidTagChar(_ c: Character) -> Bool {
+        c.isLetter || c.isNumber || c == "_" || c == "-"
+    }
 }
 
