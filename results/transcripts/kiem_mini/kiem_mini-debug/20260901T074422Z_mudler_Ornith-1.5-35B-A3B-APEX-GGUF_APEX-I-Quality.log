Approach: Use a regex or manual scan.

Manual scan:
```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let tagChars = CharacterSet.alphanumerics.union(CharacterSet.underscoredCharacters
)
    var characters = Array(text)
    var i = 0
    while i < characters.count {
        if characters[i] == "#" {
            // ensure preceded by word boundary (start or non-tag char)
            let prevIsTagChar = i > 0 && tagChars.contains(characters[i-1])
            if !prevIsTagChar {
                // collect following tag chars
                var j = i + 1
                var tag = ""
                while j < characters.count && tagChars.contains(characters[j]) {
                    tag.append(characters[j])
                    j += 1
                }
                if !tag.isEmpty {
                    tags.append(tag)
                }
            }
        }
        i += 1
    }
    return tags
}
```

