import Foundation

@main
struct HermesVerify {
    static var failures = 0
    static func check(_ label: String, _ actual: [String], _ expected: [String]) {

        if actual == expected { print("PASS \(label): \(actual)") }
        else { failures += 1; print("FAIL \(label): got \(actual), want \(expected
)") }
    }
    static func main() {
        // Existing tests in NoteKitTests.swift (no regressions)
        check("extractTagsSimple", extractTags(from: "hello #world #swift"), ["world
", "swift"])
        check("extractTagsNoneWhenAbsent", extractTags(from: "just plain text"), [])

        // New tests in NoteKitTests.swift
