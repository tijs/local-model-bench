 list,#urgent."), ["urgent"])
        check("extractTagsTagInsideParentheses", extractTags(from: "(#ideas)"), ["
ideas"])
        check("extractTagsKeepsAppearanceOrder", extractTags(from: "(#ideas) and list
,#urgent. then #done"), ["ideas", "urgent", "done"])
        if failures > 0 { print("RESULT: FAILED (\(failures))"); exit(1) }
        print("RESULT: ALL PASSED")
    }
}
