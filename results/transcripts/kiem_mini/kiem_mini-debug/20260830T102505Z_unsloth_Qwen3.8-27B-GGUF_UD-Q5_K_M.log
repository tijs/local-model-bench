import Foundation

@main
struct HermesVerify {
    static var failures = 0
    static func check(_ label: String, _ actual: [String], _ expected: [String]) {
        if actual == expected { print("PASS \(label): \(actual)") }
        else { failures += 1; print("FAIL \(label): got \(actual), want \(expected)") }
    }
    static func main() {
        // Existing tests in NoteKitTests.swift (no regressions)
        check("extractTagsSimple", extractTags(from: "hello #world #swift"), ["world", "swift"])
        check("extractTagsNoneWhenAbsent", extractTags(from: "just plain text"), [])
        // New tests in NoteKitTests.swift
        check("extractTagsTagAfterCommaAndTrailingPeriod", extractTags(from: "shopping list,#urgent."), ["urgent"])
        check("extractTagsTagInsideParentheses", extractTags(from: "(#ideas)"), ["ideas"])
        check("extractTagsKeepsAppearanceOrder", extractTags(from: "(#ideas) and list,#urgent. then #done"), ["ideas", "urgent", "done"])
        if failures > 0 { print("RESULT: FAILED (\(failures))"); exit(1) }
        print("RESULT: ALL PASSED")
    }
}
