var inTag = false
for ch in text {
    if ch == "#" {
        if inTag && !current.isEmpty { tags.append(String(current)) }
        current = []
        inTag = true
    } else if inTag && (ch.isLetter || ch.isNumber || ch == "_") {
        current.append(ch)
    } else {
        if inTag && !current.isEmpty { tags.append(String(current)) }
        current = []
        inTag = false
    }
}
if inTag && !current.isEmpty { tags.append(String(current)) }
return tags
```

