A simpler manual scan:

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var current: [Character] = []
    for ch in text {
        if ch == "#" {
            if !current.isEmpty { tags.append(String(current)) }
            current = []
        } else if ch.isLetter || ch.isNumber || ch == "_" {
            current.append(ch)
        } else {
            if !current.isEmpty { tags.append(String(current)) }
            current = []
        }
    }
    if !current.isEmpty { tags.append(String(current)) }
    return tags
}
```

