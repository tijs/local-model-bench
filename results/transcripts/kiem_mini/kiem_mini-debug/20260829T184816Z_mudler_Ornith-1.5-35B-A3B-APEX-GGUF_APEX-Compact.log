Let me write the implementation:

```swift
public func extractTags(from text: String) -> [String] {
    let tagCharacters = Set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
0123456789_/-")
    var tags: [String] = []
    let chars = Array(text)
    let n = chars.count
    var i = 0
    while i < n {
        if chars[i] == "#" {
            var j = i + 1
            while j < n && tagCharacters.contains(chars[j]) {
                j += 1
            }
            if j > i + 1 {
                tags.append(String(chars[(i + 1)..<j]))
            }
            i = j
        } else {
            i += 1
        }
    }
    return tags
}
```

This preserves order, handles both examples, and won't regress existing behavior.


