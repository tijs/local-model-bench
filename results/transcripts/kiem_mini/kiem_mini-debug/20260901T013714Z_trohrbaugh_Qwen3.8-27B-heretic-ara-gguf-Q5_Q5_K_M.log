+expectEq(extractTags(from: "#"), [], "lone hash yields nothing")
+expectEq(extractTags(from: "(#a)(#b)"), ["a", "b"], "adjacent parenthesized tags")
+expectEq(extractTags(from: "see #a, #b and (#c)."), ["a", "b", "c"], "mixed punctuation order")
