/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    return TextUtilities.extractTags(from: text)
}

private extension TextUtilities {
    public static func extractTags(from text: String) -> [String] {
        let patterns = [
