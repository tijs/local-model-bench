A cleaner approach with indices:

public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var searchStart = text.startIndex
    while searchStart < text.endIndex,
          let hashIndex = text[searchStart...].firstIndex(of: "#") {
        var end = text.index(after: hashIndex)
        // The tag extends up to the next whitespace
        while end < text.endIndex && !text[end].isWhitespace {
            end = text.index(after: end)
        }
        // Trim non-word characters from the ends
        var start = text.index(after: hashIndex)
        while start < end, !(text[start].isLetter || text[start].isNumber) {
            start = text.index(after, start)
        }
        while end > start, !(text[end - 1].isLetter || text[end - 1].isNumber) {
            end = text.index(before, end)
        }
        if start < end {
            tags.append(String(text[start..<end]))
            searchStart = end
        } else {
            searchStart = text.index(after, hashIndex)
        }
    }
    return tags
}

