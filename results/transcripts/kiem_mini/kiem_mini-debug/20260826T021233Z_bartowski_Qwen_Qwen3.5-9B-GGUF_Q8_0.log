Found the bug. The current implementation splits by spaces first, so:
- `"shopping list,#urgent."` becomes `["shopping", "list,#urgent."]` - the tag is
 attached to the previous word because there's no space before `#urgent`
- `"(#ideas)"` becomes `["(#ideas)"]` - the parentheses are included and there's no
 space before or after

The fix needs to:
1. Split by whitespace to get tokens
2. For each token, look for `#` anywhere in the token (not just at the start after
 split)
3. Extract the tag properly (from `#` to either end of token, or to a closing parenthesis
 if that's what closes it)

Let me write a better implementation:

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var i = 0
    while i < text.count {
        if text[i] == "#" {
            var tagStart = i
            var i = i + 1
            
            // Skip any whitespace after #
            while i < text.count && text[i].isWhitespace {
                i += 1
            }
            
            // Start of actual tag text
            var tagStart = i
            
            // Find end of tag (either end of string, whitespace, or closing paren
)
            while i < text.count && text[i] != ")" && !text[i].isWhitespace {
                i += 1
            }
            
            // If we hit a closing paren, the tag is everything from tagStart to before
 the paren
            if i < text.count && text[i] == ")" {
                let tag = String(text[tagStart..<i])
                if !tag.isEmpty {
                    tags.append(tag)
                    i += 1 // skip the )
                }
            } else {
                // Tag ends at whitespace or end of string
                let tag = String(text[tagStart..<i])
                if !tag.isEmpty {
                    tags.append(tag)
                }
            }
        } else {
            i += 1
        }
    }
    return tags
}
```

