+/// Extracts #tags from a note's body text, in the order they appear.
+public func extractTags(from text: String) -> [String] {
+    var tags: [String] = []
+    var i = 0
+    while i < text.count {
+        if text[i] == "#" {
+            var j = i + 1
+            // Skip whitespace immediately after #
+            while j < text.count && text[j].isWhitespace {
+                j += 1
+            }
+            // Start of tag text
+            var tagStart = j
+            // Find end: whitespace, closing paren, or end of string
+            while j < text.count && text[j] != ")" && !text[j].isWhitespace {
+                j += 1
+            }
+            // Extract tag
+            if tagStart < j {
+                let tag = String(text[tagStart..<j])
+                if !tag.isEmpty {
+                    tags.append(tag)
+                }
+            }
+        }
+        i += 1
+    }
+    return tags
+}
