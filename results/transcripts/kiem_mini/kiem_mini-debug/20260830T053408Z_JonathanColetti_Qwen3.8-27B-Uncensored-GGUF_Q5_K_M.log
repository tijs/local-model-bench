Actually, the simplest and most robust approach with no availability concerns is:


```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var current = ""
    var inTag = false
    for ch in text {
        if ch == "#" {
            inTag = true
            current = ""
        } else if inTag && (ch.isLetter || ch.isNumber || ch == "_") {
            current.append(ch)
        } else if inTag && ch == "-" {
            current.append(ch)
        } else if inTag {
            if !current.isEmpty { tags.append(current) }
            inTag = false
            current = ""
        }
    }
    if inTag && !current.isEmpty { tags.append(current) }
    return tags
}
```

