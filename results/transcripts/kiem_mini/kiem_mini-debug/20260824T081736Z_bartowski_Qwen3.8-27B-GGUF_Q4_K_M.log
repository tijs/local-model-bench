            tags.append(current)
            inTag = false
            current = ""
        }
        // If inTag is true and the character isn't a valid tag character (and current
 is empty):
        // the tag is just "#" — a lone hash with nothing after it — should it be
 kept waiting?
    }
    if inTag, !current.isEmpty { tags.append(current) }
    return tags
}
```

