The simplest and most robust approach without using regex literals: manual character
 scanning, or NSRegularExpression. A manual scan is deterministic and doesn't need
 Foundation regex:

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var current: [Character] = []
    var inTag = false
    for ch in text {
        if ch == "#" {
            if inTag && !current.isEmpty { tags.append(String(current)) }
            inTag = true
            current = []
        } else if inTag && (ch.isLetter || ch.isNumber || ch == "-" || ch == "_")
 {
            current.append(ch)
        } else if inTag {
            // end of tag
            if !current.isEmpty { tags.append(String(current)) }
            inTag = false
            current = []
        }
    }
    if inTag && !current.isEmpty { tags.append(String(current)) }
    return tags
}
```

