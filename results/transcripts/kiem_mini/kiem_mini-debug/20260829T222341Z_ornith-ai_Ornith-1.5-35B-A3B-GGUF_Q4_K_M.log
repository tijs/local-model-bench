```swift
import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
///
/// A tag starts with `#` and runs through the following word characters
/// (letters, digits, underscore) or hyphens. Because the `#` may appear
/// anywhere in the text (not only at a space boundary), tags embedded
/// mid-token such as `list,#urgent.` and tags wrapped in punctuation
/// such as `(#ideas)` are both captured, while trailing punctuation is
/// dropped.
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let tagChars: Set<Character> = Set("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
_-")
    var chars = Array(text)
    var i = 0
    while i < chars.count {
        if chars[i] == "#" {
            var j = i + 1
            while j < chars.count && tagChars.contains(chars[j]) {
                j += 1
            }
            if j > i + 1 {
                tags.append(String(chars[(i + 1)..<j]))
            }
            i = j
        } else {
            i += 1
        }
    }
    return tags
}
```

