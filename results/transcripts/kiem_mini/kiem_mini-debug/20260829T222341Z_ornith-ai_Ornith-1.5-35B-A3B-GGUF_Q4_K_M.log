+import Foundation
+@testable import NoteKit
+
+// Test driver: compiles against the real source, runs assertions.
+var failures = 0
+func check(_ got: [String], _ expected: [String], _ label: String) {
+    if got == expected {
+        print("PASS: \(label)")
+    } else {
+        failures += 1
+        print("FAIL: \(label) -> got \(got), expected \(expected)")
+    }
+}
+
+check(extractTags(from: "hello #world #swift"), ["world", "swift"], "simple")
+check(extractTags(from: "just plain text"), [], "none")
+check(extractTags(from: "shopping list,#urgent."), ["urgent"], "comma-embedded")
+check(extractTags(from: "(#ideas)"), ["ideas"], "parenthesized")
+check(extractTags(from: "first #alpha then #beta, and #gamma!"), ["alpha", "beta", "gamma"], "order")
+check(extractTags(from: "#tag1,#tag2;#tag3."), ["tag1", "tag2", "tag3"], "trailing-punct")
+check(extractTags(from: "#single"), ["single"], "bare single")
+check(extractTags(from: "##notag ##"), ["notag"], "leading-hash")
+
+if failures == 0 {
+    print("\nALL TESTS PASSED")
+} else {
+    print("\n\(failures) TEST(S) FAILED")
+    exit(1)
+}
