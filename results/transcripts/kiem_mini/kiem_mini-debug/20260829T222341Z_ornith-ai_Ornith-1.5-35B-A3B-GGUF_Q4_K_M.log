Let me think about the cleanest Swift implementation.

```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let chars = Array(text)
    var i = 0
    while i < chars.count {
        if chars[i] == "#" {
            // ensure preceding char is a boundary (start or non-alphanumeric)
            let precededByBoundary = i == 0 || !chars[i-1].isLetter && !chars[i-1
].isNumber
            if precededByBoundary {
                var j = i + 1
                while j < chars.count && (chars[j].isLetter || chars[j].isNumber)
 {
                    j += 1
                }
                let tag = String(chars[(i+1)..<j])
                if !tag.isEmpty {
                    tags.append(tag)
                }
                i = j
            } else {
                i += 1
            }
        } else {
            i += 1
        }
    }
    return tags
}
