Let me use NSRegularExpression for maximum compatibility and clarity:

```swift
import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
public func extractTags(from text: String) -> [String] {
    let pattern = "#[\\w]+"
    guard let regex = try? NSRegularExpression(pattern: pattern) else {
        return []
    }
    let range = NSRange(text.startIndex..., in: text)
    return regex.matches(in: text, range: range)
        .map { match in
            let matchRange = match.range
            if matchRange.location == NSNotFound { return "" }
            return String(text[Range(matchRange, in: text)!].dropFirst())
        }
}
```

Wait, `match.range` returns the range of the whole match. I drop the first character
