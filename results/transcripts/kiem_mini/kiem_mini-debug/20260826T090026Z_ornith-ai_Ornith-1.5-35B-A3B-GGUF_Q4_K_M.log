            current.append(character)
        } else if inTag {
            // non-tag character ends the tag
            if !current.isEmpty { tags.append(current) }
            current = ""
            inTag = false
        }
    }
    if inTag, !current.isEmpty { tags.append(current) }
    return tags
}
```

