```swift
public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    let scalars = Array(text.unicodeScalars)
    var i = 0
    while i < scalars.count {
        let c = scalars[i]
        if c == "#" {
            // Only count if the preceding character is not a tag-name character (
word boundary).
            let prevIsNameChar = i > 0 && isTagNameChar(scalars[i - 1])
            if !prevIsNameChar {
                var j = i + 1
                while j < scalars.count && isTagNameChar(scalars[j]) {
                    j += 1
                }
                if j > i + 1 {
                    tags.append(String(text[start: j])) // need indices...
                }
            }
        }
        i += 1
    }
    return tags
}
```

