/// Extracts #tags from a note body text, in the order they appear.
///
/// A tag is a `#` followed by one or more name characters (letters, digits,
/// or underscores), where the `#` is at the start of the text or is not
/// immediately preceded by a name character. Surrounding punctuation such
/// as commas or parentheses does not break extraction: e.g. both
/// `"shopping list,#urgent."` and `"(#ideas)"` yield `["urgent"]` /
/// `["ideas"]`.
public func extractTags(from text: String) -> [String] {
    func isNameChar(_ c: Character) -> Bool {
        c.isLetter || c.isNumber || c == "_"
    }

    var tags: [String] = []
    var characters = text.makeIterator()
    var previous: Character?

    while let ch = characters.next() {
        if ch != "#" {
            previous = ch
            continue
        }
        guard previous.map(isNameChar) != true else {
