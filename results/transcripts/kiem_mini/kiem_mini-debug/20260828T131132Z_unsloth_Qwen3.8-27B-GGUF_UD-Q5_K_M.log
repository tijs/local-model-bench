public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var index = text.startIndex
    while let hash = text[index...].firstIndex(of: "#") {
        let prevIsNameChar = hash > text.startIndex && isTagNameChar(text[text.index
(before: hash)])
        if !prevIsNameChar {
            var end = text.index(after: hash)
            while end < text.endIndex, isTagNameChar(text[end]) {
                end = text.index(after: end)
            }
            if end != text.index(after: hash) {
                tags.append(String(text[text.index(after: hash)..<end]))
            }
        }
        index = text.index(after: hash)
    }
    return tags
}

private func isTagNameChar(_ c: Character) -> Bool {
    c.isLetter || c.isNumber || c == "_"
}
```

