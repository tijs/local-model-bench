 import Foundation
 
 /// Extracts #tags from a note's body text, in the order they appear.
+///
+/// A tag is a `#` followed by at least one name character (letter, digit,
+/// or underscore), where the `#` is at the start of the text or not
+/// immediately preceded by a name character. Surrounding punctuation
+/// doesn't prevent extraction: both `"shopping list,#urgent."` and
+/// `"(#ideas)"` yield their tag.
 public func extractTags(from text: String) -> [String] {
-    return text.split(separator: " ")
-        .filter { $0.hasPrefix("#") }
-        .map { String($0.dropFirst()) }
+    func isNameChar(_ c: Character) -> Bool {
+        c.isLetter || c.isNumber || c == "_"
+    }
+
+    var tags: [String] = []
+    var characters = text.makeIterator()
+    var previous: Character?
+
+    while let ch = characters.next() {
+        if ch != "#" {
+            previous = ch
+            continue
+        }
+        // A '#' glued to a word (e.g. "foo#bar") is not a tag.
+        if let prev = previous, isNameChar(prev) {
+            previous = ch
+            continue
+        }
+        var name: [Character] = []
+        var next = characters.next()
+        while let c = next, isNameChar(c) {
+            name.append(c)
+            next = characters.next()
+        }
+        if !name.isEmpty {
+            tags.append(String(name))
+        }
+        previous = next
+    }
+    return tags
 }
 
