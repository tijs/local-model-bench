public func extractTags(from text: String) -> [String] {
    var tags: [String] = []
    var i = text.startIndex
    while i < text.endIndex {
        if text[i] == "#" {
            let start = text.index(after: i)
            var j = start
            while j < text.endIndex {
                let c = text[j]
                if c.isLetter || c.isNumber || c == "-" || c == "_" {
                    j = text.index(after: j)
                } else { break }
            }
            if j > start {
                tags.append(String(text[start..<j]))
            }
            i = j
        } else {
            i = text.index(after: i)
        }
    }
    return tags
}
```

