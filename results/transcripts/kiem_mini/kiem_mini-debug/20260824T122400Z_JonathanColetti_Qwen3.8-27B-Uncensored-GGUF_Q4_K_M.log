import Foundation

/// Extracts #tags from a note's body text, in the order they appear.
///
/// A tag is a `#` followed by one or more letters, digits, hyphens, or
/// underscores. It is recognized regardless of any surrounding
/// punctuation (e.g. `list,#urgent.` or `(#ideas)`), and plain,
/// unadorned tags like `#world` keep working.
public func extractTags(from text: String) -> [String] {
    let pattern = NSRegularExpression(pattern: "#[A-Za-z0-9_-]+")
    let range = text.startIndex..<text.endIndex
    return pattern.matches(in: text, range: range)
        .map { String(text[$0.range]) }
        .map { String($0.dropFirst()) }
}
```

NSRegularExpression.matches returns them in order of appearance. Good.

Note: `range` is an NSRange of the whole string; in Swift you can use `text.start
Index..<text.endIndex`? NSRegularExpression.matches(in:options:range:) takes an NSRange
. In Swift, you can pass NSRange(text.startIndex..<text.endIndex) or use the `NSRange
(text.startIndex..<text.endIndex)` conversion. Actually, there's a convenience: `
pattern.matches(in: text, options: [], range: NSRange(location: 0, length: text.utf
16.count))`. Simpler and more robust. Or, use String's built-in `ranges(of:options
:range:)`? In macOS 13+ / Swift 5.7+, `text.ranges(of: "#[A-Za-z0-9_-]+", options
: .regularExpression)` returns [Range<String.Index>] in order. The host is macOS 
