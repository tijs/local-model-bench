+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    pin(&mut notes, "b");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn pin_only_affects_matching_id() {
+    let mut notes = vec![note("a"), note("b"), note("c")];
+    pin(&mut notes, "b");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    notes[1].pinned = true;
+    unpin(&mut notes, "b");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
