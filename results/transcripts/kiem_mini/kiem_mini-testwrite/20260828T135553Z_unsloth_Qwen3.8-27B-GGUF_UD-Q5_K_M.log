+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn make_notes() -> Vec<Note> {
+    let mut a = new_note("a", "First", "body a");
+    let mut b = new_note("b", "Second", "body b");
+    let mut c = new_note("c", "Third", "body c");
+    a.pinned = false;
+    b.pinned = true;
+    c.pinned = false;
+    vec![a, b, c]
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = make_notes();
+    assert!(!notes[0].pinned);
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned, "note 'a' should be pinned after pin()");
+    assert!(notes[1].pinned, "already-pinned note 'b' stays pinned");
+    assert!(!notes[2].pinned, "note 'c' is unaffected by pinning 'a'");
+}
+
+#[test]
+fn pin_is_idempotent() {
+    let mut notes = make_notes();
+    notes[1].pinned = true;
+
+    pin(&mut notes, "b");
+
+    assert!(notes[1].pinned);
+    assert_eq!(notes, make_notes(), "pinning an already-pinned note must not change anything");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = make_notes();
+    assert!(notes[1].pinned);
+
+    unpin(&mut notes, "b");
+
+    assert!(!notes[1].pinned, "note 'b' should be unpinned after unpin()");
+    assert!(!notes[0].pinned, "note 'a' is unaffected by unpinning 'b'");
+    assert!(!notes[2].pinned, "note 'c' is unaffected by unpinning 'b'");
+}
+
+#[test]
+fn unpin_is_idempotent() {
+    let mut notes = make_notes();
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+    assert_eq!(notes, make_notes(), "unpinning an already-unpinned note must not change anything");
+}
+
+#[test]
+fn pin_missing_id_is_noop() {
+    let mut notes = make_notes();
+    let snapshot = notes.clone();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, snapshot, "pinning a missing id must not mutate the slice");
+}
+
+#[test]
+fn unpin_missing_id_is_noop() {
