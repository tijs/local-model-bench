+use notekeep::{Note, pin, unpin, ordered_pinned_first};
+
+#[test]
+fn test_pin_sets_pinned_flag() {
+    let mut note = Note {
+        id: "test-id".to_string(),
+        title: "Test Note".to_string(),
+        body: "Note body".to_string(),
+        tags: vec![],
+        pinned: false,
+    };
+    pin(&mut [note], "test-id");
+    assert!(note.pinned);
+}
+
+#[test]
+fn test_unpin_clears_pinned_flag() {
+    let mut note = Note {
+        id: "test-id".to_string(),
+        title: "Test Note".to_string(),
+        body: "Note body".to_string(),
+        tags: vec![],
+        pinned: true,
+    };
+    unpin(&mut [note], "test-id");
+    assert!(!note.pinned);
+}
+
