+use notekeep::{ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str, pinned: bool) -> Note {
+    Note {
+        id: id.to_string(),
+        title: format!("title-{id}"),
+        body: String::new(),
+        tags: Vec::new(),
+        pinned,
+    }
+}
+
+fn ids(notes: &[&Note]) -> Vec<&str> {
+    notes.iter().map(|n| n.id.as_str()).collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a", false), note("b", false)];
+    pin(&mut notes, "b");
+    assert!(notes[0].id == "a" && !notes[0].pinned);
+    assert!(notes[1].id == "b" && notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a", true), note("b", true)];
+    unpin(&mut notes, "a");
+    assert!(notes[0].id == "a" && !notes[0].pinned);
+    assert!(notes[1].id == "b" && notes[1].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![note("a", false), note("b", true)];
+    pin(&mut notes, "does-not-exist");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = vec![note("a", true), note("b", false)];
+    unpin(&mut notes, "does-not-exist");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pin_on_empty_slice_is_noop() {
+    let mut notes: Vec<Note> = Vec::new();
+    pin(&mut notes, "anything");
+    unpin(&mut notes, "anything");
+    assert!(notes.is_empty());
+}
+
+#[test]
+fn ordered_pinned_first_puts_pinned_before_unpinned() {
+    let notes = vec![
+        note("a", false),
+        note("b", true),
+        note("c", false),
+        note("d", true),
+    ];
+    let ordered = ids(&ordered_pinned_first(&notes));
+    assert_eq!(ordered, vec!["b", "d", "a", "c"]);
+}
+
+#[test]
+fn ordered_pinned_first_preserves_relative_order_within_groups() {
+    let notes = vec![
+        note("u1", false),
+        note("p1", true),
+        note("u2", false),
+        note("p2", true),
+        note("u3", false),
+        note("p3", true),
+    ];
