+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned, "note b should be pinned after pin()");
+    assert!(!notes[0].pinned, "note a should remain unpinned");
+}
+
+#[test]
+fn pin_leaves_other_notes_untouched() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    notes[0].pinned = true;
+    pin(&mut notes, "b");
+    assert!(notes[0].pinned, "previously pinned note must stay pinned");
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    notes[0].pinned = true;
+    notes[1].pinned = true;
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned, "note a should be unpinned after unpin()");
+    assert!(notes[1].pinned, "note b should remain pinned");
+}
+
+#[test]
