+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![new_note("a", "Note A", "body a")];
+    assert!(!notes[0].pinned);
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn pin_only_affects_matching_note() {
+    let mut notes = vec![
+        new_note("a", "Note A", "body a"),
+        new_note("b", "Note B", "body b"),
+        new_note("c", "Note C", "body c"),
+    ];
+
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "Note A", "body a")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_only_affects_matching_note() {
+    let mut notes = vec![
+        new_note("a", "Note A", "body a"),
+        new_note("b", "Note B", "body b"),
+    ];
+    pin(&mut notes, "a");
+    pin(&mut notes, "b");
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn pin_missing_id_is_noop() {
+    let notes_before: Vec<Note> = vec![
+        new_note("a", "Note A", "body a"),
+        new_note("b", "Note B", "body b"),
+    ];
+    let mut notes = notes_before.clone();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, notes_before);
+}
+
+#[test]
+fn unpin_missing_id_is_noop() {
+    let mut notes = vec![new_note("a", "Note A", "body a")];
+    pin(&mut notes, "a");
+    let before: Vec<Note> = notes.clone();
+
+    unpin(&mut notes, "does-not-exist");
