@@ -0,0 +1,65 @@
+use notekeep::pin;
+use notekeep::unpin;
+use notekeep::ordered_pinned_first;
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "Test 1".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+        Note { id: "2".to_string(), title: "Test 2".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+    ];
+
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "Test 1".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: true },
+        Note { id: "2".to_string(), title: "Test 2".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+    ];
+
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "Test 1".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+    ];
+
+    pin(&mut notes, "999");
+    // The note with id "999" doesn't exist, so nothing should change.
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "Test 1".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: true },
+    ];
+
+    unpin(&mut notes, "999");
+    // The note with id "999" doesn't exist, so nothing should change.
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn ordered_pinned_first_groups_pinned_before_unpinned() {
+    let mut notes = vec![
+        Note { id: "a".to_string(), title: "A (unpinned)".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+        Note { id: "b".to_string(), title: "B (pinned)".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: true },
+        Note { id: "c".to_string(), title: "C (unpinned)".to_string(), body: "body".to_string(), tags: Vec::new(), pinned: false },
+    ];
+
+    ordered_pinned_first(&notes);
+    
+    // Pinned notes should come first, preserving their relative order.
+    // Then unpinned notes, also preserving their relative order.
+    let result = notes.iter().collect::<Vec<_>>();
+    assert_eq!(result[0].id, "b");   // B was pinned first
+    assert_eq!(result[1].id, "c");   // C was unpinned first (among unpinned)
+    assert_eq!(result[2].id, "a");   // A was unpinned second (after C)
+}
