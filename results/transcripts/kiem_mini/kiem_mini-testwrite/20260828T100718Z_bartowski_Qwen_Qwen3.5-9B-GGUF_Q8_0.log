+use crate::lib::{Note, pin, unpin, ordered_pinned_first, new_note};
+
+#[test]
+fn test_pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("id1", "Title 1", "Body 1"),
+        new_note("id2", "Title 2", "Body 2"),
+    ];
+
+    pin(&mut notes, "id1");
+
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn test_unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        new_note("id1", "Title 1", "Body 1"),
+        new_note("id2", "Title 2", "Body 2"),
+    ];
+
+    pin(&mut notes, "id1");
+    unpin(&mut notes, "id1");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn test_pin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        new_note("id1", "Title 1", "Body 1"),
+        new_note("id2", "Title 2", "Body 2"),
+    ];
+
+    pin(&mut notes, "nonexistent");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
