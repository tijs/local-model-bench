+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str) -> Note {
+    new_note(id, id, &format!("body of {id}"))
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    assert!(!notes[1].pinned, "fresh notes start unpinned");
+
+    pin(&mut notes, "b");
+
+    assert!(notes[1].pinned, "pinned note has pinned = true");
+    assert!(!notes[0].pinned, "unmatched note stays unpinned");
+    assert_eq!(notes[1].id, "b");
+    assert_eq!(notes[1].title, "b");
+}
+
+#[test]
+fn pin_is_idempotent_and_does_not_touch_others() {
+    let mut notes = vec![note("a"), note("b"), note("c")];
+    pin(&mut notes, "b");
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+    assert!(!notes[2].pinned);
+    assert_eq!(notes.len(), 3, "pin must not add or remove notes");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    notes[0].pinned = true;
+    notes[1].pinned = true;
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "unpinned note has pinned = false");
+    assert!(notes[1].pinned, "other pinned note stays pinned");
+}
+
+#[test]
+fn unpin_unpinned_note_is_a_noop() {
+    let mut notes = vec![note("a")];
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+    assert_eq!(notes.len(), 1);
+}
+
+#[test]
+fn pin_missing_id_is_harmless_noop() {
+    let mut notes = vec![note("a"), note("b")];
+    let before: Vec<(String, bool)> = notes
+        .iter()
+        .map(|n| (n.id.clone(), n.pinned))
+        .collect();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes.len(), 2, "no note added or removed");
+    let after: Vec<(String, bool)> = notes
+        .iter()
+        .map(|n| (n.id.clone(), n.pinned))
+        .collect();
+    assert_eq!(before, after, "slice unchanged");
+}
+
+#[test]
+fn unpin_missing_id_is_harmless_noop() {
+    let mut notes = vec![note("a")];
+    notes[0].pinned = true;
+
+    unpin(&mut notes, "does-not-exist");
+
+    assert!(notes[0].pinned, "existing note untouched");
