+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn notes() -> Vec<Note> {
+    vec![
+        new_note("a", "A", "body a"),
+        new_note("b", "B", "body b"),
+        new_note("c", "C", "body c"),
+    ]
+}
+
+fn ids<'a>(notes: &'a [Note]) -> Vec<&'a str> {
+    notes.iter().map(|n| n.id.as_str()).collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut ns = notes();
+    assert!(!ns[1].pinned);
+
+    pin(&mut ns, "b");
+
+    assert!(ns[1].pinned);
+    // other notes untouched
+    assert!(!ns[0].pinned);
+    assert!(!ns[2].pinned);
+    // identity and content preserved
+    assert_eq!(ns[1].id, "b");
+    assert_eq!(ns[1].title, "B");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut ns = notes();
+    pin(&mut ns, "a");
+    pin(&mut ns, "c");
+    assert!(ns[0].pinned);
+    assert!(ns[2].pinned);
+
+    unpin(&mut ns, "a");
+
+    assert!(!ns[0].pinned);
+    // other pinned note stays pinned
+    assert!(ns[2].pinned);
+    assert!(!ns[1].pinned);
+    assert_eq!(ns[0].id, "a");
+}
+
+#[test]
+fn unpin_only_affects_matching_id() {
+    let mut ns = notes();
+    pin(&mut ns, "a");
+    pin(&mut ns, "b");
+
+    unpin(&mut ns, "b");
+
+    assert!(ns[0].pinned);
+    assert!(!ns[1].pinned);
+    assert!(!ns[2].pinned);
+}
+
+#[test]
+fn pin_missing_id_is_noop() {
+    let mut ns = notes();
+    pin(&mut ns, "zzz");
+
+    assert!(!ns.iter().any(|n| n.pinned));
+    assert_eq!(ns.len(), 3);
+    assert_eq!(ids(&ns), vec!["a", "b", "c"]);
+}
+
+#[test]
+fn unpin_missing_id_is_noop() {
+    let mut ns = notes();
+    pin(&mut ns, "b");
+    unpin(&mut ns, "zzz");
+
+    assert!(ns[1].pinned);
+    assert!(!ns[0].pinned);
