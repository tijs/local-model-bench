+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+/// Helper: create notes with known ids and pinned states.
+fn make_notes() -> Vec<Note> {
+    vec![
+        new_note("a", "A", ""),
+        new_note("b", "B", ""),
+        new_note("c", "C", ""),
+    ]
+}
+
+// ---------------------------------------------------------------------------
+// pin()
+// ---------------------------------------------------------------------------
+
+#[test]
+fn pin_sets_pinned_flag_to_true() {
+    let mut notes = make_notes();
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned);
+    assert!(!notes[0].pinned);
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn pin_on_empty_slice_is_harmless() {
+    let mut notes: Vec<Note> = vec![];
+    pin(&mut notes, "nonexistent");
+    assert!(notes.is_empty());
+}
+
+#[test]
+fn pin_by_missing_id_is_noop() {
+    let mut notes = make_notes();
+    pin(&mut notes, "z");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+    assert!(!notes[2].pinned);
+}
+
