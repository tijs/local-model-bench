+use notekeep::{pin, unpin, ordered_pinned_first, new_note, Note};
+
+#[test]
+fn pinning_a_note_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("1", "First", "Note one"),
+        new_note("2", "Second", "Note two"),
+    ];
+    
+    assert!(!notes[0].pinned);
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpinning_a_note_clears_pinned_flag() {
+    let mut notes = vec![
+        new_note("1", "First", "Note one"),
+        new_note("2", "Second", "Note two"),
+    ];
+    
+    // First pin it
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+    
+    // Then unpin it
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pinning_nonexistent_id_is_harmless_noop() {
+    let mut notes = vec![
+        new_note("1", "First", "Note one"),
+        new_note("2", "Second", "Note two"),
+    ];
+    
+    let original_states = notes.iter().map(|n| n.pinned).collect::<Vec<_>>();
+    
+    // Try to pin a note that doesn't exist
+    pin(&mut notes, "nonexistent");
+    
+    // Verify all notes retain their original pinned state
+    let new_states = notes.iter().map(|n| n.pinned).collect::<Vec<_>>();
+    assert_eq!(original_states, new_states);
+}
+
+#[test]
+fn unpinning_nonexistent_id_is_harmless_noop() {
+    let mut notes = vec![
+        new_note("1", "First", "Note one"),
+        new_note("2", "Second", "Note two"),
+    ];
+    
+    // Pin the first note
+    pin(&mut notes, "1");
+    let pinned_states = notes.iter().map(|n| n.pinned).collect::<Vec<_>>();
+    
+    // Try to unpin a note that doesn't exist
+    unpin(&mut notes, "nonexistent");
+    
+    // Verify all notes retain their state
+    let new_states = notes.iter().map(|n| n.pinned).collect::<Vec<_>>();
+    assert_eq!(pinned_states, new_states);
+}
