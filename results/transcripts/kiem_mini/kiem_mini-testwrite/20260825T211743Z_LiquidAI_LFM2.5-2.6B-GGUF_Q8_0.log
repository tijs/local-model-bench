+use crate::Note;
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        Note { id: "a", title: "Test 1", body: "body1", pinned: false },
+        Note { id: "b", title: "Test 2", body: "body2", pinned: false },
+    ];
+
+    crate::pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        Note { id: "a", title: "Test 1", body: "body1", pinned: true },
+        Note { id: "b", title: "Test 2", body: "body2", pinned: false },
+    ];
+
+    crate::unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        Note { id: "a", title: "Test 1", body: "body1", pinned: false },
+    ];
+
+    crate::pin(&mut notes, "nonexistent");
+    // The note should remain unchanged (pinned stays false)
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        Note { id: "a", title: "Test 1", body: "body1", pinned: true },
+    ];
+
+    crate::unpin(&mut notes, "nonexistent");
+    // The note should remain unchanged (pinned stays true)
+}
+
+#[test]
+fn ordered_pinned_first_groups_pinned_before_unpinned() {
+    let mut notes = vec![
+        Note { id: "a", title: "Unpinned 1", body: "b1", pinned: false },
+        Note { id: "b", title: "Pinned 1", body: "b2", pinned: true },
+        Note { id: "c", title: "Unpinned 2", body: "b3", pinned: false },
+        Note { id: "d", title: "Pinned 2", body: "b4", pinned: true },
+    ];
+
+    let ordered = crate::ordered_pinned_first(&notes);
+
+    // Pinned notes should come first, in their original relative order
+    assert_eq!(ordered[0].id, "b");   // b is the first pinned note (index 1)
+    assert_eq!(ordered[1].id, "d");   // d is the second pinned note (index 3)
+    
+    // Unpinned notes should come after, in their original relative order
+    assert_eq!(ordered[2].id, "a");   // a was first unpinned (index 0)
+    assert_eq!(ordered[3].id, "c");   // c was second unpinned (index 2)
+}
