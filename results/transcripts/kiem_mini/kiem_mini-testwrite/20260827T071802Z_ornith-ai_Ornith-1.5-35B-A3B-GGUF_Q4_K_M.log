+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+#[test]
+fn pin_sets_flag_on_matching_note() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    pin(&mut notes, "a");
+    assert_eq!(notes[0].pinned, true);
+    assert_eq!(notes[1].pinned, false);
+}
+
+#[test]
+fn unpin_clears_flag_on_matching_note() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    notes[0].pinned = true;
+    unpin(&mut notes, "a");
+    assert_eq!(notes[0].pinned, false);
+    assert_eq!(notes[1].pinned, false);
+}
+
+#[test]
+fn pin_missing_id_is_no_op() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    pin(&mut notes, "does-not-exist");
+    assert!(notes.iter().all(|n| !n.pinned));
+}
+
+#[test]
+fn unpin_missing_id_is_no_op() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    notes[0].pinned = true;
+    unpin(&mut notes, "does-not-exist");
+    assert_eq!(notes[0].pinned, true);
+}
