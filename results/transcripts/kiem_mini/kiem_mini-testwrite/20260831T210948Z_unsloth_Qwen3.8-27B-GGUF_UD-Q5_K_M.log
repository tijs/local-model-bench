+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+fn note_with_pin(id: &str, pinned: bool) -> notekeep::Note {
+    let mut n = new_note(id, &format!("Title {id}"), "");
+    n.pinned = pinned;
+    n
+}
+
+#[test]
+fn pinning_sets_pinned_flag() {
+    let mut notes = vec![note_with_pin("a", false), note_with_pin("b", false)];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned, "unmatched note must not be affected");
+}
+
+#[test]
+fn unpinning_clears_pinned_flag() {
+    let mut notes = vec![note_with_pin("a", true), note_with_pin("b", true)];
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned, "unmatched note must not be affected");
+}
+
+#[test]
+fn pinning_unknown_id_is_noop() {
+    let mut notes = vec![note_with_pin("a", false), note_with_pin("b", false)];
+    pin(&mut notes, "does-not-exist");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpinning_unknown_id_is_noop() {
+    let mut notes = vec![note_with_pin("a", true), note_with_pin("b", true)];
+    unpin(&mut notes, "does-not-exist");
+    assert!(notes[0].pinned);
+    assert!(notes[1].pinned);
+}
+
+#[test]
