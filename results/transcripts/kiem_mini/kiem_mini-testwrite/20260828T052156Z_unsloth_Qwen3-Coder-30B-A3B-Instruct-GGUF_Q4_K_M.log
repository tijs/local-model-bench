+use notekeep::{pin, unpin, ordered_pinned_first, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        Note {
+            id: "1".to_string(),
+            title: "Note 1".to_string(),
+            body: "Body 1".to_string(),
+            tags: vec![],
+            pinned: false,
+        },
+        Note {
+            id: "2".to_string(),
+            title: "Note 2".to_string(),
+            body: "Body 2".to_string(),
+            tags: vec![],
+            pinned: false,
+        },
+    ];
+
+    pin(&mut notes, "1");
+
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        Note {
+            id: "1".to_string(),
+            title: "Note 1".to_string(),
+            body: "Body 1".to_string(),
+            tags: vec![],
+            pinned: true,
+        },
+        Note {
+            id: "2".to_string(),
+            title: "Note 2".to_string(),
+            body: "Body 2".to_string(),
+            tags: vec![],
+            pinned: false,
+        },
+    ];
+
+    unpin(&mut notes, "1");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
