+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+/// Pinning a note sets its `pinned` flag to `true`.
+#[test]
+fn pin_sets_flag() {
+    let mut notes = vec![new_note("a", "first", "body")];
+    assert!(!notes[0].pinned);
+
+    pin(&mut notes, "a");
+
+    assert_eq!(notes[0].pinned, true);
+}
+
+/// Unpinning a note clears its `pinned` flag.
+#[test]
+fn unpin_clears_flag() {
+    let mut notes = vec![new_note("a", "first", "body")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert_eq!(notes[0].pinned, false);
+}
+
+/// Pinning a note by an id that isn't in the slice is a harmless no-op:
+/// the slice is unchanged and no panic occurs.
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![
+        new_note("a", "first", "body"),
+        new_note("b", "second", "body"),
+    ];
+    let before = notes.clone();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, before);
+    assert!(!notes.iter().any(|n| n.pinned));
+}
+
+/// Unpinning a note by an id that isn't in the slice is a harmless no-op.
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = vec![
+        new_note("a", "first", "body"),
+        new_note("b", "second", "body"),
+    ];
+    let before = notes.clone();
+
+    unpin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, before);
+}
+
+/// `ordered_pinned_first` puts every pinned note before every unpinned note,
+/// preserving the relative order within each group.
+#[test]
+fn ordered_pinned_first_groups_and_preserves_order() {
+    let mut notes = vec![
+        new_note("1", "one", "body"),
+        new_note("2", "two", "body"),
+        new_note("3", "three", "body"),
+        new_note("4", "four", "body"),
+        new_note("5", "five", "body"),
+    ];
+
+    pin(&mut notes, "3");
+    pin(&mut notes, "1");
+    pin(&mut notes, "5");
+
+    let ordered = ordered_pinned_first(&notes);
+
+    let ids: Vec<&str> = ordered.iter().map(|n| n.id.as_str()).collect();
+    // Pinned group (1, 3, 5) keeps insertion order, then unpinned (2, 4).
+    assert_eq!(ids, vec!["1", "3", "5", "2", "4"]);
+}
+
