+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+// ---------------------------------------------------------------------------
+// pin()
+// ---------------------------------------------------------------------------
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("a", "A", ""),
+        new_note("b", "B", ""),
+    ];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pin_by_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", "")];
+    pin(&mut notes, "z");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_already_pinned_note_is_stable() {
+    let mut notes = vec![new_note("a", "A", "")];
+    notes[0].pinned = true;
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+}
+
+// ---------------------------------------------------------------------------
+// unpin()
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        new_note("a", "A", ""),
+        new_note("b", "B", ""),
+    ];
+    notes[0].pinned = true;
+    notes[1].pinned = true;
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
