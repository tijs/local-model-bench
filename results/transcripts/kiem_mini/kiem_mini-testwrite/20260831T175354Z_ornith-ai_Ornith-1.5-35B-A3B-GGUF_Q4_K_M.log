+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+/// Build a slice of notes in the given order for reuse across tests.
+fn sample() -> Vec<Note> {
+    vec![
+        new_note("a", "Alpha", "first note"),
+        new_note("b", "Beta", "second note"),
+        new_note("c", "Gamma", "third note"),
+    ]
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned, "note 'b' should be marked pinned");
+}
+
+#[test]
+fn pin_leaves_other_notes_unpinned() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+    assert!(!notes[0].pinned, "note 'a' must remain unpinned");
+    assert!(!notes[2].pinned, "note 'c' must remain unpinned");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = sample();
+    pin(&mut notes, "a");
+    pin(&mut notes, "c");
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned, "note 'a' should be unpinned again");
+    assert!(notes[2].pinned, "note 'c' should stay pinned");
+}
+
+#[test]
+fn pin_missing_id_is_noop() {
+    let mut notes = sample();
+    pin(&mut notes, "does-not-exist");
+    for note in &notes {
+        assert!(!note.pinned, "no note should become pinned by a missing id");
+    }
+}
+
+#[test]
+fn unpin_missing_id_is_noop() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+    unpin(&mut notes, "ghost");
