+use notekeep::new_note;
+use notekeep::{ordered_pinned_first, pin, unpin};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("a", "A", "first"),
+        new_note("b", "B", "second"),
+    ];
+
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned, "untouched note should stay unpinned");
+    assert!(notes[1].pinned, "pinned note should have pinned flag set");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "first")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "unpinning should clear the pinned flag");
+}
