+use notekeep::new_note;
+use notekeep::{ordered_pinned_first, pin, unpin};
+
+#[test]
+fn pin_sets_pinned_flag_on_matching_note() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned, "note 'a' should stay unpinned");
+    assert!(notes[1].pinned, "note 'b' should be pinned");
+}
+
+#[test]
+fn pin_only_affects_the_first_match() {
+    let mut notes = vec![
+        new_note("dup", "First", "x"),
+        new_note("dup", "Second", "y"),
+    ];
+
+    pin(&mut notes, "dup");
+
+    assert!(notes[0].pinned, "first matching note should be pinned");
+    assert!(!notes[1].pinned, "second matching note should stay unpinned");
+}
+
+#[test]
+fn pin_is_idempotent() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+
+    pin(&mut notes, "a");
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag_on_matching_note() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    pin(&mut notes, "a");
+    pin(&mut notes, "b");
+    assert!(notes[0].pinned && notes[1].pinned);
+
+    unpin(&mut notes, "b");
+
+    assert!(notes[0].pinned, "note 'a' should stay pinned");
+    assert!(!notes[1].pinned, "note 'b' should be unpinned");
+}
+
+#[test]
+fn unpin_on_unpinned_note_keeps_it_unpinned() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_harmless_noop() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+
+    pin(&mut notes, "does-not-exist");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned, "no note should become pinned");
+}
+
+#[test]
+fn unpin_unknown_id_is_harmless_noop() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
