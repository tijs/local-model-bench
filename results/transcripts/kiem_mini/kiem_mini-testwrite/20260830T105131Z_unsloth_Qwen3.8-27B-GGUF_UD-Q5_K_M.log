+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn notes_with_pinned(pinned_ids: &[&str]) -> Vec<Note> {
+    let mut notes = vec![
+        new_note("a", "Alpha", "body a"),
+        new_note("b", "Beta", "body b"),
+        new_note("c", "Gamma", "body c"),
+        new_note("d", "Delta", "body d"),
+    ];
+    for id in pinned_ids {
+        for n in &mut notes {
+            if n.id == *id {
+                n.pinned = true;
+            }
+        }
+    }
+    notes
+}
+
+#[test]
+fn pin_sets_pinned_flag_on_matching_note() {
+    let mut notes = notes_with_pinned(&[]);
+    assert!(notes.iter().all(|n| !n.pinned));
+
+    pin(&mut notes, "c");
+
+    assert!(notes[2].pinned, "note 'c' should be pinned");
+    assert!(
+        notes[0].pinned == false && notes[1].pinned == false && notes[3].pinned == false,
+        "only note 'c' should be pinned"
+    );
+}
+
+#[test]
+fn pin_is_idempotent_and_leaves_other_fields_alone() {
+    let mut notes = notes_with_pinned(&["a"]);
+    let before = notes[0].clone();
+
+    pin(&mut notes, "a");
+
+    assert_eq!(notes[0], before, "re-pinning an already-pinned note is a no-op");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = notes_with_pinned(&["a", "b", "c"]);
+    assert!(notes[0].pinned && notes[1].pinned && notes[2].pinned);
+
+    unpin(&mut notes, "b");
+
+    assert!(!notes[1].pinned, "note 'b' should no longer be pinned");
+    assert!(notes[0].pinned && notes[2].pinned, "other pinned notes stay pinned");
+}
+
+#[test]
+fn pin_missing_id_is_a_noop() {
+    let mut notes = notes_with_pinned(&["a"]);
+    let before = notes.clone();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, before, "pinning a missing id must not change anything");
+}
+
+#[test]
+fn unpin_missing_id_is_a_noop() {
+    let mut notes = notes_with_pinned(&["a"]);
+    let before = notes.clone();
+
+    unpin(&mut notes, "does-not-exist");
+
+    assert_eq!(notes, before, "unpinning a missing id must not change anything");
+}
+
