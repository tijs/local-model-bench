+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn sample_notes() -> Vec<Note> {
+    vec![
+        new_note("a", "Alpha", "alpha body"),
+        new_note("b", "Beta", "beta body"),
+        new_note("c", "Gamma", "gamma body"),
+        new_note("d", "Delta", "delta body"),
+    ]
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = sample_notes();
+    pin(&mut notes, "b");
+    assert_eq!(notes[1].pinned, true);
+}
+
+#[test]
+fn pin_sets_flag_on_any_matching_note() {
+    let mut notes = sample_notes();
+    pin(&mut notes, "d");
+    assert_eq!(notes[3].pinned, true);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = sample_notes();
+    pin(&mut notes, "b");
+    assert_eq!(notes[1].pinned, true);
+    unpin(&mut notes, "b");
+    assert_eq!(notes[1].pinned, false);
+}
+
+#[test]
+fn pinning_unknown_id_is_noop() {
+    let mut notes = sample_notes();
+    pin(&mut notes, "does-not-exist");
+    assert!(notes.iter().all(|n| !n.pinned));
+}
+
+#[test]
+fn unpinning_unknown_id_is_noop() {
+    let mut notes = sample_notes();
+    unpin(&mut notes, "nope");
+    assert!(notes.iter().all(|n| !n.pinned));
+}
+
+#[test]
+fn pin_is_harmless_to_other_notes() {
+    let mut notes = sample_notes();
+    pin(&mut notes, "c");
+    // Every note except the targeted one keeps its original (unpinned) state.
+    assert_eq!(notes[0].pinned, false);
+    assert_eq!(notes[1].pinned, false);
+    assert_eq!(notes[2].pinned, true);
+    assert_eq!(notes[3].pinned, false);
+}
+
+#[test]
+fn ordered_pinned_first_puts_all_pinned_before_all_unpinned() {
+    let notes = sample_notes();
+    pin(&notes, "b");
+    pin(&notes, "d");
+    let ordered = ordered_pinned_first(&notes);
+    let ids: Vec<&str> = ordered.iter().map(|n| n.id.as_str()).collect();
+    // Pinned notes (b, d) come first, then the unpinned ones (a, c).
+    assert_eq!(ids, vec!["b", "d", "a", "c"]);
+}
+
+#[test]
+fn ordered_pinned_first_preserves_relative_order_within_groups() {
+    let notes = sample_notes();
+    // Pin in a non-contiguous, non-sorted order and check both groups keep
+    // their original relative ordering.
+    pin(&notes, "d");
+    pin(&notes, "a");
+    let ordered = ordered_pinned_first(&notes);
