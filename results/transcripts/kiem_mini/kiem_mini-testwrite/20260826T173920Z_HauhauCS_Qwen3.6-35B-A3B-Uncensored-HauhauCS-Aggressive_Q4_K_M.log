+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+// ---------------------------------------------------------------------------
+// pin()
+// ---------------------------------------------------------------------------
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("a", "A", ""),
+        new_note("b", "B", ""),
+    ];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pin_on_empty_slice_is_noop() {
+    let mut notes: Vec<Note> = vec![];
+    pin(&mut notes, "no-such-id");
+    assert!(notes.is_empty());
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("x", "X", "")];
+    pin(&mut notes, "missing");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_already_pinned_is_idempotent() {
+    let mut notes = vec![new_note("a", "A", "")];
+    pin(&mut notes, "a");
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+}
+
+// ---------------------------------------------------------------------------
+// unpin()
+// ---------------------------------------------------------------------------
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "")];
+    notes[0].pinned = true;
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_on_empty_slice_is_noop() {
+    let mut notes: Vec<Note> = vec![];
+    unpin(&mut notes, "no-such-id");
+    assert!(notes.is_empty());
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("x", "X", "")];
+    unpin(&mut notes, "missing");
+    assert!(!notes[0].pinned);
+}
