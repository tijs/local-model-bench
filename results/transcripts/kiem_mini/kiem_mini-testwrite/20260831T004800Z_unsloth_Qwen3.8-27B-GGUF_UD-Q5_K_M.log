+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str) -> Note {
+    new_note(id, id, "")
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a"), note("b")];
+    pin(&mut notes, "a");
+    pin(&mut notes, "b");
+    assert!(notes[0].pinned && notes[1].pinned);
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+    unpin(&mut notes, "b");
+    assert!(!notes[0].pinned && !notes[1].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![note("a"), note("b")];
+    pin(&mut notes, "does-not-exist");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+    assert_eq!(notes.len(), 2);
+}
+
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = vec![note("a")];
+    unpin(&mut notes, "does-not-exist");
+    assert!(!notes[0].pinned);
+    assert_eq!(notes.len(), 1);
+}
+
+#[test]
+fn ordered_pinned_first_orders_pinned_before_unpinned() {
