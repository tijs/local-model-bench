+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn fixture() -> Vec<Note> {
+    vec![
+        new_note("a", "Alpha", "body a"),
+        new_note("b", "Beta", "body b"),
+        new_note("c", "Charlie", "body c"),
+    ]
+}
+
+// --- pin ---
+
+#[test]
+fn pin_sets_flag() {
+    let mut notes = fixture();
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn pin_does_not_affect_other_notes() {
+    let mut notes = fixture();
+    pin(&mut notes, "b");
+    assert!(!notes[0].pinned);
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = fixture();
+    pin(&mut notes, "z");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn pin_already_pinned_is_stable() {
+    let mut notes = fixture();
+    pin(&mut notes, "b");
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned);
+}
+
+// --- unpin ---
+
+#[test]
+fn unpin_clears_flag() {
+    let mut notes = fixture();
+    notes[0].pinned = true;
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_does_not_affect_other_notes() {
+    let mut notes = fixture();
+    notes[0].pinned = true;
+    notes[2].pinned = true;
+    unpin(&mut notes, "b");
+    assert!(notes[0].pinned);
+    assert!(notes[2].pinned);
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = fixture();
+    notes[0].pinned = true;
+    unpin(&mut notes, "z");
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_unpinned_note_is_stable() {
+    let mut notes = fixture();
+    unpin(&mut notes, "b");
+    assert!(!notes[1].pinned);
+}
