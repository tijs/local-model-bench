+use rust::*;
+
+#[test]
+fn test_pin_unpin_behavior() {
+    let mut notes = vec![
+        new_note("1", "Title 1", "Body 1"),
+        new_note("2", "Title 2", "Body 2"),
+    ];
+
+    // Test pinning
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+
+    // Test unpinning
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn test_pin_unpin_non_existent_id() {
+    let mut notes = vec![
+        new_note("1", "Title 1", "Body 1"),
+    ];
+
+    // Pin non-existent ID
+    pin(&mut notes, "999");
+    assert!(!notes[0].pinned);
+
+    // Unpin non-existent ID
+    unpin(&mut notes, "999");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn test_ordered_pinned_first() {
+    let mut notes = vec![
+        new_note("1", "T1", "B1"), // unpinned
+        new_note("2", "T2", "B2"), // pinned
+        new_note("3", "T3", "B3"), // unpinned
+        new_note("4", "T4", "B4"), // pinned
+    ];
+
+    pin(&mut notes, "2");
+    pin(&mut notes, "4");
+
+    let ordered = ordered_pinned_first(&notes);
+
+    assert_eq!(ordered.len(), 4);
+    // Pinned first: 2, 4
+    assert_eq!(ordered[0].id, "2");
+    assert_eq!(ordered[1].id, "4");
+    // Unpinned next: 1, 3
+    assert_eq!(ordered[2].id, "1");
+    assert_eq!(ordered[3].id, "3");
+}
