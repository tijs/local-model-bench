+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+/// Pinning a note sets its `pinned` flag to `true`.
+#[test]
+fn pin_sets_flag() {
+    let mut notes = vec![new_note("a", "First", "body")];
+    assert!(!notes[0].pinned);
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned, "pin should set the pinned flag");
+}
+
+/// Unpinning clears the `pinned` flag.
+#[test]
+fn unpin_clears_flag() {
+    let mut notes = vec![new_note("a", "First", "body")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "unpin should clear the pinned flag");
+}
+
+/// Pinning an unknown id is a harmless no-op: nothing panics and no note
+/// changes state.
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![
+        new_note("a", "First", "body"),
+        new_note("b", "Second", "body"),
+    ];
+
+    pin(&mut notes, "does-not-exist");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+/// Unpinning an unknown id is a harmless no-op: nothing panics and no note
