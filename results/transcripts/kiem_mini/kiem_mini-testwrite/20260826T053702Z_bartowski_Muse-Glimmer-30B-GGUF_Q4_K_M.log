+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("1", "A", "body"),
+        new_note("2", "B", "body"),
+    ];
+    pin(&mut notes, "2");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        Note {
+            id: "1".into(),
+            title: "A".into(),
+            body: "".into(),
+            tags: vec![],
+            pinned: true,
+        },
+        new_note("2", "B", "body"),
+    ];
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+    // unpinning an already unpinned note is fine
+    unpin(&mut notes, "2");
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("1", "A", "body")];
+    let before = notes.clone();
+    pin(&mut notes, "does-not-exist");
+    assert_eq!(notes, before);
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = vec![
+        Note {
+            id: "1".into(),
+            title: "A".into(),
+            body: "".into(),
+            tags: vec![],
+            pinned: true,
+        },
+    ];
+    let before = notes.clone();
+    unpin(&mut notes, "does-not-exist");
+    assert_eq!(notes, before);
+}
+
+#[test]
+fn ordered_pinned_first_puts_pinned_before_unpinned_preserving_order() {
+    let notes = vec![
+        new_note("a", "A", ""),
+        new_note("b", "B", ""),
+        new_note("c", "C", ""),
+        new_note("d", "D", ""),
+    ];
+    // make b and d pinned, but in original order a,b,c,d
+    let mut notes_mut = notes.clone();
+    pin(&mut notes_mut, "b");
+    pin(&mut notes_mut, "d");
+    // use original notes with pinned flags set via mutation
+    // For ordered_pinned_first we need notes with pinned flags set
+    // We'll build a vector with pinned flags manually
+    let notes_with_flags = vec![
+        Note { id: "a".into(), title: "A".into(), body: "".into(), tags: vec![], pinned: false },
+        Note { id: "b".into(), title: "B".into(), body: "".into(), tags: vec![], pinned: true },
+        Note { id: "c".into(), title: "C".into(), body: "".into(), tags: vec![], pinned: false },
+        Note { id: "d".into(), title: "D".into(), body: "".into(), tags: vec![], pinned: true },
+    ];
+    let ordered = ordered_pinned_first(&notes_with_flags);
