+use notekeep::{new_note, pin, unpin, ordered_pinned_first, Note};
+
+#[test]
+fn pinning_sets_pinned_flag() {
+    let mut notes = vec![new_note("1", "First", "body1"), new_note("2", "Second", "body2")];
+    
+    pin(&mut notes, "1");
+    
+    assert!(notes[0].pinned, "First note should be pinned");
+    assert!(!notes[1].pinned, "Second note should not be pinned");
+}
+
+#[test]
+fn unpinning_clears_pinned_flag() {
+    let mut notes = vec![new_note("1", "First", "body1"), new_note("2", "Second", "body2")];
+    
+    // First pin it
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned, "First note should be pinned after pin()");
+    
+    // Then unpin it
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned, "First note should not be pinned after unpin()");
+}
+
+#[test]
+fn pinning_nonexistent_id_is_harmless_noop() {
+    let mut notes = vec![new_note("1", "First", "body1"), new_note("2", "Second", "body2")];
+    
+    // Try to pin a note that doesn't exist
+    pin(&mut notes, "nonexistent");
+    
+    // Should not panic and all notes should remain unpinned
+    assert!(!notes[0].pinned, "First note should still be unpinned");
+    assert!(!notes[1].pinned, "Second note should still be unpinned");
+}
+
+#[test]
+fn unpinning_nonexistent_id_is_harmless_noop() {
+    let mut notes = vec![new_note("1", "First", "body1"), new_note("2", "Second", "body2")];
+    
+    // Try to unpin a note that doesn't exist (all are already unpinned)
+    unpin(&mut notes, "nonexistent");
+    
+    // Should not panic and all notes should remain unpinned
+    assert!(!notes[0].pinned, "First note should still be unpinned");
+    assert!(!notes[1].pinned, "Second note should still be unpinned");
+}
+
+#[test]
+fn ordered_pinned_first_puts_pinned_notes_first() {
+    let mut notes = vec![
+        new_note("1", "First", "body1"),
+        new_note("2", "Second", "body2"),
+        new_note("3", "Third", "body3"),
+    ];
+    
+    // Pin the first and third notes
+    pin(&mut notes, "1");
+    pin(&mut notes, "3");
+    
+    let ordered = ordered_pinned_first(&notes);
+    
+    // Should have 3 notes returned
+    assert_eq!(ordered.len(), 3);
+    
+    // First note (pinned) should be first
+    assert_eq!(ordered[0].id, "1");
+    
+    // Third note (pinned) should be second
+    assert_eq!(ordered[1].id, "3");
+    
+    // Second note (unpinned) should be last
+    assert_eq!(ordered[2].id, "2");
+}
+
+#[test]
+fn ordered_pinned_first_preserves_relative_order_within_groups() {
