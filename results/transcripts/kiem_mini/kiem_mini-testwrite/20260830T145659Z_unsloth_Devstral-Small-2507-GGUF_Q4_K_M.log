+use super::*;
+
+#[test]
+fn test_pin_note() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Some content"),
+        new_note("2", "Note 2", "More content"),
+    ];
+    
+    // Pin the first note
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+    
+    // Pinning a note that's already pinned should be a no-op
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+    
+    // Pinning a non-existent note should be a no-op
+    pin(&mut notes, "99");
+    assert_eq!(notes.iter().filter(|n| n.pinned).count(), 1);
+}
+
+#[test]
+fn test_unpin_note() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Some content"),
+        new_note("2", "Note 2", "More content"),
+    ];
+    
+    // Pin both notes
+    pin(&mut notes, "1");
+    pin(&mut notes, "2");
+    assert!(notes[0].pinned);
+    assert!(notes[1].pinned);
+    
+    // Unpin the first note
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+    
+    // Unpinning a note that's already unpinned should be a no-op
+    unpin(&mut notes, "1");
+    assert!(!notes[0].pinned);
+    
+    // Unpinning a non-existent note should be a no-op
+    unpin(&mut notes, "99");
+    assert_eq!(notes.iter().filter(|n| n.pinned).count(), 1);
+}
+
+#[test]
+fn test_ordered_pinned_first() {
+    let notes = vec![
+        new_note("1", "Note 1", "Some content"),
+        new_note("2", "Note 2", "More content"),
+        new_note("3", "Note 3", "Other content"),
+    ];
+    
+    // Pin some notes
+    let mut notes = notes;
+    pin(&mut notes, "2"); // Pin the middle note
+    pin(&mut notes, "1"); // Pin the first note
+    
+    // Test ordered_pinned_first
+    let ordered = ordered_pinned_first(&notes);
+    
+    // Check that all pinned notes come before unpinned ones
+    let mut iter = ordered.iter();
+    let first = iter.next().unwrap();
+    let second = iter.next().unwrap();
+    let third = iter.next().unwrap();
+    
+    // First two should be pinned, third should not be
+    assert!(first.pinned);
+    assert_eq!(first.id, "1");
+    assert!(second.pinned);
+    assert_eq!(second.id, "2");
+    assert!(!third.pinned);
