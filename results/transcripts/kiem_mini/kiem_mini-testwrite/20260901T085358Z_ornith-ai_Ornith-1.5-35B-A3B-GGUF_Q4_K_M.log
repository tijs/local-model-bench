+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+    assert!(!notes[0].pinned, "note starts unpinned");
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned, "pin should set the pinned flag to true");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned, "note should be pinned before unpin");
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "unpin should clear the pinned flag to false");
+}
+
+#[test]
+fn pin_by_missing_id_is_noop() {
+    let mut notes = vec![
+        new_note("a", "A", "body a"),
+        new_note("b", "B", "body b"),
+    ];
+    let before = notes.clone();
+
+    pin(&mut notes, "does-not-exist");
+
+    assert_eq!(
+        notes, before,
+        "pinning a missing id must not change any note"
+    );
+}
+
+#[test]
+fn unpin_by_missing_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+
+    unpin(&mut notes, "does-not-exist");
+
+    assert!(!notes[0].pinned, "unpinning a missing id must be a harmless no-op");
+}
+
