+//! Integration tests for the pinning behavior exposed at the crate root:
+//! `pin`, `unpin`, and `ordered_pinned_first`.
+
+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str, pinned: bool) -> Note {
+    let mut n = new_note(id, id, format!("body for {id}"));
+    n.pinned = pinned;
+    n
+}
+
+#[test]
+fn pin_sets_pinned_flag_on_matching_note() {
+    let mut notes = vec![note("a", false), note("b", false)];
+
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned, "unmatched note must stay unpinned");
+    assert!(notes[1].pinned, "matched note must become pinned");
+}
+
+#[test]
+fn pin_is_idempotent_for_already_pinned_note() {
+    let mut notes = vec![note("a", true)];
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+    assert_eq!(notes.len(), 1);
+}
+
+#[test]
+fn unpin_clears_pinned_flag_on_matching_note() {
+    let mut notes = vec![note("a", true), note("b", true)];
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "matched note must be unpinned");
+    assert!(notes[1].pinned, "other pinned note must stay pinned");
+}
