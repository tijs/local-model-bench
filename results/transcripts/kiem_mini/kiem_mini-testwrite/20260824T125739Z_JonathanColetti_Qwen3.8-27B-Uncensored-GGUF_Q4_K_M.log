+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str, pinned: bool) -> Note {
+    let mut n = new_note(id, "title", "body");
+    n.pinned = pinned;
+    n
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a", false), note("b", false)];
+
+    pin(&mut notes, "b");
+
+    assert!(!notes[0].pinned, "note 'a' should stay unpinned");
+    assert!(notes[1].pinned, "note 'b' should be pinned");
+}
+
+#[test]
+fn pin_is_idempotent_and_does_not_touch_others() {
+    let mut notes = vec![note("a", false), note("b", true), note("c", false)];
+
+    pin(&mut notes, "a");
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+    assert!(notes[1].pinned, "already-pinned note should stay pinned");
+    assert!(!notes[2].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a", true), note("b", true)];
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned, "note 'a' should be unpinned");
+    assert!(notes[1].pinned, "note 'b' should stay pinned");
+}
+
+#[test]
+fn pin_missing_id_is_noop() {
+    let mut notes = vec![note("a", false), note("b", true)];
+
+    pin(&mut notes, "nope");
+
+    assert!(!notes[0].pinned);
+    assert!(notes[1].pinned);
+}
