+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str, pinned: bool) -> Note {
+    Note {
+        id: id.to_string(),
+        title: format!("title-{id}"),
+        body: format!("body-{id}"),
+        tags: Vec::new(),
+        pinned,
+    }
+}
+
+fn ids(notes: &[&Note]) -> Vec<String> {
+    notes.iter().map(|n| n.id.clone()).collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a", false), note("b", false)];
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned, "note 'a' should be pinned after pin()");
+    assert!(!notes[1].pinned, "note 'b' should remain unpinned");
+}
+
+#[test]
+fn pin_leaves_other_fields_unchanged() {
+    let mut notes = vec![new_note("x", "My Title", "some #tagged body")];
+
+    pin(&mut notes, "x");
+
+    assert!(notes[0].pinned);
+    assert_eq!(notes[0].id, "x");
+    assert_eq!(notes[0].title, "My Title");
+    assert_eq!(notes[0].body, "some #tagged body");
+    assert_eq!(notes[0].tags, vec!["tagged"]);
+}
+
+#[test]
+fn pin_on_already_pinned_note_is_idempotent() {
+    let mut notes = vec![note("a", true)];
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a", true), note("b", true)];
+
+    unpin(&mut notes, "b");
+
+    assert!(notes[0].pinned, "note 'a' should stay pinned");
+    assert!(!notes[1].pinned, "note 'b' should be unpinned after unpin()");
+}
+
+#[test]
+fn unpin_on_already_unpinned_note_is_idempotent() {
+    let mut notes = vec![note("a", false)];
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_harmless_noop() {
+    let mut notes = vec![note("a", false), note("b", false)];
+
+    pin(&mut notes, "missing");
+
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
