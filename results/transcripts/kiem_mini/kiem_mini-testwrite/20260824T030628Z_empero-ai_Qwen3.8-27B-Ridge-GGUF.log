+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    assert!(!notes[1].pinned);
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned);
+    // Other notes are untouched.
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    pin(&mut notes, "b");
+    assert!(notes[1].pinned);
+    unpin(&mut notes, "b");
+    assert!(!notes[1].pinned);
+    // Other notes are untouched.
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    pin(&mut notes, "missing");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", ""), new_note("b", "B", "")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    unpin(&mut notes, "missing");
+    // The pinned note stays pinned; nothing else changed.
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pin_unpin_roundtrip_restores_original_state() {
+    let mut notes = vec![new_note("x", "X", "")];
