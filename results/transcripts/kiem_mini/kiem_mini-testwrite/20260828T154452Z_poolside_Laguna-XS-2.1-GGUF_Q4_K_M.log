+use notekeep::{new_note, pin, unpin, ordered_pinned_first, Note};
+
+#[test]
+fn pinning_a_note_sets_its_pinned_flag() {
+    let mut notes = vec![new_note("1", "Title 1", "Body 1"), new_note("2", "Title 2", "Body 2")];
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+    
+    pin(&mut notes, "1");
+    
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpinning_a_note_clears_its_pinned_flag() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "T1".to_string(), body: "B1".to_string(), tags: vec![], pinned: true },
+        Note { id: "2".to_string(), title: "T2".to_string(), body: "B2".to_string(), tags: vec![], pinned: true },
+    ];
+    
+    unpin(&mut notes, "2");
+    
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pinning_nonexistent_id_is_harmless_no_op() {
+    let mut notes = vec![new_note("1", "Title 1", "Body 1")];
+    let original_pinned = notes[0].pinned;
+    
+    // Should not panic or modify anything
+    pin(&mut notes, "nonexistent");
+    
+    assert_eq!(notes[0].pinned, original_pinned);
+}
+
+#[test]
+fn unpinning_nonexistent_id_is_harmless_no_op() {
+    let mut notes = vec![new_note("1", "Title 1", "Body 1")];
+    notes[0].pinned = true;
+    
+    // Should not panic or modify anything
+    unpin(&mut notes, "nonexistent");
+    
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn ordered_pinned_first_puts_pinned_notes_first() {
+    let mut notes = vec![
+        Note { id: "1".to_string(), title: "T1".to_string(), body: "B1".to_string(), tags: vec![], pinned: false },
+        Note { id: "2".to_string(), title: "T2".to_string(), body: "B2".to_string(), tags: vec![], pinned: true },
+        Note { id: "3".to_string(), title: "T3".to_string(), body: "B3".to_string(), tags: vec![], pinned: false },
+        Note { id: "4".to_string(), title: "T4".to_string(), body: "B4".to_string(), tags: vec![], pinned: true },
+    ];
+    
+    let ordered = ordered_pinned_first(&notes);
+    
+    assert_eq!(ordered.len(), 4);
+    // First two should be the pinned ones
+    assert!(ordered[0].pinned);
+    assert!(ordered[1].pinned);
+    // Last two should be unpinned
+    assert!(!ordered[2].pinned);
+    assert!(!ordered[3].pinned);
+}
+
+#[test]
