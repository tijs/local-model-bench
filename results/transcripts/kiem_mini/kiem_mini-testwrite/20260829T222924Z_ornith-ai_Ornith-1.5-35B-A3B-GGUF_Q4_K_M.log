+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn sample() -> Vec<Note> {
+    vec![
+        new_note("a", "Alpha", "alpha note"),
+        new_note("b", "Beta", "beta note"),
+        new_note("c", "Gamma", "gamma note"),
+    ]
+}
+
+#[test]
+fn pin_sets_the_flag_on_the_matching_note() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+
+    assert!(notes.iter().any(|n| n.id == "b" && n.pinned));
+    assert_eq!(notes.iter().find(|n| n.id == "b").unwrap().pinned, true);
+}
+
+#[test]
+fn pin_leaves_other_notes_unpinned() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+
+    assert!(!notes.iter().any(|n| n.id == "a" && n.pinned));
+    assert!(!notes.iter().any(|n| n.id == "c" && n.pinned));
+    assert_eq!(notes.iter().find(|n| n.id == "a").unwrap().pinned, false);
+    assert_eq!(notes.iter().find(|n| n.id == "c").unwrap().pinned, false);
+}
+
+#[test]
+fn unpin_clears_the_flag_on_the_matching_note() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+    unpin(&mut notes, "b");
+
+    assert_eq!(notes.iter().find(|n| n.id == "b").unwrap().pinned, false);
+}
+
+#[test]
+fn unpin_is_a_no_op_on_an_already_unpinned_note() {
+    let mut notes = sample();
+    unpin(&mut notes, "a");
+
+    assert_eq!(notes.iter().find(|n| n.id == "a").unwrap().pinned, false);
+}
+
+#[test]
+fn pin_by_missing_id_is_a_harmless_no_op() {
+    let mut notes = sample();
+    pin(&mut notes, "does-not-exist");
+
+    assert!(notes.iter().all(|n| !n.pinned));
+}
+
+#[test]
+fn unpin_by_missing_id_is_a_harmless_no_op() {
+    let mut notes = sample();
+    pin(&mut notes, "b");
+    unpin(&mut notes, "does-not-exist");
+
+    // The real note is still pinned; the missing id changed nothing.
+    assert!(notes.iter().any(|n| n.id == "b" && n.pinned));
+    assert!(notes.iter().all(|n| n.id != "b" || n.pinned));
+}
+
+#[test]
+fn ordered_pinned_first_puts_every_pinned_note_before_every_unpinned_note() {
+    let notes = sample();
+    pin(&mut notes.clone(), "c");
+    pin(&mut notes.clone(), "a");
+
+    let ordered = ordered_pinned_first(&notes);
+
+    let pinned_ids: Vec<&str> = ordered
+        .iter()
+        .filter(|n| n.pinned)
+        .map(|n| n.id.as_str())
