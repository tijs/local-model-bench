+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+// Pinning a note sets its `pinned` flag to true.
+#[test]
+fn pin_sets_flag() {
+    let mut notes = vec![new_note("a", "first", "body")];
+    assert!(!notes[0].pinned);
+
+    pin(&mut notes, "a");
+
+    assert!(notes[0].pinned);
+}
+
+// Unpinning a note clears its `pinned` flag.
+#[test]
+fn unpin_clears_flag() {
+    let mut notes = vec![new_note("a", "first", "body")];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+}
+
+// Pinning an id that isn't present is a harmless no-op.
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = vec![new_note("a", "first", "body")];
+
+    pin(&mut notes, "does-not-exist");
+
+    assert!(!notes[0].pinned);
+}
+
+// Unpinning an id that isn't present is a harmless no-op.
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = vec![new_note("a", "first", "body")];
+
+    unpin(&mut notes, "does-not-exist");
+
+    assert!(!notes[0].pinned);
+}
+
+// `ordered_pinned_first` puts every pinned note before every unpinned note,
+// preserving the relative order within each group.
+#[test]
+fn ordered_pinned_first_keeps_relative_order() {
+    let mut notes = vec![
+        new_note("1", "one", "body"),
+        new_note("2", "two", "body"),
+        new_note("3", "three", "body"),
+        new_note("4", "four", "body"),
+    ];
+
+    pin(&mut notes, "3");
+    pin(&mut notes, "1");
+
+    let ordered = ordered_pinned_first(&notes);
+    let ids: Vec<&str> = ordered.iter().map(|n| n.id.as_str()).collect();
+
+    assert_eq!(ids, vec!["1", "3", "2", "4"]);
+}
+
+// `ordered_pinned_first` preserves relative order within the unpinned group
+// even when pinned notes are scattered through the slice.
+#[test]
+fn ordered_pinned_first_unpinned_order_preserved() {
+    let mut notes = vec![
+        new_note("1", "one", "body"),
+        new_note("2", "two", "body"),
+        new_note("3", "three", "body"),
+    ];
+
+    pin(&mut notes, "2");
+
+    let ordered = ordered_pinned_first(&notes);
