+use super::*;
+
+#[test]
+fn test_pin_sets_pinned_flag() {
+    let mut note = new_note("1", "Test Note", "Some content");
+    assert!(!note.pinned, "Note should start unpinned");
+    
+    let mut notes = vec![note];
+    pin(&mut notes, "1");
+    
+    assert!(notes[0].pinned, "Note should be pinned after pin()");
+}
+
+#[test]
+fn test_unpin_clears_pinned_flag() {
+    let mut note = new_note("1", "Test Note", "Some content");
+    note.pinned = true;
+    
+    let mut notes = vec![note];
+    unpin(&mut notes, "1");
+    
+    assert!(!notes[0].pinned, "Note should be unpinned after unpin()");
+}
+
+#[test]
+fn test_pin_unpin_nonexistent_id_is_noop() {
+    let mut note1 = new_note("1", "Test Note 1", "Some content");
+    let mut note2 = new_note("2", "Test Note 2", "Some content");
+    note1.pinned = true;
+    
+    let mut notes = vec![note1, note2];
+    
+    // Pinning a non-existent note should be a no-op
+    pin(&mut notes, "3");
+    assert!(notes[0].pinned, "Existing pinned note should remain pinned");
+    assert!(!notes[1].pinned, "Existing unpinned note should remain unpinned");
+    
+    // Unpinning a non-existent note should be a no-op
+    unpin(&mut notes, "3");
+    assert!(notes[0].pinned, "Existing pinned note should remain pinned");
+    assert!(!notes[1].pinned, "Existing unpinned note should remain unpinned");
+}
+
+#[test]
+fn test_ordered_pinned_first() {
+    let note1 = new_note("1", "Test Note 1", "Some content");
+    let note2 = new_note("2", "Test Note 2", "Some content");
+    let note3 = new_note("3", "Test Note 3", "Some content");
+    
+    let mut note1 = note1;
+    let mut note3 = note3;
+    note1.pinned = true;
+    note3.pinned = true;
+    
+    let notes = vec![note2, note1, note3]; // Unpinned, Pinned, Pinned
+    
+    let ordered = ordered_pinned_first(&notes);
+    
+    // Check that all pinned notes come before unpinned ones
+    assert!(ordered[0].pinned, "First note should be pinned");
+    assert!(ordered[1].pinned, "Second note should be pinned");
+    assert!(!ordered[2].pinned, "Third note should be unpinned");
+    
+    // Check that relative order within groups is preserved
+    assert_eq!(ordered[0].id, "1", "First pinned note should be note1");
+    assert_eq!(ordered[1].id, "3", "Second pinned note should be note3");
+    assert_eq!(ordered[2].id, "2", "First unpinned note should be note2");
+}
+
+#[test]
+fn test_ordered_pinned_first_empty() {
+    let notes: Vec<Note> = vec![];
+    let ordered = ordered_pinned_first(&notes);
+    assert!(ordered.is_empty(), "Empty input should produce empty output");
+}
+
+#[test]
+fn test_ordered_pinned_first_all_pinned() {
