+fn main() {
+    // Test 1: pinning sets the pinned flag
+    println!("Test 1: pinning sets the pinned flag");
+    let mut note = new_note("1", "Test", "Body");
+    assert_eq!(note.pinned, false);
+    
+    let notes = &mut [note];
+    pin(notes, "1");
+    assert_eq!(notes[0].pinned, true);
+    println!("✓ Pinning works correctly");
+
+    // Test 2: unpinning clears the pinned flag
+    println!("Test 2: unpinning clears the pinned flag");
+    let mut note = new_note("2", "Test2", "Body2");
+    note.pinned = true;  // Start pinned
+    
+    let notes = &mut [note];
+    unpin(notes, "2");
+    assert_eq!(notes[0].pinned, false);
+    println!("✓ Unpinning works correctly");
+
+    // Test 3: pinning non-existent note is no-op
+    println!("Test 3: pinning non-existent note is no-op");
+    let mut note = new_note("3", "Test3", "Body3");
+    let original_pinned = note.pinned;
+    
+    let notes = &mut [note];
+    pin(notes, "nonexistent");
+    assert_eq!(notes[0].pinned, original_pinned);
+    println!("✓ Pinning non-existent note is no-op");
+
+    // Test 4: ordered_pinned_first preserves order
+    println!("Test 4: ordered_pinned_first preserves order");
+    let mut note1 = new_note("1", "First", "Body 1");
+    let mut note2 = new_note("2", "Second", "Body 2");
+    let mut note3 = new_note("3", "Third", "Body 3");
+    let mut note4 = new_note("4", "Fourth", "Body 4");
+    
