+use notekeep::{pin, unpin, ordered_pinned_first, new_note, Note};
+
+#[test]
+fn pinning_sets_pinned_flag() {
+    let mut note = new_note("1", "Test", "Body");
+    assert_eq!(note.pinned, false);
+    
+    // Pin the note
+    let notes = &mut [note];
+    pin(notes, "1");
+    
+    // Verify the pinned flag is set
+    assert_eq!(notes[0].pinned, true);
+}
+
+#[test]
+fn unpinning_clears_pinned_flag() {
+    let mut note = new_note("1", "Test", "Body");
+    note.pinned = true;  // Start pinned
+    
+    // Unpin the note
+    let notes = &mut [note];
+    unpin(notes, "1");
+    
+    // Verify the pinned flag is cleared
+    assert_eq!(notes[0].pinned, false);
+}
+
+#[test]
+fn pinning_nonexistent_note_is_noop() {
+    let mut note = new_note("1", "Test", "Body");
+    let original_pinned = note.pinned;
+    
+    // Try to pin a note that doesn't exist
+    let notes = &mut [note];
+    pin(notes, "nonexistent");
+    
+    // Verify the pinned flag remains unchanged
+    assert_eq!(notes[0].pinned, original_pinned);
+}
+
+#[test]
+fn unpinning_nonexistent_note_is_noop() {
+    let mut note = new_note("1", "Test", "Body");
+    let original_pinned = note.pinned;
+    
+    // Try to unpin a note that doesn't exist
+    let notes = &mut [note];
+    unpin(notes, "nonexistent");
+    
+    // Verify the pinned flag remains unchanged
+    assert_eq!(notes[0].pinned, original_pinned);
+}
+
+#[test]
+fn ordered_pinned_first_preserves_order() {
+    let note1 = new_note("1", "First", "Body 1");
+    let mut note2 = new_note("2", "Second", "Body 2");
+    let mut note3 = new_note("3", "Third", "Body 3");
+    let mut note4 = new_note("4", "Fourth", "Body 4");
+    
+    // Pin some notes
+    note2.pinned = true;
+    note4.pinned = true;
+    
+    let notes = [note1, note2, note3, note4];
+    let result = ordered_pinned_first(&notes);
+    
+    // Verify pinned notes come first in order
+    assert_eq!(result[0].id, "2");  // First pinned note
+    assert_eq!(result[1].id, "4");  // Second pinned note
+    
+    // Verify unpinned notes come after in order
+    assert_eq!(result[2].id, "1");  // First unpinned note
+    assert_eq!(result[3].id, "3");  // Second unpinned note
+}
