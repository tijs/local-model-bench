+#!/usr/bin/env python3
+"""
+Ad-hoc verification script for pinning behavior tests
+"""
+
+import subprocess
+import sys
+import os
+
+def run_command(cmd, cwd=None):
+    """Run a shell command and return result"""
+    try:
+        result = subprocess.run(
+            cmd, 
+            shell=True, 
+            cwd=cwd,
+            capture_output=True, 
+            text=True,
+            timeout=30
+        )
+        return result.returncode == 0, result.stdout, result.stderr
+    except subprocess.TimeoutExpired:
+        return False, "", "Command timed out"
+
+def main():
+    """Verify the pinning behavior tests work correctly"""
+    
+    # Change to the rust directory where our tests are located
+    rust_dir = "./rust"
+    
+    if not os.path.exists(rust_dir):
+        print("ERROR: Rust directory not found")
+        return 1
+    
+    # Run cargo test to verify our tests pass
+    success, stdout, stderr = run_command("cargo test", cwd=rust_dir)
+    
+    if not success:
+        print("ERROR: Tests failed to run")
+        print("STDOUT:", stdout)
+        print("STDERR:", stderr)
+        return 1
+    
+    # Check that our specific tests ran and passed
+    if "test result: ok. 8 passed" in stdout:
+        print("✅ All 8 pinning behavior tests passed successfully")
+        print("✅ Pinning functionality verified correctly")
+        return 0
+    else:
+        print("ERROR: Expected test results not found")
+        print("STDOUT:", stdout)
+        return 1
+
+if __name__ == "__main__":
+    sys.exit(main())
