+use notekeep::{new_note, ordered_pinned_first, pin, unpin};
+
+fn note(id: &str, pinned: bool) -> notekeep::Note {
+    let mut n = new_note(id, id, "body");
+    n.pinned = pinned;
+    n
+}
+
+fn ids(notes: &[notekeep::Note]) -> Vec<&str> {
+    notes.iter().map(|n| n.id.as_str()).collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![note("a", false), note("b", false)];
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned, "note a should be pinned");
+    assert!(!notes[1].pinned, "note b should be untouched");
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![note("a", true), note("b", true)];
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned, "note a should be unpinned");
+    assert!(notes[1].pinned, "note b should stay pinned");
+}
