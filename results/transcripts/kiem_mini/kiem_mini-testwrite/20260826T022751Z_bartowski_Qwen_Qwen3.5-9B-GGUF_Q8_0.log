+use notekeep::{pin, unpin, ordered_pinned_first, Note, new_note};
+
+fn main() {
+    println!("=== Pin Behavior Verification ===\n");
+
+    // Test 1: pin sets flag
+    println!("Test 1: pin sets pinned flag");
+    let mut notes = vec![
+        new_note("id1", "Title1", "Body1"),
+        new_note("id2", "Title2", "Body2"),
+        new_note("id3", "Title3", "Body3"),
+    ];
+    pin(&mut notes, "id2");
+    assert_eq!(notes[0].pinned, false, "id1 should be false");
+    assert_eq!(notes[1].pinned, true, "id2 should be true");
+    assert_eq!(notes[2].pinned, false, "id3 should be false");
+    println!("  ✓ PASS\n");
+
+    // Test 2: unpin clears flag
+    println!("Test 2: unpin clears pinned flag");
+    pin(&mut notes, "id2"); // re-pin
+    unpin(&mut notes, "id2");
+    assert_eq!(notes[1].pinned, false, "id2 should be false after unpin");
+    println!("  ✓ PASS\n");
+
+    // Test 3: pin non-existent id is noop
+    println!("Test 3: pin non-existent id is harmless noop");
+    let mut notes = vec![
+        new_note("id1", "Title1", "Body1"),
+        new_note("id2", "Title2", "Body2"),
+    ];
+    pin(&mut notes, "nonexistent");
+    assert_eq!(notes[0].pinned, false, "id1 should remain false");
+    assert_eq!(notes[1].pinned, false, "id2 should remain false");
+    println!("  ✓ PASS\n");
+
+    // Test 4: unpin non-existent id is noop
+    println!("Test 4: unpin non-existent id is harmless noop");
+    let mut notes = vec![
+        new_note("id1", "Title1", "Body1"),
+        new_note("id2", "Title2", "Body2"),
+    ];
+    unpin(&mut notes, "nonexistent");
+    assert_eq!(notes[0].pinned, false, "id1 should remain false");
+    assert_eq!(notes[1].pinned, false, "id2 should remain false");
+    println!("  ✓ PASS\n");
+
+    // Test 5: ordered_pinned_first preserves relative order
+    println!("Test 5: ordered_pinned_first preserves relative order");
+    let notes = vec![
+        new_note("id1", "Title1", "Body1"),
+        new_note("id2", "Title2", "Body2"),
+        new_note("id3", "Title3", "Body3"),
+        new_note("id4", "Title4", "Body4"),
+        new_note("id5", "Title5", "Body5"),
+    ];
+    let mut notes = notes;
+    pin(&mut notes, "id2");
+    pin(&mut notes, "id4");
+    let result = ordered_pinned_first(&notes);
+    assert_eq!(result.len(), 5, "should have 5 notes");
+    assert_eq!(result[0].id, "id2", "first should be pinned id2");
+    assert_eq!(result[1].id, "id4", "second should be pinned id4");
+    assert_eq!(result[2].id, "id1", "third should be unpinned id1");
+    assert_eq!(result[3].id, "id3", "fourth should be unpinned id3");
+    assert_eq!(result[4].id, "id5", "fifth should be unpinned id5");
+    println!("  ✓ PASS\n");
+
+    println!("=== All 5 verification checks passed ===");
+}
