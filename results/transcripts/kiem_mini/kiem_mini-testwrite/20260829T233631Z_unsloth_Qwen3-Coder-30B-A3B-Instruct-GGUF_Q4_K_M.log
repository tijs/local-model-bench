+use notekeep::{pin, unpin, ordered_pinned_first, new_note, Note};
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Body 1"),
+        new_note("2", "Note 2", "Body 2"),
+    ];
+    
+    pin(&mut notes, "1");
+    
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Body 1"),
+        new_note("2", "Note 2", "Body 2"),
+    ];
+    
+    // First pin the note
+    pin(&mut notes, "1");
+    assert!(notes[0].pinned);
+    
+    // Then unpin it
+    unpin(&mut notes, "1");
+    
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn pinning_nonexistent_note_is_noop() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Body 1"),
+        new_note("2", "Note 2", "Body 2"),
+    ];
+    
+    // Try to pin a note that doesn't exist
+    pin(&mut notes, "3");
+    
+    // All notes should remain unpinned
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpinning_nonexistent_note_is_noop() {
+    let mut notes = vec![
+        new_note("1", "Note 1", "Body 1"),
+        new_note("2", "Note 2", "Body 2"),
+    ];
+    
+    // Try to unpin a note that doesn't exist
+    unpin(&mut notes, "3");
+    
+    // All notes should remain unpinned
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
