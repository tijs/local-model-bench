+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn ids(notes: &[Note]) -> Vec<&str> {
+    notes.iter().map(|n| n.id.as_str()).collect()
+}
+
+fn ordered_ids(notes: &[Note]) -> Vec<&str> {
+    ordered_pinned_first(notes)
+        .iter()
+        .map(|n| n.id.as_str())
+        .collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    assert!(!notes[1].pinned);
+
+    pin(&mut notes, "b");
+
+    assert!(notes[1].pinned);
+    // Other notes are untouched.
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_keeps_other_fields_intact() {
+    let mut notes = vec![new_note("a", "A", "body #tag")];
+    pin(&mut notes, "a");
+
+    assert_eq!(notes[0].id, "a");
+    assert_eq!(notes[0].title, "A");
+    assert_eq!(notes[0].body, "body #tag");
+    assert_eq!(notes[0].tags, vec!["tag".to_string()]);
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = vec![new_note("a", "A", "body a"), new_note("b", "B", "body b")];
+    pin(&mut notes, "a");
+    pin(&mut notes, "b");
+    assert!(notes[0].pinned);
+    assert!(notes[1].pinned);
+
+    unpin(&mut notes, "a");
+
+    assert!(!notes[0].pinned);
+    // Other notes are untouched.
+    assert!(notes[1].pinned);
+}
+
+#[test]
+fn pin_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+    pin(&mut notes, "missing");
+
+    assert!(!notes[0].pinned);
+    assert_eq!(notes.len(), 1);
+    assert_eq!(notes[0], Note { id: "a".into(), title: "A".into(), body: "body a".into(), tags: vec![], pinned: false });
+}
+
+#[test]
+fn unpin_nonexistent_id_is_noop() {
+    let mut notes = vec![new_note("a", "A", "body a")];
+    pin(&mut notes, "a");
+    unpin(&mut notes, "missing");
+
+    assert!(notes[0].pinned);
+    assert_eq!(notes.len(), 1);
+}
