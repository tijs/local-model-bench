+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn note(id: &str, pinned: bool) -> Note {
+    let mut note = new_note(id, id, "");
+    note.pinned = pinned;
+    note
+}
+
+#[test]
+fn pinning_a_note_sets_its_pinned_flag() {
+    let mut notes = vec![note("one", false)];
+
+    pin(&mut notes, "one");
+
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn unpinning_a_note_clears_its_pinned_flag() {
+    let mut notes = vec![note("one", true)];
+
+    unpin(&mut notes, "one");
+
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pinning_or_unpinning_a_missing_id_is_a_no_op() {
+    let mut notes = vec![note("one", false), note("two", true)];
+    let original = notes.clone();
+
+    pin(&mut notes, "missing");
+    unpin(&mut notes, "missing");
+
+    assert_eq!(notes, original);
+}
+
+#[test]
+fn ordered_pinned_first_preserves_order_within_each_group() {
+    let notes = vec![
+        note("unpinned-one", false),
+        note("pinned-one", true),
+        note("unpinned-two", false),
+        note("pinned-two", true),
+    ];
+
+    let ordered = ordered_pinned_first(&notes);
+
+    let ids: Vec<&str> = ordered.iter().map(|note| note.id.as_str()).collect();
+    assert_eq!(ids, vec!["pinned-one", "pinned-two", "unpinned-one", "unpinned-two"]);
+    assert!(ordered[..2].iter().all(|note| note.pinned));
+    assert!(ordered[2..].iter().all(|note| !note.pinned));
+}
