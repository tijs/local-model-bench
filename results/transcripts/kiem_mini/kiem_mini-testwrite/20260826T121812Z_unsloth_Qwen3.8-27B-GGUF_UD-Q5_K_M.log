+use notekeep::{new_note, ordered_pinned_first, pin, unpin, Note};
+
+fn notes_with_ids(ids: &[&str]) -> Vec<Note> {
+    ids.iter().map(|id| new_note(id, "title", "body")).collect()
+}
+
+#[test]
+fn pin_sets_pinned_flag() {
+    let mut notes = notes_with_ids(&["a", "b"]);
+    pin(&mut notes, "a");
+    assert!(notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_clears_pinned_flag() {
+    let mut notes = notes_with_ids(&["a", "b"]);
+    pin(&mut notes, "a");
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn unpin_on_unpinned_note_is_noop() {
+    let mut notes = notes_with_ids(&["a"]);
+    unpin(&mut notes, "a");
+    assert!(!notes[0].pinned);
+}
+
+#[test]
+fn pin_unknown_id_is_noop() {
+    let mut notes = notes_with_ids(&["a", "b"]);
+    pin(&mut notes, "missing");
+    assert!(!notes[0].pinned);
+    assert!(!notes[1].pinned);
+}
+
+#[test]
+fn unpin_unknown_id_is_noop() {
+    let mut notes = notes_with_ids(&["a"]);
+    pin(&mut notes, "a");
+    unpin(&mut notes, "missing");
+    assert!(notes[0].pinned);
+}
+
+#[test]
+fn ordered_pinned_first_puts_pinned_before_unpinned() {
+    let mut notes = notes_with_ids(&["a", "b", "c", "d"]);
+    pin(&mut notes, "b");
+    pin(&mut notes, "d");
+
+    let ordered = ordered_pinned_first(&notes);
+    assert_eq!(
+        ordered.iter().map(|n| n.id.as_str()).collect::<Vec<_>>(),
+        vec!["b", "d", "a", "c"]
+    );
+}
