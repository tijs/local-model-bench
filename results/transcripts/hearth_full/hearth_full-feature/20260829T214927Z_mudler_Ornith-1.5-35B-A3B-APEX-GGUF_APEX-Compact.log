+import type { BuildingKind, ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+
+/**
+ * Sells `amount` of `resource` at the market, converting it into stone at
+ * a 2:1 ratio (rounded down) — selling 5 wood yields 2 stone. The sold
+ * resource is never taken below 0, so selling more than held simply
+ * liquidates what's left. Requires a market to already be built, since a
+ * settlement without one has nowhere to sell.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  const hasMarket = settlement.buildings.includes("market" as BuildingKind);
+  if (!hasMarket) {
+    throw new Error("cannot sell resources: no market built");
+  }
+  const gained = Math.floor(amount / 2);
+  const kept = Math.max(0, settlement.resources[resource] - amount);
+  return {
+    ...settlement,
+    resources: credit(settlement.resources, "stone", gained),
+    // Preserve the clamp even when nothing was sold, so the resource
+    // remains present and non-negative in the resulting settlement.
+    resources: { ...settlement.resources, [resource]: kept },
+  };
+}
