+import type { ResourceKind, Settlement } from "../types";
+
+/**
+ * Sells `amount` of `resource` at the settlement's market, converting it
+ * into stone at a 2:1 ratio (rounded down). If the settlement holds less
+ * than `amount`, the shortfall is simply not sold — the resource is never
+ * taken below 0. Throws if no market is built.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resources: no market built");
+  }
+  const held = settlement.resources[resource];
+  const sold = Math.min(amount, held);
+  const stoneGained = Math.floor(sold / 2);
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: held - sold,
+      stone: settlement.resources.stone + stoneGained,
+    },
+  };
+}
