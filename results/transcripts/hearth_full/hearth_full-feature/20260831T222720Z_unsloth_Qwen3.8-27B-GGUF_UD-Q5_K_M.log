import type { ResourceKind, Settlement } from "../types";
import { credit } from "../resources/costs";

/** 2 units of the sold resource become 1 stone... */
export const TRADE_RATIO = 2;

export function sellResource(settlement: Settlement, resource: ResourceKind, amount
: number): Settlement {
  if (!settlement.buildings.includes("market")) {
    throw new Error("cannot trade: no market built");
  }
  const sold = Math.min(amount, Math.max(0, settlement.resources[resource]));
  const stoneGained = Math.floor(sold / TRADE_RATIO);
  return {
    ...settlement,
    resources: credit({ ...settlement.resources, [resource]: settlement.resources
[resource] - sold }, "stone", stoneGained),
  };
}
```

