+ * Sells `amount` of `resource` at the market for stone at a 2:1 ratio,
+ * rounded down. Only what's actually on hand is sold, so the sold
+ * resource never drops below 0 — selling 3 wood when you have 2 sells 2
+ * (for 1 stone), not 3. Throws if no market is built, since the market
+ * is the only place goods can be converted into stone.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resource: no market is built");
+  }
+  const sold = Math.max(0, Math.min(amount, settlement.resources[resource]));
+  const stoneGained = Math.floor(sold / STONE_PER_SELL_RATIO);
+  return {
+    ...settlement,
+    resources: credit({ ...settlement.resources, [resource]: settlement.resources[resource] - sold }, "stone", stoneGained),
+  };
+}
