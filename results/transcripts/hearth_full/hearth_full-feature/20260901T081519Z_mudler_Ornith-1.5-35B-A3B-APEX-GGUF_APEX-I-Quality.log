import type { ResourceKind, Settlement } from "../types";
import { credit } from "../resources/costs";

/** How many units of a resource convert into a single stone when sold —
 * the market always trades at this fixed 2:1 rate, rounded down. */
const SELL_RATE = 2;

/**
 * Sell `amount` of `resource` to the settlement's market, converting it
 * into stone at a fixed 2:1 rate (rounded down). Never removes more of a
 * resource than the settlement actually has, so the sold resource is
 * never pushed below 0 and any leftover of the requested amount is simply
 * not sold. Requires that a "market" is already built — without one there
 * is nowhere to sell through, so the call throws instead. Returns a new
 * settlement; the input is left untouched.
 */
export function sellResource(
  settlement: Settlement,
  resource: ResourceKind,
  amount: number,
): Settlement {
  if (!settlement.buildings.includes("market")) {
    throw new Error("cannot sell resources: no market has been built");
  }
  const have = settlement.resources[resource];
  const sold = Math.min(amount, Math.max(0, have));
  const stone = Math.floor(sold / SELL_RATE);
  const resources = credit(
    { ...settlement.resources, [resource]: have - sold },
    "stone",
    stone,
  );
  return { ...settlement, resources };
}
```

