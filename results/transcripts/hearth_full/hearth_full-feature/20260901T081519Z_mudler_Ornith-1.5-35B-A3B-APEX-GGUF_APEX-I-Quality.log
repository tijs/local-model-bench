```typescript
import type { BuildingKind, Settlement } from "../types";
import { credit } from "../resources/costs";

/** Ratio of resource units to stone produced when selling — 2 resource
 * units convert into 1 stone. */
const SELL_RATIO = 2;

/**
 * Sell `amount` of `resource` to a market, converting it into stone at a
 * 2:1 ratio (rounded down). Never takes more of a resource than the
 * settlement currently has (so the sold resource is never pushed below 0),
 * and the stone gained is the floor of what was actually sold divided by
 * the sell ratio. Requires that a "market" has already been built,
 * otherwise the settlement has nowhere to sell through. Returns a new
 * settlement; the original is left untouched.
 */
export function sellResource(
  settlement: Settlement,
  resource: ResourceKind,
  amount: number,
): Settlement {
  if (!settlement.buildings.includes("market")) {
    throw new Error("cannot sell resources: no market has been built");
  }
  const have = settlement.resources[resource];
  const sold = Math.min(amount, Math.max(0, have));
  const stone = Math.floor(sold / SELL_RATIO);
  const resources = {
    ...settlement.resources,
    [resource]: have - sold,
    stone: credit(settlement.resources, "stone", stone).stone,
  };
  return { ...settlement, resources };
}
```

