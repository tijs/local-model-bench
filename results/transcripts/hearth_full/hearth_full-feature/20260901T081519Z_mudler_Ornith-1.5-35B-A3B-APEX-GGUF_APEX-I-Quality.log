+import type { BuildingKind, Settlement } from "../types";
+import { countOf } from "../buildings/actions";
+
+/**
+ * Sell `amount` of `resource` to a market, converting it into stone at a
+ * 2:1 ratio (rounded down): every two units of the sold resource yields
+ * one unit of stone. The settlement's stock of `resource` is never taken
+ * below zero — selling more than you own only moves what you actually
+ * have. Requires a "market" building to exist, since only a settlement
+ * with a market can conduct trade; throws otherwise.
+ *
+ * The ratio is expressed in terms of the sold resource: the amount of
+ * stone received is `Math.floor(sold / 2)`, independent of which
+ * resource is being sold (wood, food, or stone alike).
+ */
+export function sellResource(settlement: Settlement, resource: BuildingKind, amount: number): Settlement {
+  if (countOf(settlement, "market") === 0) {
+    throw new Error("cannot sell resources: no market is built");
+  }
+
+  const sold = Math.min(amount, settlement.resources[resource]);
+  const stoneGain = Math.floor(sold / 2);
+
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: settlement.resources[resource] - sold,
+      stone: settlement.resources.stone + stoneGain,
+    },
+  };
+}
