+import type { ResourceKind, Settlement } from "../types";
+
+/** How many units of a sold resource buy one stone at the market — the
+ * market buys everything at this flat rate; see SELL_RATIO. */
+export const SELL_RATIO = 2;
+
+/**
+ * Sells `amount` of `resource` to the market, converting it into stone at
+ * a 2:1 ratio (rounded down). Never takes the sold resource below 0, so
+ * selling more than the settlement holds just empties the stockpile and
+ * credits whatever the held amount is worth. Throws if no market is
+ * built — selling is a market function. Returns a new settlement; the
+ * input is not mutated.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number,
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resources: no market built");
+  }
+  const sold = Math.max(0, Math.min(amount, settlement.resources[resource]));
+  const stoneGained = Math.floor(sold / SELL_RATIO);
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: settlement.resources[resource] - sold,
+      stone: settlement.resources.stone + stoneGained,
+    },
+  };
+}
