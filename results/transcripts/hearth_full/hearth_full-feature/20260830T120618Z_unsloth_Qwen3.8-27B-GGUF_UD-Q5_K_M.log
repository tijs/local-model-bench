@@ -0,0 +1,24 @@
+import type { ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+
+/**
+ * Sells `amount` of `resource` at a built market, converting it to stone at
+ * a 2:1 ratio (rounded down — selling an odd amount loses the remainder).
+ * Never takes the sold resource below 0: if the settlement has less than
+ * `amount` on hand, only what it has is sold. Throws if no market is built.
+ * Immutably returns the updated settlement.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resources: no market built");
+  }
+  const sold = Math.max(0, Math.min(amount, settlement.resources[resource]));
+  const stoneGain = Math.floor(sold / 2);
+  return {
+    ...settlement,
+    resources: credit({
+      ...settlement.resources,
+      [resource]: settlement.resources[resource] - sold,
+    }, "stone", stoneGain),
+  };
+}
