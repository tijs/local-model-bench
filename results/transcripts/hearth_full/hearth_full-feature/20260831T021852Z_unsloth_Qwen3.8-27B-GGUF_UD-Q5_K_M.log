trade.ts implementation:

```ts
import type { ResourceKind, Settlement } from "../types";
import { credit } from "../resources/costs";

/** Two units of any resource sell for one stone — the market's fixed
 * trade ratio. */
export const SELL_RATIO = 2;

/**
 * Sells up to `amount` of `resource` at the market, converting it into
 * stone at a 2:1 ratio (rounded down). Never takes the sold resource
 * below 0 — if the settlement has less of `resource` than `amount`, the
 * entire remainder is sold. Throws if no market is built.
 */
export function sellResource(settlement: Settlement, resource: ResourceKind, amount
: number): Settlement {
  if (!settlement.buildings.includes("market")) {
    throw new Error("cannot sell without a market built");
  }
  const sold = Math.max(0, Math.min(amount, settlement.resources[resource]));
  const stoneGained = Math.floor(sold / SELL_RATIO);
  const resources = { ...settlement.resources, [resource]: settlement.resources[resource
] - sold };
  return { ...settlement, resources: credit(resources, "stone", stoneGained) };
}
```

