+import type { ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+
+/**
+ * Every 2 units of `resource` sold converts to 1 stone — the ratio is
+ * applied to the amount actually sold, rounded down, so an odd leftover
+ * unit (or the odd unit at the bottom of the stock) is simply not
+ * converted.
+ */
+export const STONE_PER_TWO_SOLD = 1;
+
+/**
+ * Sells `amount` of `resource` through the settlement's market, converting
+ * what is actually sold into stone at the 2:1 ratio (rounded down). If
+ * the settlement holds less than `amount` of `resource`, everything it
+ * has is sold — the resource is never taken below 0. Throws if no market
+ * is built, since there is no other way to trade. Returns a new
+ * Settlement; the input is not mutated.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number,
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell: no market built");
+  }
+  const sold = Math.min(Math.max(0, amount), settlement.resources[resource]);
+  const stoneGained = Math.floor(sold / STONE_PER_TWO_SOLD);
+  return {
+    ...settlement,
+    resources: credit(
+      { ...settlement.resources, [resource]: settlement.resources[resource] - sold },
+      "stone",
+      stoneGained,
+    ),
+  };
+}
