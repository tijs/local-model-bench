+import type { BuildingKind, ResourceKind, Settlement } from "../types";
+
+/**
+ * Sell `amount` of `resource` at the market, converting it to stone at a
+ * 2:1 ratio (rounded down).  The sold resource is never taken below 0.
+ *
+ * Throws if the settlement has no market built.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number,
+): Settlement {
+  if (!settlement.buildings.includes("market" as BuildingKind)) {
+    throw new Error("no market built");
+  }
+
+  const actual = Math.min(amount, settlement.resources[resource]);
+  const stoneGain = Math.floor(actual / 2);
+
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: settlement.resources[resource] - actual,
+      stone: settlement.resources.stone + stoneGain,
+    },
+  };
+}
