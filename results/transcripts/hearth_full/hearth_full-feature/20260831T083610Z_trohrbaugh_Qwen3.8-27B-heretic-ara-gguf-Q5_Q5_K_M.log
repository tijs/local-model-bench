+import { describe, expect, it } from "vitest";
+import { sellResource } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function s(overrides: Partial<Settlement> = {}): Settlement {
+  return { resources: { wood: 30, food: 10, stone: 5 }, population: 2, buildings: [], turn: 0, ...overrides };
+}
+
+describe("sellResource", () => {
+  it("throws without a market", () => {
+    expect(() => sellResource(s(), "wood", 10)).toThrow();
+  });
+
+  it("sells 2:1 into stone", () => {
+    const r = sellResource(s({ buildings: ["storehouse", "market"] }), "wood", 10);
+    expect(r.resources).toEqual({ wood: 20, food: 10, stone: 10 });
+  });
+
+  it("rounds down (3 -> 1 stone)", () => {
+    const r = sellResource(s({ buildings: ["market"] }), "food", 3);
+    expect(r.resources).toEqual({ wood: 30, food: 7, stone: 6 });
+  });
+
+  it("clamps at 0, never below", () => {
+    const r = sellResource(s({ buildings: ["market"] }), "wood", 99);
+    expect(r.resources).toEqual({ wood: 0, food: 10, stone: 5 + Math.floor(30 / 2) });
+  });
+
+  it("does not mutate the input", () => {
+    const orig = s({ buildings: ["market"], resources: { wood: 4, food: 10, stone: 5 } });
+    sellResource(orig, "wood", 4);
+    expect(orig.resources.wood).toBe(4);
+  });
+});
