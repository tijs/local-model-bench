@@ -0,0 +1,27 @@
+import type { ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+
+/** Stone received per 2 units of the sold resource (2:1 ratio, rounded
+ * down — see sellResource). */
+export const STONE_PER_SOLD_RATIO = 2;
+
+/**
+ * Sells `amount` of `resource` at the settlement's market, converting it
+ * into stone at a 2:1 ratio (rounded down: 3 units -> 1 stone, 4 -> 2).
+ * If the settlement holds fewer than `amount` units, it sells everything
+ * it has — the resource is never taken below 0. Throws if no market is
+ * built; trading needs one.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number,
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell without a market");
+  }
+  const sold = Math.min(settlement.resources[resource], amount);
+  const gained = Math.floor(sold / STONE_PER_SOLD_RATIO);
+  const resources = { ...settlement.resources, [resource]: settlement.resources[resource] - sold };
+  return { ...settlement, resources: credit(resources, "stone", gained) };
+}
