+import type { Settlement, ResourceKind } from "../types";
+import { credit } from "../resources/costs";
+
+/**
+ * Sells `amount` of `resource` to the market, converting it into stone at
+ * a 2:1 ratio (rounded down) — two units of any resource buy one stone.
+ * The sold resource is never taken below 0 (whatever can't be sold is
+ * simply lost), and the settlement is otherwise returned unchanged.
+ *
+ * Requires a market to have been built — see buildings/registry.ts — since
+ * trade can only happen where a market stands.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resources: no market built");
+  }
+  const sold = Math.floor(amount / 2);
+  const retained = Math.max(0, settlement.resources[resource] - sold);
+  const gainedStone = Math.min(sold, settlement.resources[resource]);
+  return {
+    ...settlement,
+    resources: {
+      ...credit(settlement.resources, resource, -retained),
+      stone: settlement.resources.stone + gainedStone,
+    },
+  };
+}
