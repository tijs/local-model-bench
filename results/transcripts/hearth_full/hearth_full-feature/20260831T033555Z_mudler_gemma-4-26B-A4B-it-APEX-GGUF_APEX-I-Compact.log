@@ -0,0 +1,38 @@
+import { Settlement, ResourceKind } from "../types";
+
+/**
+ * Sells a specified amount of a resource in exchange for stone at a 2:1 ratio.
+ * 
+ * @param settlement The settlement to perform the trade in.
+ * @param resource The kind of resource to sell.
+ * @param amount The amount of the resource to sell.
+ * @returns A new Settlement instance with updated resources.
+ * @throws Error if no market is built in the settlement.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("No market built; cannot trade resources.");
+  }
+
+  const currentAmount = settlement.resources[resource];
+  const sellAmount = Math.min(currentAmount, amount);
+
+  if (sellAmount <= 0) {
+    return settlement;
+  }
+
+  const stoneGain = Math.floor(sellAmount / 2);
+
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: currentAmount - sellAmount,
+      stone: settlement.resources.stone + stoneGain,
+    },
+  };
+}
