@@ -0,0 +1,55 @@
+import { Settlement, ResourceKind } from "../types";
+import { sellResource } from "./trade";
+
+describe("sellResource", () => {
+  const baseSettlement: Settlement = {
+    resources: { wood: 100, food: 100, stone: 100 },
+    population: 10,
+    buildings: [],
+    turn: 1,
+  };
+
+  it("throws if no market is built", () => {
+    expect(() => sellResource(baseSettlement, "wood", 10)).toThrow("No market built; cannot trade resources.");
+  });
+
+  it("successfully sells resource and gains stone at 2:1 ratio", () => {
+    const withMarket: Settlement = {
+      ...baseSettlement,
+      buildings: ["market"],
+    };
+    const result = sellResource(withMarket, "wood", 20);
+    expect(result.resources.wood).toBe(80);
+    expect(result.resources.stone).toBe(110); // 20 / 2 = 10 gain
+  });
+
+  it("rounds down stone gain", () => {
+    const withMarket: Settlement = {
+      ...baseSettlement,
+      buildings: ["market"],
+    };
+    const result = sellResource(withMarket, "wood", 1);
+    expect(result.resources.wood).toBe(99);
+    expect(result.resources.stone).toBe(100); // floor(1/2) = 0 gain
+  });
+
+  it("never takes the sold resource below 0", () => {
+    const withMarket: Settlement = {
+      ...baseSettlement,
+      buildings: ["market"],
+    };
+    const result = sellResource(withMarket, "wood", 200);
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(150); // floor(100/2) = 50 gain
+  });
+
+  it("does nothing if amount is 0 or less", () => {
+    const withMarket: Settlement = {
+      ...baseSettlement,
+      buildings: ["market"],
+    };
+    const result = sellResource(withMarket, "wood", 0);
+    expect(result.resources.wood).toBe(100);
+    expect(result.resources.stone).toBe(100);
+  });
+});
