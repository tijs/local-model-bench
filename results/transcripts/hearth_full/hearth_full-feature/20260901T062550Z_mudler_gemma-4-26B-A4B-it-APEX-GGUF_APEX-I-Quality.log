+import { Settlement, ResourceKind } from "../types";
+
+describe("sellResource", () => {
+  const baseSettlement: Settlement = {
+    resources: { wood: 100, food: 100, stone: 100 },
+    population: 10,
+    buildings: ["hut", "storehouse", "market"],
+    turn: 1,
+  };
+
+  it("should sell wood for stone at 2:1 ratio", () => {
+    const result = sellResource(baseSettlement, "wood", 10);
+    expect(result.resources.wood).toBe(90);
+    expect(result.resources.stone).toBe(105);
+  });
+
+  it("should round down stone gain", () => {
+    const result = sellResource(baseSettlement, "wood", 5);
+    expect(result.resources.wood).toBe(95);
+    expect(result.resources.stone).toBe(102);
+  });
+
+  it("should not sell more than available", () => {
+    const result = sellResource(baseSettlement, "wood", 200);
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(150); // 100 + floor(100/2)
+  });
+
+  it("should not allow selling if no market is built", () => {
+    const noMarketSettlement = { ...baseSettlement, buildings: ["hut", "storehouse"] };
+    expect(() => sellResource(noMarketSettlement, "wood", 10)).toThrow("No market built in settlement");
+  });
