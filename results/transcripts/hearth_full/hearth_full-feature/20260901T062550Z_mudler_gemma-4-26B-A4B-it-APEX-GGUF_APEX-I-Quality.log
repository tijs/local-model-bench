@@ -0,0 +1,34 @@
+import { Settlement, ResourceKind } from "../types";
+
+/**
+ * Sells a given amount of a resource, converting it into stone at a 2:1 ratio.
+ * The sold resource cannot go below 0.
+ * @throws Error if a "market" building is not present in the settlement.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("No market built in settlement");
+  }
+
+  const currentAmount = settlement.resources[resource];
+  const actualAmountToSell = Math.min(amount, currentAmount);
+
+  if (actualAmountToSell <= 0) {
+    return settlement;
+  }
+
+  const stoneGain = Math.floor(actualAmountToSell / 2);
+
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: currentAmount - actualAmountToSell,
+      stone: settlement.resources.stone + stoneGain,
+    },
+  };
+}
