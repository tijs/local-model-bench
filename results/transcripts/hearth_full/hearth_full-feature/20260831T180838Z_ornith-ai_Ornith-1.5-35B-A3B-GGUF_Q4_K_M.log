+import type { BuildingKind, ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+import { countOf } from "../buildings";
+
+/** How much stone one unit of any resource yields when sold — two units
+ * of the sold resource buy one stone, rounded down, so the conversion is
+ * floor(amount / 2). */
+export const SELL_TO_STONE_RATIO = 2;
+
+/**
+ * Sells `amount` of `resource` to the market, converting it into stone at
+ * the 2:1 ratio (floor), and never taking the sold resource below 0 —
+ * selling more than you have simply sells what you have. Only possible
+ * if the settlement has a market; throw otherwise, since without a market
+ * there is no one to trade with.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (countOf(settlement, "market" as BuildingKind) === 0) {
+    throw new Error("cannot sell without a market");
+  }
+  const sold = Math.min(amount, Math.max(0, settlement.resources[resource]));
+  const stone = Math.floor(sold / SELL_TO_STONE_RATIO);
+  const next = credit(settlement.resources, resource, -sold);
+  return { ...settlement, resources: credit(next, "stone", stone) };
+}
