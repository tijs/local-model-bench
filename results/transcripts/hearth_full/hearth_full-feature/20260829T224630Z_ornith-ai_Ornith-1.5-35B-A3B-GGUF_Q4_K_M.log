+import type { ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+
+/**
+ * Sell `amount` of `resource` to the market, converting it into stone at a
+ * 2:1 ratio (rounded down): two units of any resource buy one unit of
+ * stone. The sold resource is never taken below zero, so selling more
+ * than the settlement holds simply sells all it has. Requires a market to
+ * be built — without one there is nowhere to trade — and throws otherwise.
+ *
+ * Returns a new settlement; the input is left untouched.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell resource: no market is built");
+  }
+
+  const available = Math.max(0, settlement.resources[resource]);
+  const sold = Math.min(available, amount);
+  const earned = Math.floor(sold / 2);
+
+  return {
+    ...settlement,
+    resources: credit(settlement.resources, resource, -sold),
+  };
+}
