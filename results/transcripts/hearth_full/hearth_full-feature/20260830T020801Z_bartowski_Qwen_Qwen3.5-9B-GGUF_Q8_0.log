+import type { Settlement } from "../types";
+
+/**
+ * Sell `amount` of the given resource at a 2:1 ratio (2 units of resource
+ * become 1 unit of stone), rounded down. Never takes the sold resource
+ * below 0. Throws if no market is built.
+ */
+export function sellResource(settlement: Settlement, resource: "wood" | "food" | "stone", amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("Cannot sell resources: no market built");
+  }
+
+  const soldAmount = Math.max(0, amount);
+  const stoneGained = Math.floor(soldAmount / 2);
+
+  settlement.resources[resource] -= soldAmount;
+  settlement.resources["stone"] += stoneGained;
+
+  return settlement;
+}
