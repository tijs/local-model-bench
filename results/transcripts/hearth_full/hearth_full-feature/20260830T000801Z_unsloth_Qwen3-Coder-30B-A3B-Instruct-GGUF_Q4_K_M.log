+import type { Settlement, ResourceKind } from "../types";
+
+/**
+ * Sells the given amount of a resource for stone at a 2:1 ratio (rounded down).
+ * Never takes the sold resource below 0.
+ * Throws if no market is built.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  // Check if market is built
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("Cannot sell resources: no market built");
+  }
+
+  // Ensure we don't sell more than we have
+  const availableAmount = settlement.resources[resource];
+  const sellAmount = Math.min(amount, availableAmount);
+  
+  // If nothing to sell, return unchanged
+  if (sellAmount <= 0) {
+    return settlement;
+  }
+  
+  // Calculate stone gained (2:1 ratio, rounded down)
+  const stoneGained = Math.floor(sellAmount / 2);
+  
+  // Create a new settlement with updated resources
+  const newResources = { ...settlement.resources };
+  newResources[resource] -= sellAmount;
+  newResources.stone += stoneGained;
+  
+  return {
+    ...settlement,
+    resources: newResources
+  };
+}
