+import { describe, it, expect } from 'vitest';
+import type { Settlement } from '../src/types';
+import { sellResource } from '../src/sim/trade';
+
+describe('sellResource', () => {
+  it('should sell resources for stone at a 2:1 ratio', () => {
+    const settlement: Settlement = {
+      resources: { wood: 10, food: 5, stone: 3 },
+      population: 5,
+      buildings: ['market'],
+      turn: 0
+    };
+
+    const result = sellResource(settlement, 'wood', 4);
+    
+    expect(result.resources.wood).toBe(6); // 10 - 4
+    expect(result.resources.stone).toBe(5); // 3 + 2 (4/2 = 2)
+  });
+
+  it('should throw an error if no market is built', () => {
+    const settlement: Settlement = {
+      resources: { wood: 10, food: 5, stone: 3 },
+      population: 5,
+      buildings: [],
+      turn: 0
+    };
+
+    expect(() => sellResource(settlement, 'wood', 4)).toThrow('Cannot sell resources: no market built');
+  });
+
+  it('should handle selling zero or negative amounts gracefully', () => {
+    const settlement: Settlement = {
+      resources: { wood: 10, food: 5, stone: 3 },
+      population: 5,
+      buildings: ['market'],
+      turn: 0
+    };
+
+    const result = sellResource(settlement, 'wood', 0);
+    
+    expect(result.resources.wood).toBe(10);
+    expect(result.resources.stone).toBe(3);
+  });
+
+  it('should not sell more than available resources', () => {
+    const settlement: Settlement = {
+      resources: { wood: 5, food: 5, stone: 3 },
+      population: 5,
+      buildings: ['market'],
+      turn: 0
+    };
+
+    const result = sellResource(settlement, 'wood', 10);
+    
+    expect(result.resources.wood).toBe(0); // All wood sold
+    expect(result.resources.stone).toBe(8); // 3 + 2 (5/2 = 2, rounded down)
+  });
+
+  it('should work with different resource types', () => {
+    const settlement: Settlement = {
+      resources: { wood: 10, food: 5, stone: 3 },
+      population: 5,
+      buildings: ['market'],
+      turn: 0
+    };
+
+    const result = sellResource(settlement, 'food', 4);
+    
+    expect(result.resources.food).toBe(1); // 5 - 4
+    expect(result.resources.stone).toBe(5); // 3 + 2 (4/2 = 2)
+  });
+});
