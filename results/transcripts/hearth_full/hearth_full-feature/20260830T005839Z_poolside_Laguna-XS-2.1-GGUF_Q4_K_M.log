+import type { Settlement, ResourceKind } from "../types";
+import { BUILDING_REGISTRY } from "../buildings/registry";
+
+/**
+ * Sells `amount` of `resource` from the settlement, converting it to stone
+ * at a 2:1 ratio (rounded down). Never takes the sold resource below 0.
+ * Throws if no market is built in the settlement.
+ */
+export function sellResource(
+  settlement: Settlement,
+  resource: ResourceKind,
+  amount: number
+): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("Cannot sell resources: no market is built");
+  }
+
+  const currentAmount = settlement.resources[resource];
+  const amountToSell = Math.min(amount, currentAmount);
+  const stoneEarned = Math.floor(amountToSell / 2);
+
+  return {
+    ...settlement,
+    resources: {
+      ...settlement.resources,
+      [resource]: currentAmount - amountToSell,
+      stone: settlement.resources.stone + stoneEarned,
+    },
+  };
+}
