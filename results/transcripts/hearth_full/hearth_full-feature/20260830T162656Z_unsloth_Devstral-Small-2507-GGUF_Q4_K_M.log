@@ -0,0 +1,58 @@
+import { expect, test } from "vitest";
+import { sellResource } from "../src/sim/trade";
+import type { Settlement } from "../src/types";
+
+// Helper function to create a test settlement
+test("sellResource should convert wood to stone at 2:1 ratio", () => {
+  const settlement: Settlement = {
+    resources: { wood: 20, stone: 10, food: 5 },
+    population: 5,
+    buildings: ["hut", "storehouse", "market"],
+    turn: 0,
+  };
+
+  const result = sellResource(settlement, "wood", 6); // 6 wood -> 3 stone
+
+  expect(result.resources.wood).toBe(14); // 20 - 6
+  expect(result.resources.stone).toBe(13); // 10 + 3
+  expect(result.resources.food).toBe(5); // unchanged
+});
+
+test("sellResource should not go below 0 resources", () => {
+  const settlement: Settlement = {
+    resources: { wood: 3, stone: 10 },
+    population: 5,
+    buildings: ["hut", "storehouse", "market"],
+    turn: 0,
+  };
+
+  const result = sellResource(settlement, "wood", 10); // try to sell 10 but only have 3
+
+  expect(result.resources.wood).toBe(0); // all wood sold
+  expect(result.resources.stone).toBe(11); // 3 wood -> 1 stone
+});
+
+test("sellResource should throw if no market is built", () => {
+  const settlement: Settlement = {
+    resources: { wood: 20, stone: 10 },
+    population: 5,
+    buildings: ["hut", "storehouse"], // no market
+    turn: 0,
+  };
+
+  expect(() => sellResource(settlement, "wood", 6)).toThrow("Cannot sell resources: no market is built");
+});
+
+test("sellResource should work with other resources", () => {
+  const settlement: Settlement = {
+    resources: { food: 20, stone: 10 },
+    population: 5,
+    buildings: ["hut", "storehouse", "market"],
+    turn: 0,
+  };
+
+  const result = sellResource(settlement, "food", 8); // 8 food -> 4 stone
+
+  expect(result.resources.food).toBe(12); // 20 - 8
+  expect(result.resources.stone).toBe(14); // 10 + 4
+});
