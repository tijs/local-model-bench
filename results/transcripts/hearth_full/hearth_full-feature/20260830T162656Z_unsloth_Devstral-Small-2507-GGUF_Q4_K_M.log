a/src/sim/trade.ts → b/src/sim/trade.ts
@@ -0,0 +1,28 @@
+import type { Settlement, ResourceKind, Resources } from "../types";
+
+/**
+ * Converts `amount` of the given resource into stone at a 2:1 ratio
+ * (rounded down), never taking the sold resource below 0. Throws if no
+ * market is built.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("Cannot sell resources: no market is built");
+  }
+
+  // Create a copy of the settlement to avoid mutating the original
+  const newSettlement = { ...settlement, resources: { ...settlement.resources } };
+
+  // Calculate how much stone we get (2:1 ratio, rounded down)
+  const stoneGain = Math.floor(amount / 2);
+
+  // Calculate how much of the resource we can actually sell
+  // (never go below 0)
+  const resourceToSell = Math.min(amount, settlement.resources[resource] || 0);
+
+  // Update resources
+  newSettlement.resources[resource] = (settlement.resources[resource] || 0) - resourceToSell;
+  newSettlement.resources.stone = (settlement.resources.stone || 0) + stoneGain;
+
+  return newSettlement;
+}
