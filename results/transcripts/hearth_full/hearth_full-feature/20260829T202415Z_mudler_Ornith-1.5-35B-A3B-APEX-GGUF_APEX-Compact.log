+import type { ResourceKind, Settlement } from "../types";
+import { credit } from "../resources/costs";
+import { countOf } from "../buildings";
+
+/**
+ * How much stone a single unit of any resource fetches at the market —
+ * one stone per two units sold, i.e. a 2:1 ratio. Kept as a named
+ * constant so the ratio is obvious at the call site and easy to tune
+ * without digging through the arithmetic in sellResource.
+ */
+export const SELL_TO_STONE_RATIO = 2;
+
+/**
+ * Sells `amount` of `resource` at the market, converting it into stone at
+ * a 2:1 ratio (rounded down). Never takes the sold resource below zero —
+ * if the settlement holds fewer than `amount` of that resource, only what
+ * it actually has is sold. Returns a new settlement; the settlement itself
+ * is not mutated.
+ *
+ * Requires a market to be built — there is nowhere to sell to otherwise,
+ * so this throws if the settlement has none.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (countOf(settlement, "market") === 0) {
+    throw new Error(`cannot sell ${resource}: no market built`);
+  }
+
+  const have = settlement.resources[resource];
+  const sold = Math.min(amount, have);
+  const stoneGained = Math.floor(sold / SELL_TO_STONE_RATIO);
+
+  const resources = { ...settlement.resources, [resource]: have - sold };
+  return {
+    ...settlement,
+    resources: credit(resources, "stone", stoneGained),
+  };
+}
