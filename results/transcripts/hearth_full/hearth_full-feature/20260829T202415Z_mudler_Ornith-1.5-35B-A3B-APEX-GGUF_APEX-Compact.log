```ts
import type { BuildingKind, ResourceKind, Resources, Settlement } from "../types";

import { credit } from "../resources/costs";
import { countOf } from "../buildings";

export function sellResource(settlement: Settlement, resource: ResourceKind, amount
: number): Settlement {
  if (countOf(settlement, "market") === 0) {
    throw new Error(`cannot sell ${resource}: no market built`);
  }
  const available = settlement.resources[resource] ?? 0;
  const sold = Math.min(Math.max(0, amount), available);
  const stoneGained = Math.floor(sold / 2);
  const resources = credit(settlement.resources, "stone", stoneGained);
  resources[resource] = resources[resource] - sold;
  return { ...settlement, resources };
}
```

