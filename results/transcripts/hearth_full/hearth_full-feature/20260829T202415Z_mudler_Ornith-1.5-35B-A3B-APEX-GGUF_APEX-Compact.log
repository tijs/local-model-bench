+import { describe, expect, it } from "vitest";
+import { availableBuildings, build } from "../src/buildings";
+import { sellResource } from "../src/sim/trade";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("market building", () => {
+  it("requires a storehouse before it becomes available", () => {
+    const s = settlement({ resources: { wood: 100, food: 10, stone: 100 } });
+    expect(availableBuildings(s)).not.toContain("market");
+  });
+
+  it("becomes available once a storehouse is built", () => {
+    const s = settlement({ resources: { wood: 100, food: 10, stone: 100 }, buildings: ["storehouse"] });
+    expect(availableBuildings(s)).toContain("market");
+  });
+
+  it("costs wood: 20, stone: 15", () => {
+    const s = build(settlement({ resources: { wood: 30, food: 10, stone: 15 } }), "market");
+    expect(s.resources.wood).toBe(10);
+    expect(s.resources.stone).toBe(0);
+    expect(s.buildings).toContain("market");
+  });
+});
+
+describe("sellResource", () => {
+  it("throws when no market is built", () => {
+    expect(() => sellResource(settlement(), "wood", 10)).toThrow();
+  });
+
+  it("converts at a 2:1 ratio, rounded down", () => {
+    const s = settlement({ buildings: ["market"], resources: { wood: 40, food: 10, stone: 10 } });
+    const result = sellResource(s, "wood", 40);
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(30); // 10 base + 20 sold -> 10
