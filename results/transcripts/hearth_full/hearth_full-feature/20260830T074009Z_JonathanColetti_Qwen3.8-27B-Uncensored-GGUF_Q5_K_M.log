+import type { ResourceKind, Settlement } from "../types";
+import { credit, deduct } from "../resources/costs";
+
+/**
+ * Sells `amount` of `resource` at the market for stone at a 2:1 ratio
+ * (2 units sold -> 1 stone, rounded down), never taking the sold
+ * resource below 0. The stone payout is credited to `settlement.stone`.
+ * Throws if the settlement has no market built — the market is what
+ * makes trade possible in the first place.
+ */
+export function sellResource(settlement: Settlement, resource: ResourceKind, amount: number): Settlement {
+  if (!settlement.buildings.includes("market")) {
+    throw new Error("cannot sell: no market built");
+  }
+  const sold = Math.max(0, Math.min(amount, settlement.resources[resource]));
+  const stoneGained = Math.floor(sold / 2);
+  const resources = credit(deduct(settlement.resources, { [resource]: sold }), "stone", stoneGained);
+  return { ...settlement, resources };
+}
