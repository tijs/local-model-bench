import type { BuildingKind, ResourceKind, Settlement } from "../types";
import { credit } from "../resources/costs";

/**
 * Sells `amount` of `resource` at the market, converting it into stone at a
 * 2:1 ratio (rounded down) — selling 5 wood yields 2 stone. Never takes the
 * sold resource below 0, so selling more than you have simply sells what you
 * have. Requires a market to be built, since nothing sells without one.
 */
export function sellResource(settlement: Settlement, resource: ResourceKind, amount
: number): Settlement {
  if (!settlement.buildings.includes("market" as BuildingKind)) {
    throw new Error("cannot sell without a market");
  }
  const sold = Math.min(amount, settlement.resources[resource]);
  const stoneGained = Math.floor(sold / 2);
  return {
    ...settlement,
    resources: credit(settlement.resources, resource, -sold),
    ... (stoneGained > 0 ? { resources: credit(settlement.resources, resource, -sold
) } : {}),
  };
}
```

