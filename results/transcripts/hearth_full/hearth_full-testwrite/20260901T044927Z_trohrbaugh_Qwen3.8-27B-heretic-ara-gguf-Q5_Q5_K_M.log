+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost, rounded up per resource", () => {
+    // Storehouse costs wood 25, stone 10 -> repair costs ceil(25/2)=13 wood, ceil(10/2)=5 stone.
+    const s = settlement({
+      resources: { wood: 40, food: 10, stone: 20 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources).toEqual({ wood: 27, food: 10, stone: 15 });
+    // Repairing must not touch the building list.
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  it("charges exactly half when the cost is even", () => {
+    // Hut costs wood 10 -> repair costs 5 wood.
+    const s = settlement({
+      resources: { wood: 20, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(15);
+  });
+
+  it("rounds up each odd cost independently per resource", () => {
+    // Farm costs wood 15, stone 5 -> repair costs ceil(15/2)=8 wood, ceil(5/2)=3 stone.
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(22);
+    expect(result.resources.stone).toBe(7);
+    expect(result.resources.food).toBe(10); // not in the cost, untouched
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({
+      resources: { wood: 40, food: 10, stone: 20 },
+      buildings: ["hut", "quarry"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result).toEqual(s);
+    expect(result.resources).toEqual({ wood: 40, food: 10, stone: 20 });
+  });
+
+  it("is a no-op for an empty settlement", () => {
+    const s = settlement();
+    const result = repairBuilding(s, "hut");
+    expect(result).toEqual(s);
+  });
+
+  it("clamps a resource at 0 when the settlement has less than the repair cost", () => {
+    // Storehouse repair costs 13 wood, 5 stone; the settlement only has 5 wood.
+    const s = settlement({
+      resources: { wood: 5, food: 10, stone: 100 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources.wood).toBe(0); // 5 - 13 would be -8, clamped
+    expect(result.resources.stone).toBe(95); // 100 - 5, unaffected by the wood clamp
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("clamps each resource independently, even from different shortages", () => {
