@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import { BUILDING_REGISTRY } from "../src/buildings/registry";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 }; half rounded up is
+    // ceil(25/2) = 13 wood and ceil(10/2) = 5 stone.
+    const s = settlement({ buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources).toEqual({ wood: 17, food: 10, stone: 5 });
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  it("rounds the half-cost up when the original cost is odd", () => {
+    // hut costs { wood: 10 } -> 5 (exact). farm costs { wood: 15, stone: 5 }
+    // -> ceil(15/2) = 8 wood, ceil(5/2) = 3 stone (odd numerator rounds up).
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+
+    const expectedWood = 30 - Math.ceil(BUILDING_REGISTRY.farm.cost.wood / 2); // 30 - 8
+    const expectedStone = 10 - Math.ceil(BUILDING_REGISTRY.farm.cost.stone / 2); // 10 - 3
+    expect(result.resources.wood).toBe(expectedWood);
+    expect(result.resources.stone).toBe(expectedStone);
+    expect(result.resources).toEqual({ wood: 22, food: 10, stone: 7 });
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result).toBe(s); // same reference: nothing was spent or changed
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0", () => {
+    // storehouse repair costs 13 wood and 5 stone, but the settlement has
+    // only 2 wood and 0 stone — both clamp to 0 rather than going negative.
+    const s = settlement({ resources: { wood: 2, food: 10, stone: 0 }, buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources).toEqual({ wood: 0, food: 10, stone: 0 });
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+});
