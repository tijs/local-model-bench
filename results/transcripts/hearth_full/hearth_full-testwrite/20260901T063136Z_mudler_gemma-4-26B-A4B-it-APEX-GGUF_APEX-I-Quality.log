import { repairBuilding } from "../src/buildings/actions";
import type { Settlement, BuildingKind, ResourceKind } from "../src/types";

function settlement(overrides: Partial<Settlement> = {}): Settlement {
  return {
    resources: { wood: 30, food: 10, stone: 10 },
    population: 2,
    buildings: [],
    turn: 0,
    ...overrides,
  };
}

describe("repairBuilding", () => {
  it("is a no-op if the settlement doesn't have that building", () => {
    const s = settlement({ buildings: ["hut"] });
    const result = repairBuilding(s, "storehouse");
    expect(result).toEqual(s);
  });

  it("repairs for half the cost, rounding up (e.g., storehouse)", () => {
    // storehouse cost: { wood: 25, stone: 10 }
    // repair cost: { wood: 13, stone: 5 }
    const s = settlement({
      resources: { wood: 100, food: 10, stone: 100 },
      buildings: ["hut", "storehouse"],
    });
    const result = repairBuilding(s, "storehouse");
    expect(result.resources.wood).toBe(87);
    expect(result.resources.stone).toBe(95);
    expect(result.buildings).toEqual(["hut", "storehouse"]);
  });

  it("does not take resources below 0 if the settlement has less than the repair cost", () => {
    // hut cost: { wood: 10 }
    // repair cost: { wood: 5 }
    const s = settlement({
      resources: { wood: 2, food: 10, stone: 10 },
      buildings: ["hut"],
    });
    const result = repairBuilding(s, "hut");
    expect(result.resources.wood).toBe(0);
    expect(result.resources.food).toBe(10);
    expect(result.resources.stone).toBe(10);
  });
});
