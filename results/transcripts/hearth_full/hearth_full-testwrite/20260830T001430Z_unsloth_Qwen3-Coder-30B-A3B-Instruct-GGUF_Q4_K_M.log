+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const original = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(original, "farm");
+    expect(result).toBe(original);
+  });
+
+  it("repairs a building for half its original cost (rounded up) per resource", () => {
+    // Test with storehouse which has an odd-numbered cost (wood: 25)
+    const original = settlement({ 
+      buildings: ["storehouse"],
+      resources: { wood: 30, food: 10, stone: 10 }
+    });
+    const result = repairBuilding(original, "storehouse");
+    
+    // Storehouse costs wood: 25, stone: 10
+    // Half cost rounded up: wood: ceil(25/2) = 13, stone: ceil(10/2) = 5
+    expect(result.resources.wood).toBe(17); // 30 - 13
+    expect(result.resources.stone).toBe(5);  // 10 - 5
+    expect(result.resources.food).toBe(10);  // unchanged
+  });
+
+  it("never takes resources below 0", () => {
+    // Test with a case where repair would cost more than available resources
+    const original = settlement({ 
+      buildings: ["storehouse"],
+      resources: { wood: 10, food: 10, stone: 5 }
+    });
+    const result = repairBuilding(original, "storehouse");
+    
+    // Storehouse costs wood: 25, stone: 10
+    // Half cost rounded up: wood: ceil(25/2) = 13, stone: ceil(10/2) = 5
+    // But we only have 10 wood and 5 stone, so resources should be set to 0
+    expect(result.resources.wood).toBe(0);   // 10 - 10 = 0 (not -3)
+    expect(result.resources.stone).toBe(0);  // 5 - 5 = 0 (not 0)
+    expect(result.resources.food).toBe(10);  // unchanged
+  });
+});

