+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs for half the original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 } -> repair is ceil(25/2)=13 wood, ceil(10/2)=5 stone
+    const s = settlement({
+      resources: { wood: 100, food: 5, stone: 100 },
+      buildings: ["hut", "storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources).toEqual({ wood: 87, food: 5, stone: 95 });
+  });
+
+  it("charges exact half when costs are even", () => {
+    // hut costs { wood: 10 } -> repair is 5
+    const s = settlement({
+      resources: { wood: 40, food: 0, stone: 0 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources).toEqual({ wood: 35, food: 0, stone: 0 });
+  });
+
+  it("leaves resources the building's cost doesn't touch alone", () => {
+    const s = settlement({
+      resources: { wood: 100, food: 7, stone: 100 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources.food).toBe(7);
+  });
+
+  it("does not mutate the input settlement", () => {
+    const s = settlement({
+      resources: { wood: 100, food: 5, stone: 100 },
+      buildings: ["storehouse"],
+    });
+    repairBuilding(s, "storehouse");
+    expect(s.resources).toEqual({ wood: 100, food: 5, stone: 100 });
+  });
+
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    // storehouse repair wants 13 wood / 5 stone, but the settlement has only 3 wood / 2 stone
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 2 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources).toEqual({ wood: 0, food: 10, stone: 0 });
+  });
+});
