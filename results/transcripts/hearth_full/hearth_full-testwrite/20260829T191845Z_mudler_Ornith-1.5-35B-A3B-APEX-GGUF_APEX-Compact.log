+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 100, food: 10, stone: 100 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  // Behavior 1: repairs for half the original cost, rounded up per resource.
+  // storehouse costs wood 25, stone 10 — the odd wood cost rounds up:
+  // ceil(25/2) = 13 wood (not 12), ceil(10/2) = 5 stone.
+  it("charges half the original cost, rounded up per resource", () => {
+    const s = settlement({ buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(100 - 13); // 87
+    expect(result.resources.stone).toBe(100 - 5); // 95
+    // The building itself is unchanged — repair does not add/remove buildings.
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  // Behavior 2: a no-op when the settlement doesn't have that building.
+  it("is a no-op when the building isn't built", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 100, food: 10, stone: 100 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("is a no-op when the settlement has no buildings", () => {
+    const s = settlement();
+    const result = repairBuilding(s, "farm");
+
+    expect(result).toBe(s);
+  });
+
+  // Behavior 3: never takes a resource below 0, even when the settlement
+  // has less of a resource than the repair would cost.
+  it("clamps a resource to 0 rather than going negative", () => {
+    // storehouse repair needs 13 wood, but the settlement only has 10.
+    const s = settlement({ buildings: ["storehouse"], resources: { wood: 10, food: 10, stone: 100 } });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(0);
+    // The other resource is still charged its (affordable) repair cost.
+    expect(result.resources.stone).toBe(95);
+  });
+
+  // Sanity check that repair never mutates the input settlement.
+  it("does not mutate the original settlement", () => {
+    const s = settlement({ buildings: ["storehouse"] });
+    repairBuilding(s, "storehouse");
+
+    expect(s.resources).toEqual({ wood: 100, food: 10, stone: 100 });
+  });
+});
