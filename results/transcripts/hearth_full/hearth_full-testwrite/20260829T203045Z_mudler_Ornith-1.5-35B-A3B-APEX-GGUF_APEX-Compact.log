+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 100, food: 10, stone: 100 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 100, food: 10, stone: 100 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("is a no-op for a building the settlement has never had", () => {
+    const s = settlement();
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 100, food: 10, stone: 100 });
+    expect(result.buildings).toEqual([]);
+  });
+
+  it("charges half the original cost, rounding up per resource", () => {
+    // storehouse costs {wood: 25, stone: 10}; repair is wood ceil(25/2)=13,
+    // stone ceil(10/2)=5. The odd wood cost is the one that must round up.
+    const s = settlement({ buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources).toEqual({ wood: 87, food: 10, stone: 95 });
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  it("rounds up every odd resource cost independently", () => {
+    // farm costs {wood: 15, stone: 5}; both are odd: wood ceil(15/2)=8,
+    // stone ceil(5/2)=3.
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources).toEqual({ wood: 92, food: 10, stone: 97 });
+  });
+
+  it("never takes a resource below zero", () => {
+    // storehouse repair needs 13 wood, but only 10 is available — clamps
+    // to 0 rather than going negative.
+    const s = settlement({ buildings: ["storehouse"], resources: { wood: 10, food: 10, stone: 100 } });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(95);
+  });
+});
