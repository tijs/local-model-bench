```ts
import { describe, expect, it } from "vitest";
import { repairBuilding } from "../src/buildings";
import type { Settlement } from "../src/types";

function settlement(overrides: Partial<Settlement> = {}): Settlement {
  return {
    resources: { wood: 30, food: 10, stone: 10 },
    population: 2,
    buildings: [],
    turn: 0,
    ...overrides,
  };
}

describe("repairBuilding", () => {
  it("deducts half the original cost per resource, rounded up (storehouse)", () =>
 {
    // Storehouse cost: wood 25, stone 10 -> repair cost ceil(25/2)=13 wood, ceil
(10/2)=5 stone
    const s = settlement({
      resources: { wood: 25, food: 10, stone: 10 },
      buildings: ["storehouse"],
    });
    const result = repairBuilding(s, "storehouse");
    expect(result.resources).toEqual({ wood: 12, food: 10, stone: 5 });
    expect(result.buildings).toEqual(["storehouse"]);
  });
```

Wait, rounding: storehouse's wood 25 → ceil(12.5) = 13 → 25-13=12. Stone 10 → 5 →
 10-5=5. Food is unchanged. Good.

  - Even-cost case: hut wood 10 → 5.
  - farm: wood 15 → 8, stone 5 → 3 (both odd — good rounding coverage).

  it("leaves resources untouched when the building isn't built (no-op)", () => {
    const s = settlement({ buildings: ["hut"] });
    const result = repairBuilding(s, "storehouse");
    expect(result).toEqual(s);
  });

  it("never takes a resource below 0", () => {
    // storehouse repair cost: 13 wood, 5 stone; settlement has only 2 wood and 1
 stone
    const s = settlement({
      resources: { wood: 2, food: 10, stone: 1 },
      buildings: ["storehouse"],
