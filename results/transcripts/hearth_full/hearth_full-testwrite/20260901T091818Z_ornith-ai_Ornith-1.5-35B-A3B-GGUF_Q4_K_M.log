+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import { BUILDING_REGISTRY } from "../src/buildings/registry";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 }; 25 is odd so it rounds up to 13,
+    // 10 is even so it stays 5.
+    const cost = BUILDING_REGISTRY["storehouse"].cost;
+    const expected = {
+      wood: Math.ceil(cost.wood / 2),
+      stone: Math.ceil(cost.stone / 2),
+    };
+
+    const s = settlement({
+      buildings: ["storehouse"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(expected.wood);
+    expect(result.resources.stone).toBe(expected.stone);
+    expect(result.resources.food).toBe(10); // untouched resource stays put
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+
+    // No-op: returns the very same settlement object, unchanged.
+    expect(result).toBe(s);
+    expect(result.resources).toEqual(s.resources);
+    expect(result.buildings).toEqual(s.buildings);
+  });
+
+  it("never takes a resource below 0", () => {
+    // Repairing a hut costs 5 wood; the settlement only has 3.
+    const s = settlement({ buildings: ["hut"], resources: { wood: 3, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "hut");
+
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+  });
+});
