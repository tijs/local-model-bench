+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    const s = settlement({
+      resources: { wood: 20, food: 0, stone: 0 },
+      buildings: ["hut"],
+    });
+    const after = repairBuilding(s, "hut");
+    // hut cost wood 10, repair ceil(10/2)=5
+    expect(after.resources.wood).toBe(15);
+    expect(after.resources.food).toBe(0);
+    expect(after.resources.stone).toBe(0);
+    expect(after.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up repair cost per resource for odd-numbered costs (storehouse)", () => {
+    const s = settlement({
+      resources: { wood: 25, food: 0, stone: 10 },
+      buildings: ["hut", "storehouse"],
+    });
+    const after = repairBuilding(s, "storehouse");
+    // storehouse cost wood 25 stone 10 -> repair wood ceil(12.5)=13, stone ceil(5)=5
+    expect(after.resources.wood).toBe(12);
+    expect(after.resources.stone).toBe(5);
+    // food unchanged
+    expect(after.resources.food).toBe(0);
+    expect(after.buildings).toContain("storehouse");
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const after = repairBuilding(s, "farm");
+    // unchanged
+    expect(after).toBe(s);
+    expect(after.resources).toEqual(s.resources);
+    expect(after.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    const s = settlement({
+      resources: { wood: 2, food: 0, stone: 0 },
+      buildings: ["hut"],
+    });
+    const after = repairBuilding(s, "hut");
+    // repair cost 5, wood 2 -> max(0, 2-5)=0
+    expect(after.resources.wood).toBe(0);
+  });
+
+  it("caps each resource individually when insufficient", () => {
+    const s = settlement({
+      resources: { wood: 5, food: 1, stone: 10 },
+      buildings: ["farm"],
+    });
+    const after = repairBuilding(s, "farm");
+    // farm cost wood 15 stone 5 -> repair wood 8 stone 3
+    // wood 5-8 => 0, stone 10-3 => 7, food unchanged
+    expect(after.resources.wood).toBe(0);
+    expect(after.resources.stone).toBe(7);
+    expect(after.resources.food).toBe(1);
+  });
+});
Created tests/repair.test.ts covering the three required behaviors for `repairBuilding` and verified they pass.

