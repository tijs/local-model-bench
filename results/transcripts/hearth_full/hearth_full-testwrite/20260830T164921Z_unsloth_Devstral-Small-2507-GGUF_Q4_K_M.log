+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+describe("repairBuilding", () => {
+  // Helper function to create a test settlement
+  function createSettlement(buildings: string[], resources: Record<string, number>) {
+    return {
+      resources: resources as any, // Type assertion for test
+      population: 10,
+      buildings: buildings as any, // Type assertion for test
+      turn: 1,
+    };
+  }
+
+  it("should be a no-op if the settlement doesn't have that building", () => {
+    const settlement = createSettlement(["hut", "farm"], { wood: 100, food: 50, stone: 30 });
+    const result = repairBuilding(settlement, "storehouse");
+    expect(result).toBe(settlement);
+    expect(result).not.toBe(settlement); // Shallow copy check
+    expect(result.resources).toBe(settlement.resources); // Same resources
+  });
+
+  it("should repair a building for half its original cost (rounded up)", () => {
+    // Test with storehouse which has wood: 25, stone: 10
+    const settlement = createSettlement(["hut", "storehouse"], { wood: 100, food: 50, stone: 100 });
+    const result = repairBuilding(settlement, "storehouse");
+    expect(result.resources.wood).toBe(77); // 100 - Math.ceil(25/2) = 100 - 13 = 87
+    expect(result.resources.stone).toBe(95); // 100 - Math.ceil(10/2) = 100 - 5 = 95
+    expect(result.resources.food).toBe(50); // Unchanged
+  });
+
+  it("should never take resources below 0", () => {
+    // Test with storehouse but very low resources
+    const settlement = createSettlement(["hut", "storehouse"], { wood: 10, food: 50, stone: 3 });
+    const result = repairBuilding(settlement, "storehouse");
+    expect(result.resources.wood).toBe(0); // 10 - 13 = -3, clamped to 0
+    expect(result.resources.stone).toBe(0); // 3 - 5 = -2, clamped to 0
+  });
+
+  it("should handle odd-numbered costs correctly", () => {
+    // Test with farm which has wood: 15, stone: 5
+    const settlement = createSettlement(["farm"], { wood: 100, food: 50, stone: 100 });
+    const result = repairBuilding(settlement, "farm");
+    expect(result.resources.wood).toBe(92); // 100 - Math.ceil(15/2) = 100 - 8 = 92
+    expect(result.resources.stone).toBe(97); // 100 - Math.ceil(5/2) = 100 - 3 = 97
+  });
+});
