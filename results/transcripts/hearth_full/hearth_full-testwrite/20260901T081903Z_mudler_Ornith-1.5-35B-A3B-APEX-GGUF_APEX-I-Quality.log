+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 }; halved and rounded up that is
+    // wood 13 (12.5 -> 13) and stone 5 (10/2).
+    const s = settlement({ buildings: ["storehouse"], resources: { wood: 30, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result).not.toBe(s);
+    expect(result.buildings).toEqual(["storehouse"]);
+    expect(result.resources).toEqual({ wood: 17, food: 10, stone: 5 });
+  });
+
+  it("leaves the settlement untouched when it doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 30, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("does not take a resource below 0 when the settlement is short of it", () => {
+    // Storehouse repair costs wood 13; the settlement only has 5 wood.
+    const s = settlement({ buildings: ["storehouse"], resources: { wood: 5, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(5);
+  });
+});
