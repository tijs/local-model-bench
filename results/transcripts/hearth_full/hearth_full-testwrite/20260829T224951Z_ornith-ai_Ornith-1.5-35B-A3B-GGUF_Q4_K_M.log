+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 100, food: 0, stone: 100 },
+    population: 1,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs for half the original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 }; half rounds up to 13 wood
+    // and 5 stone (25 is odd -> 13, 10 is even -> 5).
+    const result = repairBuilding(settlement({ buildings: ["storehouse"] }), "storehouse");
+    expect(result.resources.wood).toBe(87);
+    expect(result.resources.stone).toBe(95);
+  });
+
+  it("rounds up independently for each resource with an odd cost", () => {
+    // farm costs { wood: 15, stone: 5 }; both are odd, so each rounds up
+    // on its own: 15 -> 8 wood, 5 -> 3 stone.
+    const result = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(result.resources.wood).toBe(92);
+    expect(result.resources.stone).toBe(97);
+  });
+
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 40, food: 0, stone: 40 } });
+    const result = repairBuilding(s, "storehouse");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 40, food: 0, stone: 40 });
+  });
+
+  it("never takes a resource below 0 when the settlement is short", () => {
+    // storehouse repair costs 13 wood, but the settlement only has 5 wood;
+    // wood floors at 0 while stone is still deducted in full.
+    const result = repairBuilding(
+      settlement({ buildings: ["storehouse"], resources: { wood: 5, food: 0, stone: 100 } }),
+      "storehouse",
+    );
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(95);
+  });
+});
