+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 100, food: 10, stone: 100 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost (rounded up)", () => {
+    // storehouse costs { wood: 25, stone: 10 }
+    // Half of 25 = 12.5 -> rounds up to 13
+    // Half of 10 = 5
+    const s = settlement({
+      buildings: ["hut", "storehouse"],
+      resources: { wood: 50, food: 10, stone: 50 },
+    });
+
+    const result = repairBuilding(s, "storehouse");
+
+    // After repairing storehouse: wood = 50 - 13 = 37, stone = 50 - 5 = 45
+    expect(result.resources.wood).toBe(37);
+    expect(result.resources.stone).toBe(45);
+    expect(result.resources.food).toBe(10); // unchanged
+    expect(result.buildings).toEqual(["hut", "storehouse"]);
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 50, food: 10, stone: 50 },
+    });
+
+    const result = repairBuilding(s, "storehouse");
+
+    // Should return the settlement unchanged
+    expect(result).toBe(s);
+    expect(result.resources).toEqual(s.resources);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    // hut costs { wood: 10 }
+    // Half would be 5 wood
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 3, food: 10, stone: 50 }, // only 3 wood available
+    });
+
+    const result = repairBuilding(s, "hut");
+
+    // Should not go below 0
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(50);
+  });
+
+  it("handles multiple resource types with uneven half-costs", () => {
+    // mine costs { wood: 30, stone: 10 }
+    // Half of 30 = 15, Half of 10 = 5
+    const s = settlement({
+      buildings: ["hut", "mine"],
+      resources: { wood: 20, food: 10, stone: 30 }, // only 20 wood available
+    });
+
+    const result = repairBuilding(s, "mine");
+
+    // After repairing mine: wood = 20 - 15 = 5, stone = 30 - 5 = 25
+    expect(result.resources.wood).toBe(5);
+    expect(result.resources.stone).toBe(25);
+  });
