+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({ resources: { wood: 100, food: 100, stone: 100 }, buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources.wood).toBe(100);
+    expect(result.resources.food).toBe(100);
+    expect(result.resources.stone).toBe(100);
+  });
+
+  it("repairs a building for half its original cost (rounded up) per resource", () => {
+    // Storehouse costs: wood: 25, stone: 10
+    // Repair cost: wood: ceil(25/2) = 13, stone: ceil(10/2) = 5
+    const s = settlement({
+      resources: { wood: 100, food: 10, stone: 100 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    // wood: 100 - 13 = 87, stone: 100 - 5 = 95
+    expect(result.resources.wood).toBe(87);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(95);
+  });
+
+  it("handles an odd-numbered cost (rounding-up case)", () => {
+    // Storehouse costs: wood: 25, stone: 10
+    // Repair cost: wood: ceil(25/2) = 13, stone: ceil(10/2) = 5
+    // This tests that odd costs are rounded up correctly
+    const s = settlement({
+      resources: { wood: 20, food: 10, stone: 20 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    // wood: 20 - 13 = 7, stone: 20 - 5 = 15
+    expect(result.resources.wood).toBe(7);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(15);
+  });
+
+  it("never takes any resource below 0 when settlement has less than repair cost", () => {
+    // Storehouse costs: wood: 25, stone: 10
+    // Repair cost: wood: ceil(25/2) = 13, stone: ceil(10/2) = 5
+    // Settlement has only 3 wood (need 13) and 2 stone (need 5)
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 2 },
+      buildings: ["storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    // wood: max(0, 3 - 13) = 0, stone: max(0, 2 - 5) = 0
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(0);
+  });
+});
