+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  describe("no-op when building is not present", () => {
+    it("returns the settlement unchanged when no buildings exist", () => {
+      const s = settlement();
+      const result = repairBuilding(s, "hut");
+      expect(result).toBe(s);
+    });
+
+    it("returns the settlement unchanged when the building is a different kind", () => {
+      const s = settlement({ buildings: ["hut"] });
+      const result = repairBuilding(s, "farm");
+      expect(result).toBe(s);
+    });
+  });
+
+  describe("rounding up odd costs", () => {
+    it("rounds up storehouse repair cost (wood 25 -> ceil 13, stone 10 -> 5)", () => {
+      const s = settlement({
+        buildings: ["storehouse"],
+        resources: { wood: 30, food: 10, stone: 10 },
+      });
+      const result = repairBuilding(s, "storehouse");
+      // wood: 25/2 = 12.5 -> ceil = 13; 30 - 13 = 17
+      expect(result.resources.wood).toBe(17);
+      // stone: 10/2 = 5; 10 - 5 = 5
+      expect(result.resources.stone).toBe(5);
+    });
+
+    it("rounds up farm repair cost (wood 15 -> ceil 8, stone 5 -> ceil 3)", () => {
