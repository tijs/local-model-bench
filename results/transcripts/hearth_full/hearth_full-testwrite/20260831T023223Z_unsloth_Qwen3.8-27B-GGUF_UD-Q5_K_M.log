+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    // hut costs { wood: 10 } -> repair costs ceil(10 / 2) = 5 wood
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources).toEqual({ wood: 25, food: 10, stone: 10 });
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds half cost up per resource (storehouse: wood 25 -> 13, stone 10 -> 5)", () => {
+    // storehouse costs { wood: 25, stone: 10 } -> repair costs ceil(25/2)=13 wood, ceil(10/2)=5 stone
+    const s = settlement({ resources: { wood: 25, food: 4, stone: 10 }, buildings: ["hut", "storehouse"] });
+    const repaired = repairBuilding(s, "storehouse");
+    expect(repaired.resources).toEqual({ wood: 12, food: 4, stone: 5 });
+    expect(repaired.buildings).toEqual(["hut", "storehouse"]);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ resources: { wood: 25, food: 4, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "storehouse");
+    expect(repaired.resources).toEqual({ wood: 25, food: 4, stone: 10 });
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0 when the settlement can't cover the repair", () => {
+    // storehouse repair costs 13 wood and 5 stone, but the settlement only
+    // has 5 wood and 3 stone -> both are clamped at 0
+    const s = settlement({ resources: { wood: 5, food: 4, stone: 3 }, buildings: ["hut", "storehouse"] });
+    const repaired = repairBuilding(s, "storehouse");
+    expect(repaired.resources).toEqual({ wood: 0, food: 4, stone: 0 });
+    expect(repaired.buildings).toEqual(["hut", "storehouse"]);
+  });
+
+  it("clamps only the short resources and leaves others alone", () => {
+    // 50 wood covers the 13-wood repair, 3 stone does not cover 5 -> only stone clamps
+    const s = settlement({ resources: { wood: 50, food: 4, stone: 3 }, buildings: ["hut", "storehouse"] });
+    const repaired = repairBuilding(s, "storehouse");
+    expect(repaired.resources).toEqual({ wood: 37, food: 4, stone: 0 });
+  });
+
+  it("does not mutate the input settlement", () => {
+    const s = settlement({ resources: { wood: 25, food: 4, stone: 10 }, buildings: ["hut", "storehouse"] });
+    repairBuilding(s, "storehouse");
+    expect(s.resources).toEqual({ wood: 25, food: 4, stone: 10 });
+    expect(s.buildings).toEqual(["hut", "storehouse"]);
+  });
+});
