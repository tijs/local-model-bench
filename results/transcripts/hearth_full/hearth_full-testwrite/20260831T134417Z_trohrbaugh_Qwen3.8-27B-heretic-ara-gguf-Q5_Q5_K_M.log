+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost per resource", () => {
+    // hut costs { wood: 10 } -> repair costs { wood: 5 }
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const after = repairBuilding(s, "hut");
+    expect(after.resources).toEqual({ wood: 25, food: 10, stone: 10 });
+    expect(after.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds each repair cost up when the original cost is odd", () => {
+    // storehouse costs { wood: 25, stone: 10 } -> repair costs { wood: 13, stone: 5 }
+    // (12.5 rounds up to 13; stone is exact at 5)
+    const s = settlement({
+      resources: { wood: 100, food: 10, stone: 50 },
+      buildings: ["hut", "storehouse"],
+    });
+    const after = repairBuilding(s, "storehouse");
+    expect(after.resources.wood).toBe(87);
+    expect(after.resources.stone).toBe(45);
+    expect(after.resources.food).toBe(10);
+  });
+
+  it("rounds each resource up independently (farm: wood 15 -> 8, stone 5 -> 3)", () => {
+    const s = settlement({
+      resources: { wood: 15, food: 10, stone: 5 },
+      buildings: ["farm"],
+    });
+    const after = repairBuilding(s, "farm");
+    expect(after.resources.wood).toBe(7);
+    expect(after.resources.stone).toBe(2);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const after = repairBuilding(s, "storehouse");
+    expect(after).toBe(s);
+    expect(after.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    // storehouse repair would cost { wood: 13, stone: 5 }; settlement only has
+    // wood 5 and stone 2.
+    const s = settlement({
+      resources: { wood: 5, food: 10, stone: 2 },
+      buildings: ["hut", "storehouse"],
+    });
+    const after = repairBuilding(s, "storehouse");
+    expect(after.resources.wood).toBe(0);
+    expect(after.resources.stone).toBe(0);
+    expect(after.resources.food).toBe(10);
+    expect(after.buildings).toEqual(["hut", "storehouse"]);
+  });
+
+  it("does not deduct anything from resources not in the building's cost", () => {
+    // storehouse repair touches only wood and stone, never food
+    const s = settlement({
+      resources: { wood: 100, food: 42, stone: 50 },
+      buildings: ["hut", "storehouse"],
+    });
+    const after = repairBuilding(s, "storehouse");
+    expect(after.resources.food).toBe(42);
+  });
+});
