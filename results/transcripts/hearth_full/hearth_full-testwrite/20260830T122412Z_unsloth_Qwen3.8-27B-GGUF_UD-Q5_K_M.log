+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 } -> repair is
+    // ceil(25/2)=13 wood and ceil(10/2)=5 stone.
+    const s = settlement({
+      resources: { wood: 100, food: 10, stone: 100 },
+      buildings: ["hut", "storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources.wood).toBe(87);
+    expect(result.resources.stone).toBe(95);
+    expect(result.resources.food).toBe(10); // not part of the cost
+    expect(result.buildings).toEqual(["hut", "storehouse"]);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({
+      resources: { wood: 100, food: 10, stone: 100 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 100, food: 10, stone: 100 });
+  });
+
+  it("never takes any resource below 0 when the settlement can't afford the repair", () => {
+    // repair costs 13 wood and 5 stone; the settlement has less of both.
+    const s = settlement({
+      resources: { wood: 5, food: 10, stone: 3 },
+      buildings: ["hut", "storehouse"],
+    });
+    const result = repairBuilding(s, "storehouse");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.buildings).toEqual(["hut", "storehouse"]);
+  });
+});
