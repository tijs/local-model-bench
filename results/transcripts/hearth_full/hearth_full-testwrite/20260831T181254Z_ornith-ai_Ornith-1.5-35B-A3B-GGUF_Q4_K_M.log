+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings/actions";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost, rounded up per resource", () => {
+    // storehouse costs { wood: 25, stone: 10 }; half rounds up to 13 wood and 5 stone.
+    // The wood cost is odd (25), exercising the Math.ceil rounding.
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(17); // 30 - 13
+    expect(result.resources.stone).toBe(5); // 10 - 5
+    expect(result.resources.food).toBe(10); // untouched
+    // The settlement still has the building — repair doesn't remove it.
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+
+    // Nothing changes — same resources, same buildings, and the same
+    // object reference back, matching the documented no-op behavior.
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0 when the settlement can't afford the repair", () => {
+    // Repairing the storehouse needs 13 wood, but only 10 is available —
+    // wood is clamped to 0 rather than going negative.
+    const s = settlement({ resources: { wood: 10, food: 10, stone: 10 }, buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(0); // clamped, not -3
+    expect(result.resources.stone).toBe(5); // 10 - 5, still fine
+    expect(result.buildings).toEqual(["storehouse"]);
+  });
+
+  it("clamps each resource independently below zero", () => {
+    // Both wood and stone fall short of their repair costs; each is
+    // clamped to 0 on its own.
+    const s = settlement({ resources: { wood: 5, food: 10, stone: 2 }, buildings: ["storehouse"] });
+    const result = repairBuilding(s, "storehouse");
+
+    expect(result.resources.wood).toBe(0); // needs 13, has 5
+    expect(result.resources.stone).toBe(0); // needs 5, has 2
+  });
+});
