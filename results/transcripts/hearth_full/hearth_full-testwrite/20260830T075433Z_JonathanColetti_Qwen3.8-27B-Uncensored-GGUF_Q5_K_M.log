+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/buildings";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    turn: 0,
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost", () => {
+    // hut costs 10 wood -> repair costs 5 wood
+    const result = repairBuilding(
+      settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] }),
+      "hut",
+    );
+    expect(result.resources).toEqual({ wood: 25, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up per resource when half the cost is fractional (odd cost)", () => {
+    // storehouse costs 25 wood + 10 stone -> repair costs ceil(25/2)=13 wood, 5 stone
+    const result = repairBuilding(
+      settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["storehouse"] }),
+      "storehouse",
+    );
+    expect(result.resources).toEqual({ wood: 17, food: 10, stone: 5 });
+  });
+
+  it("repairs each resource independently (multi-resource cost)", () => {
+    // farm costs 15 wood + 5 stone -> repair costs 8 wood (ceil(15/2)) + 3 stone (ceil(5/2))
+    const result = repairBuilding(
+      settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] }),
+      "farm",
+    );
+    expect(result.resources).toEqual({ wood: 22, food: 10, stone: 7 });
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const result = repairBuilding(s, "storehouse");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    // storehouse repair costs 13 wood + 5 stone; settlement has only 8 wood + 2 stone
+    const result = repairBuilding(
+      settlement({ resources: { wood: 8, food: 10, stone: 2 }, buildings: ["storehouse"] }),
+      "storehouse",
+    );
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("clamps only the deficient resource and deducts the rest normally", () => {
+    // mine costs 30 wood + 10 stone -> repair costs 15 wood + 5 stone;
+    // settlement has only 10 wood, so wood clamps to 0 while stone deducts in full
+    const result = repairBuilding(
+      settlement({ resources: { wood: 10, food: 10, stone: 20 }, buildings: ["mine"] }),
+      "mine",
+    );
+    expect(result.resources).toEqual({ wood: 0, food: 10, stone: 15 });
+  });
+});
