+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+describe("repairBuilding", () => {
+  it("repairs a building for half its original cost (rounded up)", () => {
+    const settlement: Settlement = {
+      resources: { wood: 100, food: 50, stone: 30 },
+      population: 5,
+      buildings: ["hut", "farm"],
+    };
+    
+    // Farm costs { wood: 15, stone: 5 }
+    // Repair cost should be { wood: 8 (Math.ceil(15/2)), stone: 3 (Math.ceil(5/2)) }
+    const expectedResources = {
+      wood: 100 - 8,
+      food: 50,
+      stone: 30 - 3,
+    };
+    
+    const result = repairBuilding(settlement, "farm");
+    expect(result.resources).toEqual(expectedResources);
+  });
+  
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const settlement: Settlement = {
+      resources: { wood: 100, food: 50, stone: 30 },
+      population: 5,
+      buildings: ["hut"],
+    };
+    
+    const originalSettlement = { ...settlement };
+    
+    const result = repairBuilding(settlement, "farm");
+    expect(result).toBe(originalSettlement);
+  });
+  
+  it("never takes any resource below 0", () => {
+    const settlement: Settlement = {
+      resources: { wood: 5, food: 10, stone: 2 },
+      population: 5,
+      buildings: ["hut", "farm", "quarry"],
+    };
+    
+    // Farm costs { wood: 15, stone: 5 }
+    // Repair cost would be { wood: 8, stone: 3 }
+    // But we only have 5 wood and 2 stone
+    const expectedResources = {
+      wood: 0, // 5 - 5 (max possible)
+      food: 10,
+      stone: 0, // 2 - 2 (max possible)
+    };
+    
+    const result = repairBuilding(settlement, "farm");
+    expect(result.resources).toEqual(expectedResources);
+  });
+  
+  it("handles case where settlement has less of a resource than repair would cost", () => {
+    const settlement: Settlement = {
+      resources: { wood: 3, food: 10, stone: 1 },
+      population: 5,
+      buildings: ["hut", "farm"],
+    };
+    
+    // Farm costs { wood: 15, stone: 5 }
+    // Repair cost would be { wood: 8, stone: 3 }
+    // But we only have 3 wood and 1 stone
+    const expectedResources = {
+      wood: 0, // 3 - 3 (max possible)
+      food: 10,
+      stone: 0, // 1 - 1 (max possible)
+    };
+    
+    const result = repairBuilding(settlement, "farm");
+    expect(result.resources).toEqual(expectedResources);
+  });
+});
