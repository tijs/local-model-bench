+import { describe, expect, test } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function makeSettlement(buildings: string[], resources: Record<string, number>): Settlement {
+  return {
+    population: 1,
+    buildings: buildings as string[],
+    resources: { wood: 0, food: 0, stone: 0, ...resources } as Settlement["resources"],
+  };
+}
+
+describe("repairBuilding", () => {
+  test("is a no-op when the settlement does not have the building", () => {
+    const settlement = makeSettlement(["hut"], { wood: 5, food: 10, stone: 3 });
+
+    const result = repairBuilding(settlement, "farm");
+
+    expect(result).toBe(settlement);
+  });
+
+  test("rounds up odd costs (farm: wood 15 -> 8, stone 5 -> 3)", () => {
+    const settlement = makeSettlement(["farm"], { wood: 20, food: 10, stone: 10 });
+
+    const result = repairBuilding(settlement, "farm");
+
+    // farm costs { wood: 15, stone: 5 }
+    // repair = Math.ceil(15/2) = 8 wood, Math.ceil(5/2) = 3 stone
+    expect(result.resources.wood).toBe(12);
+    expect(result.resources.stone).toBe(7);
+    expect(result.buildings).toEqual(["farm"]);
+  });
+
+  test("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    const settlement = makeSettlement(["hut"], { wood: 3, food: 10, stone: 3 });
+
+    const result = repairBuilding(settlement, "hut");
+
+    // hut costs { wood: 10 }, repair = Math.ceil(10/2) = 5 wood
+    // settlement only has 3 wood, so it should go to 0 (not -2)
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(3);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+});
