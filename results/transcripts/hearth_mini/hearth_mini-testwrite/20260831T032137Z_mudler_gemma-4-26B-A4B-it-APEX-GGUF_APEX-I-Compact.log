The tests passed successfully.

```typescript
import { describe, it, expect } from "vitest";
import { repairBuilding, BUILDING_COSTS } from "../src/sim";
import type { Settlement, BuildingKind } from "../src/types";

describe("repairBuilding", () => {
  const createSettlement = (resources: any, buildings: BuildingKind[]): Settlement => ({
    resources,
    population: 10,
    buildings,
  });

  it("repairs an already-built building for half its original cost (rounded up)", () => {
    // hut costs { wood: 10 }. Half is 5.
    const settlement = createSettlement({ wood: 10, food: 10, stone: 10 }, ["hut"]);
    const repaired = repairBuilding(settlement, "hut");
    expect(repaired.resources.wood).toBe(5);
    expect(repaired.buildings).toEqual(["hut"]);
  });

  it("rounds up the cost if the original cost is odd", () => {
    // farm costs { wood: 15, stone: 5 }. 
    // Half of 15 is 7.5 -> 8.
    // Half of 5 is 2.5 -> 3.
    const settlement = createSettlement({ wood: 20, food: 10, stone: 10 }, ["farm"]);
    const repaired = repairBuilding(settlement, "farm");
    expect(repaired.resources.wood).toBe(12); // 20 - 8
    expect(repaired.resources.stone).toBe(7); // 10 - 3
  });

  it("is a no-op if the settlement doesn't have that building", () => {
    const settlement = createSettlement({ wood: 10, food: 10, stone: 10 }, ["hut"]);
    // Try to repair a farm which is not present
    const repaired = repairBuilding(settlement, "farm");
    expect(repaired).toEqual(settlement);
  });

  it("never takes resources below 0", () => {
    // hut costs { wood: 10 }. Half is 5.
    // Settlement has only 2 wood.
    const settlement = createSettlement({ wood: 2, food: 10, stone: 10 }, ["hut"]);
    const repaired = repairBuilding(settlement, "hut");
    expect(repaired.resources.wood).toBe(0);
  });
});
```


