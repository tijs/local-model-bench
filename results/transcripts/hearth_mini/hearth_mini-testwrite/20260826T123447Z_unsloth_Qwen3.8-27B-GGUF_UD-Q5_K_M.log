+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const s = settlement();
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual([]);
+  });
+
+  it("does not deduct when the building is absent even with enough resources", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("repairs a hut for exactly half its cost (even cost)", () => {
+    // hut costs 10 wood -> repair is 5 wood
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(25);
+    expect(result.resources.stone).toBe(10);
+    expect(result.resources.food).toBe(10);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds each odd-numbered cost up per resource", () => {
+    // farm costs 15 wood and 5 stone -> repair is 8 wood and 3 stone
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(22); // 30 - ceil(15/2) = 30 - 8
+    expect(result.resources.stone).toBe(7); // 10 - ceil(5/2) = 10 - 3
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("repairs a quarry for exactly half (even cost)", () => {
+    // quarry costs 20 wood -> repair is 10 wood
+    const s = settlement({ buildings: ["quarry"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result.resources.wood).toBe(20);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    // farm repair needs 8 wood, settlement has only 3 wood -> 0, not -5
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 3, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(7); // 10 - 3 still applies
+  });
+
+  it("clamps every resource independently", () => {
+    // farm repair needs 8 wood and 3 stone; settlement short on both
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 2, food: 10, stone: 1 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+  });
+
