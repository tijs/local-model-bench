+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("repairs a hut for half cost (5 wood, rounded up from 10/2)", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(25);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up for odd-numbered costs (farm wood: 15 -> 8)", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // 15 / 2 = 7.5, ceil = 8
+    expect(result.resources.wood).toBe(22);
+    // stone: 5 / 2 = 2.5, ceil = 3
+    expect(result.resources.stone).toBe(7);
+  });
+
+  it("rounds up for odd-numbered stone costs (quarry stone: 20 -> 10)", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["quarry"],
+    });
+    const result = repairBuilding(s, "quarry");
+    // 20 / 2 = 10, ceil = 10
+    expect(result.resources.stone).toBe(0);
+  });
+
+  it("never takes a resource below 0 when settlement has less than repair cost", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // farm repair needs 8 wood (ceil(15/2)), but only has 3
+    // result should be max(0, 3 - 8) = 0
+    expect(result.resources.wood).toBe(0);
+    // stone: 5 / 2 = 2.5, ceil = 3, has 10, so 10 - 3 = 7
+    expect(result.resources.stone).toBe(7);
+  });
+
+  it("repairs multiple resources correctly when settlement has enough", () => {
+    const s = settlement({
+      resources: { wood: 50, food: 10, stone: 20 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // wood: ceil(15/2) = 8, 50 - 8 = 42
+    expect(result.resources.wood).toBe(42);
+    // stone: ceil(5/2) = 3, 20 - 3 = 17
+    expect(result.resources.stone).toBe(17);
+  });
+});
