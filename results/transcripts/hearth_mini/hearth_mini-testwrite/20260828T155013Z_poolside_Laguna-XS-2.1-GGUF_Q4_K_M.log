+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const original = settlement({ buildings: ["hut", "farm"] });
+    const result = repairBuilding(original, "quarry");
+    expect(result).toBe(original); // Same object reference since it's a no-op
+    expect(result.resources).toEqual(original.resources);
+    expect(result.buildings).toEqual(["hut", "farm"]);
+  });
+
+  it("repairs a building for half its original cost rounded up", () => {
+    // Farm costs: wood: 15, stone: 5
+    // Repair cost: wood: ceil(15/2) = 8, stone: ceil(5/2) = 3
+    const s = settlement({
+      resources: { wood: 20, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(12); // 20 - 8
+    expect(result.resources.stone).toBe(7); // 10 - 3
+  });
+
+  it("does not take any resource below 0", () => {
+    // Hut costs: wood: 10
+    // Repair cost: wood: ceil(10/2) = 5
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 10 }, // Only 3 wood, less than 5 needed
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(0); // Capped at 0
+  });
+
+  it("rounds up repair cost for odd-numbered costs", () => {
+    // Farm costs: wood: 15, stone: 5
+    // Repair cost: wood: ceil(15/2) = 8 (15 is odd, so 7.5 rounds to 8)
+    //               stone: ceil(5/2) = 3 (5 is odd, so 2.5 rounds to 3)
+    const s = settlement({
+      resources: { wood: 25, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(17); // 25 - 8
+    expect(result.resources.stone).toBe(7); // 10 - 3
+  });
+});
