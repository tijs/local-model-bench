+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function makeSettlement(buildings: string[] = [], resources = { wood: 100, food: 100, stone: 100 }): Settlement {
+  return {
+    resources: { ...resources },
+    population: 1,
+    buildings: buildings as Settlement["buildings"],
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement does not have the building", () => {
+    const settlement = makeSettlement(["hut"]);
+    const result = repairBuilding(settlement, "farm");
+
+    expect(result).toBe(settlement);
+  });
+
+  it("charges half the original cost, rounded up per resource", () => {
+    // farm costs { wood: 15, stone: 5 }
+    // repair should cost ceil(15/2) = 8 wood, ceil(5/2) = 3 stone
+    const settlement = makeSettlement(["farm"], { wood: 100, food: 100, stone: 100 });
+    const result = repairBuilding(settlement, "farm");
+
+    expect(result.resources.wood).toBe(92);   // 100 - 8
+    expect(result.resources.stone).toBe(97);   // 100 - 3
+    expect(result.resources.food).toBe(100);   // unchanged
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    // hut costs { wood: 10 }, repair costs ceil(10/2) = 5 wood
+    // settlement has only 3 wood, so it should drop to 0, not -2
+    const settlement = makeSettlement(["hut"], { wood: 3, food: 100, stone: 100 });
+    const result = repairBuilding(settlement, "hut");
+
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(100);
+    expect(result.resources.stone).toBe(100);
+  });
+});
