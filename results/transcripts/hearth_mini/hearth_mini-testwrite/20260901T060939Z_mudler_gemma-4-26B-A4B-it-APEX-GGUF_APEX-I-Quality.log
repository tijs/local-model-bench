```typescript
import { describe, expect, it } from "vitest";
import { repairBuilding } from "../src/sim";
import type { Settlement } from "../src/types";

function settlement(overrides: Partial<Settlement> = {}): Settlement {
  return {
    resources: { wood: 30, food: 10, stone: 10 },
    population: 2,
    buildings: [],
    ...overrides,
  };
}

describe("repairBuilding", () => {
  it("is a no-op if the settlement doesn't have the building", () => {
    const s = settlement({ buildings: ["hut"] });
    const result = repairBuilding(s, "farm");
    expect(result).toEqual(s);
  });

  it("repairs a building for half its cost, rounding up for odd costs", () => {
    // farm cost: wood: 15, stone: 5
    // repair cost: wood: ceil(15/2)=8, stone: ceil(5/2)=3
    const s = settlement({
      buildings: ["farm"],
      resources: { wood: 20, food: 10, stone: 10 },
    });
    const result = repairBuilding(s, "farm");
    expect(result.resources.wood).toBe(12);
    expect(result.resources.stone).toBe(7);
  });

  it("never takes a resource below 0", () => {
    // farm repair cost for stone is 3.
    const s = settlement({
      buildings: ["farm"],
      resources: { wood: 20, food: 10, stone: 1 },
    });
    const result = repairBuilding(s, "farm");
    expect(result.resources.stone).toBe(0);
  });
});
```


