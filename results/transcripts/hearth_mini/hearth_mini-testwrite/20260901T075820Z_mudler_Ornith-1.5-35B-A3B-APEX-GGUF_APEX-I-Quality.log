+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    // hut costs 5 wood to build -> 5/2 = 2.5 -> rounded up to 5 wood to repair
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    expect(s.resources.wood).toBe(25);
+    // unrelated resources are untouched
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("rounds the cost up per resource for an odd-numbered cost", () => {
+    // farm costs 15 wood + 5 stone -> 15/2 = 7.5 -> 8 wood, 5/2 = 2.5 -> 3 stone
+    const s = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(s.resources.wood).toBe(30 - 8); // 22
+    expect(s.resources.stone).toBe(10 - 3); // 7
+  });
+
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual(s.resources);
+    expect(result.buildings).toEqual(s.buildings);
+  });
+
+  it("never takes a resource below 0 when the settlement is short on resources", () => {
+    // hut repair costs 5 wood, but only 3 wood is available -> clamps to 0
+    const s = repairBuilding(settlement({ resources: { wood: 3, food: 10, stone: 10 } }), "hut");
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("does not mutate the original settlement", () => {
+    const original = settlement({ buildings: ["hut"], resources: { wood: 30, food: 10, stone: 10 } });
+    repairBuilding(original, "hut");
+    expect(original.resources.wood).toBe(30);
+  });
+});
