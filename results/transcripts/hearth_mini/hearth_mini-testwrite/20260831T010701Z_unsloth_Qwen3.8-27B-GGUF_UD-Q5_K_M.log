+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a hut for half its original cost", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const r = repairBuilding(s, "hut");
+    // hut costs 10 wood, so repair costs 5 wood
+    expect(r.resources.wood).toBe(25);
+    expect(r.resources.food).toBe(10);
+    expect(r.resources.stone).toBe(10);
+    expect(r.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds each repair cost up for odd-numbered costs", () => {
+    const s = settlement({
+      resources: { wood: 15, food: 0, stone: 5 },
+      buildings: ["farm"],
+    });
+    const r = repairBuilding(s, "farm");
+    // farm costs 15 wood (ceil(15/2) = 8) and 5 stone (ceil(5/2) = 3)
+    expect(r.resources.wood).toBe(7);
+    expect(r.resources.stone).toBe(2);
+    expect(r.resources.food).toBe(0);
+  });
+
+  it("does not take resources below 0 when the settlement is short", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 0, stone: 1 },
+      buildings: ["farm"],
+    });
+    const r = repairBuilding(s, "farm");
+    // repair costs 8 wood and 3 stone, but the settlement has only 3 wood
+    // and 1 stone, so both clamp at 0
+    expect(r.resources.wood).toBe(0);
+    expect(r.resources.stone).toBe(0);
+    expect(r.resources.food).toBe(0);
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const r = repairBuilding(s, "quarry");
+    expect(r).toBe(s);
+    expect(r.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("does not mutate the original settlement", () => {
+    const s = settlement({
+      resources: { wood: 10, food: 0, stone: 10 },
+      buildings: ["hut"],
+    });
+    repairBuilding(s, "hut");
+    expect(s.resources).toEqual({ wood: 10, food: 0, stone: 10 });
+  });
+});
