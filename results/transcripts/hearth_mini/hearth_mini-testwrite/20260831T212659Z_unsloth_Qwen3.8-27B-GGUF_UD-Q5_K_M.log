+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost", () => {
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    // hut costs wood: 10, repair costs 5
+    expect(s.resources.wood).toBe(25);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds each repair cost up per resource (odd costs)", () => {
+    // farm costs wood: 15, stone: 5 -> repair costs wood: 8, stone: 3
+    const s = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(s.resources.wood).toBe(30 - 8);
+    expect(s.resources.stone).toBe(10 - 3);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    const s = repairBuilding(
+      settlement({ buildings: ["hut"], resources: { wood: 3, food: 10, stone: 10 } }),
+      "hut",
+    );
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const original = settlement({ resources: { wood: 30, food: 10, stone: 10 } });
+    const s = repairBuilding(original, "hut");
+    expect(s).toBe(original);
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual([]);
+  });
+});
