+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its cost (rounded up per resource)", () => {
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    // hut costs 10 wood -> half is 5.
+    expect(s.resources.wood).toBe(25);
+  });
+
+  it("rounds up each resource's half-cost independently for odd costs", () => {
+    // farm costs wood 15, stone 5 -> ceil(15/2)=8, ceil(5/2)=3.
+    const s = repairBuilding(
+      settlement({ buildings: ["farm"], resources: { wood: 30, food: 10, stone: 10 } }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(22);
+    expect(s.resources.stone).toBe(7);
+  });
+
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 30, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("never takes a resource below 0 when the settlement lacks enough", () => {
+    // quarry costs wood 20 -> half is 10, but only 3 wood is available.
+    const s = repairBuilding(
+      settlement({ buildings: ["quarry"], resources: { wood: 3, food: 10, stone: 10 } }),
+      "quarry",
+    );
+    expect(s.resources.wood).toBe(0);
+  });
+});
