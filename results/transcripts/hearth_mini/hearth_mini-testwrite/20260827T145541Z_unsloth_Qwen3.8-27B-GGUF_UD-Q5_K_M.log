+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost, rounded up per resource", () => {
+    // farm costs wood 15, stone 5 -> repair ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(22);
+    expect(result.resources.stone).toBe(7);
+    expect(result.resources.food).toBe(10);
+    expect(result.buildings).toEqual(["farm"]);
+  });
+
+  it("uses exact half cost when the original cost is even", () => {
+    // hut costs wood 10 -> repair ceil(10/2)=5 wood
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(25);
+    expect(result.resources.stone).toBe(10);
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    // farm repair costs 8 wood and 3 stone; settlement has only 3 wood, 1 stone
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 3, food: 10, stone: 1 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("does not mutate the input settlement", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result).not.toBe(s);
+  });
+});
