+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost, rounded up per resource", () => {
+    // farm costs wood 15, stone 5 -> repair cost ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const s = settlement({ buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(30 - 8);
+    expect(repaired.resources.stone).toBe(10 - 3);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.buildings).toEqual(["farm"]);
+  });
+
+  it("repairs an even-cost building for exactly half", () => {
+    // hut costs wood 10 -> repair cost ceil(10/2)=5 wood
+    const s = settlement({ buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(25);
+  });
+
+  it("rounds up each odd cost component separately", () => {
+    // farm: wood 15 -> 8 (up), stone 5 -> 3 (up)
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 8, food: 10, stone: 3 },
