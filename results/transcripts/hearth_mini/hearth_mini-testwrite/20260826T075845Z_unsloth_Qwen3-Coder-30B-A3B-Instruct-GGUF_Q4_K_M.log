+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost (rounded up)", () => {
+    // Test with odd-numbered costs to check rounding
+    const s = settlement({ 
+      resources: { wood: 15, food: 5, stone: 5 },
+      buildings: ["farm"]
+    });
+    
+    const result = repairBuilding(s, "farm");
+    
+    // Farm originally costs wood: 15, stone: 5
+    // Half rounded up: wood: 8, stone: 3
+    expect(result.resources.wood).toBe(7); // 15 - 8 = 7
+    expect(result.resources.stone).toBe(2); // 5 - 3 = 2
+    expect(result.resources.food).toBe(5); // unchanged
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({ 
+      resources: { wood: 10, food: 5, stone: 5 },
+      buildings: ["hut"]
+    });
+    
+    const result = repairBuilding(s, "farm"); // farm not built
+    
+    expect(result).toBe(s); // should return the same object
+    expect(result.resources.wood).toBe(10);
+    expect(result.resources.stone).toBe(5);
+    expect(result.resources.food).toBe(5);
+  });
+
+  it("never takes any resource below 0", () => {
+    const s = settlement({ 
+      resources: { wood: 1, food: 2, stone: 1 },
+      buildings: ["farm"]
+    });
+    
+    const result = repairBuilding(s, "farm");
+    
+    // Farm costs wood: 15, stone: 5
+    // Half rounded up: wood: 8, stone: 3
+    // But we only have 1 wood and 1 stone, so should be reduced to 0
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(2); // unchanged
+  });
+});
