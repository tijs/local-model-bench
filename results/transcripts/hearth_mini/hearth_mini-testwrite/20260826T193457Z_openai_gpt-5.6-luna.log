+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("deducts half the building cost, rounding up per resource", () => {
+    const repaired = repairBuilding(
+      settlement({
+        resources: { wood: 30, food: 10, stone: 10 },
+        buildings: ["farm"],
+      }),
+      "farm",
+    );
+
+    expect(repaired.resources).toEqual({ wood: 22, food: 10, stone: 7 });
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const original = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: [],
+    });
+
+    expect(repairBuilding(original, "farm")).toEqual(original);
+  });
+
+  it("does not take a resource below zero when resources are insufficient", () => {
+    const repaired = repairBuilding(
+      settlement({
+        resources: { wood: 2, food: 10, stone: 10 },
+        buildings: ["farm"],
+      }),
+      "farm",
+    );
+
+    expect(repaired.resources).toEqual({ wood: 0, food: 10, stone: 7 });
+    expect(repaired.resources.wood).toBeGreaterThanOrEqual(0);
+  });
+});
+
+// The farm's odd costs (15 wood and 5 stone) make the rounding-up behavior
+// observable: the repair costs are 8 wood and 3 stone.
