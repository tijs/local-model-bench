+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an existing building for half original cost rounded up per resource", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    // hut cost wood 10 -> repair ceil(10/2)=5
+    expect(repaired.resources.wood).toBe(25);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("repairs farm with odd-numbered cost rounding up", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    // farm cost wood 15 -> ceil(15/2)=8, stone 5 -> ceil(5/2)=3
+    expect(repaired.resources.wood).toBe(22);
+    expect(repaired.resources.stone).toBe(7);
+    expect(repaired.resources.food).toBe(10);
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const s = settlement({ buildings: [] });
+    const result = repairBuilding(s, "hut");
+    // should return the same settlement object unchanged
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual([]);
+  });
+
+  it("never takes a resource below zero", () => {
+    const s = settlement({ resources: { wood: 3, food: 0, stone: 0 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    // repair cost 5, wood 3 -> max(0, 3-5)=0
+    expect(repaired.resources.wood).toBe(0);
+  });
+
+  it("never takes a resource below zero for multi-resource buildings", () => {
+    const s = settlement({ resources: { wood: 10, food: 5, stone: 2 }, buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    // wood repair 8 -> 10-8=2
+    // stone repair 3 -> max(0,2-3)=0
+    expect(repaired.resources.wood).toBe(2);
+    expect(repaired.resources.stone).toBe(0);
+    expect(repaired.resources.food).toBe(5);
+  });
+});
