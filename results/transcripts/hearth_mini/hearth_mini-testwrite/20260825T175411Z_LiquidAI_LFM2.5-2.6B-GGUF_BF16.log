+import { BUILDING_COSTS, repairBuilding } from "../src/sim.ts";
+
+// Test 1: No-op if settlement doesn't have the building
+const emptySettlement: any = {
+  resources: { wood: 10, stone: 5 },
+  buildings: [],
+  population: 0,
+};
+
+test("repairBuilding should be a no-op when the building is not built", () => {
+  const result = repairBuilding(emptySettlement, "hut");
+  expect(result).toEqual(emptySettlement);
+});
+
+// Test 2: Repair hut (wood: 10) - cost ceil(10/2) = 5
+const hutSettlement: any = {
+  resources: { wood: 20 },
+  buildings: ["hut"],
+  population: 0,
+};
+
+test("repairBuilding should repair a built hut for half its cost (rounded up)", () => {
+  const result = repairBuilding(hutSettlement, "hut");
+  expect(result.resources.wood).toBe(15); // 20 - ceil(10/2) = 20 - 5 = 15
+});
+
+// Test 3: Repair farm (wood: 15, stone: 5) - costs ceil(15/2)=8, ceil(5/2)=3
+const farmSettlement: any = {
+  resources: { wood: 30, stone: 10 },
+  buildings: ["farm"],
+  population: 0,
+};
+
+test("repairBuilding should repair a built farm for half its cost (rounded up)", () => {
+  const result = repairBuilding(farmSettlement, "farm");
+  expect(result.resources.wood).toBe(22); // 30 - ceil(15/2) = 30 - 8 = 22
+  expect(result.resources.stone).toBe(7); // 10 - ceil(5/2) = 10 - 3 = 7
+});
+
+// Test 4: Repair quarry (wood: 20) - cost ceil(20/2) = 10
+const quarrySettlement: any = {
+  resources: { wood: 25 },
+  buildings: ["quarry"],
+  population: 0,
+};
+
+test("repairBuilding should repair a built quarry for half its cost (rounded up)", () => {
+  const result = repairBuilding(quarrySettlement, "quarry");
+  expect(result.resources.wood).toBe(15); // 25 - ceil(20/2) = 25 - 10 = 15
+});
+
+// Test 5: Repair should never take resources below 0
+const lowResourceSettlement: any = {
+  resources: { wood: 3 },
+  buildings: ["hut"],
+  population: 0,
+};
+
+test("repairBuilding should never reduce resources below zero", () => {
+  const result = repairBuilding(lowResourceSettlement, "hut");
+  expect(result.resources.wood).toBe(3); // Should not go negative
+});
