+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("repairs a hut for half its original cost (10 -> 5 wood)", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(25);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+  });
+
+  it("repairs a farm for half its original cost (15 wood, 5 stone -> 8 wood, 3 stone)", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(22);
+    expect(result.resources.stone).toBe(7);
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("rounds up repair costs for odd numbers (quarry: 20 -> 10 wood)", () => {
+    const s = settlement({ buildings: ["quarry"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result.resources.wood).toBe(20);
+  });
+
+  it("rounds up repair costs for odd numbers (farm wood: 15 -> 8)", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    // 15 / 2 = 7.5, ceil = 8
+    expect(result.resources.wood).toBe(22);
+  });
+
+  it("rounds up repair costs for odd numbers (farm stone: 5 -> 3)", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    // 5 / 2 = 2.5, ceil = 3
+    expect(result.resources.stone).toBe(7);
+  });
+
+  it("never takes resources below 0 when repairing hut", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
