+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: [] });
+    const result = repairBuilding(s, "hut");
+    expect(result).toBe(s);
+  });
+
+  it("repairs a building for half its original cost (rounded up)", () => {
+    // Test with odd-numbered cost - should round up
+    const s = settlement({ 
+      buildings: ["hut"],
+      resources: { wood: 10, food: 10, stone: 10 }
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(5); // 10 / 2 = 5 (no rounding needed)
+  });
+
+  it("repairs a building with odd-numbered cost and rounds up", () => {
+    // Test with odd-numbered cost - should round up
+    const s = settlement({ 
+      buildings: ["farm"],
+      resources: { wood: 15, food: 10, stone: 5 }
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(8); // 15 / 2 = 7.5 -> 8 (rounded up)
+    expect(result.resources.stone).toBe(3); // 5 / 2 = 2.5 -> 3 (rounded up)
+  });
+
+  it("never takes any resource below 0", () => {
+    const s = settlement({ 
+      buildings: ["farm"],
+      resources: { wood: 5, food: 10, stone: 1 }
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0); // 5 / 2 = 2.5 -> 3, but we only have 5, so 5 - 3 = 2 (but this is wrong)
+    // Let me reconsider - the cost is wood: 15, stone: 5
+    // Repair cost should be wood: 8, stone: 3
+    // But we only have wood: 5, stone: 1
+    // So we can only afford wood: 5, stone: 1
+    // After repair: wood: 0, stone: 0 (but we don't want to go below 0)
+    // Actually, let's recheck the logic - for wood: 5 - 8 = -3, but it should be max(0, 5-8) = 0
+    // For stone: 1 - 3 = -2, but it should be max(0, 1-3) = 0
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+  });
+});
