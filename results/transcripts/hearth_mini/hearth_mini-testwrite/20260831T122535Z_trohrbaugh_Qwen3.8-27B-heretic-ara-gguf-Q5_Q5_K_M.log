+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    // hut costs 10 wood -> repair costs 5 wood
+    const s = settlement({ buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(25);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds the repair cost up per resource (odd-numbered cost)", () => {
+    // farm costs 15 wood, 5 stone -> repair costs ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const s = settlement({ buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(22);
+    expect(repaired.resources.stone).toBe(7);
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement();
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(repaired.buildings).toEqual([]);
+  });
+
+  it("never takes any resource below 0 when resources are scarce", () => {
+    // farm repair would cost 8 wood, 3 stone, but settlement only has 3 wood, 1 stone
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 1 },
+      buildings: ["farm"],
+    });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+    expect(repaired.resources.food).toBe(10);
+  });
+
+  it("does not mutate the original settlement", () => {
+    const s = settlement({ buildings: ["quarry"] });
+    const repaired = repairBuilding(s, "quarry");
+    expect(s.resources.wood).toBe(30);
+    expect(repaired.resources.wood).toBe(20);
+  });
+});
