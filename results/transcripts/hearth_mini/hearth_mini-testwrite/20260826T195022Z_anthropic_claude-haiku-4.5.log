+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+describe("repairBuilding", () => {
+  const baseSettlement: Settlement = {
+    resources: { wood: 100, food: 100, stone: 100 },
+    population: 5,
+    buildings: ["hut"],
+  };
+
+  describe("repairs a building for half its cost (rounded up)", () => {
+    it("repairs a hut (even cost)", () => {
+      const settlement = {
+        ...baseSettlement,
+        buildings: ["hut"],
+        resources: { wood: 100, food: 100, stone: 100 },
+      };
+      // hut costs 10 wood, repair costs ceil(10/2) = 5 wood
+      const result = repairBuilding(settlement, "hut");
+      expect(result.resources.wood).toBe(95);
+      expect(result.resources.food).toBe(100);
+      expect(result.resources.stone).toBe(100);
+    });
+
+    it("repairs a farm (odd costs that round up)", () => {
+      const settlement = {
+        ...baseSettlement,
+        buildings: ["farm"],
+        resources: { wood: 100, food: 100, stone: 100 },
+      };
+      // farm costs 15 wood and 5 stone
+      // repair costs ceil(15/2) = 8 wood and ceil(5/2) = 3 stone
+      const result = repairBuilding(settlement, "farm");
+      expect(result.resources.wood).toBe(92);
+      expect(result.resources.stone).toBe(97);
+      expect(result.resources.food).toBe(100);
+    });
+
+    it("repairs a quarry (even cost)", () => {
+      const settlement = {
+        ...baseSettlement,
+        buildings: ["quarry"],
+        resources: { wood: 100, food: 100, stone: 100 },
+      };
+      // quarry costs 20 wood, repair costs ceil(20/2) = 10 wood
+      const result = repairBuilding(settlement, "quarry");
+      expect(result.resources.wood).toBe(90);
+      expect(result.resources.food).toBe(100);
+      expect(result.resources.stone).toBe(100);
+    });
+  });
+
+  describe("is a no-op if the settlement doesn't have that building", () => {
+    it("returns unchanged settlement when building doesn't exist", () => {
+      const settlement = {
+        ...baseSettlement,
+        buildings: ["hut"],
+        resources: { wood: 100, food: 100, stone: 100 },
+      };
+      const result = repairBuilding(settlement, "farm");
+      expect(result.resources).toEqual(settlement.resources);
+      expect(result.buildings).toEqual(settlement.buildings);
+      expect(result.population).toBe(settlement.population);
