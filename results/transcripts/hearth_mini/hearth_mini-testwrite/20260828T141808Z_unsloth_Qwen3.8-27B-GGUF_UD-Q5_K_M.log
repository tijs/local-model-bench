```ts
import { describe, expect, it } from "vitest";
import { repairBuilding } from "../src/sim";
import type { Settlement } from "../src/types";

function settlement(overrides: Partial<Settlement> = {}): Settlement {
  return {
    resources: { wood: 30, food: 10, stone: 10 },
    population: 2,
    buildings: [],
    ...overrides,
  };
}

describe("repairBuilding", () => {
  it("deducts half the original cost of an owned building", () => {
    // hut costs 10 wood; repair costs 5
    const s = repairBuilding(
      settlement({ buildings: ["hut"], resources: { wood: 20, food: 10, stone: 10
 } }),
      "hut",
    );
    expect(s.resources.wood).toBe(15);
    expect(s.resources.food).toBe(10);
    expect(s.resources.stone).toBe(10);
    expect(s.buildings).toEqual(["hut"]);
  });

  it("rounds each resource's repair cost up (odd-numbered cost)", () => {
    // farm costs 15 wood and 5 stone; repair costs ceil(15/2)=8 wood and ceil(5/
2)=3 stone
    const s = repairBuilding(
      settlement({ buildings: ["farm"], resources: { wood: 15, food: 10, stone: 5
 } }),
      "farm",
    );
    expect(s.resources.wood).toBe(7);
    expect(s.resources.stone).toBe(2);
  });

  it("is a no-op when the settlement does not have the building", () => {
    const original = settlement({ buildings: ["hut"] });
    const s = repairBuilding(original, "farm");
    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
    expect(s.buildings).toEqual(["hut"]);
  });

  it("never takes a resource below 0", () => {
    // farm repair costs 8 wood and 3 stone
    const s = repairBuilding(
      settlement({ buildings: ["farm"], resources: { wood: 4, food: 10, stone: 1 }
 }),
      "farm",
    );
    expect(s.resources.wood).toBe(0);
    expect(s.resources.stone).toBe(0);
    expect(s.resources.food).toBe(10);
  });

  it("leaves resources at 0 when the settlement starts at 0", () => {
    const s = repairBuilding(
      settlement({ buildings: ["quarry"], resources: { wood: 0, food: 0, stone: 0
 } }),
      "quarry",
    );
    expect(s.resources).toEqual({ wood: 0, food: 0, stone: 0 });
  });
});
```

This covers the three behaviors + rounding up (farm's odd cost 15) + a case where
 resources are less than the cost (wood 4 < 8, stone 1 < 3).

Note on the no-op test: I could also assert identity with `toBe(original)`. The implementation
 does return the same object, and "does nothing" strongly implies that. But a copy
 that's equal is also behaviorally "does nothing". To be safe against implementation
 changes, a behavior-based assertion is enough. Let me stay behavior-based.

After that, run npm run test and npm run typecheck.
