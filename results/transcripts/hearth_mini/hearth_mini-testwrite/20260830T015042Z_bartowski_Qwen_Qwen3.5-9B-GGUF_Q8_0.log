+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op if settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources.wood).toBe(30);
+  });
+
+  it("repairs a hut for half cost (rounded up)", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "hut");
+    // hut costs 10 wood, repair is ceil(10/2) = 5
+    expect(result.resources.wood).toBe(25);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("handles odd-numbered cost by rounding up", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    // farm costs 15 wood, repair is ceil(15/2) = 8
+    expect(result.resources.wood).toBe(22);
+    // farm costs 5 stone, repair is ceil(5/2) = 3
+    expect(result.resources.stone).toBe(7);
+  });
+
+  it("does not take a resource below 0 when insufficient resources", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // farm repair needs 8 wood but only has 3, so wood stays at 3
+    expect(result.resources.wood).toBe(3);
+  });
+
+  it("reduces resources by repair cost when sufficient", () => {
+    const s = settlement({ buildings: ["quarry"] });
+    const result = repairBuilding(s, "quarry");
+    // quarry costs 20 wood, repair is ceil(20/2) = 10
+    expect(result.resources.wood).toBe(20);
+  });
+
+  it("is a no-op if settlement has no buildings", () => {
+    const s = settlement({ buildings: [] });
+    const result = repairBuilding(s, "hut");
+    expect(result.buildings).toEqual([]);
+    expect(result.resources.wood).toBe(30);
+  });
+});
