+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function makeSettlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 100, food: 100, stone: 100 },
+    population: 1,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement does not have the building", () => {
+    const settlement = makeSettlement({ buildings: ["hut"] });
+    const result = repairBuilding(settlement, "farm");
+    expect(result).toBe(settlement);
+  });
+
+  it("repairs a building for half its original cost, rounded up per resource", () => {
+    // farm costs { wood: 15, stone: 5 }
+    // repair cost = ceil(15/2)=8 wood, ceil(5/2)=3 stone (odd-numbered cost)
+    const settlement = makeSettlement({
+      buildings: ["farm"],
+      resources: { wood: 100, food: 100, stone: 100 },
+    });
+    const result = repairBuilding(settlement, "farm");
+    expect(result.resources.wood).toBe(100 - 8); // 92
+    expect(result.resources.stone).toBe(100 - 3); // 97
+    expect(result.resources.food).toBe(100);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    // hut costs { wood: 10 }, repair cost = ceil(10/2) = 5
+    const settlement = makeSettlement({
+      buildings: ["hut"],
+      resources: { wood: 3, food: 100, stone: 100 },
+    });
+    const result = repairBuilding(settlement, "hut");
+    expect(result.resources.wood).toBe(0);
+    expect(result).not.toBe(settlement);
+  });
+});
