+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+
+    // hut costs 10 wood; half is 5.
+    expect(repaired.resources.wood).toBe(25);
+    // The building is still there; population and other fields are preserved.
+    expect(repaired.buildings).toEqual(["hut"]);
+    expect(repaired.population).toBe(2);
+  });
+
+  it("rounds the half-cost up per resource for an odd original cost", () => {
+    // farm costs wood 15 (odd) and stone 5 (odd); half rounded up is 8 and 3.
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+
+    expect(repaired.resources.wood).toBe(30 - 8);
+    expect(repaired.resources.stone).toBe(10 - 3);
+  });
+
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "quarry");
+
+    // No quarry present: the settlement is returned unchanged.
+    expect(repaired).toBe(s);
+    expect(repaired.resources.wood).toBe(30);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0 when the settlement cannot afford the repair", () => {
+    // hut repair costs 5 wood, but the settlement only has 3.
+    const s = settlement({ resources: { wood: 3, food: 10, stone: 10 }, buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+
+    expect(repaired.resources.wood).toBe(0);
+    // Other resources are untouched.
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.resources.stone).toBe(10);
+  });
+});
