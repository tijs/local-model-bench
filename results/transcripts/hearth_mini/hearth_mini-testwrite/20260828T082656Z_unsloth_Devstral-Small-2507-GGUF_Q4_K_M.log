+      buildings: ["quarry"],
+      resources: { wood: 5, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "quarry");
+    expect(result.buildings).toEqual(["quarry"]);
+    expect(result.resources).toEqual({ wood: 0, food: 10, stone: 10 });
+  });
+});
