+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement, BuildingKind } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("repairs a building for half its original cost (rounded up)", () => {
+    // Hut costs 10 wood, repair should cost 5 wood (Math.ceil(10/2))
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources).toEqual({ wood: 25, food: 10, stone: 10 });
+  });
+
+  it("handles odd-numbered costs correctly (rounding up)", () => {
+    // Farm costs 15 wood and 5 stone, repair should cost 8 wood and 3 stone
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.buildings).toEqual(["farm"]);
+    expect(result.resources).toEqual({ wood: 22, food: 10, stone: 7 });
+  });
+
+  it("never takes any resource below 0", () => {
+    // Quarry costs 20 wood, but we only have 5 wood
