+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+  });
+
+  it("repairs for half the original cost per resource", () => {
+    // hut costs 10 wood -> repair costs 5 wood
+    const s = settlement({ buildings: ["hut"], resources: { wood: 20, food: 5, stone: 5 } });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources).toEqual({ wood: 15, food: 5, stone: 5 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds the repair cost up per resource for odd-numbered costs", () => {
+    // farm costs 15 wood, 5 stone -> repair costs ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const s = settlement({ buildings: ["farm"], resources: { wood: 20, food: 5, stone: 10 } });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources).toEqual({ wood: 12, food: 5, stone: 7 });
+  });
+
+  it("never takes a resource below 0 when the settlement can't fully afford the repair", () => {
+    // farm repair costs 8 wood, 3 stone; settlement only has 3 wood and 1 stone
+    const s = settlement({ buildings: ["farm"], resources: { wood: 3, food: 4, stone: 1 } });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources).toEqual({ wood: 0, food: 4, stone: 0 });
+  });
+});
