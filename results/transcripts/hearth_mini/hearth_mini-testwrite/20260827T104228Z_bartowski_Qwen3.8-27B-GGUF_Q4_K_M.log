+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs for half the original cost, rounded up per resource", () => {
+    // farm costs wood 15 (odd -> ceil 15/2 = 8) and stone 5 (odd -> ceil 5/2 = 3)
+    const s = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(s.resources.wood).toBe(22);
+    expect(s.resources.stone).toBe(7);
+    expect(s.resources.food).toBe(10);
+    expect(s.buildings).toEqual(["farm"]);
+  });
+
+  it("uses exact half when the cost is even", () => {
+    // hut costs wood 10 (even -> ceil 10/2 = 5)
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    expect(s.resources.wood).toBe(25);
+  });
+
+  it("does not deduct food, which is not part of the cost", () => {
+    const s = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(s.resources.food).toBe(10);
+  });
+
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const before = settlement({ buildings: ["hut"] });
+    const after = repairBuilding(before, "farm");
+    expect(after).toBe(before);
+  });
+
+  it("clamps resources at 0 when there isn't enough to cover the repair", () => {
+    // hut repair costs wood 5, but the settlement only has 3
+    const s = repairBuilding(
+      settlement({
+        buildings: ["hut"],
+        resources: { wood: 3, food: 10, stone: 10 },
+      }),
+      "hut",
+    );
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+});
