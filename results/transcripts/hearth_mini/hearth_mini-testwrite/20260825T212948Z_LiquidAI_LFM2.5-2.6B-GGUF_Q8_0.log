+import { repairBuilding } from "../src/sim";
+import type { Settlement, BuildingKind } from "../src/types";
+
+// Test 1: No-op if settlement doesn't have the building
+const emptySettlement: Settlement = {
+  resources: { wood: 10, stone: 5 },
+  buildings: [],
+  population: 0,
+};
+
+test("repairBuilding should be a no-op when the building is not present", () => {
+  const result = repairBuilding(emptySettlement, "hut");
+  expect(result).toEqual(emptySettlement);
+});
+
+// Test 2: Repair an already-built building for half its original cost (rounded up)
+const hutCost = { wood: 10 };
+const settlementWithHut: Settlement = {
+  resources: { wood: 20, stone: 5 },
+  buildings: ["hut"],
+  population: 0,
+};
+
+test("repairBuilding should repair a built building for half its cost (rounded up)", () => {
+  const result = repairBuilding(settlementWithHut, "hut");
+  // Original hut cost is wood: 10. Half rounded up = ceil(10/2) = 5
+  // So we should subtract 5 from wood
+  expect(result.resources.wood).toBe(15); // 20 - 5 = 15
+  expect(result.resources.stone).toBe(5);
+});
+
+// Test 3: Odd-numbered cost rounding up (e.g., 7 -> ceil(7/2) = 4)
+const farmCost = { wood: 15, stone: 5 };
+const settlementWithFarm: Settlement = {
+  resources: { wood: 30, stone: 10 },
+  buildings: ["farm"],
+  population: 0,
+};
+
+test("repairBuilding should round up odd-numbered costs (e.g., 7 -> 4)", () => {
+  const result = repairBuilding(settlementWithFarm, "farm");
+  // wood cost 15 -> ceil(15/2) = 8
+  // stone cost 5 -> ceil(5/2) = 3
+  expect(result.resources.wood).toBe(22); // 30 - 8 = 22
+  expect(result.resources.stone).toBe(7); // 10 - 3 = 7
+});
+
+// Test 4: Never takes resources below 0 (insufficient resources)
+const lowResourceSettlement: Settlement = {
+  resources: { wood: 5, stone: 2 },
+  buildings: ["hut"],
+  population: 0,
+};
+
+test("repairBuilding should never take resources below 0", () => {
+  const result = repairBuilding(lowResourceSettlement, "hut");
+  // hut cost is wood: 10. Half rounded up = ceil(10/2) = 5
+  // But only 5 wood available, so we should have 0 left (not negative)
+  expect(result.resources.wood).toBe(0);
+  expect(result.resources.stone).toBe(2);
+});
