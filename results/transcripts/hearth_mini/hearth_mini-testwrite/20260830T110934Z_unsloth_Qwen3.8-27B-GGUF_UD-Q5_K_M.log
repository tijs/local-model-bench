+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("deducts half the original cost, rounded up per resource", () => {
+    // farm costs { wood: 15, stone: 5 } → repair costs { wood: 8, stone: 3 }
+    const s = settlement({ buildings: ["farm"] });
+    const r = repairBuilding(s, "farm");
+    expect(r.resources.wood).toBe(30 - 8);
+    expect(r.resources.stone).toBe(10 - 3);
+    expect(r.resources.food).toBe(10); // untouched
+    expect(r.buildings).toEqual(["farm"]);
+  });
+
+  it("deducts an exact half for an even cost", () => {
+    // hut costs { wood: 10 } → repair costs { wood: 5 }
+    const s = settlement({ resources: { wood: 10, food: 0, stone: 0 }, buildings: ["hut"] });
+    const r = repairBuilding(s, "hut");
+    expect(r.resources.wood).toBe(5);
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const r = repairBuilding(s, "farm");
+    expect(r).toBe(s);
+    expect(r.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("never takes a resource below 0", () => {
+    // quarry repair costs { wood: 10 }; settlement has only 3 wood
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 10 },
+      buildings: ["quarry"],
+    });
+    const r = repairBuilding(s, "quarry");
+    expect(r.resources.wood).toBe(0);
+    expect(r.resources.food).toBe(10); // other resources untouched
+  });
+
+  it("clamps multiple short resources to 0 at once", () => {
+    // farm repair costs { wood: 8, stone: 3 }; settlement has wood 1, stone 0
+    const s = settlement({
+      resources: { wood: 1, food: 10, stone: 0 },
+      buildings: ["farm"],
+    });
+    const r = repairBuilding(s, "farm");
+    expect(r.resources.wood).toBe(0);
+    expect(r.resources.stone).toBe(0);
+    expect(r.resources.food).toBe(10);
+  });
+});
