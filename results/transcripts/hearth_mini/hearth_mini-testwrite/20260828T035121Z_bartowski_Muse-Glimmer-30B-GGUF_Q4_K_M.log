+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a hut for half cost rounded up", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 20, food: 5, stone: 5 } });
+    const repaired = repairBuilding(s, "hut");
+    // hut cost wood 10, repair ceil(10/2)=5
+    expect(repaired.resources.wood).toBe(15);
+    expect(repaired.resources.food).toBe(5);
+    expect(repaired.resources.stone).toBe(5);
+  });
+
+  it("repairs a farm with multiple resources, rounding up per resource", () => {
+    const s = settlement({ buildings: ["farm"], resources: { wood: 20, food: 5, stone: 10 } });
+    const repaired = repairBuilding(s, "farm");
+    // farm cost wood 15 -> ceil(7.5)=8, stone 5 -> ceil(2.5)=3
+    expect(repaired.resources.wood).toBe(12);
+    expect(repaired.resources.stone).toBe(7);
+    expect(repaired.resources.food).toBe(5);
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 20, food: 5, stone: 5 } });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired).toBe(s);
+    expect(repaired.resources.wood).toBe(20);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes resources below zero when repair cost exceeds available", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 3, food: 0, stone: 0 } });
+    const repaired = repairBuilding(s, "hut");
+    // repair cost 5, wood 3 -> max(0, 3-5)=0
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.food).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+  });
+
+  it("handles odd cost rounding up and insufficient resources for multiple resources", () => {
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 4, food: 1, stone: 2 }
+    });
+    const repaired = repairBuilding(s, "farm");
+    // wood repair 8, stone repair 3
+    // wood: max(0,4-8)=0, stone: max(0,2-3)=0
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+    expect(repaired.resources.food).toBe(1);
+  });
+
+  it("does not modify original settlement", () => {
+    const s = settlement({ buildings: ["quarry"], resources: { wood: 20, food: 0, stone: 0 } });
+    const originalWood = s.resources.wood;
+    repairBuilding(s, "quarry");
+    expect(s.resources.wood).toBe(originalWood);
+  });
+});
