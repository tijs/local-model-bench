+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost, rounded up per resource", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] });
+    // farm costs wood 15, stone 5 -> repair is ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(22);
+    expect(repaired.resources.stone).toBe(7);
+    // buildings are unchanged by a repair
+    expect(repaired.buildings).toEqual(["farm"]);
+  });
+
+  it("rounds up an odd-numbered cost (farm wood cost 15 -> 8)", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(22); // 30 - ceil(15/2) = 30 - 8
+  });
+
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s); // same reference, nothing changed
+    expect(result.resources.wood).toBe(30);
+    expect(result.resources.stone).toBe(10);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0", () => {
+    const s = settlement({ resources: { wood: 3, food: 10, stone: 10 }, buildings: ["hut"] });
+    // hut repair costs ceil(10/2) = 5 wood, but only 3 available
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(0);
+  });
+});
