+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built hut for half its cost (wood 10 -> 5)", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(25);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+    expect(repaired.population).toBe(2);
+  });
+
+  it("rounds half-cost up for odd-numbered costs (farm wood 15 -> 8, stone 5 -> 3)", () => {
+    const s = settlement({ buildings: ["farm"] });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(22); // 30 - ceil(15/2) = 30 - 8
+    expect(repaired.resources.stone).toBe(7); // 10 - ceil(5/2) = 10 - 3
+    expect(repaired.resources.food).toBe(10);
+  });
+
+  it("repairs a built quarry for half its cost (wood 20 -> 10)", () => {
+    const s = settlement({ buildings: ["quarry"] });
+    const repaired = repairBuilding(s, "quarry");
+    expect(repaired.resources.wood).toBe(20);
+  });
+
+  it("is a no-op when the settlement doesn't have the building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired).toBe(s);
+    expect(repaired.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("is a no-op on an empty settlement", () => {
+    const s = settlement();
+    const repaired = repairBuilding(s, "quarry");
+    expect(repaired).toBe(s);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 1 },
+      buildings: ["farm"],
+    });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(0); // 3 - 8 would be negative
+    expect(repaired.resources.stone).toBe(0); // 1 - 3 would be negative
+    expect(repaired.resources.food).toBe(10); // untouched
+  });
+
+  it("never takes a resource below 0 when the settlement has zero of it", () => {
+    const s = settlement({
+      resources: { wood: 0, food: 5, stone: 0 },
+      buildings: ["hut"],
+    });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.food).toBe(5);
+    expect(repaired.resources.stone).toBe(0);
+  });
+
+  it("does not mutate the input settlement", () => {
+    const s = settlement({ buildings: ["hut"] });
+    repairBuilding(s, "hut");
+    expect(s.resources.wood).toBe(30);
+  });
