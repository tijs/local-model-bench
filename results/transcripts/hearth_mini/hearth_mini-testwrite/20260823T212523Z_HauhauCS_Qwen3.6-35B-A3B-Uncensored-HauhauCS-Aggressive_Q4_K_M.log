+import { describe, it, expect } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function makeSettlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 1,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost, rounded up per resource", () => {
+    const settlement = makeSettlement({
+      buildings: ["farm"],
+    });
+    // farm costs { wood: 15, stone: 5 }
+    // repair cost = ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const result = repairBuilding(settlement, "farm");
+
+    expect(result.buildings).toEqual(["farm"]);
+    expect(result.resources.wood).toBe(30 - 8); // 22
+    expect(result.resources.stone).toBe(10 - 3); // 7
+    expect(result.resources.food).toBe(10); // unchanged
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const settlement = makeSettlement({
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(settlement, "quarry");
+
+    expect(result).toBe(settlement); // same object returned
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.resources.wood).toBe(30);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+  });
+
+  it("never takes resources below 0 when the settlement has less than the repair cost", () => {
+    const settlement = makeSettlement({
+      buildings: ["farm"],
+      resources: { wood: 5, food: 10, stone: 2 },
+    });
+    // farm repair cost = 8 wood, 3 stone
+    // wood: max(0, 5 - 8) = 0, stone: max(0, 2 - 3) = 0
+    const result = repairBuilding(settlement, "farm");
+
+    expect(result.buildings).toEqual(["farm"]);
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10); // unchanged
+  });
+});
