+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an existing building, deducting half the original cost", () => {
+    // hut costs wood: 10, so repair costs ceil(10 / 2) = 5 wood.
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    expect(s.resources.wood).toBe(25);
+    // The building list is unchanged (no new building is added).
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds the cost up per resource when the cost is odd", () => {
+    // farm costs wood: 15 (odd), so repair costs ceil(15 / 2) = 8 wood.
+    const s = repairBuilding(settlement({ buildings: ["farm"] }), "farm");
+    expect(s.resources.wood).toBe(22);
+  });
+
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0", () => {
+    // farm costs wood: 15, repair costs ceil(15 / 2) = 8 wood, but only 3 remain.
+    const s = repairBuilding(
+      settlement({ buildings: ["farm"], resources: { wood: 3, food: 10, stone: 10 } }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(0);
+  });
+});
