+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a building for half its original cost (rounded up)", () => {
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "hut");
+    // Hut costs 10 wood, repair should cost 5 (Math.ceil(10/2))
+    expect(repaired.resources.wood).toBe(25);
+    expect(repaired.resources.food).toBe(10); // unchanged
+    expect(repaired.resources.stone).toBe(10); // unchanged
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "hut");n    // Should be unchanged
+    expect(result).toBe(s);
+    expect(result.resources.wood).toBe(30);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+    expect(result.buildings).toEqual(["farm"]);
+  });
+
+  it("never takes any resource below 0", () => {
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 1, food: 10, stone: 1 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    // Farm costs wood: 15, stone: 5
+    // Repair should cost wood: 8 (Math.ceil(15/2)), stone: 3 (Math.ceil(5/2))
+    // But we only have 1 of each, so should end up with 0
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+    expect(repaired.resources.food).toBe(10); // unchanged
+    expect(repaired.buildings).toEqual(["farm"]);
+  });
+
+  it("handles rounding up for odd-numbered costs", () => {
+    const s = settlement({
+      buildings: ["quarry"],
+      resources: { wood: 12, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "quarry");
+    // Quarry costs 20 wood, repair should cost 10 (Math.ceil(20/2))
+    expect(repaired.resources.wood).toBe(2); // 12 - 10
+    expect(repaired.resources.food).toBe(10); // unchanged
+    expect(repaired.resources.stone).toBe(10); // unchanged
+    expect(repaired.buildings).toEqual(["quarry"]);
+  });
+});
