+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a building for half its original cost (rounded up)", () => {
+    // farm costs wood: 15, stone: 5
+    // half cost: wood: 8 (rounded up from 7.5), stone: 3
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 20, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(12); // 20 - 8 = 12
+    expect(repaired.resources.stone).toBe(7); // 10 - 3 = 7
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const s = settlement({
+      buildings: ["hut"],
+    });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired).toBe(s); // Same reference, no changes
+  });
+
+  it("never takes resources below 0", () => {
+    // quarry costs wood: 20
+    // half cost: wood: 10
+    const s = settlement({
+      buildings: ["quarry"],
+      resources: { wood: 5, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "quarry");
+    expect(repaired.resources.wood).toBe(0); // 5 - 10 = -5, but clamped to 0
+  });
+
+  it("rounds up odd-numbered costs", () => {
+    // quarry costs wood: 20, half is exactly 10 (no rounding needed)
+    // Let's verify rounding works with an odd cost
+    // We need a building/resource combination with odd cost
+    // hut: wood: 10 -> half is 5 (no rounding needed)
+    // farm: wood: 15 -> half is 8 (rounded up from 7.5)
+    // farm: stone: 5 -> half is 3 (rounded up from 2.5)
+    // quarry: wood: 20 -> half is 10 (no rounding needed)
+
+    // Testing farm wood repair (15 -> ceil(15/2) = 8)
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 10, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    expect(repaired.resources.wood).toBe(2); // 10 - 8 = 2
+  });
+
+  it("handles settlement with less resource than repair cost", () => {
+    // Even when settlement has less than repair cost, resources don't go below 0
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 5, food: 10, stone: 5 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    // farm costs wood: 15, stone: 5
+    // repair cost: wood: 8 (rounded up), stone: 3 (rounded up)
+    expect(repaired.resources.wood).toBe(0); // 5 - 8 = -3, clamped to 0
+    expect(repaired.resources.stone).toBe(2); // 5 - 3 = 2
+  });
+});
