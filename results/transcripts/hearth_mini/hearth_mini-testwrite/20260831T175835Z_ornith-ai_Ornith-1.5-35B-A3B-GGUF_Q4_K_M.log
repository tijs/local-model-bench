+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a building for half its original cost, rounded up per resource", () => {
+    // hut costs 10 wood -> repair costs ceil(10 / 2) = 5 wood
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    expect(s.resources.wood).toBe(25);
+    // unaffected resources stay put
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+    // the building is still present
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up when the cost is odd (per resource)", () => {
+    // farm costs wood 15, stone 5 -> repair costs ceil(15 / 2) = 8 and ceil(5 / 2) = 3
+    const s = repairBuilding(settlement({ resources: { wood: 30, food: 10, stone: 10 } }), "farm");
+    expect(s.resources.wood).toBe(22);
+    expect(s.resources.stone).toBe(7);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const before = settlement({ buildings: ["hut"], resources: { wood: 30, food: 10, stone: 10 } });
+    const s = repairBuilding(before, "quarry");
+    // nothing deducted, nothing added
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual(["hut"]);
+    // returns the same (unmodified) settlement instance
+    expect(s).toBe(before);
+  });
+
+  it("never takes a resource below 0", () => {
+    // quarry repair costs ceil(20 / 2) = 10 wood, but the settlement only has 4
+    const s = repairBuilding(
+      settlement({ buildings: ["quarry"], resources: { wood: 4, food: 10, stone: 10 } }),
+      "quarry",
+    );
+    expect(s.resources.wood).toBe(0);
+    // other resources are untouched
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("does not mutate the input settlement", () => {
+    const before = settlement({ buildings: ["hut"], resources: { wood: 30, food: 10, stone: 10 } });
+    repairBuilding(before, "hut");
+    expect(before.resources.wood).toBe(30);
+  });
+});
