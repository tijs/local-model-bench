+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a hut for half its wood cost", () => {
+    const s = repairBuilding(settlement({ buildings: ["hut"] }), "hut");
+    expect(s.resources.wood).toBe(25); // 30 - 10/2
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+    expect(s.buildings).toEqual(["hut"]);
+    expect(s.population).toBe(2);
+  });
+
+  it("repairs a farm rounding up per resource for odd costs", () => {
+    // Farm costs 15 wood (ceil(15/2)=8) and 5 stone (ceil(5/2)=3).
+    const s = repairBuilding(
+      settlement({ resources: { wood: 20, food: 10, stone: 10 }, buildings: ["farm"] }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(12); // 20 - 8
+    expect(s.resources.stone).toBe(7); // 10 - 3
+    expect(s.resources.food).toBe(10);
+  });
+
+  it("repairs a quarry for half its wood cost", () => {
+    const s = repairBuilding(settlement({ buildings: ["quarry"] }), "quarry");
+    expect(s.resources.wood).toBe(20); // 30 - 20/2
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const base = settlement();
+    const s = repairBuilding(base, "farm");
+    expect(s).toBe(base);
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual([]);
+  });
+
+  it("never takes a resource below 0 when resources are short", () => {
+    const s = repairBuilding(
+      settlement({ resources: { wood: 4, food: 10, stone: 2 }, buildings: ["farm"] }),
+      "farm",
+    );
+    // Repair would cost 8 wood and 3 stone; only 4 wood and 2 stone held.
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.stone).toBe(0);
+    expect(s.resources.food).toBe(10);
+  });
+
+  it("does not modify the input settlement", () => {
+    const base = settlement({ buildings: ["hut"] });
+    const before = { ...base.resources, buildings: [...base.buildings] };
+    repairBuilding(base, "hut");
+    expect(base.resources).toEqual(before);
+    expect(base.buildings).toEqual(before.buildings);
+  });
+});
