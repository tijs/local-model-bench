+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement does not have the building", () => {
+    const s = settlement();
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual(s.resources);
+    expect(result.buildings).toEqual([]);
+  });
+
+  it("repairs for half the original cost, rounded up per resource", () => {
+    // farm costs { wood: 15, stone: 5 }; ceil(15/2) = 8, ceil(5/2) = 3
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(30 - 8);
+    expect(result.resources.stone).toBe(10 - 3);
+    expect(result.resources.food).toBe(10);
+    expect(result.buildings).toEqual(["farm"]);
+  });
+
+  it("never takes a resource below 0 when resources fall short", () => {
+    // farm repair needs 8 wood, but only 5 are available -> wood clamps to 0
+    const s = settlement({ resources: { wood: 5, food: 10, stone: 10 }, buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0);
+    // other resources are still deducted correctly
+    expect(result.resources.stone).toBe(10 - 3);
+  });
+
+  it("does not mutate the original settlement", () => {
+    const s = settlement({ buildings: ["farm"] });
+    repairBuilding(s, "farm");
+    expect(s.resources.wood).toBe(30);
+    expect(s.resources.stone).toBe(10);
+  });
+});
