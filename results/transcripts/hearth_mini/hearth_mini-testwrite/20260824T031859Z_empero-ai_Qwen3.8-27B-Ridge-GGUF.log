+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an existing building for half its original cost (even costs)", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "hut");
+    // hut costs 10 wood -> repair is ceil(10/2) = 5 wood
+    expect(result.resources.wood).toBe(25);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up the repair cost for odd-numbered original costs", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // farm costs 15 wood + 5 stone -> repair is ceil(15/2) = 8 wood, ceil(5/2) = 3 stone
+    expect(result.resources.wood).toBe(22);
+    expect(result.resources.stone).toBe(7);
+  });
+
+  it("is a no-op if the settlement does not have that building", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result).toBe(s);
+    expect(result.resources.wood).toBe(30);
+    expect(result.resources.stone).toBe(10);
+  });
+
+  it("never takes a resource below 0", () => {
+    const s = settlement({
+      resources: { wood: 3, food: 10, stone: 2 },
+      buildings: ["farm"],
+    });
+    const result = repairBuilding(s, "farm");
+    // repair wants 8 wood and 3 stone; only 3 wood and 2 stone available
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("repairs a quarry for half its original cost", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["quarry"],
+    });
+    const result = repairBuilding(s, "quarry");
+    // quarry costs 20 wood -> repair is ceil(20/2) = 10 wood
+    expect(result.resources.wood).toBe(20);
+  });
+});
