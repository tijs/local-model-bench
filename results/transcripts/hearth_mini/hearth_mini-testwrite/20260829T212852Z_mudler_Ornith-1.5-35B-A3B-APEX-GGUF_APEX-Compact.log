+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("is a no-op when the settlement does not have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "quarry");
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+  });
+
+  it("charges half the original cost, rounded up per resource (odd cost)", () => {
+    // farm costs wood 15, stone 5 -> repair wood = ceil(15/2) = 8, stone = ceil(5/2) = 3
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(22);
+    expect(result.resources.stone).toBe(7);
+    // unchanged building list and untouched resources
+    expect(result.resources.food).toBe(10);
+    expect(result.buildings).toEqual(["farm"]);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair cost", () => {
+    // hut repair costs wood 5, but only 3 wood is available -> clamps to 0
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 3, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+    expect(result.buildings).toEqual(["hut"]);
+  });
+});
