+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half original cost rounded up per resource", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
+    });
+    const repaired = repairBuilding(s, "hut");
+    expect(repaired.resources.wood).toBe(25); // 30 - ceil(10/2)=5
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up repair cost for odd-numbered costs", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["farm"],
+    });
+    const repaired = repairBuilding(s, "farm");
+    // farm cost: wood 15 -> ceil(7.5)=8, stone 5 -> ceil(2.5)=3
+    expect(repaired.resources.wood).toBe(22); // 30-8
+    expect(repaired.resources.stone).toBe(7); // 10-3
+  });
+
+  it("is a no-op if settlement does not have the building", () => {
+    const s = settlement({
+      resources: { wood: 30, food: 10, stone: 10 },
+      buildings: ["hut"],
