+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its cost (rounded up per resource)", () => {
+    // hut costs 10 wood, so repair costs ceil(10/2) = 5 wood.
+    const s = repairBuilding(
+      settlement({ buildings: ["hut"] }),
+      "hut",
+    );
+    expect(s.resources.wood).toBe(25);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up each resource when the cost is odd", () => {
+    // farm costs 15 wood and 5 stone, so repair costs ceil(15/2) = 8 wood
+    // and ceil(5/2) = 3 stone.
+    const s = repairBuilding(
+      settlement({ buildings: ["farm"] }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(22);
+    expect(s.resources.stone).toBe(7);
+    expect(s.resources.food).toBe(10);
+  });
+
+  it("does not affect resources of a settlement without the building", () => {
+    const original = settlement({ buildings: ["hut"] });
+    // No farm here: repairing one must be a no-op.
+    const s = repairBuilding(original, "farm");
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("is a no-op when the settlement has no buildings at all", () => {
+    const s = repairBuilding(settlement(), "quarry");
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual([]);
+  });
+
+  it("never takes a resource below 0 when resources are insufficient", () => {
+    // quarry repair costs ceil(20/2) = 10 wood; settlement only has 4.
+    const s = repairBuilding(
+      settlement({
+        resources: { wood: 4, food: 10, stone: 10 },
+        buildings: ["quarry"],
+      }),
+      "quarry",
+    );
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("clamps every insufficient resource to 0 independently", () => {
+    // farm repair costs 8 wood and 3 stone; settlement has only 2 wood, 1 stone.
