+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an existing building for half its original cost, rounded up per resource", () => {
+    // farm costs wood: 15 (odd -> ceil(15/2) = 8) and stone: 5 (ceil(5/2) = 3)
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+
+    expect(result.resources.wood).toBe(22); // 30 - 8
+    expect(result.resources.stone).toBe(7); // 10 - 3
+    expect(result.buildings).toContain("farm");
+  });
+
+  it("is a no-op when the settlement does not have the building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 5, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "farm");
+
+    expect(result).toBe(s);
+    expect(result.resources).toEqual({ wood: 5, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0 when the settlement lacks the resources", () => {
+    // farm repair needs wood: 8, but the settlement only has 5 wood
+    const s = settlement({ buildings: ["farm"], resources: { wood: 5, food: 10, stone: 10 } });
+    const result = repairBuilding(s, "farm");
+
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(7); // ceil(5/2) = 3, still affordable
+  });
+});
