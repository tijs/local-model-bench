+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an existing building for half its original cost", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 20, food: 10, stone: 10 } });
+    const repaired = repairBuilding(s, "hut");
+    // hut cost wood 10, half rounded up = 5
+    expect(repaired.resources.wood).toBe(15);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+  });
+
+  it("rounds up repair cost for odd-numbered costs", () => {
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 30, food: 10, stone: 10 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    // farm cost wood 15, stone 5
+    // repair: ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    expect(repaired.resources.wood).toBe(22);
+    expect(repaired.resources.stone).toBe(7);
+    expect(repaired.resources.food).toBe(10);
+  });
+
+  it("is a no-op if the settlement does not have the building", () => {
+    const s = settlement({ buildings: ["hut"], resources: { wood: 20, food: 10, stone: 10 } });
+    const repaired = repairBuilding(s, "farm");
+    // farm not built, resources unchanged
+    expect(repaired.resources.wood).toBe(20);
+    expect(repaired.resources.stone).toBe(10);
+    expect(repaired.resources.food).toBe(10);
+    expect(repaired.buildings).toEqual(["hut"]);
+    // returned same object (no-op)
+    expect(repaired).toBe(s);
+  });
+
+  it("never takes a resource below zero", () => {
+    const s = settlement({
+      buildings: ["hut"],
+      resources: { wood: 3, food: 0, stone: 0 },
+    });
+    const repaired = repairBuilding(s, "hut");
+    // repair cost 5 wood, but only 3 available -> should floor at 0
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.food).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+  });
+
+  it("handles partial resources without going negative", () => {
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 2, food: 5, stone: 1 },
+    });
+    const repaired = repairBuilding(s, "farm");
+    // wood repair 8 -> wood floors to 0, stone repair 3 -> stone floors to 0
+    expect(repaired.resources.wood).toBe(0);
+    expect(repaired.resources.stone).toBe(0);
+    expect(repaired.resources.food).toBe(5);
+  });
+});
