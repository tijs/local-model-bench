+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs a built building for half its original cost", () => {
+    // hut costs 10 wood -> repair costs 5 wood
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "hut");
+    expect(result.resources.wood).toBe(25);
+    expect(result.resources.food).toBe(10);
+    expect(result.resources.stone).toBe(10);
+    expect(result.buildings).toEqual(["hut"]);
+    expect(result.population).toBe(2);
+  });
+
+  it("rounds the repair cost up per resource for odd costs", () => {
+    // farm costs 15 wood, 5 stone -> repair costs ceil(15/2)=8 wood, ceil(5/2)=3 stone
+    const s = settlement({ buildings: ["farm"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(30 - 8);
+    expect(result.resources.stone).toBe(10 - 3);
+    expect(result.resources.food).toBe(10);
+  });
+
+  it("is a no-op when the settlement doesn't have that building", () => {
+    const s = settlement({ buildings: ["hut"] });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(result.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0", () => {
+    // quarry repair costs 10 wood; settlement only has 4 wood
+    const s = settlement({
+      buildings: ["quarry"],
+      resources: { wood: 4, food: 10, stone: 10 },
+    });
+    const result = repairBuilding(s, "quarry");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(10);
+  });
+
+  it("never takes a resource below 0 when short on multiple resources", () => {
+    // farm repair costs 8 wood, 3 stone; settlement has 5 wood, 2 stone
+    const s = settlement({
+      buildings: ["farm"],
+      resources: { wood: 5, food: 10, stone: 2 },
+    });
+    const result = repairBuilding(s, "farm");
+    expect(result.resources.wood).toBe(0);
+    expect(result.resources.stone).toBe(0);
+    expect(result.resources.food).toBe(10);
+  });
+});
