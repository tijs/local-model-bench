+import { describe, expect, it } from "vitest";
+import { repairBuilding } from "../src/sim";
+import type { Settlement } from "../src/types";
+
+function settlement(overrides: Partial<Settlement> = {}): Settlement {
+  return {
+    resources: { wood: 30, food: 10, stone: 10 },
+    population: 2,
+    buildings: [],
+    ...overrides,
+  };
+}
+
+describe("repairBuilding", () => {
+  it("repairs an already-built building for half its original cost", () => {
+    // hut costs wood 10, so repair costs wood 5
+    const s = repairBuilding(
+      settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] }),
+      "hut",
+    );
+    expect(s.resources.wood).toBe(25);
+    expect(s.resources.food).toBe(10);
+    expect(s.resources.stone).toBe(10);
+  });
+
+  it("rounds up each per-resource half cost (odd-numbered cost)", () => {
+    // farm costs wood 15 and stone 5: repair costs ceil(15/2)=8 wood and ceil(5/2)=3 stone
+    const s = repairBuilding(
+      settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["farm"] }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(22);
+    expect(s.resources.stone).toBe(7);
+  });
+
+  it("is a no-op if the settlement doesn't have that building", () => {
+    const before = settlement({ resources: { wood: 30, food: 10, stone: 10 }, buildings: ["hut"] });
+    const s = repairBuilding(before, "farm");
+    expect(s.resources).toEqual({ wood: 30, food: 10, stone: 10 });
+    expect(s.buildings).toEqual(["hut"]);
+  });
+
+  it("never takes a resource below 0 when the settlement has less than the repair costs", () => {
+    const s = repairBuilding(
+      settlement({ resources: { wood: 3, food: 10, stone: 10 }, buildings: ["hut"] }),
+      "hut",
+    );
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.food).toBe(10);
+  });
+
+  it("clamps every affected resource to 0 individually", () => {
+    // farm repair costs 8 wood and 3 stone; settlement has only 6 wood and 2 stone
+    const s = repairBuilding(
+      settlement({ resources: { wood: 6, food: 10, stone: 2 }, buildings: ["farm"] }),
+      "farm",
+    );
+    expect(s.resources.wood).toBe(0);
+    expect(s.resources.stone).toBe(0);
+  });
+});
