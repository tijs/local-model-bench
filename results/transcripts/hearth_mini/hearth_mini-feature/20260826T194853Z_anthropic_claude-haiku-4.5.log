+/**
+ * Returns all building kinds that are both affordable and allowed
+ * given their prerequisites.
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  const allBuildings: BuildingKind[] = ["hut", "farm", "quarry", "storehouse"];
+  return allBuildings.filter((kind) => {
+    // Check if affordable
+    if (!canAfford(settlement, kind)) {
+      return false;
+    }
+    // Check if prerequisite is met
+    const prerequisite = BUILDING_PREREQUISITES[kind];
+    if (prerequisite && !settlement.buildings.includes(prerequisite)) {
+      return false;
+    }
+    return true;
+  });
