3. **`availableBuildings`** function:
   ```ts
   export function availableBuildings(settlement: Settlement): BuildingKind[] {
     return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter((kind) => {
       if (!canAfford(settlement, kind)) return false;
       const prereq = PREREQUISITE[kind];
       if (prereq === null) return true;
       return settlement.buildings.includes(prereq);
     });
   }
   ```

It iterates every `BuildingKind`, checks affordability via the existing `canAfford`, then filters out any building whose prerequisite isn't already in `settlement.buildings`. Only `"storehouse"` has a prerequisite (`"hut"`); the others have `null` and pass through.


