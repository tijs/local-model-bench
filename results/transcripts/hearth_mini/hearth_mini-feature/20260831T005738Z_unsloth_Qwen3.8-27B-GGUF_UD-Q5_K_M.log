export const BUILDING_PREREQUISITES: Record<BuildingKind, BuildingKind[]> = {
  hut: [],
  farm: [],
  quarry: [],
  storehouse: ["hut"],
};

export function availableBuildings(settlement: Settlement): BuildingKind[] {
  return (Object.keys(BUILDING_PREREQUISITES) as BuildingKind[]).filter(
    (kind) =>
      canAfford(settlement, kind) &&
      BUILDING_PREREQUISITES[kind].every((p) => settlement.buildings.includes(p)),

  );
}

