  return (Object.keys(BUILDING_PREREQUISITES) as BuildingKind[]).filter(
    (kind) =>
      canAfford(settlement, kind) &&
      BUILDING_PREREQUISITES[kind].every((p) => settlement.buildings.includes(p)),
  );
}

