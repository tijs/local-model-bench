+/**
+ * Optional prerequisite for building a kind. A building is only allowed when
+ * the settlement already has every listed prerequisite kind built.
+ */
+export const BUILDING_PREREQUISITES: Record<BuildingKind, BuildingKind[]> = {
+  hut: [],
+  farm: [],
+  quarry: [],
+  storehouse: ["hut"],
 };
 
 export function canAfford(settlement: Settlement, kind: BuildingKind): boolean {
   const cost = BUILDING_COSTS[kind];
   return (Object.entries(cost) as [keyof Resources, number][]).every(
     ([res, amount]) => settlement.resources[res] >= amount,
+  );
+}
+
+/**
+ * Whether the settlement is allowed to build `kind`, given prerequisites.
+ * A building is allowed only if every prerequisite kind is already built.
+ */
+export function isAllowed(settlement: Settlement, kind: BuildingKind): boolean {
+  return BUILDING_PREREQUISITES[kind].every((prereq) =>
+    settlement.buildings.includes(prereq),
+  );
+}
+
+/**
+ * Returns every building kind that is currently both affordable (per
+ * `canAfford`) and allowed given prerequisites.
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter((kind) =>
+    canAfford(settlement, kind) && isAllowed(settlement, kind),
   );
 }
 
