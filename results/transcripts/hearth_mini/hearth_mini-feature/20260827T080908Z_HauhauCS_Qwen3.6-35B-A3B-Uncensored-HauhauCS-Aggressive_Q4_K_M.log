+/**
+ * Returns every building kind that is currently both affordable (per
+ * `canAfford`) and allowed given prerequisites (the prerequisite building
+ * must already exist in the settlement, or there is no prerequisite).
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
