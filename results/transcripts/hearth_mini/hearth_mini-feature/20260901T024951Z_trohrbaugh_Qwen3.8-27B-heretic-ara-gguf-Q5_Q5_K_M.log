+/**
+ * Every building kind that is both affordable (per `canAfford`) and allowed
+ * given prerequisites (all required buildings already exist).
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(PREREQUISITES) as BuildingKind[]).filter(
+    (kind) =>
+      canAfford(settlement, kind) &&
+      (PREREQUISITES[kind] ?? []).every((req) =>
+        settlement.buildings.includes(req),
+      ),
   );
 }
 
