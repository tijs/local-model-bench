+export const BUILDING_PREREQUISITES: Record<BuildingKind, BuildingKind[]> = {
+  hut: [],
+  farm: [],
+  quarry: [],
+  storehouse: ["hut"],
 };
 
 export function canAfford(settlement: Settlement, kind: BuildingKind): boolean {
   const cost = BUILDING_COSTS[kind];
   return (Object.entries(cost) as [keyof Resources, number][]).every(
     ([res, amount]) => settlement.resources[res] >= amount,
+  );
+}
+
+export function hasPrerequisites(settlement: Settlement, kind: BuildingKind): boolean {
+  return BUILDING_PREREQUISITES[kind].every((req) =>
+    settlement.buildings.includes(req),
+  );
+}
+
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter(
+    (kind) => canAfford(settlement, kind) && hasPrerequisites(settlement, kind),
   );
 }
 
