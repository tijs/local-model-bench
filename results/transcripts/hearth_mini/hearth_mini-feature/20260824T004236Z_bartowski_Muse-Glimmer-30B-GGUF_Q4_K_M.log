Implementation:

export const BUILDING_PREREQUISITES: Partial<Record<BuildingKind, BuildingKind>> =
 {
  storehouse: "hut",
};

export function availableBuildings(settlement: Settlement): BuildingKind[] {
  const kinds = Object.keys(BUILDING_COSTS) as BuildingKind[];
  return kinds.filter(kind => {
    if (!canAfford(settlement, kind)) return false;
    const prereq = BUILDING_PREREQUISITES[kind];
    if (!prereq) return true;
    return settlement.buildings.includes(prereq);
  });
}

