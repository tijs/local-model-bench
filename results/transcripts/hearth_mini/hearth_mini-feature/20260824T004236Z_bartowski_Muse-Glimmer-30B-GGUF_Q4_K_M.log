Implement function:

export function availableBuildings(settlement: Settlement): BuildingKind[] {
  return (["hut", "farm", "quarry", "storehouse"] as BuildingKind[]).filter(kind =>
 {
    if (!canAfford(settlement, kind)) return false;
    const prereq = BUILDING_PREREQUISITES[kind];
    if (prereq && !settlement.buildings.includes(prereq)) return false;
    return true;
  });
}

