+/**
+ * Returns every building kind that is currently affordable and allowed
+ * given prerequisites (its prerequisite buildings must already be built).
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter(
+    (kind) =>
+      canAfford(settlement, kind) &&
+      (BUILDING_PREREQUISITES[kind] ?? []).every((pre) =>
+        settlement.buildings.includes(pre),
+      ),
   );
 }
 
