+const BUILDING_KINDS: BuildingKind[] = ["hut", "farm", "quarry", "storehouse"];
+
+/**
+ * Returns every building kind that is both affordable and allowed given
+ * prerequisites (i.e. its prerequisite building, if any, is already built).
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return BUILDING_KINDS.filter((kind) => {
+    const prereq = BUILDING_PREREQS[kind];
+    if (prereq && !settlement.buildings.includes(prereq)) {
+      return false;
+    }
+    return canAfford(settlement, kind);
+  });
 }
 
