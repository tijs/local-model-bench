+export function hasPrerequisite(settlement: Settlement, kind: BuildingKind): boolean {
+  const prerequisite = BUILDING_PREREQUISITES[kind];
+  if (!prerequisite) {
+    return true; // No prerequisite required
+  }
+  return settlement.buildings.includes(prerequisite);
+}
+
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return Object.keys(BUILDING_COSTS).filter(kind => 
+    canAfford(settlement, kind as BuildingKind) && 
+    hasPrerequisite(settlement, kind as BuildingKind)
+  ) as BuildingKind[];
