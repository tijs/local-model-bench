 /**
+ * Returns every building kind that is currently both affordable (per
+ * `canAfford`) and allowed given prerequisites.
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter((kind) => {
+    if (!canAfford(settlement, kind)) {
+      return false;
+    }
+    const prereq = BUILDING_PREREQUISITES[kind];
+    if (prereq !== undefined && !settlement.buildings.includes(prereq)) {
+      return false;
+    }
+    return true;
+  });
+}
