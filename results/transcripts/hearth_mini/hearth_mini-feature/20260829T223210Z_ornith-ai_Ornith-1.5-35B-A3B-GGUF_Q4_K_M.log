```ts
export const BUILDING_PREREQUISITES: Record<BuildingKind, BuildingKind[]> = {
  hut: [],
  farm: [],
  quarry: [],
  storehouse: ["hut"],
};

export function availableBuildings(settlement: Settlement): BuildingKind[] {
  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter((kind) => {
    if (!canAfford(settlement, kind)) {
      return false;
    }
    return BUILDING_PREREQUISITES[kind].every((prereq) =>
      settlement.buildings.includes(prereq),
    );
  });
}
```

