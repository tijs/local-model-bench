+/** Whether the settlement meets the prerequisite for the given building. */
+export function meetsPrerequisite(settlement: Settlement, kind: BuildingKind): boolean {
+  const prereq = BUILDING_PREREQUISITES[kind];
+  if (prereq === undefined) return true;
+  return settlement.buildings.includes(prereq);
+}
+
+/**
+ * Returns every building kind that is both affordable and allowed given
+ * prerequisites.
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter(
+    (kind) => canAfford(settlement, kind) && meetsPrerequisite(settlement, kind),
   );
 }
 
