3. **`availableBuildings` function** — iterates all `BuildingKind` values, filters to those that are both `canAfford` and whose prerequisite (if any) is already in `settlement.buildings`:
   ```ts
   export function availableBuildings(settlement: Settlement): BuildingKind[] {
     return (Object.keys(BUILDING_COSTS) as BuildingKind[]).filter((kind) => {
       if (!canAfford(settlement, kind)) return false;
       const prereq = BUILDING_PREREQUISITES[kind];
       if (prereq && !settlement.buildings.includes(prereq)) return false;
       return true;
     });
   }
   ```

