   export function availableBuildings(settlement: Settlement): BuildingKind[] {
     return (Object.keys(BUILDING_COSTS) as BuildingKind[])
       .filter((kind) => canAfford(settlement, kind))
       .filter((kind) => {
         const prereq = PREREQUISITE[kind];
         return prereq == null || settlement.buildings.includes(prereq);
       });
   }
