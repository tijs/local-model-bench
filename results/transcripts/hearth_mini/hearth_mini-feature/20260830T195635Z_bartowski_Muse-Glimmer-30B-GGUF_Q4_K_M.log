+/**
+ * Returns every building kind that is currently both affordable (per
+ * canAfford) and allowed given prerequisites.
+ */
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  const kinds: BuildingKind[] = ["hut", "farm", "quarry", "storehouse"];
+  return kinds.filter((kind) => {
+    if (!canAfford(settlement, kind)) {
+      return false;
+    }
+    const prereqs = BUILDING_PREREQUISITES[kind];
+    if (!prereqs || prereqs.length === 0) {
+      return true;
+    }
+    return prereqs.every((p) => settlement.buildings.includes(p));
+  });
+}
