+import { describe, it, expect } from 'vitest';
+import { availableBuildings, build, type Settlement } from './sim';
+
+describe('availableBuildings', () => {
+  it('should return available buildings based on resources and prerequisites', () => {
+    const settlement: Settlement = {
+      resources: { wood: 30, food: 10, stone: 15 },
+      population: 1,
+      buildings: ['hut'],
+    };
+
+    const available = availableBuildings(settlement);
+    expect(available).toContain('farm');
+    expect(available).toContain('quarry');
+    expect(available).toContain('storehouse'); // Should be available since hut is built
+  });
+
+  it('should not allow storehouse before hut is built', () => {
+    const settlement: Settlement = {
+      resources: { wood: 30, food: 10, stone: 15 },
+      population: 1,
+      buildings: [],
+    };
+
+    const available = availableBuildings(settlement);
+    expect(available).not.toContain('storehouse');
+  });
+
+  it('should not allow buildings that are unaffordable', () => {
+    const settlement: Settlement = {
+      resources: { wood: 5, food: 10, stone: 5 },
+      population: 1,
+      buildings: ['hut'],
+    };
+
+    const available = availableBuildings(settlement);
+    expect(available).not.toContain('storehouse'); // Not affordable
+    expect(available).toContain('farm'); // Affordable
+  });
+
+  it('should allow all buildings when resources are sufficient', () => {
+    const settlement: Settlement = {
+      resources: { wood: 100, food: 100, stone: 100 },
+      population: 1,
+      buildings: ['hut', 'farm'],
+    };
+
+    const available = availableBuildings(settlement);
+    expect(available).toContain('storehouse');
+    expect(available).toContain('quarry');
+  });
+});
