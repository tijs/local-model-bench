+// Define prerequisites for buildings
+const BUILDING_PREREQUISITES: Partial<Record<BuildingKind, BuildingKind>> = {
+  storehouse: "hut",
+};
+
 export function canAfford(settlement: Settlement, kind: BuildingKind): boolean {
   const cost = BUILDING_COSTS[kind];
   return (Object.entries(cost) as [keyof Resources, number][]).every(
     ([res, amount]) => settlement.resources[res] >= amount,
   );
+}
+
+export function hasPrerequisite(settlement: Settlement, kind: BuildingKind): boolean {
+  const prerequisite = BUILDING_PREREQUISITES[kind];
+  if (!prerequisite) {
+    return true; // No prerequisite needed
+  }
+  return settlement.buildings.includes(prerequisite);
+}
+
+export function availableBuildings(settlement: Settlement): BuildingKind[] {
+  return Object.keys(BUILDING_COSTS).filter(kind => 
+    canAfford(settlement, kind as BuildingKind) && 
+    hasPrerequisite(settlement, kind as BuildingKind)
+  ) as BuildingKind[];
 }
 
