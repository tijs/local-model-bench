+import { availableBuildings, build } from "./src/sim";
+import type { Settlement } from "./src/types";
+
+// Test case 1: No buildings, enough resources for hut
+const settlement1: Settlement = {
+  resources: { wood: 100, food: 100, stone: 100 },
+  population: 1,
+  buildings: [],
+};
+
+console.log("Test 1 - No buildings, enough resources:");
+console.log(availableBuildings(settlement1)); // Should show ["hut", "farm", "quarry"]
+
