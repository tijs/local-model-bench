 import type { Bookmark } from "./types.ts";
+
+// Normalize a URL for duplicate detection. The URL parser lowercases the
+// hostname (which is case-insensitive) while preserving the case of the path
+// (which is case-sensitive), so two URLs that differ only by hostname case are
+// treated as the same bookmark. Falls back to a case-insensitive string
+// comparison for values that don't parse as valid URLs.
+function normalizeUrl(url: string): string {
+  try {
+    return new URL(url).href;
+  } catch {
+    return url.toLowerCase();
+  }
+}
 
