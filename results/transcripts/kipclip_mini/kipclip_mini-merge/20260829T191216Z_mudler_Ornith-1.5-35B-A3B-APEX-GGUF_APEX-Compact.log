+// Two URLs are considered the same when their hostnames match
+// case-insensitively (hostnames are case-insensitive per the URL spec),
+// falling back to an exact comparison if either URL cannot be parsed.
+function sameUrl(a: string, b: string): boolean {
+  try {
+    return new URL(a).host.toLowerCase() === new URL(b).host.toLowerCase();
+  } catch {
+    return a === b;
+  }
