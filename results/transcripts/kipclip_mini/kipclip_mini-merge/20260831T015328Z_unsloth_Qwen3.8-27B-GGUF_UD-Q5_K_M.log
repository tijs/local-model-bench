import type { Bookmark } from "./types.ts";

function sameUrl(a: string, b: string): boolean {
  const ua = new URL(a);
  const ub = new URL(b);
  ua.hostname = ua.hostname.toLowerCase();
  ub.hostname = ub.hostname.toLowerCase();
  return ua.toString() === ub.toString();
}
```

