+import { mergeImports } from "../src/import_merge.ts";
+import type { Bookmark } from "../src/types.ts";
+
+async function runTest() {
+  const cases = [
+    {
+      name: "Case-insensitive hostname merge",
+      existing: [{ url: "https://example.com/a", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "https://EXAMPLE.com/a", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 1,
+      expectedTags: ["tag1", "tag2"],
+    },
+    {
+      name: "Exact match merge",
+      existing: [{ url: "https://example.com/a", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "https://example.com/a", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 1,
+      expectedTags: ["tag1", "tag2"],
+    },
+    {
+      name: "Different path - no merge",
+      existing: [{ url: "https://example.com/a", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "https://example.com/b", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 2,
+      expectedTags: ["tag1", "tag2"],
+    },
+    {
+      name: "Different search - no merge",
+      existing: [{ url: "https://example.com/a?q=1", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "https://example.com/a?q=2", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 2,
+      expectedTags: ["tag1", "tag2"],
+    },
+    {
+      name: "Different protocol - no merge",
+      existing: [{ url: "https://example.com/a", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "http://example.com/a", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 2,
+      expectedTags: ["tag1", "tag2"],
+    },
+    {
+      name: "Malformed URL fallback",
+      existing: [{ url: "not-a-url", tags: ["tag1"], id: "1", title: "T1", createdAt: 1 }],
+      incoming: [{ url: "not-a-url", tags: ["tag2"], id: "2", title: "T2", createdAt: 2 }],
+      expectedLength: 1,
+      expectedTags: ["tag1", "tag2"],
+    },
+  ];
+
+  let allPassed = true;
+
+  for (const c of cases) {
+    const result = mergeImports(c.existing, c.incoming);
+    const lengthPass = result.length === c.expectedLength;
+    
+    // For merged cases, check tags. For non-merged, check both exist.
+    let tagsPass = false;
+    if (c.expectedLength === 1) {
+      tagsPass = c.expectedTags.every(t => result[0].tags.includes(t));
+    } else {
+      const allTags = result.flatMap(r => r.tags);
+      tagsPass = c.expectedTags.every(t => allTags.includes(t));
+    }
+
+    if (lengthPass && tagsPass) {
+      console.log(`✅ PASS: ${c.name}`);
+    } else {
+      console.error(`❌ FAIL: ${c.name}`);
+      console.error(`   Expected length: ${c.expectedLength}, got: ${result.length}`);
+      console.error(`   Expected tags: ${c.expectedTags}, got: ${result.map(r => r.tags).flat()}`);
+      allPassed = false;
+    }
+  }
+
+  if (!allPassed) {
+    process.exit(1);
+  }
+}
