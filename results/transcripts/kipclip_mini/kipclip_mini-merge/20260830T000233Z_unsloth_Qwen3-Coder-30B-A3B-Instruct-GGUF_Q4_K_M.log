+// Verification script for the URL case-insensitive hostname fix
+// This tests the exact scenario described in the bug report
+
+import type { Bookmark } from "./src/types.ts";
+
+// Mock the fixed mergeImports function to test the logic directly
+function mergeImports(existing: Bookmark[], incoming: Bookmark[]): Bookmark[] {
+  const result = existing.map((b) => ({ ...b, tags: [...b.tags] }));
+
+  for (const inc of incoming) {
+    const match = result.find((b) => {
+      try {
+        // Normalize URLs for comparison by converting hostnames to lowercase
+        const existingUrl = new URL(b.url);
+        const incomingUrl = new URL(inc.url);
+        return (
+          existingUrl.protocol === incomingUrl.protocol &&
+          existingUrl.hostname.toLowerCase() === incomingUrl.hostname.toLowerCase() &&
+          existingUrl.pathname === incomingUrl.pathname &&
+          existingUrl.search === incomingUrl.search &&
+          existingUrl.hash === incomingUrl.hash
+        );
+      } catch {
+        // If URL parsing fails, fall back to string comparison
+        return b.url === inc.url;
+      }
+    });
+    if (match) {
+      match.tags = Array.from(new Set([...match.tags, ...inc.tags]));
+    } else {
+      result.push({ ...inc, tags: [...inc.tags] });
+    }
+  }
+
+  return result;
+}
+
+// Test case from the bug report
+console.log("Testing URL case-insensitive hostname matching fix...\n");
+
+// Create test data with the exact scenario from the bug report
+const existingBookmarks: Bookmark[] = [
+  {
+    id: "1",
+    url: "https://example.com/a",
+    title: "Example Page A",
+    tags: ["tag1"],
+    createdAt: 0
+  }
+];
+
+const incomingBookmarks: Bookmark[] = [
+  {
+    id: "2",
+    url: "https://EXAMPLE.com/a", // Same URL but different hostname case
+    title: "Example Page A Duplicate",
+    tags: ["tag2"],
+    createdAt: 1
+  }
+];
+
+console.log("Existing bookmark:");
+console.log(`  URL: ${existingBookmarks[0].url}`);
+console.log(`  Tags: ${existingBookmarks[0].tags.join(", ")}`);
+
+console.log("\nIncoming bookmark:");
+console.log(`  URL: ${incomingBookmarks[0].url}`);
+console.log(`  Tags: ${incomingBookmarks[0].tags.join(", ")}`);
+
+// Execute the merge
+const result = mergeImports(existingBookmarks, incomingBookmarks);
+
+console.log("\nResult:");
+console.log(`  Number of bookmarks: ${result.length}`);
+
+if (result.length === 1) {
+  console.log("✅ SUCCESS: URLs with different hostname cases were merged correctly");
+  console.log(`  Merged tags: ${result[0].tags.join(", ")}`);
