@@ -0,0 +1,55 @@
+import { normalizeTag } from "../src/tag_utils.ts";
+import { assertEquals } from "@std/assert";
+
+Deno.test("normalizeTag — lowercases letters", () => {
+  assertEquals(normalizeTag("Hello"), "hello");
+  assertEquals(normalizeTag("WORLD"), "world");
+  assertEquals(normalizeTag("MiXeDcAsE"), "mixedcase");
+  assertEquals(normalizeTag("A"), "a");
+});
+
+Deno.test("normalizeTag — collapses mixed punctuation and whitespace into a single dash", () => {
+  // Multiple punctuation characters in a row collapse to one dash
+  assertEquals(normalizeTag("foo!!!bar"), "foo-bar");
+  assertEquals(normalizeTag("foo...bar"), "foo-bar");
+  assertEquals(normalizeTag("foo!!!...bar"), "foo-bar");
+
+  // Whitespace runs collapse to one dash
+  assertEquals(normalizeTag("foo   bar"), "foo-bar");
+  assertEquals(normalizeTag("foo\tbar"), "foo-bar");
+  assertEquals(normalizeTag("foo\nbar"), "foo-bar");
+
+  // Mixed punctuation and whitespace collapse to one dash
+  assertEquals(normalizeTag("foo !@# bar"), "foo-bar");
+  assertEquals(normalizeTag("foo  ...  bar"), "foo-bar");
+  assertEquals(normalizeTag("foo\t!bar"), "foo-bar");
+  assertEquals(normalizeTag("foo ! @ # bar"), "foo-bar");
+
+  // Longer runs of mixed characters
+  assertEquals(normalizeTag("a b!c@d#e"), "a-b-c-d-e");
+});
+
+Deno.test("normalizeTag — strips leading and trailing dashes", () => {
+  // Leading punctuation becomes a leading dash, which is stripped
+  assertEquals(normalizeTag("!!foo"), "foo");
+  assertEquals(normalizeTag("...foo"), "foo");
+  assertEquals(normalizeTag("  foo"), "foo");
+  assertEquals(normalizeTag("  !!  foo"), "foo");
+
+  // Trailing punctuation becomes a trailing dash, which is stripped
+  assertEquals(normalizeTag("foo!!"), "foo");
+  assertEquals(normalizeTag("foo..."), "foo");
+  assertEquals(normalizeTag("foo  "), "foo");
+  assertEquals(normalizeTag("foo  !!  "), "foo");
+
+  // Both leading and trailing
+  assertEquals(normalizeTag("!!foo!!"), "foo");
+  assertEquals(normalizeTag("...foo..."), "foo");
+  assertEquals(normalizeTag("  foo  "), "foo");
+
+  // Only punctuation — result is empty string
+  assertEquals(normalizeTag("!!!"), "");
+  assertEquals(normalizeTag("..."), "");
+  assertEquals(normalizeTag("  "), "");
+  assertEquals(normalizeTag("!@#$%"), "");
+});
