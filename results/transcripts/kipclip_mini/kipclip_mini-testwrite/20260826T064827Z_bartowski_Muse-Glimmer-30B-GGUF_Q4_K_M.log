+#!/usr/bin/env -S deno run --allow-read
+// hermes-verify ad-hoc verification of normalizeTag
+const SRC = "/Users/tijs/projects/local-model-bench/runner/runs/tmp7zp4oi9h/run/src/tag_utils.ts";
+
+async function main() {
+  const mod = await import("file://" + SRC);
+  const normalizeTag = mod.normalizeTag;
+  const cases = [
+    ["Hello", "hello"],
+    ["HELLO WORLD", "hello-world"],
+    ["-Hello-", "hello"],
+    ["Hello   World", "hello-world"],
+    ["Hello---World", "hello-world"],
+    ["A--B__C  D", "a-b-c-d"],
+    ["foo!!!bar...baz", "foo-bar-baz"],
+    ["---leading", "leading"],
+    ["trailing---", "trailing"],
+    ["  - -  test  - - ", "test"],
+  ];
+  let passed = 0;
+  for (const [input, expected] of cases) {
+    const out = normalizeTag(input);
+    const ok = out === expected;
+    console.log(`${ok ? "PASS" : "FAIL"} ${JSON.stringify(input)} => ${JSON.stringify(out)}`);
+    if (ok) passed++;
+  }
+  console.log(`Ad-hoc verification: ${passed}/${cases.length} passed`);
+  if (passed !== cases.length) Deno.exit(1);
+}
+main();
