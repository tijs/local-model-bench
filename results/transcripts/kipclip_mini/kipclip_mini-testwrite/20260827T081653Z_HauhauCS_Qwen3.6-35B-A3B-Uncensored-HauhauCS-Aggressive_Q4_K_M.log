@@ -0,0 +1,38 @@
+import { normalizeTag } from "../src/tag_utils.ts";
+import { assertEquals } from "@std/assert";
+
+Deno.test("normalizeTag - lowercases the tag", () => {
+  assertEquals(normalizeTag("Hello"), "hello");
+  assertEquals(normalizeTag("HELLO"), "hello");
+  assertEquals(normalizeTag("HeLLo"), "hello");
+  assertEquals(normalizeTag("aBc123"), "abc123");
+});
+
+Deno.test("normalizeTag - collapses mixed punctuation and whitespace into a single dash", () => {
+  assertEquals(normalizeTag("foo--bar"), "foo-bar");
+  assertEquals(normalizeTag("foo...bar"), "foo-bar");
+  assertEquals(normalizeTag("foo  bar"), "foo-bar");
+  assertEquals(normalizeTag("foo!@#$%bar"), "foo-bar");
+  assertEquals(normalizeTag("foo   ...   bar"), "foo-bar");
+  assertEquals(normalizeTag("foo/bar baz"), "foo-bar-baz");
+  assertEquals(normalizeTag("foo\t\nbar"), "foo-bar");
+  assertEquals(normalizeTag("a---b---c"), "a-b-c");
+});
+
+Deno.test("normalizeTag - strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---hello---"), "hello");
+  assertEquals(normalizeTag("...hello..."), "hello");
+  assertEquals(normalizeTag("  hello  "), "hello");
+  assertEquals(normalizeTag("---hello"), "hello");
+  assertEquals(normalizeTag("hello---"), "hello");
+  assertEquals(normalizeTag("---hello-world---"), "hello-world");
+  assertEquals(normalizeTag("...foo...bar..."), "foo-bar");
+});
+
+Deno.test("normalizeTag - handles edge cases", () => {
+  assertEquals(normalizeTag(""), "");
+  assertEquals(normalizeTag("---"), "");
+  assertEquals(normalizeTag("   "), "");
+  assertEquals(normalizeTag("a"), "a");
+  assertEquals(normalizeTag("HELLO_WORLD"), "hello_world");
+});
