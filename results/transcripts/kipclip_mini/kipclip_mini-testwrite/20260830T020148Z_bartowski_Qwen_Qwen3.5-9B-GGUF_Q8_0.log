+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag: lowercases input", () => {
+  assertEquals(normalizeTag("UPPERCASE"), "uppercase");
+  assertEquals(normalizeTag("MiXeDcAsE"), "mixedcase");
+  assertEquals(normalizeTag("AlreadyLower"), "alreadylower");
+});
+
+Deno.test("normalizeTag: collapses mixed punctuation and whitespace into a single dash", () => {
+  assertEquals(normalizeTag("hello...world"), "hello-world");
+  assertEquals(normalizeTag("hello---world"), "hello-world");
+  assertEquals(normalizeTag("hello___world"), "hello-world");
+  assertEquals(normalizeTag("hello   world"), "hello-world");
+  assertEquals(normalizeTag("hello\tworld"), "hello-world");
+  assertEquals(normalizeTag("hello\nworld"), "hello-world");
+  assertEquals(normalizeTag("hello...---...world"), "hello-world");
+  assertEquals(normalizeTag("hello!!!???@@@world"), "hello-world");
+  assertEquals(normalizeTag("hello  ...  ---  !!!  world"), "hello-world");
+});
+
+Deno.test("normalizeTag: strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---hello---"), "hello");
+  assertEquals(normalizeTag("--hello--"), "hello");
+  assertEquals(normalizeTag("-hello-"), "hello");
+  assertEquals(normalizeTag("hello-"), "hello");
+  assertEquals(normalizeTag("-hello"), "hello");
+  assertEquals(normalizeTag("----"), "");
+  assertEquals(normalizeTag("---"), "");
+  assertEquals(normalizeTag("--"), "");
+  assertEquals(normalizeTag("-"), "");
+  assertEquals(normalizeTag(""), "");
+});
