+// Verification script for tag_normalize.test.ts functionality
+import { normalizeTag } from "../src/tag_utils.ts";
+
+// Test the exact behaviors covered in our tests
+const testCases = [
+  { input: "UPPERCASE", expected: "uppercase", description: "lowercases uppercase letters" },
+  { input: "tag-with.punctuation and   spaces", expected: "tag-with-punctuation-and-spaces", description: "collapses mixed punctuation/whitespace into single dash" },
+  { input: "---leading-dashes", expected: "leading-dashes", description: "strips leading dashes" },
+  { input: "trailing-dashes---", expected: "trailing-dashes", description: "strips trailing dashes" },
+  { input: "  Mixed_Case.With   Spaces  ", expected: "mixed-case-with-spaces", description: "handles mixed case and punctuation correctly" },
+  { input: "", expected: "", description: "handles empty string" },
+  { input: "   \t\n  ", expected: "", description: "handles only whitespace" },
+  { input: "!@#$%^&*()", expected: "", description: "handles only special characters" }
+];
+
+let passed = 0;
+let failed = 0;
+
+console.log("Verifying normalizeTag function behavior...\n");
+
+for (const testCase of testCases) {
+  const result = normalizeTag(testCase.input);
+  if (result === testCase.expected) {
+    console.log(`✅ ${testCase.description}: "${testCase.input}" → "${result}"`);
+    passed++;
+  } else {
+    console.log(`❌ ${testCase.description}: "${testCase.input}" → Expected "${testCase.expected}", got "${result}"`);
+    failed++;
+  }
+}
+
+console.log(`\nResults: ${passed} passed, ${failed} failed`);
+
+if (failed === 0) {
+  console.log("✅ All tests pass - normalizeTag works correctly!");
+} else {
+  console.log("❌ Some tests failed");
+  Deno.exit(1);
+}
