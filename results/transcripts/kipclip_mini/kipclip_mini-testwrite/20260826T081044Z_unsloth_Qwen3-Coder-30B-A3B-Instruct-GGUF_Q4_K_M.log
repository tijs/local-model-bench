+  assertEquals(result, "tag-with.punctuation-and-spaces");
+});
+
+Deno.test("normalizeTag strips leading dashes", () => {
+  const result = normalizeTag("---leading-dashes");
+  assertEquals(result, "leading-dashes");
+});
