+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases tags", () => {
+  assertEquals(normalizeTag("Hello"), "hello");
+  assertEquals(normalizeTag("ABC"), "abc");
+  assertEquals(normalizeTag("MiXeDcAsE"), "mixedcase");
+});
+
+Deno.test("normalizeTag collapses runs of punctuation/whitespace into a single dash", () => {
+  assertEquals(normalizeTag("Hello World"), "hello-world");
+  assertEquals(normalizeTag("Hello,  World!"), "hello-world");
+  assertEquals(normalizeTag("a b  c"), "a-b-c");
+  assertEquals(normalizeTag("foo...bar"), "foo-bar");
+  assertEquals(normalizeTag("a!@#b"), "a-b");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("--tag--"), "tag");
+  assertEquals(normalizeTag("  -foo-  "), "foo");
+  assertEquals(normalizeTag("___hello___"), "hello");
+});
+
+Deno.test("normalizeTag leaves already-normalized tags unchanged", () => {
+  assertEquals(normalizeTag("plain"), "plain");
+  assertEquals(normalizeTag("tag-name"), "tag-name");
+  assertEquals(normalizeTag("v2"), "v2");
+});
