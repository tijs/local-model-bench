+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases the tag", () => {
+  assertEquals(normalizeTag("Hello World"), "hello world".replace(" ", "-"));
+  assertEquals(normalizeTag("MyTag"), "mytag");
+  assertEquals(normalizeTag("ABC123"), "abc123");
+});
+
+Deno.test("normalizeTag collapses runs of punctuation and whitespace into a single dash", () => {
+  assertEquals(normalizeTag("hello   world"), "hello-world");
+  assertEquals(normalizeTag("hello,world"), "hello-world");
+  assertEquals(normalizeTag("hello!!!world"), "hello-world");
+  assertEquals(normalizeTag("foo!! bar__baz"), "foo-bar-baz");
+  assertEquals(normalizeTag("  a - b  "), "a-b");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("--hello--"), "hello");
+  assertEquals(normalizeTag("...tag..."), "tag");
+  assertEquals(normalizeTag("-a-b-"), "a-b");
+});
+
+Deno.test("normalizeTag leaves clean tags unchanged", () => {
+  assertEquals(normalizeTag("plain-tag-123"), "plain-tag-123");
+});
