+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases uppercase characters", () => {
+  assertEquals(normalizeTag("HELLO"), "hello");
+  assertEquals(normalizeTag("MixedCase"), "mixedcase");
+  assertEquals(normalizeTag("UPPER-lower"), "upper-lower");
+});
+
+Deno.test("normalizeTag collapses mixed punctuation and whitespace into single dash", () => {
+  assertEquals(normalizeTag("hello world"), "hello-world");
+  assertEquals(normalizeTag("hello  world"), "hello-world");
+  assertEquals(normalizeTag("hello-world"), "hello-world");
+  assertEquals(normalizeTag("hello--world"), "hello-world");
+  assertEquals(normalizeTag("hello_world"), "hello-world");
+  assertEquals(normalizeTag("hello.world"), "hello-world");
+  assertEquals(normalizeTag("hello, world!"), "hello-world");
+  assertEquals(normalizeTag("hello @#$ world"), "hello-world");
+  assertEquals(normalizeTag("hello - world"), "hello-world");
+  assertEquals(normalizeTag("hello\tworld"), "hello-world");
+  assertEquals(normalizeTag("hello\nworld"), "hello-world");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("-hello"), "hello");
+  assertEquals(normalizeTag("hello-"), "hello");
+  assertEquals(normalizeTag("-hello-"), "hello");
+  assertEquals(normalizeTag("--hello--"), "hello");
+  assertEquals(normalizeTag("---hello---"), "hello");
+});
+
+Deno.test("normalizeTag combines all transformations", () => {
+  assertEquals(normalizeTag("  HELLO-WORLD  "), "hello-world");
+  assertEquals(normalizeTag("--Hello  World--"), "hello-world");
+  assertEquals(normalizeTag("-Hello_World!"), "hello-world");
+  assertEquals(normalizeTag("  @HELLO@  @WORLD@  "), "hello-world");
+});
+
+Deno.test("normalizeTag handles empty and whitespace-only strings", () => {
+  assertEquals(normalizeTag(""), "");
+  assertEquals(normalizeTag("   "), "");
+  assertEquals(normalizeTag("\t\n"), "");
+  assertEquals(normalizeTag("---"), "");
+});
+
+Deno.test("normalizeTag preserves alphanumeric characters", () => {
+  assertEquals(normalizeTag("hello123"), "hello123");
+  assertEquals(normalizeTag("test-123-abc"), "test-123-abc");
+  assertEquals(normalizeTag("2024-01-15"), "2024-01-15");
+});
