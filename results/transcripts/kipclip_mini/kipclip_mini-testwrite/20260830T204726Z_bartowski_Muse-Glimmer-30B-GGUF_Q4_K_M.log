@@ -0,0 +1,28 @@
+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases", () => {
+  assertEquals(normalizeTag("Hello"), "hello");
+  assertEquals(normalizeTag("HELLO"), "hello");
+  assertEquals(normalizeTag("HeLLo WoRLd"), "hello-world");
+});
+
+Deno.test("normalizeTag collapses mixed punctuation/whitespace into single dash", () => {
+  assertEquals(normalizeTag("Hello---World"), "hello-world");
+  assertEquals(normalizeTag("Hello   World"), "hello-world");
+  assertEquals(normalizeTag("Hello___World!!!"), "hello-world");
+  assertEquals(normalizeTag("a  b\tc\nd"), "a-b-c-d");
+  assertEquals(normalizeTag("foo.bar_baz"), "foo-bar-baz");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---hello---"), "hello");
+  assertEquals(normalizeTag("-hello-"), "hello");
+  assertEquals(normalizeTag("---Hello World---"), "hello-world");
+  assertEquals(normalizeTag("   ---test---   "), "test");
+});
+
+Deno.test("normalizeTag combined behavior", () => {
+  assertEquals(normalizeTag("  ---My_TAG!! 2025--- "), "my-tag-2025");
+  assertEquals(normalizeTag("___UPPER___lower___"), "upper-lower");
+});
