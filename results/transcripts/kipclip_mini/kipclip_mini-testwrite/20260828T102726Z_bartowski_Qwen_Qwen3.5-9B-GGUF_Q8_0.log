+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag: lowercases input", () => {
+  assertEquals(normalizeTag("HelloWorld"), "helloworld");
+  assertEquals(normalizeTag("HELLO_WORLD"), "hello-world");
+  assertEquals(normalizeTag("MiXeD_CaSe_123"), "mixed-case-123");
+});
+
+Deno.test("normalizeTag: collapses mixed punctuation/whitespace into a single dash", () => {
+  assertEquals(normalizeTag("hello...world"), "hello-world");
+  assertEquals(normalizeTag("hello___world"), "hello-world");
+  assertEquals(normalizeTag("hello  world"), "hello-world");
+  assertEquals(normalizeTag("hello... world___"), "hello-world");
+  assertEquals(normalizeTag("hello!!!---___world@@@"), "hello-world");
+  assertEquals(normalizeTag("a:b;c,d.e"), "a-b-c-d-e");
+});
+
+Deno.test("normalizeTag: strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---hello---"), "hello");
