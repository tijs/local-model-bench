+import { normalizeTag } from "../src/tag_utils.ts";
+import { assertEquals } from "@std/assert";
+
+Deno.test("normalizeTag - lowercases uppercase letters", () => {
+  assertEquals(normalizeTag("Hello"), "hello");
+  assertEquals(normalizeTag("FOO"), "foo");
+  assertEquals(normalizeTag("MiXeD"), "mixed");
+  assertEquals(normalizeTag("AbCdEf"), "abcdef");
+});
+
+Deno.test("normalizeTag - collapses mixed punctuation and whitespace into a single dash", () => {
+  // Multiple punctuation characters become one dash
+  assertEquals(normalizeTag("foo---bar"), "foo-bar");
+  assertEquals(normalizeTag("foo!!!bar"), "foo-bar");
+  assertEquals(normalizeTag("foo...bar"), "foo-bar");
+
+  // Whitespace runs become a single dash
+  assertEquals(normalizeTag("foo  bar"), "foo-bar");
+  assertEquals(normalizeTag("foo\tbar"), "foo-bar");
+  assertEquals(normalizeTag("foo\nbar"), "foo-bar");
+
+  // Mixed punctuation and whitespace collapse into one dash
+  assertEquals(normalizeTag("foo !@# bar"), "foo-bar");
+  assertEquals(normalizeTag("foo  ---  bar"), "foo-bar");
+  assertEquals(normalizeTag("foo...  ...bar"), "foo-bar");
+  assertEquals(normalizeTag("foo,;:!bar"), "foo-bar");
+  assertEquals(normalizeTag("foo  !@#  bar"), "foo-bar");
+});
+
+Deno.test("normalizeTag - strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---foo---"), "foo");
+  assertEquals(normalizeTag("  ---  foo  ---  "), "foo");
+  assertEquals(normalizeTag("---hello-world---"), "hello-world");
+  assertEquals(normalizeTag("!@#$foo!@#$"), "foo");
+  assertEquals(normalizeTag("  foo  "), "foo");
+  assertEquals(normalizeTag("  hello  world  "), "hello-world");
+});
+
+Deno.test("normalizeTag - combined behavior", () => {
+  assertEquals(normalizeTag("  Hello World!  "), "hello-world");
+  assertEquals(normalizeTag("---MIXED---CASE---"), "mixed-case");
+  assertEquals(normalizeTag("foo...bar...baz"), "foo-bar-baz");
+  assertEquals(normalizeTag("  "), "");
+  assertEquals(normalizeTag(""), "");
+  assertEquals(normalizeTag("single"), "single");
+  assertEquals(normalizeTag("123"), "123");
+  assertEquals(normalizeTag("a1b2c3"), "a1b2c3");
+});
