import { normalizeTag } from "/Users/tijs/projects/local-model-bench/runner/runs/tmp
15t34dvr/run/src/tag_utils.ts";

const cases: Array<[string, string]> = [
  // lowercasing
  ["Rust", "rust"],
  ["TypeScript", "typescript"],
  // collapse mixed punctuation/whitespace
  ["New York City", "new-york-city"],
  ["New__York", "new-york"],
  ["c++/rust!", "c-rust"],
  ["a , b . c", "a-b-c"],
  ["a  b", "a-b"],
  // strip leading/trailing dashes
  ["  hello  ", "hello"],
  ["---rust---", "rust"],
  ["-rust", "rust"],
  ["rust-", "rust"],
  ["__private__", "private"],
];

let failed = 0;
for (const [input, expected] of cases) {
  const actual = normalizeTag(input);
  if (actual !== expected) {
    failed++;
    console.error(`FAIL: normalizeTag(${JSON.stringify(input)}) => ${JSON.stringify
(actual)}, expected ${JSON.stringify(expected)}`);
  }
}
if (failed > 0) {
  console.error(`${failed}/${cases.length} cases failed`);
  Deno.exit(1);
}
console.log(`All ${cases.length} ad-hoc normalizeTag cases passed`);
```

