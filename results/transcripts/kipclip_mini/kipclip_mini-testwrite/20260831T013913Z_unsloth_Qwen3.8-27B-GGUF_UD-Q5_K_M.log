+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases", () => {
+  assertEquals(normalizeTag("Rust"), "rust");
+  assertEquals(normalizeTag("TypeScript"), "typescript");
+  assertEquals(normalizeTag("ABC123"), "abc123");
+});
+
+Deno.test("normalizeTag collapses mixed punctuation/whitespace into a single dash", () => {
+  assertEquals(normalizeTag("foo  bar"), "foo-bar");
+  assertEquals(normalizeTag("foo!!!bar"), "foo-bar");
+  assertEquals(normalizeTag("foo, bar"), "foo-bar");
+  assertEquals(normalizeTag("a.b-c d"), "a-b-c-d");
+  assertEquals(normalizeTag("  spaced   out  "), "spaced-out");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("--foo--"), "foo");
+  assertEquals(normalizeTag("...bar"), "bar");
+  assertEquals(normalizeTag("baz!!"), "baz");
+  assertEquals(normalizeTag("  --dashy--  "), "dashy");
+  assertEquals(normalizeTag("--"), "");
+});
