+// Ad-hoc verification of tests/tag_normalize.test.ts
+// This verifies the normalizeTag function tests are correct
+
+import { assert } from "https://deno.land/std@0.224.0/assert/mod.ts";
+import { normalizeTag } from "./src/tag_utils.ts";
+
+// Verify the function behaves as expected for test coverage
+const testCases = [
+  // Lowercasing tests
+  { input: "FOO", expected: "foo" },
+  { input: "Bar-Baz", expected: "bar-baz" },
+  { input: "HELLO WORLD", expected: "hello-world" },
+  // Collapsing tests
+  { input: "foo---bar", expected: "foo-bar" },
+  { input: "foo   bar", expected: "foo-bar" },
+  { input: "foo,--bar", expected: "foo-bar" },
+  { input: "foo - _ bar", expected: "foo-bar" },
+  { input: "a...b", expected: "a-b" },
+  { input: "hello!!!world", expected: "hello-world" },
+  // Strip leading/trailing tests
+  { input: "---foo", expected: "foo" },
+  { input: "foo---", expected: "foo" },
+  { input: "---foo---", expected: "foo" },
+  { input: "---foo-bar---", expected: "foo-bar" },
+];
+
+console.log(`Running ${testCases.length} ad-hoc verification cases...`);
+for (const { input, expected } of testCases) {
+  const result = normalizeTag(input);
+  assert(result === expected, `normalizeTag(${JSON.stringify(input)}) = ${JSON.stringify(result)}, expected ${JSON.stringify(expected)}`);
+}
+console.log("All ad-hoc verification tests passed!");
