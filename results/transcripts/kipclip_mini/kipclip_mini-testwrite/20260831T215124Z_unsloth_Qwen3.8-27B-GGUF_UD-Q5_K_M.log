+import { assertEquals } from "@std/assert";
+import { normalizeTag } from "../src/tag_utils.ts";
+
+Deno.test("normalizeTag lowercases input", () => {
+  assertEquals(normalizeTag("Hello World"), "hello-world");
+  assertEquals(normalizeTag("TAGS"), "tags");
+});
+
+Deno.test("normalizeTag collapses runs of punctuation and whitespace into a single dash", () => {
+  assertEquals(normalizeTag("hello   world"), "hello-world");
+  assertEquals(normalizeTag("foo!@#bar"), "foo-bar");
+  assertEquals(normalizeTag("a  -  b"), "a-b");
+  assertEquals(normalizeTag("spaces\tand\nnewlines"), "spaces-and-newlines");
+});
+
+Deno.test("normalizeTag strips leading and trailing dashes", () => {
+  assertEquals(normalizeTag("---leading"), "leading");
+  assertEquals(normalizeTag("trailing---"), "trailing");
+  assertEquals(normalizeTag("!!mixed!! ends!!"), "mixed-ends");
+  assertEquals(normalizeTag("  --both--  "), "both");
+});
+
+Deno.test("normalizeTag trims surrounding whitespace", () => {
+  assertEquals(normalizeTag("  hello  "), "hello");
+});
