+    name: "lowercase basic string",
+    test: () => {
+      expect(normalizeTag("Hello World")).toBe("hello-world");
+      console.log("✓ Test 1 passed: lowercase basic string")
+    }
+  },
+  {
+    name: "trim whitespace",
+    test: () => {
+      expect(normalizeTag("  test  ")).toBe("test");
+      console.log("✓ Test 2 passed: trim whitespace");
+    }
+  },
+  {
+    name: "collapse multiple separators",
+    test: () => {
+      expect(normalizeTag("test--abc!!!def")).toBe("test--abc-def");
+      console.log("✓ Test 3 passed: collapse multiple separators");
+    }
+  },
+  {
+    name: "strip leading/trailing dashes",
+    test: () => {
+      expect(normalizeTag("-hello-world-").toBe("hello-world");
+      console.log("✓ Test 4 passed: strip leading/trailing dashes");
+    }
+  },
+  {
+    name: "collapse mixed separators",
+    test: () => {
+      expect(normalizeTag("hello!!!  world@@  test")).toBe("hello-world");
+      console.log("✓ Test 5 passed: collapse mixed separators");
+    }
+  },
+  {
+    name: "empty string handling",
+    test: () => {
+      expect(normalizeTag("")).toBe("");
+      console.log("✓ Test 6 passed: empty string handling");
+    }
+  },
+  {
+    name: "case normalization",
+    test: () => {
+      expect(normalizeTag("HeLLo WoRLd")).toBe("hello-world");
+      console.log("✓ Test 7 passed: case normalization");
+    }
+  }
+];
+
+let passed = 0;
+let failed = 0;
+
+for (const test of tests) {
+  try {
+    test.test();
+    passed++;
+  } catch (e) {
+    console.log(`✗ Test failed: ${test.name}: ${e.message}`);
+    failed++;
+  }
+}
+
+console.log(`
+${passed} passed, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
