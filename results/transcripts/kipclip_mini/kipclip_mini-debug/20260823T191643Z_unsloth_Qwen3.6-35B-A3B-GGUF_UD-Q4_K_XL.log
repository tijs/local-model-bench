+import { normalizeUrl } from "./src/url_utils.ts";
+import { assertEquals } from "jsr:@std/assert";
+
+// Bug regression: multiple tracking params must ALL be stripped
+const url = "https://example.com/?utm_source=fb&fbclid=abc123&utm_campaign=sale";
+const result = normalizeUrl(url);
+const q = new URL(result).searchParams;
+assertEquals(q.has("utm_source"), false, "utm_source should be stripped");
+assertEquals(q.has("fbclid"), false, "fbclid should be stripped");
+assertEquals(q.has("utm_campaign"), false, "utm_campaign should be stripped");
+assertEquals(q.has("utm_medium"), false, "utm_medium should not be present");
+
+// Single tracking param still works
+const url2 = "https://Example.COM/?utm_source=google";
+const result2 = normalizeUrl(url2);
+const q2 = new URL(result2).searchParams;
+assertEquals(q2.has("utm_source"), false, "utm_source should be stripped");
+assertEquals(new URL(result2).hostname, "example.com", "hostname should be lowercased");
+
+// No tracking params - other query params preserved
+const url3 = "https://example.com/path?foo=bar&baz=qux";
+const result3 = normalizeUrl(url3);
+const q3 = new URL(result3).searchParams;
+assertEquals(q3.get("foo"), "bar");
+assertEquals(q3.get("baz"), "qux");
+
