+// Test script to verify the fix for multiple tracking parameters in normalizeUrl
+
+// Since we can't import directly, let's manually implement what the function should do
+function normalizeUrl(rawUrl) {
+  const TRACKING_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid"];
+  
+  const u = new URL(rawUrl);
+  u.hostname = u.hostname.toLowerCase();
+
+  for (const param of TRACKING_PARAMS) {
+    if (u.searchParams.has(param)) {
+      u.searchParams.delete(param);
+    }
+  }
+
+  let result = u.toString();
+  if (u.pathname === "/" && result.endsWith("/")) {
+    result = result.slice(0, -1);
+  }
+  return result;
+}
+
+// Test cases
+const testCases = [
+  {
+    input: 'https://example.com/?utm_source=source1&utm_medium=medium1&fbclid=12345',
+    description: 'URL with utm_source, utm_medium, and fbclid'
+  },
+  {
+    input: 'https://example.com/path?utm_campaign=campaign1&fbclid=67890&utm_source=source2',
+    description: 'URL with utm_campaign, fbclid, and utm_source'
+  },
+  {
+    input: 'https://EXAMPLE.COM/?utm_source=test&fbclid=abc&other_param=value',
+    description: 'URL with uppercase hostname and multiple tracking params'
+  }
+];
+
+console.log('Testing normalizeUrl function with multiple tracking parameters...\n');
+
+let allPassed = true;
+
+for (const testCase of testCases) {
+  try {
+    const result = normalizeUrl(testCase.input);
+    console.log(`Input:  ${testCase.input}`);
+    console.log(`Output: ${result}`);
+    
+    // Check that no tracking parameters remain
+    const hasTrackingParams = ['utm_source', 'utm_medium', 'utm_campaign', 'fbclid'].some(param => 
+      result.includes(`${param}=`)
+    );
+    
+    if (hasTrackingParams) {
+      console.log('❌ FAILED: Tracking parameters still present');
+      allPassed = false;
+    } else {
+      console.log('✅ PASSED: All tracking parameters removed');
+    }
+    console.log('');
+  } catch (error) {
+    console.log(`❌ ERROR in ${testCase.description}: ${error}`);
+    allPassed = false;
+    console.log('');
+  }
+}
+
+if (allPassed) {
+  console.log('🎉 All tests passed! The fix works correctly.');
+} else {
