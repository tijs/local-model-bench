+const assert = require('assert');
+const { URL } = require('url');
+
+// Simulate the TRACKING_PARAMS and normalizeUrl function from the original code
+const TRACKING_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid"];
+
+function normalizeUrl(rawUrl) {
+  const u = new URL(rawUrl);
+  u.hostname = u.hostname.toLowerCase();
+
+  for (const param of TRACKING_PARAMS) {
+    if (u.searchParams.has(param)) {
+      u.searchParams.delete(param);
+    }
+  }
+
+  let result = u.toString();
+  if (u.pathname === "/" && result.endsWith("/")) {
+    result = result.slice(0, -1);
+  }
+  return result;
+}
+
+// Test case with multiple tracking parameters
+function testMultipleTrackingParams() {
+  const urlWithTracking = 'https://Example.com/path/?utm_source=test&utm_medium=email&fbclid=12345';
+  const normalized = normalizeUrl(urlWithTracking);
+  const normalizedUrl = new URL(normalized);
+  
+  // Check that all tracking parameters are removed
+  for (const param of TRACKING_PARAMS) {
+    assert(!normalizedUrl.searchParams.has(param), `${param} was not removed from URL`);
+  }
+  
+  // Verify the hostname is lowercased and trailing slash is removed
+  assert(normalizedUrl.hostname === 'example.com', `Hostname was not lowercased: ${normalizedUrl.hostname}`);
+  
+  console.log('SUCCESS: All tracking parameters were removed and URL was normalized correctly');
+  console.log(`Original: ${urlWithTracking}`);
+  console.log(`Normalized: ${normalized}`);
+}
+
+// Run the test
+testMultipleTrackingParams();
