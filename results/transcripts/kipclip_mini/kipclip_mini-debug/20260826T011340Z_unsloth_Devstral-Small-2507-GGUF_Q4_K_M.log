+import { normalizeUrl, TRACKING_PARAMS } from './src/url_utils.js';
+
+function testNormalizeUrl() {
+  // Create a URL with multiple tracking parameters
+  const urlWithTracking = new URL('https://example.com/path/?utm_source=test&utm_medium=email&fbclid=12345');
+  const normalized = normalizeUrl(urlWithTracking.toString());
+  
+  // Check that all tracking parameters are removed
+  const normalizedUrl = new URL(normalized);
+  for (const param of TRACKING_PARAMS) {
+    if (normalizedUrl.searchParams.has(param)) {
+      console.error(`FAIL: ${param} was not removed from URL`);
+      return false;
+    }
+  }
+  
+  // Verify the hostname is lowercased and trailing slash is removed
+  if (normalizedUrl.hostname !== 'example.com') {
+    console.error(`FAIL: Hostname was not lowercased: ${normalizedUrl.hostname}`);
+    return false;
+  }
+  
+  console.log('SUCCESS: All tracking parameters were removed and URL was normalized correctly');
+  return true;
+}
+
+testNormalizeUrl();
