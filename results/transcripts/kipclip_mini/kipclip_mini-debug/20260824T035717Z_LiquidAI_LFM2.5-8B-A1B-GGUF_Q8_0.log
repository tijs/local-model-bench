The original bug was that when a bookmarked URL has multiple tracking parameters (e.g., both `utm_source` and `fbclid`), only one gets stripped - the other stays in the saved URL. The fix involves removing the `break` statement after deleting a parameter, so that all matching parameters are removed.

The current code:
```ts
export const TRACKING_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid"];

/**
 * Normalizes a bookmarked URL: lowercases the hostname, strips known
 * tracking params, and drops a trailing slash on the bare path.
 */
export function normalizeUrl(rawUrl: string): string {
  const u = new URL(rawUrl);
  u.hostname = u.hostname.toLowerCase();

  for (const param of TRACKING_PARAMS) {
    if (u.searchParams.has(param)) {
      u.searchParams.delete(param);
    }
  }

  let result = u.toString();
  if (u.pathname === "/" && result.endsWith("/")) {
    result = result.slice(0, -1);
  }
  return result;
}
```

This now correctly removes ALL tracking parameters from the URL, not just the first one. The change was removing the `break` statement so that the loop continues checking all tracking parameters.

