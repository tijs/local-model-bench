+import { assertEquals } from "@std/assert";
+import { normalizeUrl } from "../src/url_utils.ts";
+
+Deno.test("normalizeUrl strips all tracking parameters", () => {
+  const urlWithMultipleTrackingParams = 'https://example.com/path?utm_source=newsletter&utm_medium=email&fbclid=12345';
+  const normalized = normalizeUrl(urlWithMultipleTrackingParams);
+  
+  // None of the tracking parameters should remain in the URL
+  const u = new URL(normalized);
+  for (const param of ['utm_source', 'utm_medium', 'fbclid']) {
+    assertEquals(u.searchParams.has(param), false, `${param} should be removed from the URL`);
+  }
+  
+  // The rest of the URL should remain intact
+  assertEquals(normalized.includes('example.com/path'), true, 'Base URL should remain intact');
+});
