+import { normalizeUrl } from './src/url_utils.ts';
+
+function verifyFix() {
+  console.log('=== Verifying URL Normalization Fix ===');
+  
+  // Test case: URL with multiple tracking parameters
+  const testUrl = 'https://Example.com/path/?utm_source=newsletter&utm_medium=email&fbclid=12345';
+  const normalized = normalizeUrl(testUrl);
+  const urlObj = new URL(normalized);
+  
+  console.log('Original URL:', testUrl);
+  console.log('Normalized URL:', normalized);
+  
+  // Check all tracking parameters are removed
+  const trackingParams = ['utm_source', 'utm_medium', 'fbclid'];
+  let allRemoved = true;
+  for (const param of trackingParams) {
+    if (urlObj.searchParams.has(param)) {
+      console.log(`❌ FAIL: ${param} was not removed`);
+      allRemoved = false;
+    } else {
+      console.log(`✅ ${param} correctly removed`);
+    }
+  }
+  
+  // Check other normalization aspects
+  if (urlObj.hostname !== 'example.com') {
+    console.log(`❌ FAIL: Hostname should be lowercase (got ${urlObj.hostname})`);
+    allRemoved = false;
+  } else {
+    console.log(`✅ Hostname correctly lowercase`);
+  }
+  
+  if (normalized !== 'https://example.com/path/') {
+    console.log(`❌ FAIL: URL should be https://example.com/path/ (got ${normalized})`);
+    allRemoved = false;
+  } else {
+    console.log(`✅ URL correctly normalized to base form`);
+  }
+  
+  if (allRemoved) {
+    console.log('\n🎉 SUCCESS: All tracking parameters are now correctly stripped!');
+  } else {
+    console.log('\n❌ FAILURE: Some tracking parameters remain or other normalization failed');
+  }
+  
+  return allRemoved;
+}
+
+verifyFix();
The fix has already been applied and verified. The bug is resolved, and the code now correctly strips all tracking parameters from URLs as intended.

