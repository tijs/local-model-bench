+import { assertEquals } from "https://deno.land/std@0.160.0/assert/mod.ts";
+import { normalizeUrl } from "./src/url_utils.ts";
+
+function testNormalizeUrl() {
+  console.log("Testing normalizeUrl with multiple tracking parameters...");
+  
+  // Test case 1: URL with multiple tracking parameters
+  const url1 = 'https://Example.com/path/?utm_source=newsletter&utm_medium=email&fbclid=12345';
+  const normalized1 = normalizeUrl(url1);
+  const u1 = new URL(normalized1);
+  
+  // Check that all tracking parameters are removed
+  assertEquals(u1.searchParams.has('utm_source'), false, "utm_source should be removed");
+  assertEquals(u1.searchParams.has('utm_medium'), false, "utm_medium should be removed");
+  assertEquals(u1.searchParams.has('fbclid'), false, "fbclid should be removed");
+  
+  // Check that the URL is otherwise normalized correctly
+  assertEquals(u1.hostname, 'example.com', "hostname should be lowercase");
+  assertEquals(normalized1, 'https://example.com/path/', "URL should be normalized correctly");
+  
+  // Test case 2: URL with only one tracking parameter
+  const url2 = 'https://Example.com/path/?utm_source=newsletter';
+  const normalized2 = normalizeUrl(url2);
+  const u2 = new URL(normalized2);
+  assertEquals(u2.searchParams.has('utm_source'), false, "utm_source should be removed");
+  
+  // Test case 3: URL with no tracking parameters
+  const url3 = 'https://Example.com/path/?sort=asc';
+  const normalized3 = normalizeUrl(url3);
+  const u3 = new URL(normalized3);
+  assertEquals(u3.searchParams.has('sort'), true, "non-tracking params should remain");
+  
+  // Test case 4: URL with trailing slash
+  const url4 = 'https://Example.com/path//?utm_source=newsletter';
+  const normalized4 = normalizeUrl(url4);
+  assertEquals(normalized4, 'https://example.com/path/', "trailing slash should be removed");
+  
+  console.log("All tests passed! normalizeUrl correctly strips all tracking parameters.");
+}
+
+testNormalizeUrl();
