+import { assertEquals } from "@std/assert";
+import { normalizeUrl, TRACKING_PARAMS } from "../src/url_utils.ts";
+
+Deno.test("normalizeUrl strips single tracking parameter", () => {
+  const result = normalizeUrl("https://example.com?utm_source=google");
+  assertEquals(result, "https://example.com/");
+});
+
+Deno.test("normalizeUrl strips multiple different tracking parameters", () => {
+  const url = "https://example.com?utm_source=google&fbclid=123&other=keep";
+  const result = normalizeUrl(url);
+  // Both utm_source and fbclid should be removed, other parameter kept
+  assertEquals(result.includes("utm_source"), false);
+  assertEquals(result.includes("fbclid"), false);
+  assertEquals(result.includes("other=keep"), true);
+});
+
+Deno.test("normalizeUrl bug fix: strips utm_source AND fbclid together", () => {
+  // This is the exact scenario from the bug report
+  const url = "https://example.com?utm_source=google&fbclid=abc123&page=1";
+  const result = normalizeUrl(url);
+  console.log("Input:", url);
+  console.log("Output:", result);
+  assertEquals(result.includes("utm_source"), false, "utm_source should be stripped");
+  assertEquals(result.includes("fbclid"), false, "fbclid should be stripped");
+  assertEquals(result.includes("page=1"), true, "non-tracking params should remain");
+});
+
+Deno.test("normalizeUrl with all tracking params present", () => {
+  const url = "https://example.com?utm_source=a&utm_medium=b&utm_campaign=c&fbclid=d&keep=yes";
+  const result = normalizeUrl(url);
+  for (const param of TRACKING_PARAMS) {
+    assertEquals(result.includes(param), false, `${param} should be stripped`);
+  }
+  assertEquals(result.includes("keep=yes"), true, "non-tracking params should remain");
+});
