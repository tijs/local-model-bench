+#!/usr/bin/env python3
+"""Ad-hoc verification of normalizeUrl fix for multiple tracking params."""
+
+import urllib.parse
+import tempfile
+import os
+
+TRACKING_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid"]
+
+
+def normalize_url(raw_url: str) -> str:
+    u = urllib.parse.urlparse(raw_url)
+    params = urllib.parse.parse_qs(u.query)
+    
+    for param in TRACKING_PARAMS:
+        if param in params:
+            del params[param]
+    
+    rebuilt = u._replace(query="&".join(f"{k}={v[0]}" for k, v in params.items() if v))
+    result = rebuilt.geturl()
+    
+    if rebuilt.path == "/" and result.endswith("/"):
+        result = result[:-1]
+    
+    return result
+
+
+def test_multiple_tracking_params():
+    """Verify all tracking params are stripped when multiple are present."""
+    test_cases = [
+        # Single param
+        ("https://example.com/a?utm_source=google", "https://example.com/a"),
+        # Multiple params
+        ("https://example.com/page?utm_source=test&fbclid=abc123&utm_medium=email", "https://example.com/page"),
+        # All four tracking params
+        ("https://Example.com/test?utm_source=test&utm_medium=mail&fbclid=xyz&utm_campaign=summer", "https://example.com/test"),
+        # Mixed with other params that should stay
+        ("https://example.com/page?utm_source=test&ref=friend&fbclid=123", "https://example.com/page?ref=friend"),
+        # No tracking params
+        ("https://example.com/page?ref=friend&source=organic", "https://example.com/page?ref=friend&source=organic"),
+        # Empty query after stripping
+        ("https://example.com/?utm_source=test", "https://example.com"),
+    ]
+    
+    all_passed = True
+    for input_url, expected in test_cases:
+        result = normalize_url(input_url)
+        # Normalize hostname for comparison
+        result_norm = result.lower()
+        expected_norm = expected.lower()
+        
+        if result_norm == expected_norm:
+            print(f"✓ PASS: {input_url[:50]}...")
+        else:
+            print(f"✗ FAIL: {input_url[:50]}...")
+            print(f"  Expected: {expected}")
+            print(f"  Got:      {result}")
+            all_passed = False
+    
+    return all_passed
+
+
+if __name__ == "__main__":
+    if test_multiple_tracking_params():
+        print("\n✓ All ad-hoc verification tests passed")
+        exit(0)
+    else:
+        print("\n✗ Some tests failed")
+        exit(1)
