+import { normalizeUrl } from "./src/url_utils.ts";
+
+function test(name: string, raw: string, expectedParams: string[]) {
+  const normalized = normalizeUrl(raw);
+  const u = new URL(normalized);
+  const params = Array.from(u.searchParams.keys());
+  const pass = expectedParams.every(p => params.includes(p)) && params.length === expectedParams.length;
+  console.log(`${name}: ${pass ? "PASS" : "FAIL"}`);
+  if (!pass) {
+    console.log("  Input:", raw);
+    console.log("  Output:", normalized);
+    console.log("  Params:", params);
+    console.log("  Expected params:", expectedParams);
+  }
+  return pass;
+}
+
+let allPass = true;
+
+allPass &= test(
+  "All four tracking params stripped",
+  "https://EXAMPLE.COM/path?utm_source=a&utm_medium=b&utm_campaign=c&fbclid=d&keep=1",
+  ["keep"]
+);
+
+allPass &= test(
+  "No tracking params present",
+  "https://example.com/path?keep=1",
+  ["keep"]
+);
+
+allPass &= test(
+  "Only tracking params present",
+  "https://example.com/path?utm_source=a&fbclid=b",
+  []
+);
+
+allPass &= test(
+  "Hostname lowercased",
+  "https://EXAMPLE.COM/path",
+  []
+);
+
