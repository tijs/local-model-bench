+const TRACKING_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "fbclid"];
+
+/**
+ * Normalizes a bookmarked URL: lowercases the hostname, strips known
+ * tracking params, and drops a trailing slash on the bare path.
+ */
+function normalizeUrl(rawUrl) {
+  const u = new URL(rawUrl);
+  u.hostname = u.hostname.toLowerCase();
+
+  for (const param of TRACKING_PARAMS) {
+    if (u.searchParams.has(param)) {
+      u.searchParams.delete(param);
+    }
+  }
+
+  let result = u.toString();
+  if (u.pathname === "/" && result.endsWith("/")) {
+    result = result.slice(0, -1);
+  }
+  return result;
+}
+
+// Test cases
+const testCases = [
+  {
+    name: "Multiple tracking params",
+    input: 'https://Example.com/?utm_source=test&utm_medium=email&fbclid=12345',
+    expected: 'https://example.com/'
+  },
+  {
+    name: "Single tracking param",
+    input: 'https://Example.com/?utm_source=test',
+    expected: 'https://example.com/'
+  },
+  {
+    name: "No tracking params",
+    input: 'https://Example.com/?ref=test',
+    expected: 'https://example.com/?ref=test'
+  },
+  {
+    name: "Mixed params with tracking",
+    input: 'https://Example.com/?ref=test&utm_source=test&utm_medium=email&fbclid=12345',
+    expected: 'https://example.com/?ref=test'
+  }
+];
+
+console.log("Running URL normalization verification...");
+let allPassed = true;
+
+for (const test of testCases) {
+  const result = normalizeUrl(test.input);
+  const passed = result === test.expected;
+  allPassed = allPassed && passed;
+  console.log(`\nTest: ${test.name}`);
+  console.log(`Input: ${test.input}`);
+  console.log(`Expected: ${test.expected}`);
+  console.log(`Result: ${result}`);
+  console.log(`Passed: ${passed}`);
+}
+
+console.log(`\nOverall result: ${allPassed ? 'PASSED' : 'FAILED'}`);
+
+// Additional verification: check that all tracking params are removed
+const multiParamUrl = 'https://example.com/path?utm_source=test&utm_medium=email&utm_campaign=promo&fbclid=12345';
+const normalized = normalizeUrl(multiParamUrl);
+const u = new URL(normalized);
+const remainingTracking = Array.from(u.searchParams.keys()).filter(param => TRACKING_PARAMS.includes(param));
+
+console.log(`\nAdditional verification:`);
+console.log(`Input with multiple tracking params: ${multiParamUrl}`);
+console.log(`Normalized URL: ${normalized}`);
+console.log(`Remaining tracking params: ${JSON.stringify(remainingTracking)}`);
+console.log(`All tracking params removed: ${remainingTracking.length === 0}`);
