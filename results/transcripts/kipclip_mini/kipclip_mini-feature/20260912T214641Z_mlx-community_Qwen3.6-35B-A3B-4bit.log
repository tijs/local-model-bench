```typescript
import type { Bookmark } from "./types.ts";

export function findByTag(bookmarks: Bookmark[], tag: string): Bookmark[] {
  return bookmarks.filter((b) => b.tags.includes(tag));
}

export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  if (tags.length === 0) return bookmarks;
  return bookmarks.filter((b) => tags.every((tag) => b.tags.includes(tag))));
}
```

**Behavior:**
- Empty `tags` → returns all bookmarks unchanged (short-circuit).
- Non-empty `tags` → uses `Array.prototype.every` so a bookmark must contain **every** tag in the array (AND semantics).
- Reuses the existing `Bookmark` type from `src/types.ts`.


