```typescript
export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  if (tags.length === 0) return bookmarks;
  return bookmarks.filter((b) => tags.every((tag) => b.tags.includes(tag)));
}
```

**Behavior:**
- **Empty `tags`** → returns all bookmarks unchanged (early return).
- **Non-empty `tags`** → returns only bookmarks that have **every** tag in the array (AND semantics, using `Array.every`).
- Uses the existing `Bookmark` type from `types.ts` (no changes needed).
