+import { filterByTags } from "./src/bookmarks.ts";
+
+const bookmarks = [
+  { id: "1", url: "https://example.com", title: "Example", tags: ["example", "test"], createdAt: Date.now() },
+  { id: "2", url: "https://test.com", title: "Test Site", tags: ["test", "site"], createdAt: Date.now() },
+  { id: "3", url: "https://example.org", title: "Another Example", tags: ["example", "org"], createdAt: Date.now() },
+  { id: "4", url: "https://test.org", title: "Test Org", tags: ["test", "org"], createdAt: Date.now() },
+];
+
+// Test cases
+const testCases = [
+  {
+    tags: [],
+    expectedIds: ["1", "2", "3", "4"],
+    description: "Empty tags array should return all bookmarks"
+  },
+  {
+    tags: ["test"],
+    expectedIds: ["1", "2", "4"],
+    description: "Single tag 'test'"
+  },
+  {
+    tags: ["test", "org"],
+    expectedIds: ["4"],
+    description: "Multiple tags 'test' and 'org'"
+  },
+  {
+    tags: ["example", "test"],
+    expectedIds: ["1"],
+    description: "Multiple tags 'example' and 'test'"
+  },
+  {
+    tags: ["example", "site"],
+    expectedIds: [],
+    description: "No bookmark has both 'example' and 'site'"
+  }
+];
+
+let allTestsPassed = true;
+
+for (const testCase of testCases) {
