+import { filterByTags } from "../src/bookmarks.ts";
+import type { Bookmark } from "../src/types.ts";
+import { assert, assertEquals } from "@std/assert";
+
+const b = (id: string, tags: string[]): Bookmark => ({
+  id, url: `https://x/${id}`, title: id, tags, createdAt: 0,
+});
+const all = [b("a", ["web", "ai"]), b("b", ["web"]), b("c", ["ai", "dev"]), b("d", ["web", "ai", "dev"])];
+
+// AND semantics
+assertEquals(filterByTags(all, ["web", "ai"]).map(x => x.id), ["a", "d"]);
+assertEquals(filterByTags(all, ["ai", "web"]).map(x => x.id), ["a", "d"]);
+assertEquals(filterByTags(all, ["web", "nope"]), []);
+assertEquals(filterByTags(all, ["web"]).map(x => x.id), ["a", "b", "d"]);
+// empty tags -> all unchanged
+assertEquals(filterByTags(all, []), all);
+// order preserved
+assertEquals(filterByTags(all, ["dev"]).map(x => x.id), ["c", "d"]);
+console.log("filterByTags sanity: all assertions passed");
