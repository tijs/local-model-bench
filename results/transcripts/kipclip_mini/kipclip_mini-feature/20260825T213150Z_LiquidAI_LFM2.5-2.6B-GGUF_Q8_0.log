+#!/usr/bin/env python3
+"""Ad-hoc verification of filterByTags function in src/bookmarks.ts"""
+
+import sys
+sys.path.insert(0, '/Users/tijs/projects/local-model-bench/runner/runs/tmp71krrx4y/run')
+
+from src.bookmarks import findByTag, filterByTags
+
+# Create sample bookmarks for testing
+bookmarks = [
+    {
+        "id": "1",
+        "url": "https://example.com/a",
+        "title": "Bookmark A",
+        "tags": ["tech", "docs"],
+        "createdAt": 1234567890
+    },
+    {
+        "id": "2",
+        "url": "https://example.com/b",
+        "title": "Bookmark B",
+        "tags": ["tech", "api"],
+        "createdAt": 1234567891
+    },
+    {
+        "id": "3",
+        "url": "https://example.com/c",
+        "title": "Bookmark C",
+        "tags": ["docs", "tutorial"],
+        "createdAt": 1234567892
+    },
+    {
+        "id": "4",
+        "url": "https://example.com/d",
+        "title": "Bookmark D",
+        "tags": ["tech", "docs", "api"],
+        "createdAt": 1234567893
+    },
+]
+
+print("=== Testing filterByTags ===")
+
+# Test 1: Empty tags array should return all bookmarks
+result = filterByTags(bookmarks, [])
+assert len(result) == 4, f"Expected 4 bookmarks, got {len(result)}"
+print(f"Test 1 (empty tags): PASS - returned {len(result)} bookmarks")
+
+# Test 2: Filter by single tag "tech"
+result = filterByTags(bookmarks, ["tech"])
+assert len(result) == 3, f"Expected 3 bookmarks with 'tech', got {len(result)}"
+print(f"Test 2 (tag 'tech'): PASS - returned {len(result)} bookmark(s)")
+
+# Test 3: Filter by multiple tags (AND semantics) - should get only D
+result = filterByTags(bookmarks, ["tech", "docs"])
+assert len(result) == 1, f"Expected 1 bookmark with both 'tech' and 'docs', got {len(result)}"
+assert result[0]["id"] == "4", f"Expected id '4', got {result[0]['id']}"
+print(f"Test 3 (tags ['tech', 'docs']): PASS - returned {len(result)} bookmark(s)")
+
+# Test 4: Filter by multiple tags where none match all
+result = filterByTags(bookmarks, ["tech", "viral"])
+assert len(result) == 0, f"Expected 0 bookmarks with both 'tech' and 'viral', got {len(result)}"
+print(f"Test 4 (tags ['tech', 'viral']): PASS - returned {len(result)} bookmark(s)")
+
+# Test 5: Verify findByTag still works (backward compatibility)
+result = findByTag(bookmarks, "docs")
+assert len(result) == 3, f"Expected 3 bookmarks with 'docs', got {len(result)}"
+print(f"Test 5 (findByTag with tag 'docs'): PASS - returned {len(result)} bookmark(s)")
+
+print("\n=== All tests passed ===")
