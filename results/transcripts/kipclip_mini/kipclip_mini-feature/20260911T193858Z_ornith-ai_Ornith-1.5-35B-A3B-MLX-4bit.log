export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  return bookmarks.filter((b) => tags.every((t) => b.tags.includes(t)));
}
```

- **AND semantics**: `tags.every(...)` requires every tag to be present.
- **Empty `tags`**: `every` on an empty array is `true`, so all bookmarks return unchanged.
