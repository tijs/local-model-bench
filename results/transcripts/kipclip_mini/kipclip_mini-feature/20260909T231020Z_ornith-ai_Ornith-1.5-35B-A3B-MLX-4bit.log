```ts
export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  if (tags.length === 0) {
    return bookmarks;
  }
  return bookmarks.filter((b) => tags.every((t) => b.tags.includes(t)));
}
```

- **AND semantics**: `tags.every(...)` requires every tag to be present in a bookmark's `tags`.
- **Empty `tags`**: returns all bookmarks unchanged (short-circuits before the filter).
- `deno check` passes.


