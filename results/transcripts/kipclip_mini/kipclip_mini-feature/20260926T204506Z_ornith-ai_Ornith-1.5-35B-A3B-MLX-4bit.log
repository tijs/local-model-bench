```ts
export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  return bookmarks.filter((b) => tags.every((t) => b.tags.includes(t)));
}
```

- AND semantics: a bookmark is kept only if it contains every tag in `tags` (`tags.every(...)`).
- Empty `tags` → `every` short-circuits to `true` → all bookmarks returned unchanged.

