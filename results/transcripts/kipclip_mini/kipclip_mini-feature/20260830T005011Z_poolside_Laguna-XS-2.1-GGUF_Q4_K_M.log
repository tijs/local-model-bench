+import { assertEquals } from "@std/assert";
+import { filterByTags } from "../src/bookmarks.ts";
+import type { Bookmark } from "../src/types.ts";
+
+function bookmark(overrides: Partial<Bookmark> = {}): Bookmark {
+  return {
+    id: "1",
+    url: "https://example.com",
+    title: "Example",
+    tags: [],
+    createdAt: 0,
+    ...overrides,
+  };
+}
+
+Deno.test("filterByTags: empty tags returns all bookmarks", () => {
+  const bookmarks = [
+    bookmark({ id: "a", tags: ["tag1", "tag2"] }),
+    bookmark({ id: "b", tags: ["tag2", "tag3"] }),
+    bookmark({ id: "c", tags: ["tag1", "tag3"] }),
+  ];
+  const result = filterByTags(bookmarks, []);
+  assertEquals(result.length, 3);
+});
+
+Deno.test("filterByTags: filter by single tag returns matching bookmarks", () => {
+  const bookmarks = [
+    bookmark({ id: "a", tags: ["tag1", "tag2"] }),
+    bookmark({ id: "b", tags: ["tag2", "tag3"] }),
+  ];
+  const result = filterByTags(bookmarks, ["tag1"]);
+  assertEquals(result.length, 1);
+  assertEquals(result[0].id, "a");
+});
+
+Deno.test("filterByTags: AND semantics for multiple tags", () => {
+  const bookmarks = [
+    bookmark({ id: "a", tags: ["tag1", "tag2"] }),
+    bookmark({ id: "b", tags: ["tag2", "tag3"] }),
+    bookmark({ id: "c", tags: ["tag1", "tag3"] }),
+  ];
+  const result = filterByTags(bookmarks, ["tag1", "tag2"]);
+  assertEquals(result.length, 1);
+  assertEquals(result[0].id, "a");
+});
+
+Deno.test("filterByTags: no match returns empty", () => {
+  const bookmarks = [
+    bookmark({ id: "a", tags: ["tag1"] }),
+  ];
+  const result = filterByTags(bookmarks, ["nonexistent"]);
+  assertEquals(result.length, 0);
+});
