+import type { Bookmark } from "./src/types.ts";
+import { filterByTags } from "./src/bookmarks.ts";
+
+// Test data
+const bookmarks: Bookmark[] = [
+  { id: "1", url: "https://a.com", title: "A", tags: ["tag1", "tag2"], createdAt: 1000 },
+  { id: "2", url: "https://b.com", title: "B", tags: ["tag2", "tag3"], createdAt: 2000 },
+  { id: "3", url: "https://c.com", title: "C", tags: ["tag1", "tag3"], createdAt: 3000 },
+];
+
+// Test 1: Empty tags array should return all bookmarks
+const emptyResult = filterByTags(bookmarks, []);
+if (emptyResult.length !== 3) {
+  console.error("FAIL: empty tags should return all");
+  Deno.exit(1);
+}
+console.log("PASS: empty tags returns all bookmarks");
+
+// Test 2: Filter by single tag
+const singleResult = filterByTags(bookmarks, ["tag1"]);
+if (singleResult.length !== 2) {
+  console.error("FAIL: filter by tag1 should return 2 bookmarks");
+  Deno.exit(1);
+}
+console.log("PASS: filter by single tag works");
+
+// Test 3: Filter by multiple tags (AND semantics)
+const multiResult = filterByTags(bookmarks, ["tag1", "tag2"]);
+if (multiResult.length !== 1) {
+  console.error("FAIL: filter by tag1 and tag2 should return 1 bookmark");
+  Deno.exit(1);
+}
+console.log("PASS: AND semantics for multiple tags works");
+
+// Test 4: No bookmarks match
+const noMatch = filterByTags(bookmarks, ["nonexistent"]);
+if (noMatch.length !== 0) {
+  console.error("FAIL: filter by nonexistent tag should return 0");
+  Deno.exit(1);
+}
+console.log("PASS: nonexistent tag returns empty");
+
+// Test 5: Verify AND semantics (tag1 AND tag3 should return bookmark 3)
+const andResult = filterByTags(bookmarks, ["tag1", "tag3"]);
+if (andResult.length !== 1 || andResult[0].id !== "3") {
+  console.error("FAIL: AND semantics - expected bookmark 3");
+  Deno.exit(1);
+}
+console.log("PASS: AND semantics verified - bookmark with both tags returned");
+
+console.log("\nALL TESTS PASSED");
