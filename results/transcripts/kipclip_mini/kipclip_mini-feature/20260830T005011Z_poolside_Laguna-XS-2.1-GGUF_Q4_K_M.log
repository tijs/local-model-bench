+// Ad-hoc verification script for filterByTags function
+// Run with: deno task test --no-check + this file
+
+import type { Bookmark } from "./src/types.ts";
+import { filterByTags } from "./src/bookmarks.ts";
+
+const bookmarks: Bookmark[] = [
+  { id: "1", url: "https://a.com", title: "A", tags: ["tag1", "tag2"], createdAt: 1000 },
+  { id: "2", url: "https://b.com", title: "B", tags: ["tag2", "tag3"], createdAt: 2000 },
+  { id: "3", url: "https://c.com", title: "C", tags: ["tag1", "tag3"], createdAt: 3000 },
+];
+
+console.log("=== Ad-hoc verification for filterByTags ===");
+
+// Test 1: Empty tags array should return all bookmarks unchanged
+const t1 = filterByTags(bookmarks, []);
+const t1Pass = t1.length === 3 && t1 === bookmarks;
+console.log(`Test 1 (empty tags returns all): ${t1Pass ? "PASS" : "FAIL"}`);
+
+// Test 2: Filter by single tag
+const t2 = filterByTags(bookmarks, ["tag1"]);
+const t2Pass = t2.length === 2 && t2.every(b => b.tags.includes("tag1"));
+console.log(`Test 2 (single tag filter): ${t2Pass ? "PASS" : "FAIL"}`);
+
+// Test 3: AND semantics - must have ALL tags
+const t3 = filterByTags(bookmarks, ["tag1", "tag2"]);
+const t3Pass = t3.length === 1 && t3[0].id === "1";
+console.log(`Test 3 (AND semantics tag1+tag2): ${t3Pass ? "PASS" : "FAIL"}`);
+
+// Test 4: Another AND test
+const t4 = filterByTags(bookmarks, ["tag1", "tag3"]);
+const t4Pass = t4.length === 1 && t4[0].id === "3";
+console.log(`Test 4 (AND semantics tag1+tag3): ${t4Pass ? "PASS" : "FAIL"}`);
+
+// Test 5: No matches
+const t5 = filterByTags(bookmarks, ["nonexistent"]);
+const t5Pass = t5.length === 0;
+console.log(`Test 5 (no matches): ${t5Pass ? "PASS" : "FAIL"}`);
+
+const allPass = t1Pass && t2Pass && t3Pass && t4Pass && t5Pass;
+console.log(`\n=== ${allPass ? "ALL TESTS PASSED" : "SOME TESTS FAILED"} ===`);
+Deno.exit(allPass ? 0 : 1);
