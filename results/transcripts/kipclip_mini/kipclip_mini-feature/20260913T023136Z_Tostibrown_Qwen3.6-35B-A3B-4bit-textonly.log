export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  return bookmarks.filter((b) => tags.every((tag) => b.tags.includes(tag)));
}
```

- **AND semantics**: `tags.every(...)` ensures all specified tags must be present.
- **Empty array**: `[].every(...)` returns `true`, so all bookmarks pass through unchanged.
