@@ -0,0 +1,27 @@
+import { filterByTags } from "./src/bookmarks.ts";
+
+const bookmarks = [
+  { id: "1", url: "https://example.com", title: "Example", tags: ["example", "test"], createdAt: Date.now() },
+  { id: "2", url: "https://test.com", title: "Test Site", tags: ["test", "site"], createdAt: Date.now() },
+  { id: "3", url: "https://example.org", title: "Another Example", tags: ["example", "org"], createdAt: Date.now() },
+  { id: "4", url: "https://test.org", title: "Test Org", tags: ["test", "org"], createdAt: Date.now() },
+];
+
+// Test empty tags array (should return all bookmarks)
+const allBookmarks = filterByTags(bookmarks, []);
+console.log("All bookmarks:", allBookmarks.length); // Should be 4
+
+// Test single tag
+const exampleBookmarks = filterByTags(bookmarks, ["example"]);
+console.log("Example bookmarks:", exampleBookmarks.map(b => b.id)); // Should be ["1", "3"]
+
+// Test multiple tags (AND semantics)
+const testExampleBookmarks = filterByTags(bookmarks, ["test", "example"]);
+console.log("Test & Example bookmarks:", testExampleBookmarks.map(b => b.id)); // Should be [] (no bookmark has both tags)
+
+const testOrgBookmarks = filterByTags(bookmarks, ["test", "org"]);
+console.log("Test & Org bookmarks:", testOrgBookmarks.map(b => b.id)); // Should be ["4"]
+
+// Test non-existent tag
+const nonexistentBookmarks = filterByTags(bookmarks, ["nonexistent"]);
+console.log("Nonexistent bookmarks:", nonexistentBookmarks.length); // Should be 0
