+import { filterByTags } from "/Users/tijs/projects/local-model-bench/runner/runs/tmp3fegj9_d/run/src/bookmarks.ts";
+
+const bookmarks = [
+  { id: "1", url: "a", title: "A", tags: ["js", "ts"], createdAt: 1 },
+  { id: "2", url: "b", title: "B", tags: ["ts", "rust"], createdAt: 2 },
+  { id: "3", url: "c", title: "C", tags: ["js", "go"], createdAt: 3 },
+];
+
+// 1) Empty tags -> all bookmarks
+const all = filterByTags(bookmarks, []);
+if (all.length !== 3) throw new Error(`empty tags: expected 3, got ${all.length}`);
+
+// 2) Single tag -> only those with "ts"
+const ts = filterByTags(bookmarks, ["ts"]);
+if (ts.length !== 2) throw new Error(`single tag: expected 2, got ${ts.length}`);
+if (ts[0].id !== "1" || ts[1].id !== "2") throw new Error("single tag: wrong bookmarks");
+
+// 3) Two tags AND -> only bookmark with BOTH tags
+const both = filterByTags(bookmarks, ["js", "ts"]);
+if (both.length !== 1) throw new Error(`two tags: expected 1, got ${both.length}`);
+if (both[0].id !== "1") throw new Error("two tags: wrong bookmark");
+
+// 4) Three tags -> none match
+const three = filterByTags(bookmarks, ["js", "ts", "rust"]);
+if (three.length !== 0) throw new Error(`three tags: expected 0, got ${three.length}`);
+
+console.log("All filterByTags checks passed.");
