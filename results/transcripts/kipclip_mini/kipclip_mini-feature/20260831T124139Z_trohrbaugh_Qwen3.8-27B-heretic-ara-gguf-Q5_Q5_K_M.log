+import { filterByTags, findByTag } from "/Users/tijs/projects/local-model-bench/runner/runs/tmppdt2su_v/run/src/bookmarks.ts";
+import type { Bookmark } from "/Users/tijs/projects/local-model-bench/runner/runs/tmppdt2su_v/run/src/types.ts";
+
+const mk = (id: string, tags: string[]): Bookmark =>
+  ({ id, url: `https://x/${id}`, title: id, tags, createdAt: 1 });
+
+const bms: Bookmark[] = [
+  mk("a", ["x"]),
+  mk("b", ["x", "y"]),
+  mk("c", ["y", "z"]),
+  mk("d", ["x", "y", "z"]),
+];
+
+let pass = 0, fail = 0;
+const check = (name: string, got: Bookmark[], expected: string[]) => {
+  const ok = got.length === expected.length && got.every((b, i) => b.id === expected[i]);
+  if (ok) pass++;
+  else { fail++; console.error(`FAIL ${name}: got [${got.map(b => b.id)}] want [${expected}]`); }
+};
+
+// empty tags → all bookmarks unchanged
+check("empty-tags-all", filterByTags(bms, []), ["a", "b", "c", "d"]);
+
+// single tag behaves like AND of one
+check("single-tag", filterByTags(bms, ["x"]), ["a", "b", "d"]);
+
+// AND semantics
+check("and-xy", filterByTags(bms, ["x", "y"]), ["b", "d"]);
+check("and-xz", filterByTags(bms, ["x", "z"]), ["d"]);
+check("and-xyz", filterByTags(bms, ["x", "y", "z"]), ["d"]);
+
+// no match
+check("none", filterByTags(bms, ["nope"]), []);
+check("none-combo", filterByTags(bms, ["x", "nope"]), []);
+
+// duplicate tags in query
+check("dup-tags", filterByTags(bms, ["y", "y"]), ["b", "c", "d"]);
+
+// consistency with findByTag for a single tag
+check("matches-findByTag", filterByTags(bms, ["y"]), findByTag(bms, "y").map((b) => b.id));
+
+console.log(`${pass} passed, ${fail} failed`);
+if (fail > 0) Deno.exit(1);
