+import type { Bookmark } from "./src/types.ts";
+import { filterByTags } from "./src/bookmarks.ts";
+
+const bookmarks: Bookmark[] = [
+  { id: "1", url: "https://a.com", title: "A", tags: ["tag1", "tag2"], createdAt: 1 },
+  { id: "2", url: "https://b.com", title: "B", tags: ["tag1"], createdAt: 2 },
+  { id: "3", url: "https://c.com", title: "C", tags: ["tag2", "tag3"], createdAt: 3 },
+  { id: "4", url: "https://d.com", title: "D", tags: ["tag1", "tag2", "tag3"], createdAt: 4 },
+  { id: "5", url: "https://e.com", title: "E", tags: [], createdAt: 5 },
+];
+
+let passed = 0;
+let failed = 0;
+
+function test(name: string, condition: boolean) {
+  if (condition) {
+    console.log(`✓ ${name}`);
+    passed++;
+  } else {
+    console.log(`✗ ${name}`);
+    failed++;
+  }
+}
+
+// Test 1: Empty tags array returns all bookmarks
+const r1 = filterByTags(bookmarks, []);
+test("Empty tags returns all", r1.length === 5 && r1.every((b, i) => b.id === bookmarks[i].id));
+
+// Test 2: Single tag filter
+const r2 = filterByTags(bookmarks, ["tag1"]);
+test("Single tag filter", r2.length === 3 && r2.map(b => b.id).sort().join(",") === "1,2,4");
+
+// Test 3: Multiple tags - AND semantics
+const r3 = filterByTags(bookmarks, ["tag1", "tag2"]);
+test("Multiple tags (AND)", r3.length === 2 && r3.map(b => b.id).sort().join(",") === "1,4");
+
+// Test 4: Tags with no matches
+const r4 = filterByTags(bookmarks, ["tag1", "tag99"]);
+test("No matches", r4.length === 0);
+
+// Test 5: All tags present
+const r5 = filterByTags(bookmarks, ["tag1", "tag2", "tag3"]);
+test("All tags present", r5.length === 1 && r5[0].id === "4");
+
+// Test 6: Empty bookmarks array
+const r6 = filterByTags([], ["tag1"]);
+test("Empty input array", r6.length === 0);
+
+// Test 7: Bookmark with no tags matching filter
+const r7 = filterByTags(bookmarks, ["tag1"]);
+test("Bookmark with no matching tags excluded", !r7.find(b => b.id === "5"));
+
+console.log(`\nResults: ${passed} passed, ${failed} failed`);
+process.exit(failed > 0 ? 1 : 0);
