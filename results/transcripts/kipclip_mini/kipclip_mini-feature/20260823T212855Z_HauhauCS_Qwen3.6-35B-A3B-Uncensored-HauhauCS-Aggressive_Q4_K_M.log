+import { filterByTags } from "./src/bookmarks.ts";
+import { assertEquals } from "https://deno.land/std@0.200.0/assert/mod.ts";
+
+const bookmarks = [
+  { id: "1", url: "a", title: "A", tags: ["js", "ts"], createdAt: 1 },
+  { id: "2", url: "b", title: "B", tags: ["js", "py"], createdAt: 2 },
+  { id: "3", url: "c", title: "C", tags: ["ts", "py"], createdAt: 3 },
+  { id: "4", url: "d", title: "D", tags: ["js", "ts", "py"], createdAt: 4 },
+];
+
+// Test 1: empty tags returns all bookmarks
+const all = filterByTags(bookmarks, []);
+assertEquals(all.length, 4);
+
+// Test 2: single tag filter
+const jsOnly = filterByTags(bookmarks, ["js"]);
+assertEquals(jsOnly.length, 2);
+assertEquals(jsOnly.map(b => b.id).sort(), ["1", "2"]);
+
+// Test 3: two tags (AND semantics)
+const both = filterByTags(bookmarks, ["js", "ts"]);
+assertEquals(both.length, 2);
+assertEquals(both.map(b => b.id).sort(), ["1", "4"]);
+
+// Test 4: three tags → only bookmark with all three
+const triple = filterByTags(bookmarks, ["js", "ts", "py"]);
+assertEquals(triple.length, 1);
+assertEquals(triple[0].id, "4");
+
+// Test 5: no match → empty array
+const none = filterByTags(bookmarks, ["rust", "go"]);
+assertEquals(none.length, 0);
+
+// Test 6: duplicate filter tags
+const dup = filterByTags(bookmarks, ["js", "js"]);
+assertEquals(dup.length, 2);
+
+console.log("All ad-hoc verification tests passed.");
