+#!/usr/bin/env node
+
+// Focused verification script for filterByTags function
+
+// Mock Bookmark type
+class Bookmark {
+  constructor(id, url, title, tags, createdAt) {
+    this.id = id;
+    this.url = url;
+    this.title = title;
+    this.tags = tags;
+    this.createdAt = createdAt;
+  }
+}
+
+// Import the function (simulated since we can't actually import TypeScript)
+function filterByTags(bookmarks, tags) {
+  if (tags.length === 0) {
+    return bookmarks;
+  }
+  return bookmarks.filter((b) => tags.every((t) => b.tags.includes(t)));
+}
+
+// Test data
+const testBookmarks = [
+  new Bookmark("1", "https://example.com", "Example", ["example", "test"], Date.now()),
+  new Bookmark("2", "https://demo.com", "Demo", ["demo", "test"], Date.now()),
+  new Bookmark("3", "https://sample.com", "Sample", ["sample", "test", "example"], Date.now()),
+];
+
+// Test cases
+function runVerification() {
+  console.log("=== filterByTags Verification ===");
+  
+  // Test 1: Empty tags array should return all bookmarks
+  const result1 = filterByTags(testBookmarks, []);
+  const pass1 = result1.length === testBookmarks.length;
+  console.log(`Test 1 (empty tags): ${pass1 ? "PASS" : "FAIL"}`);
+  
+  // Test 2: Should return bookmarks with all specified tags
+  const result2 = filterByTags(testBookmarks, ["test", "example"]);
+  const pass2 = result2.length === 2 && result2.some(b => b.id === "1") && result2.some(b => b.id === "3");
+  console.log(`Test 2 (tags: ['test', 'example']): ${pass2 ? "PASS" : "FAIL"}`);
+  
+  // Test 3: Should return empty array when no bookmark matches all tags
+  const result3 = filterByTags(testBookmarks, ["nonexistent", "tag"]);
+  const pass3 = result3.length === 0;
+  console.log(`Test 3 (non-matching tags): ${pass3 ? "PASS" : "FAIL"}`);
+  
+  // Test 4: Should handle single tag case correctly
+  const result4 = filterByTags(testBookmarks, ["test"]);
+  const pass4 = result4.length === 3;
+  console.log(`Test 4 (single tag 'test'): ${pass4 ? "PASS" : "FAIL"}`);
+  
+  // Summary
+  const allPass = pass1 && pass2 && pass3 && pass4;
+  console.log(`\nOverall: ${allPass ? "ALL TESTS PASS" : "SOME TESTS FAILED"}`);
+  
+  return allPass;
+}
+
+// Run verification
+const success = runVerification();
+process.exit(success ? 0 : 1);
