+import { assertEquals } from "https://deno.land/std@0.206.0/assert/mod.ts";
+import { Bookmark } from "../src/types.ts";
+import { filterByTags } from "../src/bookmarks.ts";
+
+const testBookmarks: Bookmark[] = [
+  {
+    id: "1",
+    url: "https://example.com",
+    title: "Example",
+    tags: ["example", "test"],
+    createdAt: Date.now(),
+  },
+  {
+    id: "2",
+    url: "https://demo.com",
+    title: "Demo",
+    tags: ["demo", "test"],
+    createdAt: Date.now(),
+  },
+  {
+    id: "3",
+    url: "https://sample.com",
+    title: "Sample",
+    tags: ["sample", "test", "example"],
+    createdAt: Date.now(),
+  },
+];
+
+deno.test("filterByTags should return all bookmarks when tags array is empty", () => {
+  const result = filterByTags(testBookmarks, []);
+  assertEquals(result.length, testBookmarks.length);
+  assertEquals(result, testBookmarks);
+});
+
+deno.test("filterByTags should return bookmarks with all specified tags", () => {
+  const result = filterByTags(testBookmarks, ["test", "example"]);
+  assertEquals(result.length, 1);
+  assertEquals(result[0].id, "3");
+});
+
+deno.test("filterByTags should return empty array when no bookmark matches all tags", () => {
+  const result = filterByTags(testBookmarks, ["nonexistent", "tag"]);
+  assertEquals(result.length, 0);
+});
+
+deno.test("filterByTags should handle single tag case correctly", () => {
+  const result = filterByTags(testBookmarks, ["test"]);
+  assertEquals(result.length, 3);
+});
