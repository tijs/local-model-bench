+import { Bookmark } from "./src/types.ts";
+import { filterByTags } from "./src/bookmarks.ts";
+
+const testBookmarks: Bookmark[] = [
+  {
+    id: "1",
+    url: "https://example.com",
+    title: "Example",
+    tags: ["example", "test"],
+    createdAt: Date.now(),
+  },
+  {
+    id: "2",
+    url: "https://demo.com",
+    title: "Demo",
+    tags: ["demo", "test"],
+    createdAt: Date.now(),
+  },
+  {
+    id: "3",
+    url: "https://sample.com",
+    title: "Sample",
+    tags: ["sample", "test", "example"],
+    createdAt: Date.now(),
+  },
+];
+
+// Test cases
+describe("filterByTags", () => {
+  it("should return all bookmarks when tags array is empty", () => {
+    const result = filterByTags(testBookmarks, []);
+    expect(result).toHaveLength(testBookmarks.length);
+    expect(result).toEqual(testBookmarks);
+  });
+
+  it("should return bookmarks with all specified tags", () => {
+    const result = filterByTags(testBookmarks, ["test", "example"]);
+    expect(result).toHaveLength(1);
+    expect(result[0].id).toBe("3");
+  });
+
+  it("should return empty array when no bookmark matches all tags", () => {
+    const result = filterByTags(testBookmarks, ["nonexistent", "tag"]);
+    expect(result).toHaveLength(0);
+  });
+
+  it("should handle single tag case correctly", () => {
+    const result = filterByTags(testBookmarks, ["test"]);
+    expect(result).toHaveLength(3);
+  });
+});
