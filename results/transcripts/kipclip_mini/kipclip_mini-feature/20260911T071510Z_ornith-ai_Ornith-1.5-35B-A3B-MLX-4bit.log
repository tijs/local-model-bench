export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
  return bookmarks.filter((b) => tags.every((t) => b.tags.includes(t)));
}
```

- AND semantics via `tags.every(...)` — a bookmark must contain every requested tag.
- Empty `tags` returns all bookmarks unchanged, since `every` over an empty array is `true`.
- `deno check` passes.


