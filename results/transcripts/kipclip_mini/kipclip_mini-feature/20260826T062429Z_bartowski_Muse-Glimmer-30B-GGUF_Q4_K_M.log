}

assertEqual(filterByTags(b, ["news","tech"]).map(x=>x.id), ["a"], "AND semantics");
assertEqual(filterByTags(b, []).map(x=>x.id), ["a","b","c"], "empty tags returns all
");
assertEqual(filterByTags(b, ["science"]).map(x=>x.id), ["c"], "single tag");
assertEqual(filterByTags(b, ["news","missing"]).map(x=>x.id), [], "no match");
console.log("All ad-hoc verifications passed");

