 export function findByTag(bookmarks: Bookmark[], tag: string): Bookmark[] {
   return bookmarks.filter((b) => b.tags.includes(tag));
 }
+
+export function filterByTags(bookmarks: Bookmark[], tags: string[]): Bookmark[] {
+  if (tags.length === 0) {
+    return bookmarks;
+  }
+  return bookmarks.filter((b) => tags.every((tag) => b.tags.includes(tag)));
+}
