# Rust
target/
# Cargo.lock is intentionally tracked (not ignored) for fixtures/ — a
# benchmark run should be fully reproducible, same as npm/deno lockfiles.

# Swift
.build/
.swiftpm/

# Node / Deno
node_modules/
.deno/

# scratch run dirs, if ever created under the repo instead of /tmp
runner/runs/

# DFlash2 llama.cpp fork checkout + build (runner/setup_dflash2_fork.sh) —
# a full llama.cpp source tree + compiled binary, too large/volatile to
# commit; the setup script is what's durable, not this output.
runner/.dflash2-fork/

# Mainline llama.cpp checkout + build, built at HEAD for DSpark support
# ahead of the Homebrew bottle (runner/setup_dspark_head.sh) — same reason
# as .dflash2-fork/ above.
runner/.dspark-head/

# Python bytecode cache
runner/__pycache__/
